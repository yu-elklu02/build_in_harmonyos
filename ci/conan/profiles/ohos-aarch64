# ─── 鸿蒙 PC aarch64 Conan Profile ──────────────────────────────────
# 目标平台：OpenHarmony / HarmonyOS PC (aarch64)
# Triplet：aarch64-linux-ohos（由 OHOS 适配版 conan 自动生成）
#
# 前提：使用 OHOS 适配版 conan（私有 PyPI 提供，基线 2.29.1）
#   - os=OHOS 为有效枚举值
#   - get_gnu_triplet 自动将 OHOS 映射为 linux-ohos
#   - CMakeToolchain 自动将 OHOS 映射为 CMAKE_SYSTEM_NAME=HarmonyOS
#   - Meson/Qbs 自动将 OHOS 映射为 harmonyos
# 因此本 profile 无需手动设置 triplet / system_name 等 conf。
#
# arch=armv8 是 conan 标准枚举值，对应 AArch64（即 aarch64）。
#
# 使用方式：
#   conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

[settings]
os=OHOS
os.version=6.0
arch=armv8
compiler=clang
compiler.version=15
compiler.libcxx=libc++
compiler.cppstd=17
build_type=Release

[conf]
# 工具链路径（环境特定，conan 无法自动探测）
tools.build:compiler_executables={"c": "/data/service/hnp/bin/clang", "cpp": "/data/service/hnp/bin/clang++"}

[buildenv]
CONFIG_SHELL=/data/service/hnp/bin/bash
SHELL=/data/service/hnp/bin/bash
# PATH 必须用 (path) 类型标记，否则被当成普通字符串变量（空格分隔），
# 导致 tool_requires 贡献的 bin/ 目录用空格拼接成畸形路径，所有依赖
# PATH 查找构建工具的包都会失败（如 libthai 查找 libdatrie 的 trietool）。
# 注意：=+ 是前置操作符，写在后面的行最终排在 PATH 最前面。
PATH=+(path)/storage/Users/currentUser/usr/local/bin
PATH=+(path)/data/service/hnp/bin
