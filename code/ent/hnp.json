{
  "name": "ent",
  "version": "0.14.6",
  "description": "ent — An entity framework for Go (code generation toolchain)",
  "homepage": "https://github.com/ent/ent",
  "source": "https://github.com/ent/ent",
  "license": "Apache-2.0",
  "type": "tool",
  "arch": "ohos-aarch64",
  "build_system": "go",
  "category": "toolchain",
  "language": "go",
  "environment": {
    "GOOS": "linux",
    "GOARCH": "arm64",
    "CC": "aarch64-linux-ohos-clang",
    "CGO_ENABLED": "1",
    "GOWORK": "off"
  },
  "output": {
    "bin": ["entc"]
  },
  "install_path": "$HOME/usr/local"
}