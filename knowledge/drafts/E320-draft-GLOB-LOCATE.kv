#====================================================================
# E260 — conan package() 用 glob 递归定位 cargo 产物
# 发现于: aiken/1.1.23 (basic_layout build_folder 解析)
# 日期: 2026-08-12
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E320
trigger_tool: conan|cargo
phase: packaging
error_signature: aiken binary not found|binary not found.*build.*source|FileNotFoundError.*target/release

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: conan|packaging|cargo|layout
match_keywords: basic_layout, build_folder, source_folder, cargo target/release, glob, package(), binary not found, conan package
title: conan package() 用 glob 递归定位 cargo 产物，绕过 basic_layout 路径不确定性

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: conanfile.py 使用 basic_layout(self) 时，build_folder 与
            source_folder 的具体路径取决于 conan 的 layout 解析，
            不同 conan 版本/profile 组合下路径可能不同。cargo build
            产物在 <build>/target/release/<bin>，但 build_folder 的
            确切位置在 conan 2.x 不同 layout 模式下有差异，
            导致 package() 中硬编码的路径（如 self.build_folder）可能
            找不到产物。
affected_scope: 所有使用 basic_layout + cargo build 的 Rust conan 配方
verification_cmd: |
  # 在 conanfile.py package() 中，用 glob 递归查找 target/release/<bin>
  import glob
  found = []
  for root in (self.build_folder, self.source_folder):
      found.extend(glob.glob(os.path.join(root, "**", "target", "release", "<bin>"), recursive=True))
  assert found, "<bin> binary not found under build/source folders"
  copy(self, "<bin>", os.path.dirname(found[0]), os.path.join(self.package_folder, "bin"))

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: glob-recursive-locate-cargo-artifact
rec_description: 在 conanfile.py package() 中，不硬编码 build_folder 路径，
                 而是用 glob.glob(recursive=True) 在 build_folder 和
                 source_folder 下递归查找 target/release/<bin>，
                 鲁棒定位 cargo 产物。
rec_command: |
  import glob, os
  found = []
  for root in (self.build_folder, self.source_folder):
      found.extend(glob.glob(os.path.join(root, "**", "target", "release", "<bin>"), recursive=True))
  assert found, "<bin> binary not found under build/source folders"
  src_dir = os.path.dirname(found[0])
  copy(self, "<bin>", src_dir, os.path.join(self.package_folder, "bin"))
rec_auto_fix: false
rec_impl: conanfile-glob-locate

fallback_priority: 2
fallback_approach: hardcoded-build-folder
fallback_description: 若 glob 方式在特定 conan 版本下不可靠，退回硬编码
                      self.build_folder 路径（但失去 layout 解析的灵活性）。
fallback_command: copy(self, "<bin>", os.path.join(self.build_folder, "target", "release"), os.path.join(self.package_folder, "bin"))
fallback_auto_fix: false
fallback_impl: conanfile-hardcode-path

# ★ 禁止策略 ★
forbid_1_pattern: find.*-name.*target/release
forbid_1_reason: 用 find 命令在 package() 中不可移植，且可能匹配到缓存中其他项目的产物
forbid_1_consequence: 误复制错误的二进制

forbid_2_pattern: cp.*target/release.*package_folder
forbid_2_reason: 直接 cp 绕过 conan 的 copy() 工具，失去 conan 的文件跟踪和权限处理
forbid_2_consequence: 产物权限/归属错误，conan package 失败

# ═══ Layer 4: 原则引用 ═══
principles: R26

