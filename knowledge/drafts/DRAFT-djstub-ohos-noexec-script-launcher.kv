#====================================================================
# DRAFT - Installed shell commands cannot execute from OHOS noexec storage
#====================================================================

id:                     DRAFT-djstub-ohos-noexec-script-launcher
trigger_tool:           shell|bash|conan|test_package|runtime
phase:                  packaging|testing|runtime
error_signature:        Permission denied.*(djlink|djstrip|djelfextract)|
                         Operation not permitted.*(script|exec)|
                         cannot execute.*(\.sh|djlink|djstrip|djelfextract)|
                         exit status 126.*shell script

severity:               3
category:               harmonyos|hmdfs|noexec|shell|launcher|packaging
match_keywords:         HarmonyOS, HMDFS, noexec, shell script, shebang,
                         Permission denied, exit 126, native ELF launcher,
                         /data/service/hnp/bin/bash, libexec, /proc/self/exe
title:                  Package script commands behind native ELF launchers on OHOS noexec storage

root_cause: >
  HarmonyOS user-data and package staging locations may deny direct execve of
  script files. The kernel rejects the script before its shebang interpreter is
  started, so chmod and replacing the shebang with an existing HNP Bash path do
  not make an installed script a reliable command entry point. This differs
  from E037, where the interpreter path itself is missing, and from E260, which
  protects selection of an ELF interpreter against path replacement.

affected_scope: >
  Conan application packages that install upstream sh or Bash utilities under
  bin/ on HarmonyOS PC and expect consumers to invoke those utilities by name.

verification_cmd: >
  conan create archives/d/djstub/0.7; command -v djlink djstrip djelfextract;
  file "$(command -v djlink)"; djlink -v; djstrip; djelfextract

rec_priority:           1
rec_approach:           native-elf-launcher-for-packaged-scripts
rec_description: >
  Keep the unmodified upstream scripts as package data under libexec/<package>/
  and install a small native ELF launcher under each public bin/ command name.
  The launcher resolves its own package-relative location, allow-lists the
  supported basename, prepends the HNP tool directory to PATH, and calls execv
  with the fixed /data/service/hnp/bin/bash path plus the script and original
  arguments. Use an argv array, not shell -c, so consumer arguments are not
  reparsed by an extra shell layer.
rec_command: >
  Compile an OHOS-only launcher with the target clang; copy scripts to
  libexec/<package>/; copy the launcher to bin/<script-name>; validate every
  installed entry through test_package on the target device.
rec_auto_fix:           false
rec_impl:               conan-packaging-plus-native-launcher

fallback_priority:      2
fallback_approach:      explicit-bash-internal-use-only
fallback_description: >
  For private build or test steps that do not need a public command entry,
  invoke the script explicitly with the fixed HNP Bash executable. Do not use
  this fallback for packaged bin/ commands because consumers expect direct
  execution through PATH.
fallback_command:       /data/service/hnp/bin/bash /absolute/package/script "$@"
fallback_auto_fix:      false
fallback_impl:          explicit-interpreter-invocation

forbid_1_pattern:       chmod.*script|rewrite.*shebang.*data/service/hnp/bin/bash
forbid_1_reason:        noexec rejects the script object before the shebang interpreter runs
forbid_1_consequence:   the installed command still exits with permission denied or status 126

forbid_2_pattern:       (system|popen|shell -c|bash -c).*(script|argv)
forbid_2_reason:        an extra command-string parse loses argv boundaries and expands untrusted text
forbid_2_consequence:   arguments can be corrupted or interpreted as shell syntax

principles:             P013

causes:                 []
caused_by:              []
similar_to:             [E037,E046,E260]
conflicts_with:         [E037]
prerequisite_of:        []

