#====================================================================
# E325-draft-vlang-source-bootstrap-ohos-runtime.kv
#====================================================================

# Layer 0: error / trigger surface
id:                     E325-draft-vlang-source-bootstrap-ohos-runtime
trigger_tool:           conan|make|compiler-bootstrap
phase:                  source,build,package,test_package
error_signature:        vlang/vc|make v|binary-sign-tool|read-only /tmp|Boehm GC|CMakeToolchain.extra_ldflags

# Layer 1: identification
severity:               3
category:               compiler-bootstrap|ohos-runtime|conan-toolchain
match_keywords:         vlang, v, vc, self-hosted compiler, bootstrap, source(), make v, binary-sign-tool, TMPDIR, gc none, extra_exelinkflags

# Layer 2: diagnosis
root_cause:             自举编译器类软件常把 bootstrap 源、阶段产物执行、源码根定位
                        和运行时临时目录耦合在一起。V 0.5.2 的默认 Makefile 会在
                        构建阶段拉取 vlang/vc，并立即执行 stage1/stage2/final
                        编译器；HarmonyOS PC 上构建阶段不能依赖联网拉取，生成的
                        ELF 需要签名后才能继续执行，默认 /tmp 可能只读，且默认
                        Boehm GC 在目标上可能报告无效数据根范围。Conan 2 的
                        CMakeToolchain 还区分可执行链接标志和通用链接标志。
affected_scope:         自举语言编译器、需要外部 bootstrap 源仓库的工具链、
                        安装后必须通过 wrapper 保持源码根关系的 CLI 编译器包，
                        以及 test_package 需要给 CMake 可执行探测追加 OHOS
                        linker 选择的 Conan 2 配方。
verification_cmd:       conan create archives/v/vlang/0.5.2 --build=vlang/*

# Layer 3: recommendation
rec_priority:           1
rec_approach:           pinned-bootstrap-source-and-signed-stage-wrapper
rec_description:        在 source() 中下载并校验主源码与 bootstrap 源，避免 build()
                        阶段 clone/pull；只运行本地 bootstrap 目标；每个需要立即
                        exec 的 OHOS 阶段产物用 binary-sign-tool 签名并恢复执行位；
                        build/package/test 均设置 recipe-owned TMPDIR/TMP/TEMP；
                        包装 bin/v 让真实编译器在 share/v 下找到 cmd/vlib/thirdparty，
                        并在 OHOS 普通编译调用中追加 -gc none。
rec_command:            get(v source) && get(vc source) && make -f Makefile -j1 v VCFILE=v.c OHOS_SIGN_TOOL=binary-sign-tool TMPDIR=$build/tmp
rec_auto_fix:           false
rec_impl:               recipe-source-bootstrap

fallback_priority:      2
fallback_approach:      executable-link-flag-split
fallback_description:   test_package 使用 Conan 2 CMakeToolchain 时，给 CMake 编译器
                        探测或消费者可执行程序追加 OHOS linker 选择，应使用
                        toolchain.extra_exelinkflags，而不是不存在的 extra_ldflags。
fallback_command:       toolchain.extra_exelinkflags.append("-fuse-ld=/path/to/ld.bfd")
fallback_auto_fix:      false
fallback_impl:          test_package

# Forbidden strategies
forbid_1_pattern:       build.*git clone|build.*curl.*vlang/vc|make.*fresh_vc
forbid_1_reason:        自举源必须在 source() 阶段固定并校验，build() 阶段联网拉取会使 CI 不可复现。
forbid_1_consequence:   构建阶段网络超时或拉取到非锁定 bootstrap 源，导致不可追溯。
forbid_2_pattern:       CMakeToolchain\.extra_ldflags
forbid_2_reason:        Conan 2 CMakeToolchain 没有该属性；可执行链接标志应走 extra_exelinkflags。
forbid_2_consequence:   generate() 阶段 AttributeError，CI 在 conan-build-test 前中止。

