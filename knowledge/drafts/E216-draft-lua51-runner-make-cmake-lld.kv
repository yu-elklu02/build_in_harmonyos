#====================================================================
# Draft knowledge entry for lua/5.1 adaptation
#====================================================================

id:                     E216
trigger_tool: make|cmake|clang
phase: compilation|linking|testing
error_signature: make: inaccessible or not found|cmake: inaccessible or not found|Error loading shared library libxml2.so.16|Error relocating .*lld: xml.* symbol not found

severity: 2
category: conan|toolchain|runner
match_keywords: make,cmake,clang,lld,libxml2,LD_LIBRARY_PATH,lua,runner,test_package
title: Makefile-only C libraries need direct Conan build and linker runtime env on OHOS runners

root_cause: Some OHOS PR runners do not expose make/cmake to Conan subprocesses, and OHOS SDK lld may require the SDK llvm/lib directory in LD_LIBRARY_PATH for libxml2 runtime symbols.
affected_scope: Small C libraries with hand-written Makefiles where downstream consumers need headers/static libraries more than packaged CLI tools.
verification_cmd: conan create archives/l/lua/5.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=lua/*

rec_priority: 1
rec_approach: direct-compile-source-list-and-wrap-link-env
rec_description: Mirror the upstream Makefile source list in the Conan recipe, compile with the profile compiler, archive with llvm-ar/llvm-ranlib, run the upstream smoke test from the build tree, and prepend OHOS SDK ohos/native/llvm/lib to LD_LIBRARY_PATH around link commands.
rec_command: use conan.tools.env.Environment().prepend_path("LD_LIBRARY_PATH", sdk_llvm_lib) with vars(self).apply() around clang link commands
rec_auto_fix: false
rec_impl: conan-recipe

fallback_priority: 2
fallback_approach: package-library-surface-only
fallback_description: If CI generic CLI smoke probes do not match upstream command semantics and downstream only needs the library, package include/lib/man/license and leave CLI binaries uninstalled.
fallback_command: set cpp_info.bindirs=[] and validate include/lua.h plus lib/liblua.a in package()
fallback_auto_fix: false
fallback_impl: conan-recipe

forbid_1_pattern: self\\.run\\(.*env=\\{.*\\}
forbid_1_reason: Conan 2 self.run(env=...) expects generated env script names, not a raw Python dict.
forbid_1_consequence: Recipe may fail before reaching the intended compiler/linker command.

principles: P014

causes:                 []
caused_by:              [E132]
similar_to:             [E011,E132]
conflicts_with:         []
prerequisite_of:        []

