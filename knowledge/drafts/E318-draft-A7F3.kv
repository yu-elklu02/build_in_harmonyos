#====================================================================
# E318.kv — GNOME 生态 glib 静态链接 g_libintl_* 符号缺失 + meson host_machine.system() 平台判断
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E318-draft-A7F3
trigger_tool:           meson|linker
phase:                  configure,linking
error_signature:        g_libintl_.*|undefined symbol.*g_libintl|host_machine.*harmonyos|implicit declaration.*dgettext

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               linking|platform_detection
match_keywords:         glib, g_libintl, libintl, gettext, meson, host_machine, host_system, harmonyos, gnome, gtk, pango, intl-wrapper

# ═══ Layer 2: 诊断层 ═══
root_cause:             glib libintl.h 将 gettext 宏定义为 g_libintl_*，OHOS musl
                        libintl.so 只导出 libintl_* 符号，glib 静态库引用 g_libintl_*
                        无定义 → 链接 undefined symbol；meson 报 host_machine=harmonyos
                        不匹配 'linux' 条件分支，Linux 特有链接器选项被跳过。
affected_scope:         所有依赖 glib 且用 meson 构建的 GNOME 生态库
                        （atk/gtk+/pango 等，凡静态链接 glib 并引用 libintl 符号者）。
verification_cmd:       pkg-config --modversion glib-2.0 && ninja -C builddir test

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           intl-wrapper
rec_description:        创建 intl-wrapper.c 将 g_libintl_* 符号映射到返回 msgid 的
                        兜底实现（OHOS musl 单域），加入 meson.build 源文件列表，
                        并注入 -Ddgettext(a,b)=((char*)(b)) 避 int 转换；
                        同时 meson.build 的 host_machine.system() == 'linux' 改为
                        in ['linux', 'harmonyos'] 使 Linux 特有链接器选项生效。
rec_command:            sed -i "s/if host_machine.system() == 'linux'/if host_machine.system() in ['linux', 'harmonyos']/g" meson.build && echo 'char *g_libintl_gettext(const char *m){return (char*)(m);}' > intl-wrapper.c
rec_auto_fix:           false
rec_impl:               source-shim

fallback_priority:      2
fallback_approach:      pkg-config-propagation
fallback_description:   PkgConfigDeps 让 configure 通过 pkg-config 找到 glib，
                        package_info() 声明 cpp_info.requires=["glib::glib"]，
                        复制 glib 包子模块 .pc（gobject/gio/gmodule）。
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          recipe

# ★ 禁止策略 ★
forbid_1_pattern:       -Ddgettext=.*libintl_dgettext
forbid_1_reason:        不要直接链接 libintl_dgettext（OHOS musl 无该导出），
                        应走 g_libintl_* 兜底映射或返回 msgid
forbid_1_consequence:   链接期 undefined symbol，需额外 wrapper

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:             E090, E107
conflicts_with:               
prerequisite_of:        

