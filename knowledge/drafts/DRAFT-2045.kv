#====================================================================
# DRAFT-2045 — HMDFS 上使用共享库实体副本提供 SONAME/链接兼容名称
# 触发事件: libtorrent 0.16.17 HarmonyOS PC 适配（Issue #2045）
#====================================================================

id:                     DRAFT-2045 (amends E274; corroborates E316)
trigger_tool:           libtool|conan|package|runtime|ld
phase:                  installation|packaging|runtime
error_signature:        ln.*(symbolic link|symlink).*(Permission denied|Operation not permitted)|
                         Error loading shared library.*lib[^ ]+\.so(\.[0-9]+)+|
                         needed by.*lib[^ ]+\.so(\.[0-9]+)+

severity:               2
category:               packaging|soname|symlink|hmdfs|conan|libtool
match_keywords:         HMDFS, symlink, SONAME, shared library, libtool,
                         compatibility name, versioned .so, file copy,
                         libtorrent.so.47, Conan package, NEEDED
title:                  Materialize SONAME compatibility names when the package filesystem cannot create symlinks

root_cause: >
  Shared-library installers normally expose one real versioned ELF through developer and
  SONAME symlinks. HMDFS does not support creating those links, so an otherwise successful
  libtool install may omit names required by linkers or the runtime loader. E274 recommends
  creating a SONAME symlink, but that primary recommendation is not executable on HMDFS.
  E316 validates copying a SONAME entity for one OpenBLAS consumer; libtorrent 0.16.17
  provides an independent libtool-based case where the same portable fallback preserves
  libtorrent.so and libtorrent.so.47 alongside libtorrent.so.47.0.0.
affected_scope: >
  Conan packages installed on filesystems without symlink support when upstream libtool or
  Makefile install rules normally create developer and SONAME aliases for a shared library.
verification_cmd: >
  llvm-readelf -d <package>/lib/libtorrent.so.47.0.0 | grep SONAME;
  ls -l <package>/lib/libtorrent.so*;
  verify that every required alias is a regular ELF file, then build and run a consumer with
  only the package lib directory on its runtime search path.

rec_priority:           1
rec_approach:           capability-aware-soname-materialization
rec_description: >
  Preserve the upstream symlink layout on filesystems that support it. When link creation is
  unavailable, copy the final real shared-library ELF to every required developer and SONAME
  compatibility name. Derive the names from the installed library layout or ELF SONAME rather
  than hard-coding unrelated ABI versions. Remove Libtool .la files after installation, and
  validate both package contents and a real consumer against the isolated package.
rec_command: >
  real=libtorrent.so.47.0.0;
  cp "$real" libtorrent.so.47;
  cp "$real" libtorrent.so;
  llvm-readelf -d "$real" | grep SONAME
rec_auto_fix:           false
rec_impl:               conan-recipe-post-install-materialization

fallback_priority:      2
fallback_approach:      create-soname-symlinks-on-capable-filesystem
fallback_description: >
  If the package directory supports symlinks, retain the conventional relative links from the
  developer and SONAME names to the real versioned ELF, as described by E274.
fallback_command:       ln -s libtorrent.so.47.0.0 libtorrent.so.47 && ln -s libtorrent.so.47 libtorrent.so
fallback_auto_fix:      false
fallback_impl:          upstream-install-layout

forbid_1_pattern:       os\.symlink|ln -s|ln -sf
forbid_1_reason:        Unconditional link creation fails on HMDFS and can leave required package names absent.
forbid_1_consequence:   Packaging fails or downstream link/runtime lookup cannot find the expected shared-library name.
forbid_2_pattern:       copy only .*\.so($| )
forbid_2_reason:        Copying only the developer name does not guarantee that the ELF SONAME requested through NEEDED exists.
forbid_2_consequence:   The package builds but an isolated runtime consumer reports a missing versioned shared library.
forbid_3_pattern:       skip.*symlink.*test.*without.*remaining
forbid_3_reason:        A platform-specific symlink test exemption must not suppress unrelated filesystem or package-consumer coverage.
forbid_3_consequence:   A broad test skip can hide regressions unrelated to the unsupported filesystem capability.

principles:             P016
similar_to:             E274, E316, E073
conflicts_with:         E274 (only when its symlink-first recommendation is applied unconditionally on HMDFS)
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-2045.md
last_updated:           2026-08-12
source_event:           archives/l/libtorrent/0.16.17

authors:                xuguowei
source_pr:              OpenHarmonyPCDeveloper/build_in_harmonyos#5124
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-12
