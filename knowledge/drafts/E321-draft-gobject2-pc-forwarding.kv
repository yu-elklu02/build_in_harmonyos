#====================================================================
# E321-draft-gobject2-pc-forwarding.kv — 消费方 meson 检测 gobject-2.0
#   需配方在 generate() 补转发型 .pc（PkgConfigDeps 只生成声明的那一个 .pc）
#   实例：graphene 1.10.8 依赖 glib2/2.88.0
#====================================================================

# --- frontmatter 检索字段 ---
library:    graphene
build:      meson
error:      pkgerror
toolchain:  clang15
platform:   ohos
dependency: glib2

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                 E321
trigger_tool:       meson|pkg-config
phase:              configuration
error_signature:    Run-time dependency gobject-2\.0 found: NO|
                    dependency.*gobject-2\.0.*not found|
                    pkg-config.*gobject-2\.0.*not found in pkg-config search path|
                    No package 'gobject-2\.0' found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           2
category:           pkg-config|build_system|dependency|glib2
match_keywords:     graphene, glib2, glib-2.0, gobject-2.0, gio-2.0, PkgConfigDeps,
                    pkg_config_name, forwarding pc, alias-pc, pkg-config search path,
                    meson dependency, GNOME, GLib, glib-mkenums, pango

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         Conan 2 的 PkgConfigDeps 按依赖包 cpp_info 组件的 pkg_config_name
                    逐一生成 .pc；本仓 glib2 配方（archives/g/glib2/2.88.0）只声明
                    根组件一个 pkg_config_name="glib-2.0"，故只生成 glib-2.0.pc。
                    而 GNOME/GLib 家族上游是 .pc **多文件体系**（glib-2.0 /
                    gobject-2.0 / gio-2.0 … 各一个 .pc）。
                    消费方 meson.build 用 dependency('gobject-2.0') 检测时，
                    pkg-config 在 generators 目录搜不到 gobject-2.0.pc → 检测失败
                    （graphene 1.10.8 的 graphene-gobject 类型需要 gobject）。
                    这是 conan PkgConfigDeps 的"每包单 .pc 输出"与上游多 .pc
                    体系的通用落差，不是单一库的问题。
affected_scope:     所有通过 conan PkgConfigDeps 依赖 GNOME/GLib 家族包（glib2、
                    gtk、pango、gdk-pixbuf 等）且消费方用 meson dependency() 检测
                    家族内非主 .pc（gobject-2.0、gio-2.0、gmodule-2.0 等）的项目。
                    另见 gdk-pixbuf `_create_pkg_config_alias`（复制改名式别名）。
verification_cmd:   |
  # 1. 看 PkgConfigDeps 生成了哪些 .pc
  ls ${generators_folder}/           # 期望只有 glib-2.0.pc，无 gobject-2.0.pc
  # 2. 复现 meson 检测失败
  pkg-config --exists gobject-2.0; echo $?   # 非 0 = 找不到
  # 3. 主 .pc 版本（转发型 .pc 的 Version 应继承它）
  pkg-config --modversion glib-2.0           # 期望 2.88.0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       forwarding-pc-in-generate
rec_description:    在**消费方配方**的 generate() 里，PkgConfigDeps.generate() 之后
                    补写一个转发型 <副>.pc（如 gobject-2.0.pc）到
                    self.generators_folder：Version 从主 .pc（glib-2.0.pc）的
                    Version 行**动态继承**（不写死）；Requires: <主.pc>（路径/Cflags
                    /Libs 全部由被转发的 glib-2.0.pc 提供，转发型 .pc 不写 prefix）。
                    前提：依赖声明用 transitive_headers=True, transitive_libs=True
                    让 glib 头/库透传给下游。这是 pango 1.56.4 配方
                    【skill: --alias-pc 生成】（cairo-ft=cairo,freetype2 /
                    cairo-fc=cairo,fontconfig）的同款手法。
rec_command:        |
  # graphene 1.10.8 配方 generate() 实例（archives/g/graphene/1.10.8/conanfile.py）
  # def generate(self):
  #     PkgConfigDeps(self).generate()
  #     self._forward_gobject_pc()
  def _forward_gobject_pc(self):
      _src = os.path.join(self.generators_folder, "glib-2.0.pc")
      if not os.path.isfile(_src):
          self.output.warning("gobject-2.0 forward: glib-2.0.pc not generated, skip")
          return
      _ver = "0"
      with open(_src, encoding="utf-8") as _f:
          for _line in _f:
              if _line.startswith("Version:"):
                  _ver = _line.split(":", 1)[1].strip()
                  break
      _dst = os.path.join(self.generators_folder, "gobject-2.0.pc")
      if os.path.isfile(_dst):
          return
      with open(_dst, "w", encoding="utf-8") as _f:
          _f.write(
              "Name: gobject-2.0\n"
              "Description: forwarding .pc generated by graphene recipe (Requires glib-2.0)\n"
              "Version: %s\n"
              "Requires: glib-2.0\n" % _ver
          )
  # 依赖声明：self.requires("glib2/2.88.0", transitive_headers=True, transitive_libs=True)
rec_auto_fix:       false
rec_impl:           recipe-generate

fallback_priority:  2
fallback_approach:  patch-glob-aliases
fallback_description: 消费方需要多个副 .pc 时，写通用循环：扫描 generators_folder 下
                    主 .pc，对每个 pkg_config_name 派生别名 .pc（Requires: 主.pc），
                    一次覆盖整个 GNOME/GLib 家族；仍走 generate()，Version 仍动态继承。
fallback_command:   |
  # 通用别名示意（generate() 内）
  # for _alias, _req in [('gobject-2.0', 'glib-2.0'), ('gio-2.0', 'glib-2.0')]:
  #     _ver = 读取 generators_folder/<_req>.pc 的 Version: 行
  #     写 generators_folder/<_alias>.pc = Name / Version / Requires: <_req>
fallback_auto_fix:  false
fallback_impl:      recipe-generate-loop

forbid_1_pattern:   写死 Version（如 .pc 里硬编码 "Version: 2.88.0"）
forbid_1_reason:    conan 依赖版本升级或配方跨版本复用后，写死的版本与主 .pc 脱节；
                    消费方 dependency('gobject-2.0', version: '>=X') 约束会拒绝
forbid_1_consequence: 版本约束不满足 → meson 报依赖版本错误；或依赖升级后遗留的
                    旧版本号误导后续排查
forbid_2_pattern:   把包内自带的 .pc 直接加 PKG_CONFIG_PATH
forbid_2_reason:    conan 包内 .pc 按 prefix=/ 安装，写的是 /lib、/include 等根路径；
                    直接加 PKG_CONFIG_PATH 会解析到设备上不存在的 /lib
forbid_2_consequence: pkg-config 命中但 Cflags/Libs 指向空目录 /lib；若同时混设
                    C_INCLUDE_PATH 还触发 E075 的 -I 过滤陷阱
forbid_2_auto_reject: false
forbid_2_suggest:   改用转发型 .pc 指向 conan 生成的 glib-2.0.pc，不污染全局 PKG_CONFIG_PATH

# ═══ Layer 4: 原则引用 ═══
principles:         P014

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:         E075, E158
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
doc_file:           doc/E321.md
last_updated:       2026-08-14
source_event:       graphene-1.10.8 适配（archives/g/graphene/1.10.8）

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
