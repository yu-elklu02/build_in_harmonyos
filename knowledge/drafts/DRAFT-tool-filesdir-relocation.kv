#====================================================================
# DRAFT-tool-filesdir-relocation: Recover packaged tool data from a stale FILESDIR
# Trigger event: pixz/1.0.7 HarmonyOS PC adaptation
#====================================================================

id:                     DRAFT-tool-filesdir-relocation
trigger_tool:           conan|runtime|test
phase:                  testing|runtime
error_signature:        FILESDIR.*(not found|missing)|Failed to load.*std\.cfg|\bstd\.cfg\b.*(not found|No such file)

severity:               2
category:               conan|packaging|tool|runtime-data|relocation|harmonyos
match_keywords:         FILESDIR, std.cfg, cppcheck, Conan package, build-time path, runtime data directory, symlink
title:                  Restore a packaged tool's stale FILESDIR to its installed data directory

root_cause: >
  Some tools embed an absolute FILESDIR while building. Conan later installs the executable and
  its data files in different package directories, leaving the embedded build path stale even
  though the required data files are present in the package.
affected_scope: >
  Relocatable Conan command-line tools whose executable embeds an absolute data directory and
  whose package contains the same runtime data under a known relative path.
verification_cmd: >
  Locate the FILESDIR marker in the executable; verify the installed data directory contains the
  required file (for cppcheck: share/Cppcheck/cfg/std.cfg); then run the upstream tool test.

rec_priority:           1
rec_approach:           verified-filesdir-relocation
rec_description: >
  Extract and validate the embedded absolute FILESDIR, map it to the package's verified data
  directory, and materialize a symlink only when the stale path is absent. If the filesystem
  rejects symlinks, copy the read-only runtime data directory as a capability fallback. Fail
  rather than overwrite an existing mismatched path.
rec_command:            inspect ELF marker FILESDIR set to; link or copy installed data directory to that exact path
rec_auto_fix:           false
rec_impl:               conan-recipe-runtime-data-relocation

fallback_priority:      2
fallback_approach:      patch-tool-build-filesdir
fallback_description: >
  Rebuild the tool with FILESDIR set to a relocatable installed data directory when its build
  system exposes such a configuration option.
fallback_command:       configure or CMake FILESDIR to the package data directory
fallback_auto_fix:      false
fallback_impl:          upstream-build-configuration

forbid_1_pattern:       symlink\(.*FILESDIR|os\.symlink\(.*hardcoded
forbid_1_reason:        Do not create a link from an unvalidated marker or replace an existing target.
forbid_1_consequence:   A malformed or stale binary can redirect writes outside the intended build cache.
forbid_2_pattern:       suppress=.*(nullPointerOutOfMemory|nullPointerArithmeticOutOfMemory)
forbid_2_reason:        Static-analysis warnings caused by unchecked allocations require source fixes, not suppression.
forbid_2_consequence:   The test may pass while a real allocation-failure crash remains in the shipped program.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             E018, E050
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-tool-filesdir-relocation.md
last_updated:           2026-08-18
source_event:           archives/p/pixz/1.0.7

authors:                elklu02
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-18
