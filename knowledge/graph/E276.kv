# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E276
trigger_tool: conan
phase: source|build
error_signature: BadZipFile: File is not a zip file|Uncompressing <name> to .|codeload.github.com/.../tar.gz/refs/tags/vX.Y.Z

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan|build
match_keywords: codeload,badzipfile,filename=,conan.get,refs.tags,tar.gz,basename,decompress
title: Conan get() 对 codeload tar.gz URL basename 误判为 zip 报 BadZipFile

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan get() 按 os.path.basename(url) 推断下载文件名再按扩展名选解压算法;codeload.github.com 的 tar.gz URL stem 是 .../tar.gz/refs/tags/vX.Y.Z,basename 得到无扩展名的 vX.Y.Z → unzip() 按无扩展名误判为 zip → 报 BadZipFile: File is not a zip file。源码 tarball 本身合法(tar xzf 能解,SHA256 校验通过),非配方/补丁错误。
affected_scope: 所有 conanfile.py source() 用 get() 拉取 codeload.github.com tar.gz URL 的配方;非 codeload 的 GitHub release tar.gz(stem 干净)不受影响。
verification_cmd: cd $REPO_DIR && sha256sum <(curl -fsSL https://codeload.github.com/McNopper/EGL/tar.gz/refs/tags/v1.0.5)  # 期望 df593a89acfaa7193193b7d9ca3864cd7eb7521e9ae88005b8864308d083881c,证 tarball 合法;再跑 python3 scripts/ohc-run.py conan-verify egl 1.0.5,加 filename= 后 G2 PASS(日志 archives/e/egl/1.0.5/reports/conan-create.log 不再出现 BadZipFile,改为 Uncompressing egl-1.0.5.tar.gz to .)。egl/1.0.5 真机验证证据: conan-verify 与 ci/conan/build_and_test.sh 双通过,test_package test_egl 跑通 EGL 生命周期(eglInitialize→eglBindAPI(ES)→eglChooseConfig→eglCreatePbufferSurface 16×16→eglCreateContext(ES3)→eglMakeCurrent→eglGetProcAddress(glGetString) 返回非 NULL 且真调取到 GL_VENDOR=HUAWEI→release→destroy/terminate),日志 /storage/Users/currentUser/egl-1.0.5-build-and-test.log。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 在 source() 的 get() 调用显式传 filename='<软件>-<版本>.tar.gz',让 conan 按扩展名正确识别为 tar.gz 解压;URL 保持官方源(R39)不变,只改下载文件名。
rec_description: conanfile.py source() 改为: get(self, **self.conan_data['sources'], strip_root=True, filename='egl-1.0.5.tar.gz')。原理:get() 的 filename 参数覆盖 basename 推断,Uncompressor2 按 .tar.gz 扩展名走 tar.gz 解压器而非 unzip。无需改 URL,无需改 conandata.yml 的 sha256。
rec_command: sed -i "s/get(self, \*\*self.conan_data\[\"sources\"\], strip_root=True)/get(self, \*\*self.conan_data[\"sources\"], strip_root=True, filename=\"egl-1.0.5.tar.gz\")/" archives/e/egl/1.0.5/conanfile.py
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

