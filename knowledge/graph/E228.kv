#====================================================================
# E228 — HMDFS 上无扩展名 Libtool 测试 wrapper 无法直接启动
#====================================================================

# Layer 0: Error Surface
id:                     E228
trigger_tool:           make|automake|libtool
phase:                  testing
error_signature:        Permission denied.*test/|LOG_COMPILER.*Permission denied|libtool.*wrapper.*cannot execute

# Layer 1: Recognition
severity:               2
category:               testing|libtool|hmdfs|permissions
match_keywords:         Libtool wrapper, LOG_COMPILER, .libs, Permission denied, extensionless script, make check, /system/bin/sh
title:                  HMDFS 上无扩展名 Libtool 测试 wrapper 无法直接启动

# Layer 2: Diagnosis
root_cause:             Automake/Libtool 为动态链接测试生成与测试 ELF 同名的无扩展名 shell wrapper，真实 ELF 位于相邻 .libs 目录。HMDFS 权限语义可能阻止 wrapper 直接执行，而它没有 .sh 后缀，普通脚本规则无法识别；同时静态或非 Libtool 测试本身是真实 ELF，不能统一交给 shell 解释。
affected_scope:         在 HarmonyOS HMDFS 工作目录运行 Automake make check，且测试集合同时包含 Libtool wrapper 和直接 ELF 的项目。
verification_cmd:       for t in test/*; do test -f "${t%/*}/.libs/${t##*/}" && file "$t" "${t%/*}/.libs/${t##*/}"; done

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           conditional-log-compiler-launcher
rec_description:        给 Automake LOG_COMPILER 提供 launcher；对首个测试参数计算同目录 .libs/<basename>，存在该真实 ELF 时用 HarmonyOS shell 启动外层 wrapper，否则直接 exec 原测试。launcher 自身也通过已知 shell 启动，不依赖执行位。
rec_command:            candidate="${1%/*}/.libs/${1##*/}"; if test -f "$candidate"; then exec /system/bin/sh "$@"; else exec "$@"; fi
rec_auto_fix:           false
rec_impl:               conan-test-launcher

fallback_priority:      2
fallback_approach:      relocate-build-tree
fallback_description:   若 LOG_COMPILER 不能覆盖上游测试驱动，将构建和测试迁移到允许脚本正常执行的目标机文件系统，再保持原 make check 判定。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       LOG_COMPILER=.*sh(?!.*\.libs)|exec /system/bin/sh \"\$@\".*unconditional
forbid_1_reason:        将所有测试统一交给 shell 会把真实 ELF 当脚本解析，制造新的失败或掩盖测试类型差异。
forbid_1_consequence:   非 Libtool 测试无法运行，make check 结果失真。
forbid_2_pattern:       chmod \+x.*wrapper|skip.*Permission denied
forbid_2_reason:        HMDFS 上 chmod 可能不改变有效执行权限；跳过 wrapper 会减少上游测试覆盖。
forbid_2_consequence:   问题仍复现，或以删减测试伪造通过。

# Layer 4: Principles
principles:             P010,P013

# Relations
causes:                 []
caused_by:              []
similar_to:             E087,E129
conflicts_with:         []
prerequisite_of:        []

