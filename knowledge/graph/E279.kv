#====================================================================
# E215.kv — 跨补丁引擎的上下文锚定补丁
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E279
trigger_tool: patch|configure
phase: configuration
error_signature: config\.guess: line [0-9]+:.*HarmonyOS|cannot guess build type

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: patch-portability
match_keywords: patch-ng, zero-context hunk, config.guess, context anchor
title: 跨补丁引擎的上下文锚定补丁

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 零上下文补丁块只依赖行号，GNU patch 与 patch-ng 可能将其插入不同语法层级。
affected_scope: CI 使用 patch-ng 而本地使用 GNU patch 的 Autotools 发布包。
verification_cmd: 分别使用 GNU patch --fuzz=0 和 patch-ng fuzz=false 应用后执行 shell 语法检查。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: context-anchored-patch
rec_description: 补丁块同时包含修改点前后的稳定上下文并使用两种补丁引擎验证。
rec_command: patch --fuzz=0 -p1 < fix.patch && sh -n config.guess
rec_auto_fix: false
rec_impl:               manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       @@ -[0-9]+,0 \+[0-9]+,[0-9]+ @@
forbid_1_reason:        零上下文插入在不同补丁引擎下定位不唯一。
forbid_1_consequence:   补丁返回成功但脚本分支被插入错误语法层级。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E279.md
last_updated: 2026-07-16
source_event: PR #2103 onigmo 与 PR #2104 libvo-aacenc

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                 2301_80739235 <2047361658@qq.com>
source_pr:               2103
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  2
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:       2026-07-16
