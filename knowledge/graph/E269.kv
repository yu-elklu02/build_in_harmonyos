#====================================================================
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E269
trigger_tool: python
phase: testing
error_signature: SyntaxError: Missing parentheses in call to print|#!/usr/bin/env python2|Python 2.*runner|print .*SyntaxError

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing
match_keywords: python2, python 2, run_tests.py, test runner, Missing parentheses, SyntaxError, subprocess.check_output
title: Python 2 测试 runner 在 OHOS Python 3 环境中无法执行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游测试 runner 使用 Python 2 的 print 语句或其他仅 Python 2 支持的语法；HarmonyOS CI 仅提供 Python 3，导致语法检查或测试执行失败。
affected_scope: 使用 Python 2 编写、通过 subprocess 调用已构建目标二进制并比对文本或 JSON 语料的 C/C++ 项目测试 runner；不适用于依赖 Python 2 C 扩展、urllib2、unicode/str 语义或 Python 2 专有第三方包的 runner。
verification_cmd: python3 -m py_compile <runner.py> && LD_LIBRARY_PATH=<build_folder> python3 <runner.py> && test <通过数> -eq <语料总数>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 2
rec_approach: port-python-script
rec_description: 对于不依赖 Python 2 C 扩展或 Python 2 专有第三方包的测试 runner，保持测试语料和断言语义不变，将 shebang 改为 python3、print 语句改为函数调用，并将 subprocess.check_output 返回的 bytes 在展示错误时显式 decode。将迁移后的 runner 纳入构建或测试阶段，以目标二进制和完整上游语料执行验证。
rec_command: python3 -m py_compile run_tests.py && LD_LIBRARY_PATH=<build_folder> python3 run_tests.py
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: execute-targeted-tests
fallback_description: 当 runner 使用 Python 2 C 扩展、Python 2 专有第三方包或复杂 unicode/str 语义而无法安全迁移时，保留上游语料不变，选取可独立执行的核心目标测试；同时在适配报告中明确未执行范围和阻塞依赖。
fallback_command: LD_LIBRARY_PATH=<build_folder> <target-test-binary>
fallback_auto_fix:      false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: delete.*testcases|skip.*testcases|not run.*Python 2
forbid_1_reason: 不能通过删除、改写或标记跳过上游语料来规避 Python 2 runner 兼容问题。
forbid_1_consequence: 上游测试覆盖被削弱，测试通过率失真，无法证明迁移后的库行为与上游一致。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

