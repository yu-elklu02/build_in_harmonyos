#====================================================================
# E226 — 受限进程不可枚举根目录导致 hostfs 身份探测误判
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E303
trigger_tool: runtime|grub-file|hostfs
phase: testing|runtime
error_signature: error: can't open `/': Permission denied[.]?|opendir.*[/].*EACCES

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: restricted-process-filesystem-probe
match_keywords: can't open /, Permission denied, hostfs, opendir, EACCES, root directory, restricted process, application domain
title: 受限进程不可枚举根目录导致 hostfs 身份探测误判

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 受限运行域可能允许路径搜索和已知文件访问，却拒绝读取根目录项；hostfs 将仅用于确认宿主伪磁盘的 opendir("/") EACCES 当成坏文件名，使真实目标文件尚未检查就提前失败
affected_scope: 在容器、沙箱或应用安全域等受限进程中以根目录枚举作为文件系统身份或能力探测、而实际数据访问另有独立校验的宿主侧工具
verification_cmd: x86_64-elf-grub-file --is-x86-multiboot multiboot.o

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: scope-root-probe-eacces
rec_description: 仅当 errno 为 EACCES 且探测路径严格等于 / 时，把 hostfs 身份探测视为成功；按运行时能力失败判断而不依赖平台宏，后续实际文件打开仍由原有函数校验并保留所有其他错误
rec_command: patch --dry-run --fuzz=0 -p1 -d "$GRUB_SOURCE_ROOT" -i "$RECIPE_ROOT/patches/0010-grub-core-kern-emu-hostfs.c.patch"
rec_auto_fix: false
rec_impl: source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: use-explicit-accessible-root
fallback_description: 若上游调用接口允许，显式传入应用域可枚举的包目录，避免把 / 作为身份探测路径
fallback_command: invoke the tool with an explicit accessible module directory
fallback_auto_fix: false
fallback_impl: runtime-option

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: ignore.*opendir.*error|return.*GRUB_ERR_NONE.*all
forbid_1_reason: 无条件吞掉目录打开错误会把 ENOENT、ENOTDIR 和真实权限故障伪装成成功
forbid_1_consequence: 后续访问在更远位置失败且诊断信息丢失
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P013, P015

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: [E031, E212]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: chmod.* /|chown.* /|disable.*sandbox|run.*root
forbid_2_reason: 修改系统根目录权限或绕过应用安全域不属于三方库适配边界
forbid_2_consequence: 破坏系统安全模型且在 CI/用户环境不可复现
doc_file:               doc/E303.md
last_updated: 2026-07-19
source_event: x86_64-elf-grub/2.12 真机 test_package 的 grub-file 在识别有效 Multiboot 对象前因 opendir("/") EACCES 退出；先以 OHOS 守卫验证根因，评审后收紧为不依赖平台宏的 path=="/" 且 EACCES 运行时条件

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          新条目生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors: 2301_80739235 <2047361658@qq.com>
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 1.0
metrics_last_used: 2026-07-19
