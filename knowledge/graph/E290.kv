#====================================================================
# E217 draft - CMake typedef detection must use a compile probe
# Corresponding document: knowledge/graph/draft/E217-draft-CX17.md
#====================================================================

# Layer 0: Error Surface
id:                     E290
trigger_tool:           cmake|conan create|clang
phase:                  configuration|compilation
error_signature:        check_symbol_exists.*typedef|HAVE_.*TYPE.*FALSE|unknown type name.*__kernel_|__kernel_rwf_t

# Layer 1: Recognition
severity:               2
category:               cmake|feature-detection|portability
match_keywords:         check_symbol_exists, typedef, type alias, check_c_source_compiles, AC_CHECK_TYPES, HAVE_KERNEL_RWF_T, __kernel_rwf_t
title:                  CMake 类型探测不能使用 check_symbol_exists

# Layer 2: Diagnosis
root_cause:             check_symbol_exists 只适合宏、函数和变量；对 typedef 或类型别名会尝试取地址并必然编译失败，使实际存在的目标类型被误判为不存在。
affected_scope:         将 Autoconf AC_CHECK_TYPES 或其他类型能力探测迁移到 CMake 的 C/C++ 项目，包括原生构建和交叉构建
verification_cmd:       cmake -S . -B build && cmake --build build --verbose

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           compile-probe-for-type
rec_description:        用目标编译器编译一个包含目标头文件、声明该类型变量的最小源码，使 HAVE_* 结果与目标头文件中的真实类型定义一致
rec_command:            include(CheckCSourceCompiles); check_c_source_compiles("#include <header.h>\nint main(void) { target_type *value = 0; return value != 0; }" HAVE_TARGET_TYPE)
rec_auto_fix:           false
rec_impl:               cmake-source-probe

fallback_priority:      2
fallback_approach:      check-type-size
fallback_description:   需要同时获取类型大小时使用 CheckTypeSize，但仍必须让目标 toolchain 完成编译探测
fallback_command:       include(CheckTypeSize); check_type_size("target_type" TARGET_TYPE_SIZE)
fallback_auto_fix:      false
fallback_impl:

# Forbidden strategies
forbid_1_pattern:       check_symbol_exists.*typedef|check_symbol_exists.*_t\b
forbid_1_reason:        typedef 不是可取地址的符号，检测会稳定地产生假阴性
forbid_1_consequence:   HAVE_* 宏错误、目标功能被静默禁用或后续编译失败
forbid_2_pattern:       手工强制 HAVE_.*TYPE.*1|直接写入生成的 config.h
forbid_2_reason:        绕过目标编译器会把 host 假设写入 target 配置
forbid_2_consequence:   交叉构建选择错误代码路径，产生 ABI 或运行时风险

# Layer 4: Principles
principles:             P017

# Relations
causes:                 []
caused_by:              []
similar_to:             E151
conflicts_with:         []
prerequisite_of:        []

