#====================================================================
# 用法: 验证后由主编提升为正式 E216 条目
# 对应的人类文档: knowledge/graph/draft/E216-draft-CX17.md
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E284
trigger_tool: configure|CMake|Conan|clang
phase: configuration|compilation
error_signature: unknown type name.*u_int16_t|sparseconfig.h|generated.*config.*host|target.*configuration header

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cross-compilation|generated-config|portability
match_keywords: generated config header, cross compile, host probe, target capability, sparseconfig.h, u_int16_t, uint16_t, Conan
title: 交叉构建时生成目标平台配置头而非复用 host 探测结果

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Autoconf/CMake 生成的 config.h 类头文件记录运行探测环境的类型、命名空间和功能宏；交叉构建若复用 Windows 或其他 host 生成结果，会把主机能力误当成 OHOS 目标能力。
affected_scope: 依赖 configure 生成 config.h、sparseconfig.h 或类似能力头文件的 C/C++ 库，尤其是 header-only 库的 Conan 交叉配方
verification_cmd: 使用 OHOS target compiler 编译上游测试和真实消费者，再在 HarmonyOS PC 上签名并执行目标 ELF

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: generate-target-config-header
rec_description: 根据已验证的目标平台能力显式生成最小配置头，并用目标编译器编译上游测试与真实消费者
rec_command: conan.tools.files.save() 生成目标 config 头；clang++ --target=aarch64-linux-ohos 编译验证
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: target-toolchain-configure
fallback_description: 若构建系统支持可靠交叉探测，使用目标 toolchain 运行 configure 并审计缓存结果
fallback_command: configure --host=aarch64-linux-ohos --build=<host-triplet>
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 直接复制 Windows 或本机 configure 生成的 config.h 到 OHOS 包
forbid_1_reason: 配置头描述的是 host 能力而非 target 能力
forbid_1_consequence: 目标编译失败、ABI/类型判断错误或运行期未定义行为
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P017

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E284.md
last_updated: 2026-07-24
source_event: sparsehash 2.0.4 OHOS Conan migration

# ═══ 知识协作 (Authorship & Provenance) ═══
