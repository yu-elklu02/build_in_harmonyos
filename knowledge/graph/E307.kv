#====================================================================
# E229 — Conan test_package 缺少 CMake 时使用 profile 编译器直编
#====================================================================

# Layer 0: Error Surface
id:                     E307
trigger_tool:           conan|cmake|clang
phase:                  testing
error_signature:        cmake: inaccessible or not found|cmake: not found|CMake.configure.*Error 127|test package.*cmake.*not found

# Layer 1: Recognition
severity:               2
category:               conan|testing|header-only|build-tool
match_keywords:         test_package, cmake not found, header-only, compile-only, tools.build:compiler_executables, Conan profile, Error 127
title:                  Conan test_package 缺少 CMake 时使用 profile 编译器直编

# Layer 2: Diagnosis
root_cause:             Header-only 或协议头包只需要编译消费者对象，但通用 test_package 引入 CMakeToolchain/CMakeDeps 后，会把目标机未安装的 CMake 变成不必要的运行前置；包本身可用，测试却在 CMake 启动前以 127 失败。
affected_scope:         仅适用于无需链接、无需生成配置头、无需消费上游 CMake target 的 C/C++ header-only、协议头或纯头数据包。
verification_cmd:       conan create <recipe-dir> -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build='*'

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           profile-compiler-direct-compile
rec_description:        在 test_package.build() 中从 tools.build:compiler_executables 读取 C/C++ 编译器，对每个独立公共头生成单独源文件并执行 compile-only；配置缺失时明确失败，不依赖 CC/CXX 或裸 cc/clang 回退。
rec_command:            self.conf.get("tools.build:compiler_executables", default={}, check_type=dict)
rec_auto_fix:           false
rec_impl:               conan-test-package

fallback_priority:      2
fallback_approach:      install-declared-cmake-tool
fallback_description:   若消费者必须链接、运行代码生成器或验证上游 CMake target，则保留 CMake，并把可复现的 CMake 工具作为明确构建前置提供。
fallback_command:       conan create <recipe-dir> -pr:h=<profile> -pr:b=<profile>
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       os\.environ.*CC|os\.environ.*CXX|default.*cc|default.*clang
forbid_1_reason:        shell 编译器回退脱离 Conan profile，可能让本地和 CI 使用不同工具链，违反 R33。
forbid_1_consequence:   测试结果不可复现，甚至误用宿主编译器。
forbid_2_pattern:       print.*success|skip.*test_package|pass.*without.*compile
forbid_2_reason:        Header-only 包仍必须实质消费被测头文件，不能用空壳输出绕过 R34。
forbid_2_consequence:   破坏性反向验证无法证明测试依赖被测包。
forbid_3_pattern:       direct.*compile.*link|required.*generated header|cmake target
forbid_3_reason:        需要链接、生成配置头或消费导出 target 的包不满足本模式适用边界。
forbid_3_consequence:   直编会遗漏传递依赖、编译定义或生成步骤。

# Layer 4: Principles
principles:             P010, P014

