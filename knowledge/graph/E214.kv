#====================================================================
# E214 — Shell 脚本交互式 read 阻塞非交互式执行
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E214
trigger_tool:           test|smoke_test|conan_test
phase:                  smoke_test
error_signature:        read -r void|Press ENTER to continue|Security check failed|hangs indefinitely|timeout kills

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               L2|shell|blocking
match_keywords:         interactive, read, blocking, non-interactive, smoke_test, timeout, shell_script, ENTER, security_check
title:                  Shell 脚本交互式 read 阻塞非交互式执行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: Shell 脚本工具（如安全审计工具 lynis）在初始化阶段有交互式安全检查，使用 `read -r var` 等待用户按 ENTER 确认。在非交互环境（conan test_package、CI、L2 smoke test）中，stdin 没有输入，`read` 会永久阻塞，直到被超时机制杀死。常见于安全审计工具（lynis, rkhunter, chkrootkit 等）有交互式安全确认提示。
affected_scope: 任何有交互式提示（read 命令等待用户输入）的 shell 脚本工具。已知影响: lynis 3.1.7, 可能影响 rkhunter, chkrootkit 等。
verification_cmd: timeout 10 ./script.sh --version && echo "PASS" || echo "FAIL"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           non-blocking-read
rec_description:        三种方案（任选其一，推荐组合方案1+2）：1. 非阻塞 read: `read -r var < /dev/null 2>/dev/null || true`；2. 早期参数处理: `for arg in "$@"; do case "$arg" in --version|-V) echo "$VERSION"; exit 0;; esac; done`；3. 终端检测: `[ -t 0 ] && read -r var || true`
rec_command:            sed -i 's/read -r void/read -r void < \/dev\/null 2>\/dev\/null || true/' script.sh
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      early-exit
fallback_description:   在交互检查之前添加 --version 等参数的早期处理，直接退出避免触发交互逻辑
fallback_command:       for arg in "$@"; do case "$arg" in --version|-V) echo "$VERSION"; exit 0;; esac; done
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       timeout.*--version.*\|\|.*echo.*FAIL
forbid_1_reason:        仅用 timeout 绕过不解决根因，脚本仍会阻塞等待 stdin
forbid_1_consequence:   CI 超时资源浪费，其他调用路径仍会阻塞

# ═══ Layer 4: 原则引用 ═══
principles:             P012

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E165
conflicts_with:         []
prerequisite_of:        []

