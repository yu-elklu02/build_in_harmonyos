#====================================================================
# E229 — 缺失 libc API 时独立测试未链接库内 fallback 对象
#====================================================================

# Layer 0: Error Surface
id:                     E229
trigger_tool:           ld|make|automake|libtool
phase:                  linking|testing
error_signature:        undefined reference to [`']?(explicit_bzero|[a-zA-Z0-9_]+)[`']?.*test|symbol not found.*fallback

# Layer 1: Recognition
severity:               2
category:               libc|fallback|testing|linking
match_keywords:         explicit_bzero, undefined reference, fallback object, hidden symbol, standalone test, LDADD, libc missing API
title:                  缺失 libc API 时独立测试未链接库内 fallback 对象

# Layer 2: Diagnosis
root_cause:             目标 libc 缺少某 API 时，上游会把 fallback 实现编入主库并可能设为 hidden；独立测试目标若只链接公共测试对象而不链接主库或准确的 fallback 对象，链接器仍找不到该符号。共享库中的 hidden fallback 也不能作为外部符号满足测试目标。
affected_scope:         自带 libc 兼容 fallback、并用独立 Automake/Libtool 测试可执行文件验证内部并发或嵌套行为的 C/C++ 项目。
verification_cmd:       grep -R -n 'fallback\|explicit_bzero' Makefile.am lib test; readelf -Ws .libs/*.so | grep -E 'HIDDEN|LOCAL'

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           link-exact-fallback-object
rec_description:        确认失败测试真实调用链和 fallback 对象来源，把准确的 libtool object 加入该测试目标 LDADD；若 CI 使用发布 tarball 且不运行 autoreconf，同步对应 Makefile.in。随后执行完整 make check，保持原断言和 SKIP 规则。
rec_command:            test_target_LDADD = lib/libname_la-fallback.lo $(COMMON_TEST_OBJECTS)
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      link-test-against-library
fallback_description:   仅当上游测试语义允许且不会形成递归依赖时，让测试链接已包含 fallback 的主库；需确认 symbol visibility 足以满足该测试。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       skip.*undefined reference|disable.*test|return 0.*OHOS
forbid_1_reason:        链接失败暴露真实适配缺口，删除测试或平台空壳会伪造通过。
forbid_1_consequence:   fallback 路径和嵌套调用行为完全未验证。
forbid_2_pattern:       export.*hidden.*fallback|visibility.*default.*test
forbid_2_reason:        为测试扩大内部 fallback 的导出范围会改变库 ABI；测试应链接准确对象而非污染公共符号表。
forbid_2_consequence:   无意新增公共 ABI，可能造成符号冲突。

# Layer 4: Principles
principles:             P010,P014

# Relations
causes:                 []
caused_by:              []
similar_to:             E213
conflicts_with:         []
prerequisite_of:        []

