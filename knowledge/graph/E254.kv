#====================================================================
# E254 — toybox patch --dry-run 会真实应用 new-file 补丁，污染 orig 目录
#====================================================================

id:                     E254
trigger_tool:           patch|refresh-patch|conan
phase:                  configuration|patch-generation
error_signature:        patch.*dry-run|creating .*\.patch|source/target file does not exist|Failed to apply patch:.*\.patch

severity:               3
category:               tool-compat|patch-pipeline
match_keywords:         toybox, patch, dry-run, new-file, 污染, orig 目录, refresh-patch, patch_ng, 无法应用
title:                  toybox patch --dry-run 真实应用 new-file 补丁，破坏补丁管线

root_cause:             鸿蒙默认 /usr/bin/patch 是 toybox 0.8.12。其 `patch --dry-run`
                        对 new-file 补丁（--- /dev/null → +++ b/...）会真实创建文件
                        （输出 "creating new.txt"），忽略 --dry-run 语义。
                        refresh-patch 的 dry-run 校验因此污染 orig 目录：
                        下一轮扫描把该文件误判为 MOD（diff_files），生成的补丁带
                        a/ b/ 前缀，patch_ng（conan apply_conandata_patches 内部）
                        无法解析/应用，conan create 在 source() 阶段失败。
affected_scope:         所有通过 refresh-patch 生成 new-file 补丁、且系统 patch 为
                        toybox 的 HarmonyOS 软件（含 conan 配方管线）
verification_cmd:       printf '--- /dev/null\n+++ b/t.txt\n@@ -0,0 +1,1 @@\n+x\n' | patch --dry-run -p1; ls t.txt 2>/dev/null && echo "被真实创建"

rec_priority:           1
rec_approach:           avoid-new-file-patches
rec_description:        补丁只保留修改文件（modified-file diff），新增源码文件通过
                        conanfile.py export_sources 传递，彻底避免 toybox new-file
                        dry-run 污染路径。toybox 对修改文件 diff 的 dry-run 不真实应用。
rec_command:            |
  # conanfile.py: 新增源码不写补丁，走 export_sources
  def export_sources(self):
      export_conandata_patches(self)
      copy(self, "*", src=os.path.join(self.recipe_folder, "compat"),
           dst=os.path.join(self.export_sources_folder, "compat"))
  # conandata.yml: 只列修改文件补丁
  #   - patch_file: "patches/0001-Makefile.am.patch"
rec_auto_fix:           false
rec_impl:               manual-recipe

fallback_priority:      2
fallback_approach:      install-gnu-patch
fallback_description:   安装 GNU patch 替代 toybox，使 --dry-run 语义正确
fallback_command:       curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- patch
fallback_auto_fix:      true
fallback_impl:          install-package

forbid_1_pattern:       (patch_file:.*compat/|patch_file:.*tests/)
forbid_1_reason:        新增文件补丁（new-file）会触发 toybox dry-run 真实应用，污染 orig
forbid_1_consequence:   下一轮 refresh-patch 误判 MOD，生成 patch_ng 无法应用的 a/ 格式补丁，W3 conan create 阻塞

principles:             P012

causes:                 []
caused_by:              [E010]
similar_to:             [E010, E106]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E254.md
last_updated:           2026-08-05
source_event:           abiword-plugin-clarisworks 3.0.8 W3 finish 失败（2026-08-05）

authors:                mkz--mkz <ak74A3WKxU__vozN.mkz--mkz@noreply.gitcode.com>
