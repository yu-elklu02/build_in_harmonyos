#====================================================================
# E221.kv — Conan test_package 缺少显式运行环境
#====================================================================

id:                     E298
trigger_tool:           cmake|ctest|test
phase:                  testing
error_signature:        Error loading shared library|
                         cannot open shared object file|
                         shared library not found|
                         command not found

severity:               3
category:               conan-test-execution
match_keywords:         cmake.test, CTest, VirtualRunEnv, conanrun,
                         test_package, shared library, runtime path,
                         LD_LIBRARY_PATH, PATH
title:                   Conan test_package 的显式运行与环境

root_cause:             cmake.test() 把执行委托给 CTest，配方无法显式控制和审计 conanrun 环境；
                         消费者需要包内动态库或 CLI 时可能因运行时搜索路径缺失而失败。
affected_scope:         使用 Conan 2 test_package 测试共享库、包内 CLI 或其他运行时资源的 C/C++ 配方。
verification_cmd:       conan create . -o '*:shared=True'

rec_priority:           1
rec_approach:           virtual-run-env-explicit-run
rec_description:        生成 VirtualRunEnv，并在 test() 中使用 self.run(..., env='conanrun') 显式执行消费者。
rec_command:            generators = 'CMakeDeps', 'CMakeToolchain', 'VirtualRunEnv'; self.run(f'"{test_bin}"', env='conanrun', cwd=self.build_folder)
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      ctest-via-conanrun
fallback_description:  必须保留 CTest 时，通过 self.run 在 conanrun 环境中执行 CTest 并打开失败输出。
fallback_command:       self.run(f'ctest --test-dir "{self.build_folder}" --output-on-failure', env='conanrun', cwd=self.build_folder)
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       LD_LIBRARY_PATH=.*\.conan2|PATH=.*\.conan2/p/
forbid_1_reason:        禁止硬编码开发机 Conan 缓存路径来修补测试运行环境，应由 VirtualRunEnv 生成环境。
forbid_1_consequence:   缓存哈希和目录会随机器、配方 revision 与包 ID 变化，测试无法复现。

principles:             

causes:                 []
caused_by:              []
similar_to:             [E019,E088,E212]
conflicts_with:         []
prerequisite_of:        []

