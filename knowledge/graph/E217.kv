# ═══ Knowledge entry — CMake 上游头文件装到 include/<subdir> 导致 test_package 找不到头文件 ═══
# Software: airspyhf 1.6.8
# Gate: conan-verify G2 (test_package)

id:                     E217
severity:               2
category:               cmake|conan-recipe|header-path
trigger_tool:           conan|cmake
phase:                  testing
error_signature:        fatal error: '.+\.h' file not found|test_package.*\.c:\d+:\d+: fatal error
match_keywords:         fatal error, file not found, includedirs, test_package, header, CMakeLists install, DESTINATION include

root_cause:             上游 CMake 用 install(FILES ${c_headers} DESTINATION include/${PROJECT_NAME}) 把头文件
                        装进 include/<subdir>，但 conan-init 生成的模板配方 package_info() 默认 includedirs=["include"]，
                        test_package 的 #include <xxx.h> 找不到头文件，G2 在 test_package 阶段失败。
                        知识图谱仅匹配到 E001（找不到编译器），根因完全不同，属误匹配。
affected_scope:         所有 CMake 工程头文件安装到 include/<subdir>（如 include/libairspyhf、include/libusb-1.0）
                        且 test_package 以顶层 <subdir>/../ 形式 include 的场景
verification_cmd:       grep -rn "DESTINATION include" <src>/CMakeLists.txt && 检查 package_info includedirs 是否匹配

rec_priority:           1
rec_approach:           check-cmake-header-install-subdir
rec_description:        先读上游 CMakeLists 确认 install(FILES ... DESTINATION) 目标目录，再把
                        package_info() 的 cpp_info.includedirs 指向实际子目录（如 ["include/libairspyhf"]），
                        与上游工具源码的 #include <airspyhf.h> 保持一致
rec_command:            grep -rn "DESTINATION include" <src>/CMakeLists.txt && 修改 conanfile.py package_info() includedirs
rec_auto_fix:           false
rec_impl:               recipe-package-info

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

