#====================================================================
# E235 - CLI 版本测试不得臆测品牌前缀
#====================================================================

# Layer 0: Error Surface
id:                     E310
trigger_tool:           conan_test|python|runtime
phase:                  testing|runtime
error_signature:        version output missing product prefix|version output missing brand prefix|version output lacks product prefix|version output lacks brand prefix|expected product prefix|expected brand prefix

# Layer 1: Recognition
severity:               2
category:               testing|cli|contract
match_keywords:         --version, version output, product prefix, brand prefix, exact version, output contract, false failure
title:                  CLI 版本测试不得臆测品牌前缀

# Layer 2: Diagnosis
root_cause:             消费者测试没有先核对生产者对 --version 的实际输出契约，而是同时要求版本号和产品名、品牌前缀或描述文本；当工具合法地只输出纯版本号时，测试会把可用制品误判为失败。
affected_scope:         所有在 Conan test_package、CI smoke 或安装后验证中解析命令行工具 --version 输出的配方和脚本。
verification_cmd:       VERSION_OUTPUT=actual-version EXPECTED_VERSION=expected-version; test "$(printf '%s' "$VERSION_OUTPUT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" = "$EXPECTED_VERSION"

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           assert-documented-version-contract
rec_description:        先从目标版本的上游文档、测试或实现确认输出契约；只去除契约允许的首尾空白，再将解析结果与包管理器已解析的期望版本比较。若上游输出包含固定前缀，应按该已证实格式解析；若只输出版本号，则精确比较纯版本号。
rec_command:            <tool> --version > version.txt 2>&1; test "$(tr -d '\r' < version.txt | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')" = "<expected-version>"
rec_auto_fix:           false
rec_impl:               consumer-test-contract-fix

fallback_priority:      2
fallback_approach:      parse-upstream-supported-version-token
fallback_description:   仅当上游明确允许多种稳定输出格式时，使用上游支持的版本解析规则提取唯一版本字段，并对额外文本保持中立；解析不到或出现多个候选时必须失败。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       if\s+['"]?[A-Za-z0-9_-]+['"]?\s+not\s+in\s+version\.lower\(\)
forbid_1_reason:        未经上游契约证明就强制要求产品名或品牌文本，会拒绝合法纯版本输出。
forbid_1_consequence:   构建和制品真实可用，但 test_package 产生稳定的假失败。
forbid_2_pattern:       (grep|find|contains).*(brand|product|tool name).*(--version|version output)
forbid_2_reason:        模糊文本包含检查不能替代对生产者输出契约和期望版本的验证。
forbid_2_consequence:   同时可能造成假失败和错误版本被误放行。

# Layer 4: Principles
principles:             

# Relations
causes:                 []
caused_by:              []
similar_to:             E035, E054, E214
conflicts_with:         []
prerequisite_of:        []

