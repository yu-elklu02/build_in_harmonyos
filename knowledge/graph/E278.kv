#====================================================================
# E215 — CMake 条件排除内部目标后将目标名静默降级为 -l 库名
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E278
trigger_tool:           cmake|clang|ld
phase:                  configuration|linking
error_signature:        CMAKE_INTERNAL_TARGET_MISSING:|CMAKE_BARE_LINK_ITEM:-l

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               cmake|target-graph|linking
match_keywords:         target_link_libraries, add_subdirectory, conditional target, if(TARGET), plain library name, unable to find library, -l
title:                  CMake 条件排除内部目标后将目标名静默降级为 -l 库名

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             消费者仍在 target_link_libraries 中引用内部目标，但定义该目标的 add_subdirectory 被测试或可选功能条件排除；CMake 将未定义的裸名称视为外部库名并生成 -l<name>，使配置阶段无报错而在最终链接时失败
affected_scope:         所有通过条件 add_subdirectory 或 option 控制内部库目标、但消费者链接关系未使用相同条件的 CMake 工程
verification_cmd:       INTERNAL_TARGET=target_name BUILD_DIR=build; cmake --build "$BUILD_DIR" --target help | grep -F "$INTERNAL_TARGET" && ! grep -R -F -- "-l${INTERNAL_TARGET}" "$BUILD_DIR"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           restore-cmake-target-definition
rec_description:        沿 target_link_libraries 反查目标定义和 option 值；运行时必需组件应移出仅测试条件，或者用同一条件同时守卫目标定义与消费者链接，再重新生成目标图确认目标存在且链接行不含裸 -l<target>
rec_command:            INTERNAL_TARGET=target_name BUILD_DIR=build; cmake --build "$BUILD_DIR" --target help | grep -F "$INTERNAL_TARGET" && ! grep -R -F -- "-l${INTERNAL_TARGET}" "$BUILD_DIR"
rec_auto_fix:           false
rec_impl:               manual-source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      declare-real-external-dependency
fallback_description:   只有确认该名称不是项目内部目标且制品确实由外部包提供后，才声明 Conan 依赖并使用其 CMake target
fallback_command:       cmake --build build --verbose --target consumer
fallback_auto_fix:      false
fallback_impl: conan-requirement

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       requirements\(\)|-L.*lib.*|find_library
forbid_1_reason:        看到 -l<name> 后未检查 CMake 目标图就直接增加包依赖、搜索路径或伪造同名库
forbid_1_consequence:   掩盖条件目标图错误，引入不存在或错误的外部依赖，并可能到链接后期才再次失败
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P005, P011, P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E050, E191, E208]
conflicts_with:         []
prerequisite_of:        []

