#====================================================================
# E222.kv — Conan 源码获取失败的分层诊断
#====================================================================

id:                     E299
trigger_tool:           conan|curl|wget
phase:                  download
error_signature:        Could not download from the URL|
                         sha256 hash failed for|
                         curl: (28)|
                         403 Forbidden|
                         404 Not Found|
                         Could not resolve host|
                         SSL certificate problem|
                         TLS handshake failed|
                         Connection refused|
                         Connection reset

severity:               3
category:               conan-source-acquisition
match_keywords:         Conan source, get(), download, timeout, mirror,
                         sha256, computed hash, provided hash, 404,
                         DNS, conandata.yml, official URL, R39
title:                   Conan 源码获取失败的分层诊断

root_cause:             网络超时、URL 错误和 SHA256 不匹配都发生在 source() 阶段，
                         但根因和修复动作不同；仅按“下载失败”摘要会产生误诊。
affected_scope:         所有通过 Conan tools.files.get() 和 conandata.yml 下载上游源码的配方。
verification_cmd:       conan source <recipe> -v

rec_priority:           1
rec_approach:           classify-source-failure
rec_description:        先按传输、HTTP 状态和完整性校验分层，再分别修复网络、URL 或可信 SHA256，始终保留官方源或权威镜像。
rec_command:            conan source <recipe> -v; sha256sum <official-release-archive>
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      verified-network-fallback
fallback_description:  仅在日志明确出现超时、DNS、TLS 或连接错误时，按 E017 重试或使用 CI 自动镜像回退。
fallback_command:       curl -fL --retry 3 <official-url> -o <archive>
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       raw\.gitcode\.com/.*/blob/|raw\.githubusercontent\.com/.*/(main|master)/
forbid_1_reason:        禁止用个人仓库 blob 或滚动分支绕过网络、URL 或哈希问题；应使用官方 release 或权威镜像。
forbid_1_consequence:   来源不可审计且内容可能漂移，CI 重现性、SHA256 可信度和 R39 合规性同时失效。

principles:             

causes:                 []
caused_by:              []
similar_to:             [E017]
conflicts_with:         []
prerequisite_of:        [E017]

doc_file:               doc/E299.md
last_updated:           2026-07-16
source_event:           PR #2063，CI #2228 的 nettle SHA256 误诊与 CI #3530 的 mcpp 官方源验证

authors:                 2301_80739235 <2047361658@qq.com>
source_pr:               2063
source_commit:

metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
