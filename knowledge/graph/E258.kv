#====================================================================
# E258 — meson.options 与 meson_options.txt 双文件（符号链接物化）导致 meson 拒绝配置
#====================================================================

id:                     E258
trigger_tool:           meson
phase:                  configuration
error_signature:        meson\.options and meson_options\.txt both exist, but are not the same file

severity:               2
category:               meson|file-layout|symlink
match_keywords:         meson.options, meson_options.txt, both exist, same file, symlink
title:                  meson.options 与 meson_options.txt 双文件（符号链接物化）导致 meson 拒绝配置

root_cause:             上游源码同时携带 meson.options 与 meson_options.txt（后者是前者的符号链接）。在 HMDFS 等文件系统上复制源码时符号链接被物化为独立普通文件，meson >= 1.5 检测到两份内容相同但非同一 inode 的文件时报错
affected_scope:         pcsc-lite 2.4.0 及其他同时打包 meson.options 与 meson_options.txt 的上游项目
verification_cmd:       ls -la meson.options meson_options.txt && meson setup build

rec_priority:           1
rec_approach:           delete-duplicate-meson-options
rec_description:        删除 meson_options.txt（或恢复其为 meson.options 的符号链接），使两者为同一文件。meson 0.63+ 支持 meson.options 命名。conan get() 的 tarfile 提取保留符号链接不受影响。
rec_command:            rm -f meson_options.txt
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E258.md
last_updated:           2026-08-07
source_event:           pcsc-lite 2.4.0 meson >= 1.5 配置失败

authors:                yanjiaxin <yanjiaxin@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
