#====================================================================
# E230 — Conan test_package 模板后缀不被 CI L0c 识别
#====================================================================

# Layer 0: Error Surface
id:                     E308
trigger_tool:           build_and_test.sh|find|conan
phase:                  testing
error_signature:        \[fail\] L0c: No test source files in test_package/|no_test_sources|TEST_SOURCES.*empty

# Layer 1: Recognition
severity:               3
category:               ci|conan|test-structure
match_keywords:         L0c, test_package, test source, suffix, .c.in, .cpp.in, template, no_test_sources, maxdepth
title:                  Conan test_package 模板后缀不被 CI L0c 识别

# Layer 2: Diagnosis
root_cause:             CI L0c 在 conan create 前只用 find 搜索 test_package 两层内以 .c/.cpp/.cc/.cxx/.sh/.py 结尾且不是 conanfile.py 的文件；真实模板若命名为 .c.in、.cpp.in 或 .tmpl，即使随后会生成并编译消费者，也会被判定为没有测试源。
affected_scope:         所有从模板生成测试消费者、但 test_package 内没有其他受 L0c 接受后缀文件的 Conan 配方；同样影响测试源放在 maxdepth 2 之外的结构。
verification_cmd:       find test_package -maxdepth 2 \( -name '*.c' -o -name '*.cpp' -o -name '*.cc' -o -name '*.cxx' -o -name '*.sh' -o -name '*.py' \) -not -name conanfile.py

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           accepted-test-source-suffix
rec_description:        让至少一个被 test_package 实际 exports/读取/编译或执行的实质测试源保留 L0c 接受的最终后缀，并同步更新 exports_sources、MANIFEST 与测试文档；随后用相同 find 规则和 fresh conan create 双重验证。
rec_command:            mv test_package/header_smoke.c.in test_package/header_smoke.c
rec_auto_fix:           false
rec_impl:               conan-test-structure

fallback_priority:      2
fallback_approach:      substantive-wrapper-source
fallback_description:   若模板扩展名不能改变，增加一个真实调用模板生成结果或被测包 API 的受支持后缀包装源；该包装源必须参与实际测试，不能只是门禁标记。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       touch.*test\.(c|cpp)|empty.*test source|dummy.*source
forbid_1_reason:        空文件或未参与测试的标记文件只欺骗 L0c，违反 R34。
forbid_1_consequence:   CI 结构门禁通过但 test_package 没有实质消费被测包。
forbid_2_pattern:       rename.*\.c\.in.*\.c$
forbid_2_reason:        只改文件名而不更新 exports_sources、模板读取路径和 MANIFEST，会在 conan create 时失败或产生陈旧统计。
forbid_2_consequence:   本地静态门禁与实际 Conan 执行结论不一致。
forbid_3_pattern:       test_package/.*/.*/.*\.(c|cpp|cc|cxx|sh|py)$
forbid_3_reason:        L0c 使用 maxdepth 2，放得更深的测试源仍不可见。
forbid_3_consequence:   TEST_SOURCES 为空并在构建前硬失败。

# Layer 4: Principles
principles:             

