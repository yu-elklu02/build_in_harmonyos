#====================================================================
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E300
trigger_tool: cmake
phase: configuration
error_signature: Could NOT find .* \(missing: .*_INCLUDE_DIR.*_LIBRARY.*\)|.*_INCLUDE_DIR-NOTFOUND|.*_LIBRARY-NOTFOUND

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: conan-cmake-dependency-bridge
match_keywords: FindFFTW.cmake, custom Find module, CMakeDeps, self.dependencies, FFTWF_INCLUDE_DIR, FFTWF_LIBRARY
title: Bridge Conan dependency paths into upstream custom CMake find modules

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: An upstream Find module may ignore Conan-generated CMake targets and search only legacy include and library cache variables, so a published dependency remains undiscoverable during cross configuration.
affected_scope: CMake projects that ship custom Find modules instead of consuming dependency config targets, especially cross builds without system search paths.
verification_cmd: Inspect the upstream Find module inputs, verify the exact header and library under self.dependencies, and confirm CMakeCache.txt binds both variables to that Conan package revision.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: cmake-cache-path-bridge
rec_description: Resolve and validate the dependency header and library from self.dependencies, then pass the exact cache variables expected by the upstream Find module through CMakeToolchain.
rec_command: Set <DEP>_INCLUDE_DIR and <DEP>_LIBRARY from the verified Conan package paths before tc.generate().
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: hard-coded system include or library path
forbid_1_reason: System paths bypass the locked Conan package and can select host or stale target artifacts.
forbid_1_consequence: Non-reproducible configure results or host contamination in the target build.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E300.md
last_updated: 2026-07-30
source_event: gromacs/2026.3 OHOS configure with fftw3f/3.3.9

