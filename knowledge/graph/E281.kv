#====================================================================
# E215 — 资源型语音/音频 Conan 叶子包适配（无编译步骤，消费者资源验证）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E281
trigger_tool:           conan-create|conan-verify|finish|test_package
phase:                  packaging
error_signature:        festvox|voice.*data|resource.*package|EST_File.*index|kedlpc8k|stub_test_method|strip_root
severity:               2
category:               resource-package-adaptation
match_keywords:         resource package, voice data, diphone, festival, no build step, file-based validation, EST index

# ═══ Layer 1: 识别层 (Recognition) ═══
title:                  资源型语音/音频 Conan 叶子包适配：无编译步骤，用 test_package 做消费者资源完整性验证

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 平台上存在一类纯语音/音频资源型 Conan 叶子包（如 Festival diphone voice data），tarball 只有数据文件（.scm/.group/COPYING），无 C/C++ 代码、无编译系统、无上游测试。Conan 适配时若按常规编译流程处理会失败：conan-init 生成错误的构建模板、L0 门禁要求 test() 必须调用 self.run()、strip_root 参数与 package() 路径不一致会导致资源找不到
affected_scope:         所有无 C/C++ 编译步骤的语音包、音频包、字体包、图标包、固件和数据包
verification_cmd:       conan create archives/f/festvox-kdlpc8k/1.4.0 --name festvox-kdlpc8k --version 1.4.0 -tf test_package/ && echo "PASS" || echo "FAIL"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           resource-package-file-copy
rec_description:        conanfile.py 中 build() 为空，package() 直接复制文件到目标安装路径（share/<vendor>/...）；source() 用 strip_root=True 并把 package() 路径同步调整为去掉顶层目录后的相对路径
rec_command:            get(self, **self.conan_data["sources"], strip_root=True) && copy(self, "*", src_dir, dst_dir)
rec_auto_fix:           true
rec_impl:               resource-copy-package

# 回退方案
fallback_priority:      2
fallback_approach:      python-inline-assertions
fallback_description:   若 OHOS sandbox 无法 fork 子进程（OOM），test_package 使用 Python os.path/hashlib 内联断言替代 shell 脚本；但远端 L0d 门禁要求 test() 必须包含 self.run() 调用真实脚本，两者需结合
fallback_command:       self.run("sh " + shlex.quote(script) + " " + shlex.quote(voice_dir))
fallback_auto_fix:      false
fallback_impl:          test-package-self-run

# ★ 禁止策略 ★
forbid_1_pattern:       strip_root=False.*source_folder/festival|status: published.*conan upload|test_package.*没有.*self\.run
forbid_1_reason:        strip_root 与 package() 路径不匹配会导致资源找不到；未经 Conan upload 不得写 published；test() 无 self.run() 会被 L0d 判定为 stub_test_method
forbid_1_consequence:   远端 CI 构建失败（L0 gate: stub_test_method），PR 无法通过评审
forbid_2_pattern:       把新增 test_package 断言写成上游测试通过率|把 Festival 加入 requirements\(\)
forbid_2_reason:        上游测试与新增消费者测试必须分开统计；Festival 运行时是可选验证工具不是 Conan 依赖
forbid_2_consequence:   测试统计失真、依赖混入，违反 PR 质量门禁

