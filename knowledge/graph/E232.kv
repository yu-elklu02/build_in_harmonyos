#====================================================================
# E232 - Prefix Conan Autotools configure with the native OHOS shell
#====================================================================

# Layer 0: Error Surface
id:                     E232
trigger_tool:           conan|autotools|configure
phase:                  configure
error_signature:        /system/bin/sh: .*configure: Permission denied|Error in build\(\) method.*autotools\.configure|ConanException: Error 126 while executing

# Layer 1: Recognition
severity:               2
category:               build-system|conan|autotools|ohos
match_keywords:         Conan, Autotools.configure, configure, Permission denied, error 126, CONFIG_SHELL, settings_build.os, _configure_args
title:                  Prefix Conan Autotools configure with the native OHOS shell

# Layer 2: Diagnosis
root_cause:             Conan Autotools.configure emits the source configure path as the first process. CONFIG_SHELL only affects shells started later by Autoconf, so it cannot wrap that initial launch when the native OHOS build executor cannot execute the source script directly.
affected_scope:         Conan Autotools recipes running natively on OHOS when the source configure file cannot be launched directly. Cross-build executors are not affected merely because settings.os is OHOS.
verification_cmd:       inspect the failing RUN command, confirm settings_build.os is OHOS, and compare direct configure execution with /system/bin/sh configure using the exact Conan-generated arguments

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           native-ohos-shell-prefix
rec_description:        Only when settings_build.os is OHOS, invoke /system/bin/sh with the official configure path and the exact arguments generated by Conan. Keep all other build executors on Autotools.configure(), even when settings.os is OHOS.
rec_command:            if settings_build.os is OHOS, run /system/bin/sh with the source configure path and autotools._configure_args; otherwise call autotools.configure()
rec_auto_fix:           false
rec_impl:               conan-recipe-platform-branch

fallback_priority:      2
fallback_approach:      executable-backed-build-root
fallback_description:   If the native source filesystem cannot be used through a verified system shell, move the build source to a tested executable-backed location without changing the configure contract.
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       settings\.os.*OHOS.*system/bin/sh
forbid_1_reason:        settings.os describes the target and would route Windows or Linux cross-build executors to a target-only shell path.
forbid_1_consequence:   Cross builds fail before configuration even though the target is OHOS.
forbid_2_pattern:       configure.*--prefix.*without.*_configure_args
forbid_2_reason:        Reconstructing only a subset of the command discards Conan toolchain and dependency arguments.
forbid_2_consequence:   Configuration can silently use the wrong compiler, flags, paths, or dependency metadata.

# Layer 4: Principles
principles:             P005

# Relations
causes:                 []
caused_by:              []
similar_to:             [E087, E165]
conflicts_with:         []
prerequisite_of:        []

