#====================================================================
# E215 - LuaRocks 3.13.0 / Lua 5.5 Path B test-dependency handling
#====================================================================

id:                     E215
trigger_tool:           conan|busted|luarocks|test_package
phase:                  testing|runtime
error_signature:        luacov 0.15.0-1|lua >= 5.1, < 5.5|os.tmpname()|unable to generate a unique filename|luarocks command not found

severity:               2
category:               L2|lua|luarocks|testing|relocatable
match_keywords:         LuaRocks, Lua 5.5, luacov, Busted, test dependency, Path B, os.tmpname, TMPDIR, relocatable launcher, test_package
title:                  LuaRocks 3.13.0 targeting Lua 5.5 needs Path B test-dependency handling

root_cause:             LuaRocks 3.13.0 supports --lua-version=5.5, but its upstream Busted test harness depends on luacov 0.15.0-1, whose rockspec declares lua >= 5.1, < 5.5. This makes the upstream test dependency incompatible with a lua/5.5.0 target, so Path A cannot be claimed even when the packaged commands build and run.
affected_scope:         LuaRocks packages targeting Lua 5.5, especially Conan recipes that must distinguish upstream Busted test accounting from consumer test_package validation.
verification_cmd:       conan create archives/l/luarocks5.5/3.13.0 --build=missing

rec_priority:           1
rec_approach:           path-b-with-consumer-validation
rec_description:        Use Path B, record upstream inventory and luacov dependency-range failure, keep test_package separate from upstream tests, execute packaged luarocks commands by absolute path, and cover positive smoke plus deterministic fault injection.
rec_command:            python test_package/test_luarocks55.py <package>/bin/luarocks <package>/bin/luarocks-admin
rec_auto_fix:           false
rec_impl:               recipe-and-test-package

fallback_priority:      2
fallback_approach:      launcher-and-tempdir-hardening
fallback_description:   Make luarocks launchers relocatable from arg[0] and patch packaged util.lua to prefer TMPDIR/TMP/TEMP before os.tmpname() on OHOS workers.
fallback_command:       set TMPDIR to a writable path and rerun luarocks --version, config lua_version, help install, invalid command, and invalid rockspec lint checks
fallback_auto_fix:      false
fallback_impl:          manual-patch

forbid_1_pattern:       count test_package as upstream Busted tests
forbid_1_reason:        Consumer checks prove packaged artifact behavior but do not satisfy upstream Path A accounting.
forbid_1_consequence:   PR evidence becomes misleading and can be rejected for false upstream-test pass rate.

doc_file:               doc/E215.md
last_updated:           2026-08-05
source_event:           PR #3886 luarocks5.5/3.13.0 Path B review

authors:                m0_46382645
source_pr:              https://gitcode.com/OpenHarmonyPCDeveloper/build_in_harmonyos/pull/3886
source_commit:

metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.8
metrics_last_used:      2026-08-05
