#====================================================================
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E273
trigger_tool: configure|make
phase: configuration|compilation
error_signature: PETSC_DIR does not point to PETSc installation path|No such file or directory.*petscvariables|hardcoded.*python3

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: dependency|relocation|conan
match_keywords: PETSC_DIR,petscvariables,absolute prefix,Conan cache,relocation,python3
title: Installed PETSc metadata retains non-relocatable build paths

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: PETSc installation metadata embeds build-time absolute prefixes and interpreter paths; downloaded Conan binaries live at a different package path.
affected_scope: SLEPc and other PETSc consumers that invoke PETSc make/configuration metadata from a Conan binary package.
verification_cmd: grep -R "PREFIXDIR\|PETSC_DIR\|python3" "$PETSC_DIR/lib/petsc/conf"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: relocate-private-dependency-copy
rec_description: Copy the PETSc package into the consumer build folder and rewrite only text metadata from the recorded prefix to the private copy; never modify the Conan cache.
rec_command: copy PETSc package to build_folder/petsc and replace recorded PREFIXDIR plus unavailable interpreter paths in text metadata
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E273.md
last_updated: 2026-07-21
source_event: slepc/3.25.1 build

