#====================================================================
# E230 - 源码分发型传输库不能只验证编译宏矩阵
#====================================================================

# Layer 0: Error Surface
id:                     E230
trigger_tool:           conan_test|ctest|cc|clang|runtime
phase:                  testing|runtime
error_signature:        compile matrix passed but runtime transport failed|runtime smoke failed at|loopback transport workflow failed

# Layer 1: Recognition
severity:               2
category:               testing|network|source-distribution|coverage
match_keywords:         compile matrix, macro namespace, source-included transport, loopback, listener, connect, accept, bidirectional transfer, runtime smoke
title:                  源码分发型传输库不能只验证编译宏矩阵

# Layer 2: Diagnosis
root_cause:             源码分发型传输实现会按命名空间、角色和传输宏编入不同消费者。逐组合编译只能证明声明与条件编译闭合，函数取址或 sizeof 检查不会执行 bind、listen、connect、accept、read、write 和 close，因此目标系统的套接字策略、地址解析和运行时语义仍可能全部失效。
affected_scope:         不生成独立共享库、由消费者直接包含实现源码，或通过大量平台/角色/协议宏选择网络传输路径的 C/C++ 包。
verification_cmd:       conan create <recipe> -pr:h=<target-profile> -pr:b=<target-profile> --build=missing

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           compile-matrix-plus-loopback-runtime
rec_description:        保留输入唯一的编译/链接宏矩阵，并按声明与实现相同的条件守卫引用全部目标平台公开入口，但只做函数取址或类型检查的组合必须标为不计数构建预检；再为每种实际支持的传输增加目标机本地回环事务：创建监听端、连接客户端、接收连接、以有界等待检查可读状态、执行标量与向量双向传输、检查地址和本地性，并验证断开与清理所有权合同。平台不支持的传输只能在到达目标操作、精确匹配 errno，并证明描述符和端点终态正确后记录能力限制；若失败操作已经关闭描述符，只释放剩余连接结构，不得再次关闭。其他失败必须保持失败；不得连接外部主机。
rec_command:            conan create <recipe> -pr:h=<target-profile> -pr:b=<target-profile> --build=missing
rec_auto_fix:           false
rec_impl:               consumer-runtime-test-suite

fallback_priority:      2
fallback_approach:      defer-runtime-proof-to-target-ci
fallback_description:   没有目标机时可先执行唯一编译矩阵，但必须明确标为预检，并在目标 CI 或设备补齐回环运行时事务后才能声明适配完成。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       sizeof\s*\(&.*(Connect|Accept|Read|Write)|return\s+0.*(transport|socket).*test
forbid_1_reason:        函数取址和固定成功返回不会执行传输行为，不能证明目标运行时可用。
forbid_1_consequence:   编译矩阵全部通过，但消费者在监听、连接或数据传输阶段失败。
forbid_2_pattern:       (curl|wget|connect).*(public|external|internet)|skip.*(bind|connect|accept).*(OHOS|HarmonyOS)
forbid_2_reason:        传输测试应限定本机回环或本地端点；广泛跳过会掩盖真实平台能力，外部端点又引入无关网络依赖。
forbid_2_consequence:   测试不可复现、产生外部副作用，或把未验证行为误报为通过。

# Layer 4: Principles
principles:             P013

