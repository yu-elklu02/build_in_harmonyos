#====================================================================
# E216 — 多源码 Conan 配方必须为每个补丁声明独立 base_path
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E282
trigger_tool:           conan|python|patch
phase:                  configuration|compilation
error_signature:        Failed to apply patch:|Failed to parse patch:|target file not found|can't find file to patch

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               conan|multi-source|patch-routing
match_keywords:         conandata.yml, apply_conandata_patches, base_path, multiple sources, nested source, patch root, destination
title:                  多源码 Conan 配方必须为每个补丁声明独立 base_path

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             recipe 把主源码和配套源码下载到 source_folder 的不同子目录，却用单一硬编码补丁根目录处理全部 conandata 条目，导致某些补丁在错误源码树中查找目标文件；Conan 2 的 apply_conandata_patches 会把每条元数据作为 patch() 参数，原生支持逐条 base_path
affected_scope:         同一 Conan recipe 下载两个及以上源码包的工程，包括主源码加配套工具链、vendored 依赖或外部项目源码
verification_cmd:       SOURCE_ROOT=/actual/source RECIPE_DIR=/actual/recipe python3 -c "import os,subprocess,yaml; from pathlib import Path; source=Path(os.environ['SOURCE_ROOT']); recipe=Path(os.environ['RECIPE_DIR']); entries=yaml.safe_load((recipe/'conandata.yml').read_text())['patches']; [subprocess.run(['patch','--dry-run','--fuzz=0','-p1','-d',str(source/p.get('base_path','.'))],stdin=(recipe/p['patch_file']).open('rb'),check=True) for p in entries]"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           conandata-per-patch-base-path
rec_description:        在 conandata.yml 每个 patch 条目声明相对 self.source_folder 的 base_path，并统一调用 apply_conandata_patches(self)；export_conandata_patches 仍负责导出 patch_file
rec_command:            python3 -c "import yaml; d=yaml.safe_load(open('conandata.yml')); assert all(p.get('base_path') for p in d['patches'])"
rec_auto_fix:           false
rec_impl:               recipe-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      explicit-patch-routing
fallback_description:   旧 Conan 不支持逐条 base_path 时，复制条目并移除自定义路由字段后显式调用 patch()，同时对白名单根目录做校验
fallback_command:       patch(self, base_path=validated_root, **patch_entry)
fallback_auto_fix:      false
fallback_impl: manual-patch-loop

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       patch\(.*base_path=.*\*\*patch_data|apply_conandata_patches\(self\).*(sed|copy)
forbid_1_reason:        对异构源码补丁集硬编码一个根目录，或在标准 helper 后用临时 sed/copy 补应用
forbid_1_consequence:   补丁目标文件找不到、补丁落入错误源码树，或源码修改不可复现
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P005, P011

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E282.md
last_updated: 2026-07-18
source_event:           Cling 1.3 同时下载 Cling v1.3 与配套 LLVM 20 源码并分别打补丁

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          条目生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                2301_80739235 <2047361658@qq.com>
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-07-18
