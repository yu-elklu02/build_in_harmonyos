#====================================================================
# E220.kv - OHOS native interpreter/toolchain composite adaptation
#====================================================================

id:                     E220
trigger_tool:           Configure|make|install|conan
phase:                  configuration|build|installation|runtime
error_signature:        ln.*Operation not permitted|
                         touch:.*Permission denied|
                         not writable by you|
                         Can't create.*lib/auto|
                         SIGSYS caught|
                         Can't set \$0 with prctl
severity:               3
category:               filesystem|permissions|toolchain|runtime-feature-detection
match_keywords:         perl, Configure, metaconfig, hardlink, symlink, LNS,
                         touch, miniperl, ExtUtils::Install, installperl,
                         POSIX::access, -w, write probe, create unlink,
                         IPC/SysV, prctl, PR_SET_NAME, tool_requires
root_cause:             OHOS true-device storage and runtime can diverge from
                         POSIX/Linux assumptions in several independent ways:
                         hardlink/symlink creation may be denied, metadata-only
                         touch on generated executables may fail, -w or
                         POSIX::access(W_OK) may not match actual create/unlink
                         ability, and Configure may detect headers/symbols for
                         runtime features that later fail with SIGSYS/EINVAL.
affected_scope:         Native interpreter or toolchain packages whose upstream
                         build systems use link-as-copy shortcuts, timestamp
                         refresh rules, Perl/ExtUtils-style install checks, or
                         configure-time feature probes that are not enough to
                         prove true-device runtime availability.
verification_cmd:       CI_PACKAGES="archives/p/perl/5.42.2" zsh ci/conan/build_and_test.sh;
                         make test_harness_notty;
                         perl -MConfig -MFile::Spec -e "print qq(ok\n)"

rec_priority:           1
rec_approach:           composite-ohos-toolchain-adaptation
rec_description:        Treat repeated build failures as a connected platform
                         pattern instead of isolated patches: replace upstream
                         link shortcuts with a copy-link wrapper that preserves
                         relative-source semantics; remove timestamp-only touch
                         steps on generated executables; replace unreliable
                         permission predicates with actual create/unlink probes;
                         and disable runtime features when true-device execution
                         proves configure probes are false positives.
rec_command:            Set TMPDIR/TMPPREFIX to a build-local writable path;
                         pass Configure through an explicit shell; set lns/LNS
                         to an OHOS copy-link wrapper; patch writeability checks
                         to probe create/unlink; disable misdetected runtime
                         features such as IPC/SysV or HAS_PRCTL_SET_NAME when
                         true-device tests prove SIGSYS/EINVAL failures.
rec_auto_fix:           false
rec_impl:               conan-recipe-and-minimal-source-patches

fallback_priority:      2
fallback_approach:      split-runtime-compatibility-followup
fallback_description:   If upstream runtime tests still fail after the build
                         tool package is usable, classify remaining failures by
                         filesystem, permissions, signal/timer, locale/timezone,
                         direct script execution, or dynamic loader behavior and
                         avoid mixing broad runtime compatibility work into a
                         dependency-tool PR.
fallback_command:       Record upstream file-level pass rate and per-file root
                         cause closure in the package notes or failure analysis.
fallback_auto_fix:      false
fallback_impl:          documentation-and-followup

forbid_1_pattern:       Treat a successful Configure header/symbol probe as
                         proof that the same feature is safe at runtime on OHOS.
forbid_1_reason:        True-device execution can still raise SIGSYS, EINVAL, or
                         hang child processes after a successful compile probe.
forbid_1_consequence:   Packages may build but later fail or hang during their
                         own upstream tests or downstream configure scripts.

principles:             P014, P016, P020
caused_by:
similar_to:             E002, E018, E050
conflicts_with:
prerequisite_of:

doc_file:               doc/E220.md
last_updated:           2026-07-27
source_event:           archives/p/perl/5.42.2

