#====================================================================
# E318 draft — HarmonyOS 上 go test 临时 ELF 未签名导致测试无法执行
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E318
trigger_tool:           go|go test|runtime
phase:                  testing
error_signature:        fork/exec.*\.test.*permission denied|go test.*permission denied|operation not permitted.*\.test|exec format error.*\.test

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               go|testing|signing|harmonyos
match_keywords:         go test,go test -c,unsigned ELF,.test,Permission denied,Operation not permitted,binary-sign-tool,source directory,test.v
title:                  HarmonyOS 上 go test 临时 ELF 未签名导致测试无法执行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             go test 默认在临时目录编译包级测试 ELF 并立即执行；HarmonyOS 会拒绝加载未签名 ELF。即使测试 ELF 已在非 HMDFS 目录成功链接，未经签名仍会在进入测试代码前失败。
affected_scope:         所有需要在 HarmonyOS 真机运行上游 Go 测试套件的项目，尤其是包含相对路径资源、多个 package 或子测试的项目。
verification_cmd:       GOTOOLCHAIN=local go test -v ./...

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           compile-sign-run-go-tests
rec_description:        按 package 使用 go test -c 将测试 ELF 输出到非 HMDFS 目录，移除旧 .codesign 后自签并恢复执行权限，最后从该 package 的原源码目录执行，保留相对资源路径、包级初始化和原测试判定。
rec_command:            go test -c -o "$TEST_ROOT/pkg.test" ./pkg && (llvm-objcopy --remove-section .codesign "$TEST_ROOT/pkg.test" 2>/dev/null || true) && binary-sign-tool sign -inFile "$TEST_ROOT/pkg.test" -outFile "$TEST_ROOT/pkg.test.signed" -selfSign 1 && mv "$TEST_ROOT/pkg.test.signed" "$TEST_ROOT/pkg.test" && chmod +x "$TEST_ROOT/pkg.test" && (cd pkg && "$TEST_ROOT/pkg.test" -test.v -test.count=1)
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      compile-off-device-sign-on-target
fallback_description:  若 HarmonyOS worker 没有可执行 Go 工具链，可在受支持的 Linux/arm64 构建机执行 go test -c，再把测试 ELF 传到目标机自签并从原 package 目录执行；源码、测试资源和提交必须一致。
fallback_command:       CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go test -c -o pkg.test ./pkg
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       go test.*\|\|.*true|skip.*go test|删除.*_test\.go|修改.*断言.*通过
forbid_1_reason:        跳过、删除或放宽上游测试不能证明 HarmonyOS 适配保持原有行为。
forbid_1_consequence:   测试覆盖率虚高，签名或真实运行问题被隐藏。
forbid_2_pattern:       cd.*cache.*&&.*\.test|/data/storage/el2/base/cache/.*\.test.*without.*cd
forbid_2_reason:        在缓存输出目录直接运行会改变依赖相对资源的 package 工作目录。
forbid_2_consequence:   测试因错误 CWD 产生假失败，或绕过原包资源语义。

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P017

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              [E077, E124, E128, E134, E166]
similar_to:             [E077]
conflicts_with:         []
prerequisite_of:        []

