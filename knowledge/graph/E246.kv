#====================================================================
# E246 — HarmonyOS seccomp 拦截 Linux 私有 syscall
#====================================================================

id:                     E246
trigger_tool:           runtime|strace|test|smoke_test
phase:                  runtime
error_signature:        SIGSYS|si_code.*SYS_SECCOMP|si_syscall|Signal 31|exit 159|
                        adjtimex.*SIGSYS|syscall 171|seccomp blocked

severity:               2
category:               kernel|syscall|compat|security|seccomp
match_keywords:         SIGSYS, SYS_SECCOMP, si_syscall, seccomp, syscall blocked,
                        adjtimex, syscall 171, signal 31, core dump, graceful degradation
title:                  HarmonyOS seccomp 拦截 Linux 私有 syscall（adjtimex 等），进程因 SIGSYS 终止

root_cause:             HarmonyOS 沙箱/安全策略(seccomp 过滤器)直接拦截部分 Linux
                        私有 syscall(如 adjtimex, aarch64 编号 171)。
                        与 E051"未实现 syscall"不同: 被拦截调用通过 seccomp 返回
                        SIGSYS, si_code=1(=SYS_SECCOMP), siginfo_t.si_syscall
                        携带 syscall 号, 进程默认因 SIGSYS 终止(core dump, exit 159)。
affected_scope:         所有调用 Linux 私有 syscall 且鸿蒙无等价安全许可的工具类库
                        (时间调整、资源控制、命名空间等), 如 adjtimex、ntp 客户端、
                        部分系统管理工具
verification_cmd:       adjtimex --print; echo "exit=$?"
                        # 预期: Signal 31 (SIGSYS) core dumped
                        # 或 C 程序: syscall(SYS_adjtimex, &tx) 触发 SIGSYS
                        # siginfo_t: si_signo=31, si_code=1(SYS_SECCOMP), si_syscall=171

rec_priority:           1
rec_approach:           graceful-degradation
rec_description:        无应用层恢复手段(seccomp 策略不可被应用层修改)。
                        适配策略: 检测 SIGSYS(可捕获时)后降级/跳过受限功能,
                        或仅保留不触发受限 syscall 的功能子集。
                        对 CLI 工具: smoke test 使用不触发受限 syscall 的路径
                        (如 --version), 核心功能在鸿蒙上标记为不可用
rec_command:            # 信号处理中读取 si_syscall 判断:
                        #   struct sigaction sa; sa.sa_sigaction = on_sigsys;
                        #   sa.sa_flags = SA_SIGINFO; sigaction(SIGSYS, &sa, NULL);
                        #   void on_sigsys(int sig, siginfo_t *si, void *uc) {
                        #       printf("si_signo=%d si_code=%d syscall=%d\n",
                        #              si->si_signo, si->si_code, si->si_syscall);
                        #   }
rec_auto_fix:           false
rec_impl:               manual-patch

forbid_1_pattern:       在鸿蒙沙箱中依赖被拦截 syscall 完成核心功能且不做降级
forbid_1_reason:        seccomp 策略不可被应用层修改, 调用必然 SIGSYS 终止进程
forbid_1_consequence:   进程 core dump(exit 159), 工具完全不可用
forbid_2_pattern:       仅用 timeout 包裹绕过(如 timeout 10 adjtimex --print)
forbid_2_reason:        不解决根因, 进程仍被 SIGSYS 终止, 功能实际不可用
forbid_2_consequence:   smoke test 假通过, 核心功能静默不可用

fallback_priority:      2
fallback_approach:      feature-subset
fallback_description:   仅保留不触发受限 syscall 的功能子集(如 --version),
                        核心功能在 PR 正文与测试报告中如实标注不可用
fallback_command:       # 对 adjtimex: smoke test 用 `adjtimex --version`(exit 0),
                        # --print/调时功能标注"鸿蒙 seccomp 限制不可用"
fallback_auto_fix:      false
fallback_impl:          manual-patch

principles:             P004

causes:                 []
caused_by:              []
similar_to:             [E051, E164]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E246.md
last_updated:           2026-08-04
source_event:           adjtimex/1.29 适配 (HarmonyOS PC)

authors:                junshi_liu <liujsh2023@lzu.edu.cn>
source_pr:              !3958
source_commit:          a3d8a75e0e4a213a338e16e5c38d0dd71443728d

metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
