#====================================================================
# E218 — CastXML LLVM/Clang 双dylib CommandLine选项重复注册
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E218
trigger_tool:           castxml|ctest
phase:                  runtime
error_signature:        CommandLine Error: Option '.*' registered more than once!|LLVM ERROR: inconsistency in registered CommandLine options|libLLVM-15.*libclang-cpp.*NEEDED|mc-relax-all

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               linking|runtime|llvm
match_keywords:         CastXML, LLVM_LINK_LLVM_DYLIB, CLANG_LINK_CLANG_DYLIB, mc-relax-all, libLLVM-15.so, libclang-cpp.so, InitLLVM, CommandLine Error, inconsistency, registered more than once, OHOS, LLVM shared library, dylib

# ═══ Layer 2: 根因层 ═══
root_cause:             CastXML 二进制同时 NEED libLLVM-15.so 和 libclang-cpp.so。
                        OHOS SDK LLVM 是 LLVM_ENABLE_SHARED_LIBS=ON 构建，libLLVM-15.so 和 libclang-cpp.so
                        各为独立 monolith，各自拥有完整的 LLVM CommandLine option 注册循环。
                        当 binary 同时 dlopen 两库时，mc-relax-all 等 option 被注册两次，
                        触发 LLVM ERROR: inconsistency in registered CommandLine options，
                        导致进程以 exit 134 崩溃，所有 3919 个 CTest 失败。
affected_scope:         OHOS SDK LLVM/Clang shared library (monolith) 场景下，任何依赖 Clang/LLVM
                        CMake config 且出现 CommandLine Error: Option registered more than once
                        的工具类项目。核心条件是 libclang-cpp.so 为包含全部 LLVM 符号的自包含 monolith。
verification_cmd:       readelf -d castxml | grep NEEDED; readelf -d libclang-cpp.so | grep NEEDED; castxml --version; ctest --output-on-failure

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           link-only-clang-cpp-monolith
rec_description:        只链接 libclang-cpp.so（OHOS SDK 的 clang monolith 已包含全部 LLVM 符号），
                        移除对 libLLVM-15.so 的直接链接。具体步骤：
                        1. patch CastXML 的 src/CMakeLists.txt：移除/注释 llvm_config(castxml ...) 调用
                        2. patch castxml.cxx：移除 #include "llvm/Support/InitLLVM.h" 和
                           llvm::InitLLVM initLLVM(...) 实例化。OHOS 不需要 LLVM crash handler，
                           直接初始化 llvm::SmallVector(argv_in, argv_in + argc_in) 替代。
                        3. 保持 CLANG_LINK_CLANG_DYLIB=ON，确保 binary 通过 clang-cpp target 链接 libclang-cpp.so。
                        前提条件：libclang-cpp.so 必须是包含所有 LLVM 符号的 monolith。
rec_command:            # patches/0007-ohos-llvm-remove-llvm-config.patch + patches/0008-ohos-llvm-remove-initllvm.patch
                        # 验证: readelf -d castxml | grep NEEDED (应只输出 libclang-cpp.so)
                        # castxml --version (exit 0); ctest --output-on-failure (应全通过)
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      static-link-llvm
fallback_description:   如果无法移除 libLLVM 依赖，则改为静态链接 LLVM 库以避免双 dylib 冲突。
fallback_command:       设置 LLVM_LINK_LLVM_DYLIB=OFF 后重新构建
fallback_auto_fix:      false
fallback_impl:          cmake-option

# ═══ Layer 4: 原则引用 ═══
principles:             P005

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

