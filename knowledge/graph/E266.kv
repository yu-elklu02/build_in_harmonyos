#====================================================================
# E106 — lld 链接器缺少 libxml2 依赖导致链接失败
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E266
trigger_tool:           clang|ld|make
phase:                  linking
error_signature:        Error loading shared library libxml2.so.16.*needed by.*lld|xmlFreeDoc: symbol not found|clang.*error: unable to execute command: No such file or directory|clang.*error: linker command failed due to signal

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               linker-dependency
match_keywords:         libxml2.so.16, lld, linker, xmlFreeDoc, symbol not found, fuse-ld
title:                  lld 链接器缺少 libxml2.so.16 依赖导致 clang 链接失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ohos-sdk 自带的 lld 链接器是动态链接的 ELF，运行时依赖 libxml2.so.16，但系统默认库搜索路径中找不到该库，导致 lld 无法启动，clang 链接阶段失败
affected_scope:         所有使用 clang 默认 lld 链接器的编译任务
verification_cmd:       /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/bin/lld --version 2>&1 | grep -q "libxml2" && echo "AFFECTED" || echo "OK"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           use-alternative-linker
rec_description:        使用 -fuse-ld=/data/service/hnp/bin/ld 指定 GNU ld 2.45 替代有问题的 lld
rec_command:            clang -fuse-ld=/data/service/hnp/bin/ld -o output source.c $(CFLAGS) $(LDFLAGS) -lssl -lcrypto
rec_auto_fix:           true
rec_impl:               add-fuse-ld-flag

# 回退方案
fallback_priority:      2
fallback_approach:      set-ld-library-path
fallback_description:   设置 LD_LIBRARY_PATH 包含 libxml2.so.16 所在目录（可能在某些环境下不生效）
fallback_command:       export LD_LIBRARY_PATH=/storage/Users/currentUser/usr/local/lib:$LD_LIBRARY_PATH
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       ln -sf.*libxml2
forbid_1_reason:         不要用 ln -sf 创建软链接覆盖系统库路径（R5 铁律）
forbid_1_consequence:    HMDFS 软链接问题可能导致系统不稳定

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E002]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E266.md
last_updated:           2026-07-06
source_event:           bannergrab 3.5 编译
authors:                lz6688 <yhwork66@163.com>
