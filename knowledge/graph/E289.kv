#====================================================================
# E217 — HELP2MAN=true 未生成手册页但 Automake 仍尝试安装
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E289
trigger_tool: make|install
phase: installation
error_signature: install: cannot stat .*\.[1-9].*: No such file or directory|No rule to make target .*\.[1-9].*install-man

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: autotools-generated-doc-install
match_keywords: HELP2MAN, man_MANS, cannot stat, No such file or directory, install-man
title: HELP2MAN=true 未生成手册页但 Automake 仍安装 man_MANS 导致失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 把 HELP2MAN 设置为 true 只会让生成命令成功返回而不产生手册页；Automake 生成的 man_MANS 安装清单仍非空，install-man 目标因此读取不存在的文件并失败
affected_scope: 使用 Automake man_MANS 安装由 help2man 生成的手册页，并在交叉构建中用 true 替代文档生成器的项目
verification_cmd: make install DESTDIR="$DESTDIR" man_MANS=

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: clear-automake-man-list
rec_description: 禁用 help2man 时，在 make install 命令行显式传入 man_MANS=，使 Automake 不执行缺失手册页的安装规则
rec_command: make install DESTDIR="$DESTDIR" man_MANS=
rec_auto_fix: false
rec_impl: pass-make-variable

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: provide-working-help2man
fallback_description: 构建环境可执行目标工具且能安装 help2man 时，保留原 man_MANS 并真实生成手册页
fallback_command: make && make install DESTDIR="$DESTDIR"
fallback_auto_fix: false
fallback_impl: install-build-tool

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: HELP2MAN=true.*make install
forbid_1_reason: 仅替换生成器不会清空 Automake 的 man_MANS 安装清单
forbid_1_consequence: 安装阶段仍因手册页不存在而失败
forbid_2_pattern: touch .*\.[1-9]|: > .*\.[1-9]
forbid_2_reason: 伪造空手册页会掩盖文档生成与安装清单不一致
forbid_2_consequence: 包中出现无效文档且真实构建缺陷未解决
forbid_3_pattern: make install.*\|\| true|make -k install
forbid_3_reason: 忽略安装失败无法证明制品完整
forbid_3_consequence: 缺失文件的包可能被错误标记为构建成功

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: []
caused_by: []
similar_to: []
conflicts_with: []
prerequisite_of: []

# ═══ 元数据 ═══
doc_file:               doc/E289.md
last_updated: 2026-07-18
source_event: x86_64-elf-grub/2.12: HELP2MAN=/bin/true 时安装失败，追加 man_MANS= 后安装和强制 Conan 构建成功

