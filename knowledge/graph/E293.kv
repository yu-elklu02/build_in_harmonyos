#====================================================================
# E218.kv — 2003年代旧 C++ 代码在 C++17 下 dynamic-exception-spec/register 编译错误
#====================================================================

id:                     E293
trigger_tool:           clang|make
phase:                  compilation
error_signature:        ISO C\+\+17 does not allow dynamic exception specifications|
                         ISO C\+\+17 does not allow 'register' storage class specifier|
                         -Wdynamic-exception-spec|-Wregister|throw\(AiksaurusException\)

severity:               2
category:               old-code-cpp17
match_keywords:         dynamic exception specifications, register storage class,
                         C++17, throw(, Wdynamic-exception-spec, Wregister,
                         2003, legacy code, old C++, compiler.cppstd, cppstd=17
title:                  2003 年代旧 C++ 代码在 C++17 标准下动态异常规范 throw(...) 与 register 关键字编译失败

root_cause:             2003 年前后编写的 C++ 代码广泛使用动态异常规范
                         throw(Type)（C++17 移除）和 register 存储说明符
                         （C++17 移除）。OHOS 编译 profile 设置
                         compiler.cppstd=17，clang -std=c++17 下这些特性
                         从 warning 升级为 hard error，导致旧 autotools
                         项目编译中断。知识图谱引擎常误匹配为工具链缺失
                         （E001 cc not found）或 shebang 问题（E165）。
affected_scope:         所有 2003 年前后发布的 C++ autotools/cmake 项目，
                         在 compiler.cppstd=17 的 OHOS 环境下编译时报错
verification_cmd:       grep -cE "throw\([A-Za-z]|\\bregister\\b" <src>/*.cpp

rec_priority:           1
rec_approach:           toolchain-flag
rec_description:        在 conanfile.py generate() 的 AutotoolsToolchain/
                         CMakeToolchain 中追加 -Wno-error=dynamic-exception-spec
                         与 -Wno-error=register，把这两个诊断降级为 warning
rec_command:            tc.extra_cxxflags.append("-Wno-error=dynamic-exception-spec"); tc.extra_cxxflags.append("-Wno-error=register")
rec_auto_fix:           true
rec_impl:               toolchain-flag

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   若降级为 warning 仍无法编译（如 -Werror 传递），
                         需 patch 源码：删除 register 关键字、将
                         throw(Type) 替换为 noexcept(false)
fallback_command:       sed -i 's/\\bregister\\b//g' src/*.cpp
fallback_auto_fix:      false
fallback_impl:          none

forbid_1_pattern:       --build=|--host=.*ohos|set\(CMAKE_CXX_STANDARD 11\)
forbid_1_reason:        禁止用 --host/--build 绕过（误判交叉编译），
                         也禁止把 cppstd 降到 11 掩盖问题（OHOS profile 固定 17）
forbid_1_consequence:   级联错误链：交叉编译误判 → AC_RUN_IFELSE 跳过 → config.h 错误 → 运行时崩溃

principles:             

causes:                 []
caused_by:              []
similar_to:             [E001, E053]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E293.md
last_updated:           2026-08-05
source_event:           archives/a/aiksaurus/1.2.1+dev-0.12/manifest.yaml

authors:                runner002 <runner002@localhost>
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
