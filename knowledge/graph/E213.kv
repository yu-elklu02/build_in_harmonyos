#====================================================================
# E213 — l64a() missing in OHOS libc (musl)
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E213
trigger_tool:           ld
phase:                  linking
error_signature:        undefined reference to .l64a.|cannot find -l.*l64a

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: missing_function
match_keywords:         l64a, undefined reference, musl, libc
title: l64a() missing in OHOS libc (musl)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: OHOS libc (musl) does not provide l64a() function, which converts a long value to a radix-64 string
affected_scope: Software that calls l64a() directly or via libraries (e.g. bitwise)
verification_cmd: echo "int main(){return (int)(long)l64a(0L);}" | clang -x c - -o /dev/null 2>&1 | grep l64a

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           implement-locally
rec_description:        Implement l64a() in a project source file and add extern declaration before usage to prevent implicit int return on aarch64
rec_command:            # Add to misc.c: char *l64a(long value) { static char buf[7]; ... } and add extern char *l64a(long); in calling file
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      stub-function
fallback_description:   Provide a stub that returns a constant string if full implementation is not needed
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       implicit.*l64a
forbid_1_reason:        Without extern declaration, compiler assumes int return, causing pointer truncation on aarch64
forbid_1_consequence:   Segfault at runtime due to truncated pointer

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E085]
conflicts_with:         []
prerequisite_of:        []

