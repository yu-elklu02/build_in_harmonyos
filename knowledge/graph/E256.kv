#====================================================================
# E314 — 二进制文件提交导致 CI diff patch 应用失败
# 对应的人类文档: doc/E314.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E256
trigger_tool:           git|git apply|patch
phase:                  CI/PR-validation
error_signature:        missing binary patch data.*\.tar\.gz|error: binary patch does not apply to.*packaging|patch does not apply.*packaging.*\.tar\.gz|PR.*diff.*无法应用.*冲突

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               ci-binary-patch-failure
match_keywords:         binary patch, tar.gz, packaging, git apply, diff patch, CI failure, missing binary patch data, staging-verified
title:                  二进制文件提交导致 CI PR diff patch 应用失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             PR 分支中提交了二进制构建产物（如 packaging/*.tar.gz）或构建过程标记文件（如 .staging-verified），CI checkout 流程通过 `git apply pr.diff` 应用 PR diff 时，git 无法处理缺少 binary patch data 的二进制文件，导致 patch 应用失败
affected_scope:         所有包含二进制文件（packaging/*.tar.gz、*.so、*.a、*.o 等）或空标记文件（.staging-verified）的 PR
verification_cmd:       git ls-tree -r HEAD -- archives/ | grep -E '(packaging/|\.staging-verified|\.tar\.gz|\.so|\.o$)'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           remove-binary-from-commit
rec_description:        从分支中删除二进制构建产物和空标记文件，amend 提交并 force push
rec_command:            git rm archives/h/hidapi/0.12.1/packaging/*.tar.gz archives/h/hidapi/0.12.1/.staging-verified && git commit --amend --no-edit && git push origin feat/xxx --force-with-lease
rec_auto_fix:           true
rec_impl:               remove-binary-files

fallback_priority:      2
fallback_approach:      add-to-gitignore
fallback_description:   在 .gitignore 中添加 packaging/ 和 .staging-verified 规则，防止后续误提交
fallback_command:       echo -e "packaging/\n.staging-verified" >> archives/h/hidapi/.gitignore
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       packaging/.*\.tar\.gz|\.staging-verified
forbid_1_reason:        二进制构建产物和空标记文件不应提交到仓库，CI 只读 conanfile.py/conandata.yml/test_package/patches/
forbid_1_consequence:   CI checkout 流程无法通过 git apply 应用包含二进制文件的 PR diff，导致 PR 构建失败

# ═══ Layer 4: 原则引用 ═══
principles:             P016

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E227]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E314.md
last_updated:           2026-08-11
source_event:           hidapi/0.12.1 PR #5056 CI 失败

