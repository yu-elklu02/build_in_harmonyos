#====================================================================
# E215-draft-4065.kv — Conan 打包时 SONAME 符号链接缺失
#   (ci_fix: janet 1.41.2 build #4065)
#====================================================================

id:                     E274
trigger_tool:           runtime|ld|conan
phase:                  runtime
error_signature:        Error loading shared library.*\(needed by.*\)|
                         Error relocating.*symbol not found

severity:               2
category:               packaging|runtime|linking
match_keywords:         shared library, SONAME, soname, symlink,
                         lib*.so.*, versioned, NEEDED, ld.so,
                         package(), conan, runtime linker,
                         Error loading shared library,
                         needed by

root_cause:             Makefile 使用 -Wl,-soname,lib.so.X.Y 编译共享库，
                        但 conanfile.py 的 package() 只复制了 lib.so 文件，
                        未创建版本化 SONAME 符号链接 lib.so.X.Y → lib.so。
                        运行时动态链接器解析 ELF 的 NEEDED 条目时找不到
                        版本化 SONAME 文件，导致加载失败。
affected_scope:         所有使用 Makefile 编译且设置了 -Wl,-soname 的
                        Conan 配方，共享库文件名为 lib.so 但 SONAME 为
                        lib.so.X.Y 的场景
verification_cmd:       llvm-readelf -d libjanet.so | grep SONAME;
                         ls -la $PREFIX/lib/*.so*

rec_priority:           1
rec_approach:           create-soname-symlink
rec_description:        在 conanfile.py 的 package() 方法中，
                        复制 lib.so 后创建 SONAME 符号链接：
                        os.symlink("lib.so", "lib.so.X.Y")
rec_command:            os.symlink("libjanet.so", "libjanet.so.1.41")
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      copy-versioned-file
fallback_description:   也可以直接复制文件为版本化名称：
                        copy(self, "build/libjanet.so", src=...,
                             dst=os.path.join(lib_dir, "libjanet.so.1.41"))
fallback_auto_fix:      false

principles:             
similar_to:             E019, E073, E207
caused_by:
conflicts_with:
prerequisite_of:

doc_file:               doc/E274.md
last_updated:           2026-07-16
source_event:           janet 1.41.2 build #4065 conan-build-test

