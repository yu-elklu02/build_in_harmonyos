# E216 draft — b2 child compiler interruption on OHOS
id:                     E216-draft-boost-test-b2-compile-interruption
trigger_tool:           b2|clang++
phase:                  compilation
error_signature:        failed clang.*compile.*warning.*no.*warnings generated|skipped.*for lack of.*\.o
severity:               2
category:               ohos, build-system, resource
match_keywords:         b2, clang++, compile interrupted, truncated output, memory pressure, cgroup
title:                  b2 child compiler interruption needs isolated verification on OHOS
root_cause:             A b2-launched compiler may be terminated before its diagnostic footer under device memory/cgroup pressure. The same clang++ command can succeed when run directly, so this is not enough evidence for a source or platform-test failure.
affected_scope:         Large Boost.Test b2 suites on memory-constrained OHOS devices.
verification_cmd:       b2 -j1 <target>; then rerun the exact clang++ command directly
rec_priority:           1
rec_approach:           isolated-retry-and-compare
rec_description:        Retry with -j1 and an isolated build directory, capture the complete compiler footer, and compare with direct clang++. Keep unresolved targets as failures until the cause is proven.
rec_command:            b2 -j1 <target>
rec_auto_fix:           false
rec_impl:               manual-diagnosis
forbid_1_pattern:       classify.*truncated.*output.*as.*OHOS.*skip
forbid_1_reason:        Truncated diagnostics do not establish a platform limitation.
principles:             P013, P014, P020
causes:                 []
caused_by:              []
similar_to:             [E074]
conflicts_with:         []
prerequisite_of:        []
doc_file:               doc/E216.md
last_updated:           2026-10-09
source_event:           Boost.Test 1.84.0 OHOS device validation
authors:
source_pr:
source_commit:
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
