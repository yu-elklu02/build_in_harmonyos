#====================================================================
# E241 — 数据/规则清单型库在 OHOS 上的固定版本、hash 完整性、规则查询和精确输出比对方法
#====================================================================

id:                     E241
trigger_tool:           conan-create|conan-verify|finish
phase:                  packaging|testing
error_signature:        data-only|rule-list|no-compile|no test suite|
                        !check|json data|static data|data package

severity:               2
category:               data-package-adaptation
match_keywords:         data package, data-only, rule-list, JSON data, SPDX,
                        no compilation, test_package, self.run, conanrun,
                        SHA256 verification, fixed output comparison
title:                  OHOS 上数据/规则清单型库的固定版本、hash 完整性、规则查询和精确输出比对方法

root_cause:             OpenHarmony PC 适配中遇到没有 C/C++ 源码、不需要编译、没有传统测试套件的数据/规则清单型上游库。这类库的核心价值在于提供固定版本的权威数据（JSON/规则清单）和可编程查询接口。传统 CMake/Autotools 模板不适用，需要专门的数据包适配模式。
affected_scope:         SPDX License List 数据包、IANA 协议/服务名数据、Unicode 字符数据库、时区数据（tzdata）、CA 证书列表、任何以 JSON/数据文件为主要产出的上游项目。

verification_cmd:       conan create archives/s/spdx-licenses/3.28.0 -tf=test_package

rec_priority:           1
rec_approach:           data-package-pattern
rec_description:        |
  数据包核心模式：
  1. settings = None（不依赖编译器/架构）
  2. 不设置 package_type（避免触发 CLI 工具命令检查）
  3. source() 使用 get() 下载 tarball
  4. build() 中验证数据完整性（版本号、总数、hash）
  5. package() 复制数据到 res/ 目录
  6. test_package 使用独立 .py 脚本 + self.run() 调用
  7. test_package 输出固定 JSON 摘要供精确比对
rec_command:            |
  # conanfile.py 关键配置:
  #   settings = None
  #   def build(): apply_conandata_patches(self); 数据校验...
  #   def package(): copy(self, "*", src=json_dir, dst=res_dir)
  #   def package_info(): self.cpp_info.resdirs = ["res"]
  #
  # test_package/conanfile.py:
  #   def test():
  #     dep = self.dependencies["pkg"]
  #     self.run(f"python3 test_pkg.py \"{dep.package_folder}/res\"",
  #              cwd=self.source_folder, env="conanrun")
rec_auto_fix:           false
rec_impl:               manual

forbid_1_pattern:       package_type.*=.*"application"
forbid_1_reason:        数据包不应设置 package_type="application"，否则 CI 误判为 CLI 工具并要求 commands.json
forbid_1_consequence:   W3 CI 阻塞，需要额外创建 commands.json

forbid_2_pattern:       settings\s*=\s*["']?[^N]|settings\s*=\s*["']os["']
forbid_2_reason:        数据包不依赖编译器/架构，不应设置 os/compiler/arch 等 settings
forbid_2_consequence:   Conan 会要求为每种架构编译同一份数据

principles:             P001

causes:                 []
caused_by:              []
similar_to:             [E221]
conflicts_with:         []
prerequisite_of:        []

