#====================================================================
# E217 — 大型 C++ 数据处理库上游 CTest/GTest 在 OHOS 上的分层迁移
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E292
trigger_tool:           cmake|ctest|gtest|conan
phase:                  testing
error_signature:        gtest_captured_stream|PARQUET_TEST_DATA|ARROW_TEST_DATA|discover_tz_dir|Cannot locate timezone|std::ranges::equal|Error loading shared library .*release.*so|duplicate libarrow_gtest|SIGTRAP 133|jobserver mkfifo|posix_fadvise failed|OpenAppendStream|Boost.Context.*x86_64|make_x86_64_sysv_elf_gas|DST|Broken_Hill|std::bad_alloc|OutOfMemory|ResizeOOM|Signal 11|symlink.*Permission denied|hardlink.*Operation not permitted|OpenSSL::SSL|OpenSSL::Crypto

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               upstream-test-framework-migration
match_keywords:         CTest, GTest, ARROW_TEST_DATA, PARQUET_TEST_DATA, TZDIR, zoneinfo, relative NEEDED, basename NEEDED, duplicate GTest, jobserver, ranges, fadvise, LocalFileSystem, Boost.Context, CMAKE_SYSTEM_PROCESSOR, DST, OOM, allocator, overcommit, FetchContent, gRPC, OpenSSL, symlink, hardlink
title:                  大型 C++ 数据处理库上游测试在 OHOS 上需要分层迁移和环境补齐

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             大型 C++ 数据处理库的上游测试同时依赖 CTest/GTest、官方测试数据、timezone 数据、动态库加载路径、C++20 标准库能力、平台文件系统语义和重依赖 FetchContent 源码包; OHOS Conan 真机环境缺少这些 Linux 开发机默认条件, 且当前测试文件系统可能拒绝 symlink/hardlink, 导致无法直接声明完整上游测试通过
affected_scope:         Apache Arrow 类多模块 C++ 数据处理库, 以及依赖 CTest/GTest、官方测试数据、运行时动态库加载环境、gRPC/OpenSSL 等重依赖的 C++ 上游测试体系
verification_cmd:       ctest --output-on-failure; ctest --output-on-failure -R parquet; ctest --output-on-failure -R 'arrow-(dataset|acero)'; sh scripts/ohos-probe-upstream-modules.sh --module flight --grpc-src <pre-extracted-grpc>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           layered-ctest-migration
rec_description:        先按 CTest target inventory 区分可执行 C++ 子集、需额外环境子集和不可执行子集; 对可执行子集补齐 TEST_TMPDIR/TMPDIR、ARROW_TEST_DATA、PARQUET_TEST_DATA、TZDIR、单一动态库目录和 basename NEEDED 等环境; timezone 用例需记录 tzdb 来源和版本, 不应未验证就把系统 zoneinfo 作为默认回退; compute-on 或 Boost.Context 场景需显式设置 CMAKE_SYSTEM_PROCESSOR/BOOST_CONTEXT_ARCHITECTURE; Flight/gRPC 等重依赖探针需先检查 FetchContent 源码包是否含 symlink/hardlink, 必要时使用 no-links 预解包并通过 FETCHCONTENT_SOURCE_DIR_* 注入; 若继续缺少 OpenSSL/BoringSSL 等依赖, 应记录为依赖闭环缺口而不是目标测试失败; 必要时给 GTest/date 等测试或运行时基础设施增加通用环境变量入口; 对可归纳为通用防御语义的平台差异采用 POSIX 兼容修复, 其余差异独立报告说明
rec_command:            export TMPDIR=$PWD/tmp ARROW_TEST_DATA=$ROOT/testing/data PARQUET_TEST_DATA=$ROOT/cpp/submodules/parquet-testing/data TZDIR=$HOME/.local/lib/python3.12/site-packages/tzdata/zoneinfo; cmake -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DBOOST_CONTEXT_ARCHITECTURE=arm64 -DBOOST_CONTEXT_ABI=aapcs; ctest -j1 --output-on-failure
rec_auto_fix:           false
rec_impl:               manual-test-layering-and-report

fallback_priority:      2
fallback_approach:      consumer-test-package-plus-difference-report
fallback_description:   若完整上游测试无法在当前 OHOS 环境闭环, 至少提供 Conan test_package 运行时 API 验证, 并将未执行或未通过子集的环境缺口、系统差异和后续计划写入 reports
fallback_command:       conan create . -o apache-arrow/*:shared=True && conan create . -o apache-arrow/*:shared=False
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       将 test_package 冒充完整上游测试通过|将 CTest target 子集写成 Path C 全量通过|忽略未通过 target
forbid_1_reason:         大型 C++ 库的消费者风险主要来自未验证模块和运行时边界, 必须分开统计上游原样测试、迁移后可执行子集和消费者验证
forbid_1_consequence:    下游库依赖 apache-arrow 时可能暴露未覆盖模块问题, 路径 B 证据也会因过度声明而不稳

# ═══ Layer 4: 原则引用 ═══
principles:             

