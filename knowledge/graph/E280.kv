#====================================================================
# E215 — Tcl 静态构建下 Thread 静态包注册缺失导致核心 thread.test hang
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E280
trigger_tool:           tcltest|tclsh|conan|make
phase:                  runtime|testing
error_signature:        can't find package Thread exactly 2\.8\.9|dynamic loading is not currently available on this system|thread\.test hang|timeout.*thread\.test|vwait.*never returns|wchan=FUTEX

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               static-package-registration
match_keywords:         Thread, Tcl_StaticPackage, package require Thread, interp create, child interp, vwait, TCLLIBPATH, pkgIndex.tcl, ThreadReap, ThreadJoin, joinable, thread.test hang
title:                  OHOS 静态构建下 Thread 未注册 Tcl_StaticPackage 导致子解释器 package require Thread 失败、主线程 vwait 永久等待

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 静态构建 (TCL_SHLIB_EXT="") 下，0010 把 Thread_Init 静态链接进 tclsh/tcltest 并仅在 AppInit 主解释器调用，未注册 Tcl_StaticPackage("Thread")。worker 线程内 interp create 创建的子解释器执行 "package require -exact Thread 2.8.9" 失败 ("can't find package Thread exactly 2.8.9")，worker 死亡后主线程 "vwait ::threadIdStarted" 永久等待 → unix/tests/thread.test hang (rc=124, 零输出, 主线程 wchan=FUTEX, worker 线程 wchan=EVENTPOLL)
affected_scope:         Tcl 8.6.14 静态构建下 unix/tests/thread.test 的 thread-7.16/7.17 等需要在子解释器 require Thread 的测试；Thread 2.8.9 静态链接场景
verification_cmd:       TCL_LIBRARY=<build>/unix/library timeout 180 <build>/build-release/tcltest unix/tests/thread.test -testdir unix/tests; echo "rc=$?"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           static-package-registration-bridge
rec_description:        0013 新增 library/pkgIndex.tcl 静态桥接 (package ifneeded Thread 2.8.9 [list load {} Thread])；0014 在 OhosStaticPkgs_Init 注册 Tcl_StaticPackage(interp, "Thread", Thread_Init, NULL)（镜像 sqlite3 注册方式）；0015 将 pkgs/thread2.8.9/pkgIndex.tcl.in 的 Thread ifneeded 改为静态 load {} 形式，防止 TCLLIBPATH 前置 pkgs 目录时动态 pkgIndex 覆盖静态桥接
rec_command:            见补丁 0013/0014/0015；验证: TCL_LIBRARY=<build>/unix/library TCLLIBPATH=<build>/build-release/pkgs timeout 240 <build>/build-release/tcltest unix/tests/thread.test -testdir unix/tests
rec_auto_fix:           true
rec_impl:               patch-0013-0014-0015

# 回退方案
fallback_priority:      2
fallback_approach:      skip-thread-tests
fallback_description:   将 thread 测试约束置为 false 跳过（不推荐，违反禁止跳过核心测试原则）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       跳过 unix/tests/thread\.test|把.*失败改成 skipped|timeout 包装后伪造 rc=0
forbid_1_reason:        必须让 thread.test 自然退出并给出真实统计，禁止伪造/跳过
forbid_1_consequence:   掩盖真实回归，无法确认 Thread 静态包修复有效性

# ═══ Layer 4: 原则引用 ═══
principles:             

