#====================================================================
# E231 — 直拷源码漏掉构建阶段生成的公共头
#====================================================================

# Layer 0: Error Surface
id:                     E309
trigger_tool:           conan|cmake|meson|autotools
phase:                  packaging|testing
error_signature:        fatal error: .*\.h.*file not found|missing generated public header|package.*installed header.*missing

# Layer 1: Recognition
severity:               2
category:               packaging|generated-header|cross-compilation
match_keywords:         generated public header, configure_file, config header, compiler probe, install_headers, source copy, package_id, fd_set
title:                  直拷源码漏掉构建阶段生成的公共头

# Layer 2: Diagnosis
root_cause:             自定义 Conan 配方只复制源码树中已有的 *.h，却没有核对 CMake/Meson/Autotools 的安装清单；由 configure_file 或编译器特性探测生成的公共头只存在于构建目录，因此不会进入包。若生成内容依赖目标 libc、ABI 或工具链，同时清空 package ID 会把错误头复用于不兼容目标。
affected_scope:         为减少构建工具依赖而直接复制头文件的 header-only、协议头和 SDK 数据配方，尤其是上游安装规则包含 configure_file、AC_CONFIG_FILES 或生成头目标时。
verification_cmd:       grep -R -E 'configure_file|AC_CONFIG_FILES|install_headers|HEADERS.*=' . | grep -E '\.h|header'

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           reproduce-generated-install-output
rec_description:        先从所有上游构建系统的安装定义枚举静态和生成公共头；运行上游配置步骤，或用 Conan profile 声明的目标编译器复现最小特性探测，再从原始模板生成并打包公共头。保留影响生成内容的 package ID 设置，并增加会展开生成宏或访问被探测成员的消费者测试。
rec_command:            audit upstream install definitions; compile target feature probes; configure the header template; package and compile a substantive consumer
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      run-upstream-configure-step
fallback_description:   若最小生成逻辑无法可靠复现，安装所需构建工具并用目标 toolchain 运行上游配置阶段，再从构建目录打包其正式生成头。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       copy.*\*\.h.*self\.info\.clear
forbid_1_reason:        源码通配复制与无条件清空 package ID 无法覆盖目标相关的生成公共头。
forbid_1_consequence:   包内容不完整，或把针对一种目标 libc 生成的头复用于另一目标。
forbid_2_pattern:       hardcode.*(fds_bits|__fds_bits)|replace.*@.*@.*without.*probe
forbid_2_reason:        硬编码探测结果只对当前主机偶然成立，交叉编译和 CI 工具链可能不同。
forbid_2_consequence:   头文件存在但消费者展开宏时编译失败。

# Layer 4: Principles
principles:             P010, P014

# Relations
causes:                 []
caused_by:              []
similar_to:             E117,E229
conflicts_with:         []
prerequisite_of:        []

