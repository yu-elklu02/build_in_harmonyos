#====================================================================
# E237 — HarmonyOS PC ACPI 接口缺失（acpid 类守护进程适配模式）
#====================================================================

id:                     E237
trigger_tool:           acpid
phase:                  runtime
error_signature:        /proc/acpi: No such file or directory|
                        /sys/bus/acpi: No such file or directory|
                        /sys/firmware/acpi: No such file or directory|
                        no NETLINK_GENERIC in /proc/net|
                        HongMeng Kernel

severity:               2
category:               runtime|platform-diff|system-service
match_keywords:         ACPI, acpid, acpi_listen, /proc/acpi, /sys/bus/acpi,
                        /sys/firmware/acpi, NETLINK_GENERIC, HongMeng Kernel,
                        HarmonyOS, power button, lid event, battery, thermal,
                        kernel interface missing, daemon
title:                  HarmonyOS PC ACPI 接口缺失，acpid 类守护进程不可运行

root_cause:             HarmonyOS PC 内核（HongMeng Kernel 1.12.0 aarch64）不提供 Linux 标准 ACPI
                        用户态接口：/proc/acpi、/sys/bus/acpi、/sys/firmware/acpi 均不存在，
                        /proc/net 中无 NETLINK_GENERIC 协议族。acpid 是纯事件源守护进程，编译期
                        只依赖 libc 与标准头文件（configure/make 全通过），但运行期依赖上述接口
                        接收电源键/合盖/电池/热事件，无接口则无事件源可读，守护进程实际不可运行。
affected_scope:         所有依赖 /proc/acpi 或 /sys/bus/acpi 或 ACPI netlink 的 Linux 事件守护进程
                        /工具（acpid, acpi_listen, kacpimon 等）
verification_cmd:       ls /proc/acpi/ 2>&1 || echo "MISSING: /proc/acpi"
                        ls /sys/bus/acpi/ 2>&1 || echo "MISSING: /sys/bus/acpi"
                        ls /sys/firmware/acpi/ 2>&1 || echo "MISSING: /sys/firmware/acpi"
                        uname -r

rec_priority:           1
rec_approach:           compile-verify-with-runtime-degradation
rec_description:        编译验证 + 运行期降级/shim 三选一，按目标场景取舍：
                        1. 仅编译验证（积分赛适配基线）：acpid 作为纯可执行包发布，configure/make/
                           conan create/conan-verify 全通过，运行依赖在 notes 中声明 ACPI 缺失。
                        2. 运行期事件源探测降级：patch event.c 让 acpid 启动时探测 /proc/acpi、
                           /sys/bus/acpi、netlink 三种事件源，全部缺失则打印明确诊断日志并退出
                           （而非静默挂起），便于集成方感知平台差异。
                        3. 平台 shim：若 HarmonyOS 有替代电源事件接口（如 hdf/udev 事件），写适配
                           层把平台事件翻译为 acpid 事件格式；当前 probe 阶段未发现该接口，需人工
                           确认后另行评估。
                        probe 阶段结论：采用方案 1（仅编译验证），不虚构可运行结论。
rec_command:            # 最小复现（HarmonyOS PC 上执行）:
                        #   ls /proc/acpi/ 2>&1 || echo "MISSING: /proc/acpi"
                        #   ls /sys/bus/acpi/ 2>&1 || echo "MISSING: /sys/bus/acpi"
                        #   ls /sys/firmware/acpi/ 2>&1 || echo "MISSING: /sys/firmware/acpi"
                        #   grep -r NETLINK_GENERIC /proc/net/ 2>/dev/null || echo "no netlink acpi"
                        #   uname -r   # HongMeng Kernel 1.12.0
rec_auto_fix:           false
rec_impl:               compile-verify-only

fallback_priority:      2
fallback_approach:      runtime-probe-degradation
fallback_description:   patch event.c 让 acpid 启动时探测 /proc/acpi、/sys/bus/acpi、netlink 三种
                        事件源，全部缺失则打印明确诊断日志并退出（而非静默挂起）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-patch

forbid_1_pattern:       声称.*可运行.*ACPI.*缺失|acpid.*正常运行.*HarmonyOS
forbid_1_reason:        HarmonyOS PC 不提供 ACPI 接口，acpid 运行期无事件源，不能声称可正常运行。
forbid_1_consequence:   下游集成方误以为守护进程功能完整，导致集成失败。

principles:             P004, P005

