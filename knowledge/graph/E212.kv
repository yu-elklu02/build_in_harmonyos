#====================================================================
# E212 — hmmac 安全标签阻止用户路径 .so 的 dlopen
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E212
trigger_tool:           runtime|test|perl|python
phase:                  runtime
error_signature:        Error loading shared library.*\.so.*Permission denied|Can't load.*\.so.*Permission denied|dlopen.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               security|hmmac|platform_limitation
match_keywords:         Permission denied, loading shared library, dlopen, hmmac, security label, hnp_file, hishell_hap_data_file, hmdfs, Perl XS, DynaLoader, ctypes CDLL
title:                  hmmac 安全标签阻止从用户路径 dlopen .so 文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: OpenHarmony 的 hmmac (Harmony MAC) 安全模块根据文件所在路径分配安全标签。/data/service/hnp/ 下的文件获得 hnp_file 标签（通过 hmmac=inherit_parent），而用户可写路径（/storage/Users 为 hmdfs 标签，/data/storage/el2/base 为 hishell_hap_data_file 标签）获得不同标签。Perl/Python 进程运行在 hnp_file 安全上下文中，hmmac 策略仅允许加载 hnp_file 标签的 .so 文件。用户无权写入 /data/service/hnp/（属主 installs:installs），导致编译产物无法被 dlopen 加载。注：perl-dbd-pg 3.18.0 (2026-06-10) 已记录此问题，当时称为 "SELinux HMDFS 限制"，本次通过 ls -Z 安全标签分析确认根因更精确地为 hmmac 安全标签。
affected_scope: 所有需要 dlopen 加载 .so 的 Perl XS 模块、Python C 扩展、JNI 库等，当 .so 位于用户可写路径时
verification_cmd: ls -Z <so_path> → 检查标签是否为 u:object_r:hnp_file:s0；若不是则 dlopen 会失败

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           install-to-hnp-path
rec_description:        通过 hnp 包管理器或 cmd-pkgs 将 .so 安装到 /data/service/hnp/ 路径，获得 hnp_file 安全标签
rec_command:            # 需通过系统包管理器安装，非用户可自行操作
rec_auto_fix:           false
rec_impl:               manual-hint

fallback_priority:      2
fallback_approach:       verify-elf-only
fallback_description:   无法安装到 hnp 路径时，仅做 ELF 技术验证（file/readelf/nm），记录平台限制，不阻塞编译流程
fallback_command:       file <so_path> && llvm-readelf -d <so_path> && llvm-nm -D <so_path>
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       chmod 777|chmod a\+rwx.*\.so
forbid_1_reason:        权限问题不是 Unix 文件权限导致的，而是 hmmac 安全标签限制。chmod 无法改变安全标签。
forbid_1_consequence:   chmod 无效，dlopen 仍然失败，且降低系统安全性

forbid_2_pattern:       chcon|setfattr.*security\.hmmac
forbid_2_reason:        普通用户无权修改 hmmac 安全标签（Operation not permitted）
forbid_2_consequence:   操作失败，浪费排障时间

# ═══ Layer 4: 原则引用 ═══
principles:             P013

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E131,E083
conflicts_with:         []
prerequisite_of:        []

