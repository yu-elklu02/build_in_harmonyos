#====================================================================
# E220.kv — 应用包运行时资源完整性检查
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E297
trigger_tool: package|runtime|test
phase: installation|runtime
error_signature: No such file or directory.*share|No such file or directory.*www|No such file or directory.*config|Disabling local tree

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: runtime-packaging
match_keywords: runtime assets, share directory, config sample, web assets, package completeness
title: 应用包运行时资源完整性检查

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 配方只复制可执行文件而遗漏程序按编译时路径查找的网页、配置模板或数据资源，导致程序可启动但功能降级。
affected_scope: 安装布局包含 bin 与 share 或 etc 资源的命令行工具、服务和桌面应用。
verification_cmd: 在隔离包目录运行功能测试并确认所有编译时资源路径存在。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: package-runtime-resource-closure
rec_description: 从上游安装规则和源码路径常量建立运行时资源清单，按相同相对布局打包并测试。
rec_command: copy runtime files to package_folder/share and run packaged binary in an isolated directory
rec_auto_fix: false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       copy\(.*["'](bin|app|program)["']
forbid_1_reason:        仅复制可执行文件不能证明应用运行时资源闭包完整。
forbid_1_consequence:   程序可启动但在读取网页、配置或数据时功能降级。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E297.md
last_updated: 2026-07-16
source_event: PR #2106 polipo

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                 2301_80739235 <2047361658@qq.com>
source_pr:               2106
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:       2026-07-16
