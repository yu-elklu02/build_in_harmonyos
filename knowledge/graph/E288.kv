#====================================================================
#
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E288
trigger_tool: cmake|conan
phase: compilation|installation
error_signature: package contains both .*\.a and .*\.so|BUILD_SHARED_LIBS.*ignored

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cmake-packaging
match_keywords: CMake, BUILD_SHARED_LIBS, static, shared, single artifact
title: CMake 双库目标收敛为单一可选产物

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游显式定义 STATIC 和 SHARED 两个目标时 BUILD_SHARED_LIBS 不参与目标类型选择，包会同时安装两类库。
affected_scope: 同时定义静态和共享目标且由 Conan shared 选项控制的 CMake 项目。
verification_cmd: ( set -eu; REF="pkg/version"; PKG="${REF%%/*}"; VER="${REF#*/}"; WORK_ROOT="$(mktemp -d)"; trap 'rm -rf "$WORK_ROOT"' EXIT; STATIC_DEPLOY="$WORK_ROOT/static"; SHARED_DEPLOY="$WORK_ROOT/shared"; conan create recipe -o "$PKG/*:shared=False"; conan create recipe -o "$PKG/*:shared=True"; conan install --requires="$REF" -o "$PKG/*:shared=False" --deployer=full_deploy --deployer-folder="$STATIC_DEPLOY"; conan install --requires="$REF" -o "$PKG/*:shared=True" --deployer=full_deploy --deployer-folder="$SHARED_DEPLOY"; STATIC_ROOT="$STATIC_DEPLOY/full_deploy/host/$PKG/$VER"; SHARED_ROOT="$SHARED_DEPLOY/full_deploy/host/$PKG/$VER"; STATIC_LIB="$(find "$STATIC_ROOT" -type d -name lib -print -quit)"; SHARED_LIB="$(find "$SHARED_ROOT" -type d -name lib -print -quit)"; test -n "$STATIC_LIB"; test -n "$SHARED_LIB"; test -n "$(find "$STATIC_LIB" -type f -name '*.a' -print -quit)"; test -z "$(find "$STATIC_LIB" \( -type f -o -type l \) -name '*.so*' -print -quit)"; test -n "$(find "$SHARED_LIB" \( -type f -o -type l \) -name '*.so*' -print -quit)"; test -z "$(find "$SHARED_LIB" -type f -name '*.a' -print -quit)"; )

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: single-cmake-library-target
rec_description: 将双目标改为一个未显式指定类型的 add_library 目标，让 BUILD_SHARED_LIBS 决定产物。
rec_command: cmake -S . -B build -DBUILD_SHARED_LIBS=OFF
rec_auto_fix: false
rec_impl:               manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       add_library\([^)]*STATIC|add_library\([^)]*SHARED
forbid_1_reason:        显式双目标会绕过 BUILD_SHARED_LIBS 的统一选择。
forbid_1_consequence:   包内同时出现静态和共享库，Conan shared 选项失效。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

