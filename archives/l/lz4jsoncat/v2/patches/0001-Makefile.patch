--- a/Makefile
+++ b/Makefile
@@ -1,7 +1,21 @@
-CFLAGS := -g -O2 -Wall
-LDLIBS := $(shell pkg-config --cflags --libs liblz4)
+# Modified for OpenHarmony cross compilation
+PREFIX ?= /usr/local
+DESTDIR ?=
+
+CFLAGS := -g -O2 -Wall -fPIC
+CPPFLAGS := -I$(PREFIX)/include
+LDFLAGS := -L$(PREFIX)/lib
+LDLIBS := -llz4
 
 lz4jsoncat: lz4jsoncat.c
 
+install: lz4jsoncat
+	install -d $(DESTDIR)$(PREFIX)/bin
+	install -d $(DESTDIR)$(PREFIX)/share/man/man1
+	install -m 755 lz4jsoncat $(DESTDIR)$(PREFIX)/bin/
+	install -m 644 lz4jsoncat.1 $(DESTDIR)$(PREFIX)/share/man/man1/
+
 clean:
 	rm -f lz4jsoncat
+
+.PHONY: install clean
