--- CMakeLists.txt
+++ CMakeLists.txt
@@ -306,3 +306,19 @@
+  if(CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR
+     CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    foreach(test_dependency gtest gtest_main gmock gmock_main)
+      if(TARGET ${test_dependency})
+        target_compile_options(${test_dependency} PRIVATE
+          -Wno-error=deprecated-copy)
+      endif()
+    endforeach()
+    foreach(benchmark_target benchmark benchmark_main)
+      if(TARGET ${benchmark_target})
+        target_compile_options(${benchmark_target} PRIVATE
+          -Wno-error=unused-but-set-variable)
+      endif()
+    endforeach()
+  endif()
+
   # GoogleTest triggers a missing field initializers warning.
   if(LEVELDB_HAVE_NO_MISSING_FIELD_INITIALIZERS)
     set_property(TARGET gtest
@@ -447,4 +463,10 @@
 if(LEVELDB_INSTALL)
+  if(CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR
+     CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    set_target_properties(leveldb PROPERTIES
+      INSTALL_RPATH "$ORIGIN"
+      BUILD_WITH_INSTALL_RPATH TRUE)
+  endif()
   install(TARGETS leveldb
     EXPORT leveldbTargets
     RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
--- third_party/googletest/googletest/src/gtest.cc
+++ third_party/googletest/googletest/src/gtest.cc
@@ -6151,9 +6151,16 @@
     return temp_dir;
   else
     return std::string(temp_dir) + "\\";
 #elif GTEST_OS_LINUX_ANDROID
   return "/sdcard/";
 #else
-  return "/tmp/";
+  const char* temp_dir = internal::posix::GetEnv("TEST_TMPDIR");
+  if (temp_dir == nullptr || temp_dir[0] == '\0') {
+    return "/tmp/";
+  }
+  if (temp_dir[strlen(temp_dir) - 1] == '/') {
+    return temp_dir;
+  }
+  return std::string(temp_dir) + "/";
 #endif  // GTEST_OS_WINDOWS_MOBILE
 }
