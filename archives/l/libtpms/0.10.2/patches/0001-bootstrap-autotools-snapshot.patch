--- /dev/null
+++ b/configure
@@ -0,0 +1,18 @@
+#!/bin/sh
+set -eu
+
+srcdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+cd "$srcdir"
+
+autoreconf --install --force
+chmod +x "$srcdir/configure"
+
+# HMDFS: config.status creates temp dirs with umask 077, which fails on this fs.
+sed \
+  -e 's#(umask 077 && mktemp -d "[.]/confXXXXXX")#mktemp -d "./confXXXXXX"#g' \
+  -e 's#(umask 077 && mkdir "\$tmp")#mkdir "$tmp"#g' \
+  "$srcdir/configure" > "$srcdir/configure.tmp"
+mv "$srcdir/configure.tmp" "$srcdir/configure"
+chmod +x "$srcdir/configure"
+
+exec "$srcdir/configure" "$@"
