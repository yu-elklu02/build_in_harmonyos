--- a/linux_lib/libcrystalhd/Makefile	2011-07-16 21:46:49.000000000 +0800
+++ b/linux_lib/libcrystalhd/Makefile	2026-07-15 17:06:28.905314063 +0800
@@ -1,21 +1,26 @@
 #
 #  Broadcom "BCM970012/BCM970015" Crystal HD device interface library.
 #
+# Modified for HarmonyOS aarch64 build
 #
 BCLIB_MINOR=6
 BCLIB_MAJOR=3
 BCLIB_NAME=libcrystalhd.so
 BCLIB_SL=$(BCLIB_NAME).$(BCLIB_MAJOR)
 BCLIB=$(BCLIB_NAME).$(BCLIB_MAJOR).$(BCLIB_MINOR)
-LIBDIR=/usr/lib
+
+# HarmonyOS DESTDIR mode (R20): PREFIX for runtime path, DESTDIR for staging
+PREFIX ?= /usr/local
+LIBDIR=$(PREFIX)/lib
+HDRDIR=$(PREFIX)/include
 
 AT   = @
 ECHO = ${AT} echo
-BCGCC = g++
+BCGCC = clang++
 
 ROOTDIR = ../..
 
-INCLUDES = -I./ -I/usr/include -I$(ROOTDIR)/include
+INCLUDES = -I./ -I$(PREFIX)/include -I$(ROOTDIR)/include
 INCLUDES += -I$(ROOTDIR)/include/link
 
 
@@ -24,7 +29,7 @@
 # -D_USE_SHMEM_
 
 CPPFLAGS += ${INCLUDES}
-CPPFLAGS += -O2 -Wall -fPIC -shared -fstrict-aliasing -msse2
+CPPFLAGS += -O2 -Wall -fPIC -shared -fstrict-aliasing
 LDFLAGS = -Wl,-soname,${BCLIB_SL} -pthread
 
 SRCFILES = 	libcrystalhd_if.cpp \
@@ -39,8 +44,9 @@
 
 all:help $(OBJFILES)
 	$(BCGCC) $(CPPFLAGS) $(LDFLAGS) -o $(BCLIB) ${OBJFILES}
-	ln -sf $(BCLIB) $(BCLIB_NAME)
-	ln -sf $(BCLIB) $(BCLIB_SL)
+	rm -f $(BCLIB_NAME) && ln -s $(BCLIB) $(BCLIB_NAME)
+	rm -f $(BCLIB_SL) && ln -s $(BCLIB) $(BCLIB_SL)
+	command -v patchelf >/dev/null 2>&1 && patchelf --set-rpath '$$ORIGIN' $(BCLIB) || true
 
 help:
 	${ECHO} OBJFILES = ${OBJFILES}
@@ -53,21 +59,16 @@
 
 install:
 	mkdir -p $(DESTDIR)$(LIBDIR)
-	mkdir -p $(DESTDIR)/lib/firmware
-	mkdir -p $(DESTDIR)/usr/include/libcrystalhd
-	cp libcrystalhd_if.h $(DESTDIR)/usr/include/libcrystalhd/
-	chmod 0644 $(DESTDIR)/usr/include/libcrystalhd/libcrystalhd_if.h
-	cp $(ROOTDIR)/include/bc_dts_defs.h $(DESTDIR)/usr/include/libcrystalhd/
-	chmod 0644 $(DESTDIR)/usr/include/libcrystalhd/bc_dts_defs.h
-	cp $(ROOTDIR)/include/bc_dts_types.h $(DESTDIR)/usr/include/libcrystalhd/
-	chmod 0644 $(DESTDIR)/usr/include/libcrystalhd/bc_dts_types.h
-	cp $(ROOTDIR)/include/libcrystalhd_version.h $(DESTDIR)/usr/include/libcrystalhd/
-	chmod 0644 $(DESTDIR)/usr/include/libcrystalhd/libcrystalhd_version.h
-	cp $(ROOTDIR)/firmware/fwbin/70012/bcm70012fw.bin $(DESTDIR)/lib/firmware/
-	chmod 0644 $(DESTDIR)/lib/firmware/bcm70012fw.bin
-	cp $(ROOTDIR)/firmware/fwbin/70015/bcm70015fw.bin $(DESTDIR)/lib/firmware/
-	chmod 0644 $(DESTDIR)/lib/firmware/bcm70015fw.bin
-	install -m 755 $(BCLIB) $(DESTDIR)$(LIBDIR)
-	(cd $(DESTDIR)$(LIBDIR); ln -sf $(BCLIB) $(BCLIB_NAME))
-	(cd $(DESTDIR)$(LIBDIR); ln -sf $(BCLIB) $(BCLIB_SL))
-
+	mkdir -p $(DESTDIR)$(HDRDIR)/libcrystalhd
+	cp libcrystalhd_if.h $(DESTDIR)$(HDRDIR)/libcrystalhd/
+	chmod 0644 $(DESTDIR)$(HDRDIR)/libcrystalhd/libcrystalhd_if.h
+	cp $(ROOTDIR)/include/bc_dts_defs.h $(DESTDIR)$(HDRDIR)/libcrystalhd/
+	chmod 0644 $(DESTDIR)$(HDRDIR)/libcrystalhd/bc_dts_defs.h
+	cp $(ROOTDIR)/include/bc_dts_types.h $(DESTDIR)$(HDRDIR)/libcrystalhd/
+	chmod 0644 $(DESTDIR)$(HDRDIR)/libcrystalhd/bc_dts_types.h
+	cp $(ROOTDIR)/include/libcrystalhd_version.h $(DESTDIR)$(HDRDIR)/libcrystalhd/
+	chmod 0644 $(DESTDIR)$(HDRDIR)/libcrystalhd/libcrystalhd_version.h
+	cp $(BCLIB) $(DESTDIR)$(LIBDIR)
+	chmod 755 $(DESTDIR)$(LIBDIR)/$(BCLIB)
+	cd $(DESTDIR)$(LIBDIR) && rm -f $(BCLIB_NAME) && ln -s $(BCLIB) $(BCLIB_NAME)
+	cd $(DESTDIR)$(LIBDIR) && rm -f $(BCLIB_SL) && ln -s $(BCLIB) $(BCLIB_SL)
