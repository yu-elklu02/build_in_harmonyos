--- a/configure
+++ b/configure
@@ -21353,6 +21353,12 @@ else
   RAWCPP="$ac_cv_path_RAWCPP"
 fi
 
+case "$host_os:$RAWCPP" in
+	linux-ohos*:*clang\ -E*)
