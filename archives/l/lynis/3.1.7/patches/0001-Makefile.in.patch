--- /dev/null
+++ b/Makefile.in
@@ -0,0 +1,43 @@
+# Makefile for lynis - shell script security auditing tool
+# Generated by configure from Makefile.in
+
+PREFIX = @PREFIX@
+DESTDIR =
+
+# Installation directories
+BINDIR = $(PREFIX)/bin
+DATADIR = $(PREFIX)/share/lynis
+MANDIR = $(PREFIX)/share/man/man8
+SYSCONFDIR = $(PREFIX)/etc/lynis
+
+all:
+	@echo "Nothing to build - lynis is a shell script tool"
+
+install: all
+	mkdir -p $(DESTDIR)$(BINDIR)
+	mkdir -p $(DESTDIR)$(DATADIR)/include
+	mkdir -p $(DESTDIR)$(DATADIR)/db
+	mkdir -p $(DESTDIR)$(DATADIR)/plugins
+	mkdir -p $(DESTDIR)$(MANDIR)
+	mkdir -p $(DESTDIR)$(SYSCONFDIR)
+	install -m 755 lynis $(DESTDIR)$(BINDIR)/lynis
+	install -m 644 lynis.8 $(DESTDIR)$(MANDIR)/lynis.8
+	cp -r include/* $(DESTDIR)$(DATADIR)/include/
+	cp -r db/* $(DESTDIR)$(DATADIR)/db/
+	-cp -r plugins/* $(DESTDIR)$(DATADIR)/plugins/
+	install -m 644 default.prf $(DESTDIR)$(SYSCONFDIR)/default.prf
+	-install -m 644 developer.prf $(DESTDIR)$(SYSCONFDIR)/developer.prf
+
+check:
+	@echo "Running lynis syntax check..."
+	sh -n lynis && echo "Syntax OK" || (echo "Syntax check failed"; exit 1)
+	@echo "Running lynis version check..."
+	sh lynis --version 2>/dev/null | head -1 || true
+
+clean:
+	@echo "Nothing to clean"
+
+distclean: clean
+	rm -f Makefile
+
+.PHONY: all install check clean distclean
