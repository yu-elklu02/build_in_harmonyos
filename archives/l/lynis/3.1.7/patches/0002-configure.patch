--- /dev/null
+++ b/configure
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Minimal configure wrapper for lynis - a shell script security auditing tool
+# Lynis has no build system; this provides autotools-style compatibility
+
+PREFIX="/usr/local"
+
+# Parse arguments
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        --help|--help=*)
+            echo "Usage: ./configure [--prefix=PREFIX]"
+            echo "  --prefix=PREFIX  Install prefix (default: /usr/local)"
+            exit 0
+            ;;
+        *)
+            # Silently ignore unknown options for compatibility
+            ;;
+    esac
+done
+
+# Generate Makefile
+sed -e "s|@PREFIX@|${PREFIX}|g" Makefile.in > Makefile
+
+echo "Configuration complete."
+echo "  Prefix: ${PREFIX}"
+echo "Run 'make install' to install."
