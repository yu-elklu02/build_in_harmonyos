#!/data/service/hnp/bin/bash
# HarmonyOS Toybox ps does not accept the Linux/BSD option forms used by Lynis.
# The default process listing is sufficient for name-based presence checks.
self_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
old_ifs=$IFS
IFS=:
for dir in $PATH; do
    [ -n "$dir" ] || dir=.
    case "$(CDPATH= cd -- "$dir" 2>/dev/null && pwd)" in
        "$self_dir") continue ;;
    esac
    if [ -x "$dir/ps" ]; then
        IFS=$old_ifs
        # Lynis uses procps/BSD flags (-x, -ax, -aux, -C, -o, -u),
        # which Toybox does not implement. Call the native listing form;
        # Lynis performs the name filtering in its caller.
        exec "$dir/ps" "$@"
    fi
done
IFS=$old_ifs
exit 127
