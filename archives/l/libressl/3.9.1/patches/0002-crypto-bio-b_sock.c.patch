+static int
+bio_is_numeric_ipv4_candidate(const char *str)
+{
+	const unsigned char *p = (const unsigned char *)str;
+
+	if (*p < '0' || *p > '9')
+		return 0;
+
+	for (; *p != '\0'; p++) {
+		if ((*p >= '0' && *p <= '9') || *p == '.' ||
+		    *p == 'x' || *p == 'X' ||
+		    (*p >= 'a' && *p <= 'f') ||
+		    (*p >= 'A' && *p <= 'F'))
+			continue;
+		return 0;
+	}
+	return 1;
+}
+
 int
 BIO_get_host_ip(const char *str, unsigned char *ip)
 {
 	struct addrinfo *res = NULL;
 	struct addrinfo hints = {
 		.ai_family = AF_INET,
 		.ai_socktype = SOCK_STREAM,
 		.ai_flags = AI_PASSIVE,
 	};
 	uint32_t *iap = (in_addr_t *)ip;
 	int error;
 
 	if (str == NULL) {
 		BIOerror(BIO_R_BAD_HOSTNAME_LOOKUP);
 		ERR_asprintf_error_data("NULL host provided");
 		return (0);
 	}
 
+	if (bio_is_numeric_ipv4_candidate(str)) {
+		struct in_addr addr;
+
+		if (inet_pton(AF_INET, str, &addr) != 1) {
+			BIOerror(BIO_R_BAD_HOSTNAME_LOOKUP);
+			ERR_asprintf_error_data("invalid numeric IPv4 host='%s'", str);
+			return (0);
+		}
+		*iap = addr.s_addr;
+		return (1);
+	}
+
 	if ((error = getaddrinfo(str, NULL, &hints, &res)) != 0) {
 		BIOerror(BIO_R_BAD_HOSTNAME_LOOKUP);
 		ERR_asprintf_error_data("getaddrinfo: host='%s' : %s'", str,
 		    gai_strerror(error));
 		return (0);
 	}
 	*iap = (uint32_t)(((struct sockaddr_in *)(res->ai_addr))->sin_addr.s_addr);
 	freeaddrinfo(res);
 	return (1);
 }
 LCRYPTO_ALIAS(BIO_get_host_ip);
 
 int
 BIO_get_port(const char *str, unsigned short *port_ptr)
 {
+	char *end = NULL;
+	unsigned long port;
 	struct addrinfo *res = NULL;
 	struct addrinfo hints = {
 		.ai_family = AF_UNSPEC,
 		.ai_socktype = SOCK_STREAM,
 		.ai_flags = AI_PASSIVE,
 	};
 	int error;
 
 	if (str == NULL) {
 		BIOerror(BIO_R_NO_PORT_SPECIFIED);
 		return (0);
+	}
+	if (str[0] == '\0') {
+		BIOerror(BIO_R_NO_PORT_SPECIFIED);
+		return (0);
+	}
+
+	if (str[0] >= '0' && str[0] <= '9') {
+		errno = 0;
+		port = strtoul(str, &end, 10);
+		if (errno == ERANGE || *end != '\0' || port > USHRT_MAX) {
+			BIOerror(BIO_R_INVALID_ARGUMENT);
+			ERR_asprintf_error_data("invalid numeric service='%s'", str);
+			return (0);
+		}
+
+		*port_ptr = (unsigned short)port;
+		return (1);
 	}
 
 	if ((error = getaddrinfo(NULL, str, &hints, &res)) != 0) {
 		BIOerror(BIO_R_INVALID_ARGUMENT);
 		ERR_asprintf_error_data("getaddrinfo: service='%s' : %s'", str,
 		    gai_strerror(error));
 		return (0);
 	}
 	*port_ptr = ntohs(((struct sockaddr_in *)(res->ai_addr))->sin_port);
 	freeaddrinfo(res);
