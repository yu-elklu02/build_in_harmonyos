+
+static int
+write_all(int fd, const unsigned char *buffer, size_t length)
+{
+	size_t offset = 0;
+
+	while (offset < length) {
+		ssize_t result = write(fd, buffer + offset, length - offset);
+
+		if (result > 0) {
+			offset += (size_t)result;
+			continue;
+		}
+		if (result < 0 && errno == EINTR)
+			continue;
+		return -1;
+	}
+	return 0;
+}
+
+static void
+print_buffer(const unsigned char *buffer, size_t length)
+{
+	while (length-- > 0)
+		printf("%02x", (unsigned int)*buffer++);
+}
+
+int
+main(void)
+{
+	unsigned char warmup[BUFFER_SIZE];
+	unsigned char parent[BUFFER_SIZE];
+	unsigned char child[BUFFER_SIZE];
+	int pipefd[2];
+	int status;
+	pid_t child_pid;
+
+	random_bytes(warmup, sizeof(warmup));
+	if (pipe(pipefd) == -1) {
+		perror("pipe");
+		return 1;
+	}
+
+	child_pid = fork();
+	if (child_pid == -1) {
+		perror("fork");
+		return 1;
+	}
+	if (child_pid == 0) {
+		close(pipefd[0]);
+		random_bytes(child, sizeof(child));
+		if (write_all(pipefd[1], child, sizeof(child)) == -1)
+			_exit(2);
+		close(pipefd[1]);
+		_exit(0);
+	}
+
+	close(pipefd[1]);
+	random_bytes(parent, sizeof(parent));
+	if (read_all(pipefd[0], child, sizeof(child)) == -1) {
+		fprintf(stderr, "failed to read child PRNG output\n");
+		return 1;
+	}
+	close(pipefd[0]);
+
+	if (waitpid(child_pid, &status, 0) != child_pid ||
+	    !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		fprintf(stderr, "child PRNG process failed\n");
+		return 1;
+	}
+
+	print_buffer(parent, sizeof(parent));
+	printf(" ");
+	print_buffer(child, sizeof(child));
+	printf("\n");
+
+	if (memcmp(parent, child, sizeof(parent)) == 0) {
+		fprintf(stderr,
+		    "forked PRNG streams matched with simulated PID reuse\n");
+		return 1;
+	}
+	return 0;
+}
