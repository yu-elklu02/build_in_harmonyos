diff --git a/dec265/CMakeLists.txt b/dec265/CMakeLists.txt
--- a/dec265/CMakeLists.txt
+++ b/dec265/CMakeLists.txt
@@ -1,6 +1,13 @@
 add_executable (dec265 dec265.cc)
 
 target_link_libraries (dec265 PRIVATE de265)
+# Explicitly link C++ standard library for static builds on libc++/musl systems
+# where the toolchain does not implicitly link the C++ runtime.
+if(HAVE_LIBCPP)
+  target_link_libraries(dec265 PRIVATE c++)
+else()
+  target_link_libraries(dec265 PRIVATE stdc++)
+endif()
 
 if(SDL2_FOUND)
   target_sources(dec265 PRIVATE sdl-display.cc)
