+#ifdef HMBS_OFFLINE_FIXTURE
+/* Offline fixture: read hardcoded Last.fm XML from files shipped with
+ * the recipe, so src/test.c runs without network or credentials. */
+static WebData *_hmbs_fixture_page(const char *url) {
+    WebData *w = (WebData*)malloc(sizeof(WebData));
+    if (!w) return NULL;
+    w->size = 0; w->page = NULL;
+    if (!url) return w;
+    const char *m = strstr(url, "method=");
+    const char *fname = NULL;
+    if (m) {
+        m += 7;
+        const char *amp = strchr(m, '&');
+        size_t mlen = amp ? (size_t)(amp - m) : strlen(m);
+        if (mlen >= 32) mlen = 31;
+        char method[32] = {0};
+        memcpy(method, m, mlen);
+        if (!strcmp(method, "artist.getinfo")) fname = "fixtures/artist_getinfo.xml";
+        else if (!strcmp(method, "album.getinfo")) fname = "fixtures/album_getinfo.xml";
+        else if (!strcmp(method, "album.search")) fname = "fixtures/album_search.xml";
+        else if (!strcmp(method, "track.getsimilar")) fname = "fixtures/track_getsimilar.xml";
+        else if (!strcmp(method, "user.getrecenttracks")) fname = "fixtures/user_getrecenttracks.xml";
+    } else {
+        char *blob = (char*)malloc(2048);
+        if (!blob) return w;
+        memset(blob, 'X', 2048);
+        w->page = blob; w->size = 2048;
+        return w;
+    }
+    if (!fname) { w->page = strdup("<lfm status=\"ok\"></lfm>"); if (w->page) w->size = strlen(w->page); return w; }
+    FILE *fp = fopen(fname, "rb");
+    if (!fp) { w->page = strdup("<lfm status=\"ok\"></lfm>"); if (w->page) w->size = strlen(w->page); return w; }
+    if (fseek(fp, 0, SEEK_END) != 0) { fclose(fp); return w; }
+    long sz = ftell(fp);
+    if (sz < 0) { fclose(fp); return w; }
+    if (fseek(fp, 0, SEEK_SET) != 0) { fclose(fp); return w; }
+    char *buf = (char*)malloc(sz + 1);
+    if (!buf) { fclose(fp); return w; }
+    size_t rd = fread(buf, 1, sz, fp); fclose(fp);
+    buf[rd] = 0; w->page = buf; w->size = rd;
+    return w;
+}
+#endif
+
