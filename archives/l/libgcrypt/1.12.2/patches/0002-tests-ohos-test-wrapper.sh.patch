--- /dev/null
+++ b/tests/ohos-test-wrapper.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Run generated shell test entries through an executable shell on HMDFS.
+set -eu
+
+test_name=${1##*/}
+case "$test_name" in
+  basic-disable-all-hwf|hashtest-6g|hashtest-256g)
+    exec "${CONFIG_SHELL:-/system/bin/sh}" "$@"
+    ;;
+  *)
+    exec "$@"
+    ;;
+esac
