--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,13 +71,30 @@
       set(_maxorder ${_cap})
     endif()
   endif()
 endforeach()
 if(_dep_used)
   message(DEPRECATION "DISABLE_*XC are deprecated; use -DMAXORDER=${_maxorder}")
   set(MAXORDER ${_maxorder})
 endif()
 message(STATUS "MAXORDER: ${MAXORDER}")
 add_compile_definitions(XC_MAXORDER=${MAXORDER})
+
+# Keep floating-point contraction off unless the builder asked otherwise. libxc
+# checks its functionals against stored references at full precision, and
+# several are ill-conditioned in the tail (e.g. mgga_x_2d_prhg07_prp10); a fused
+# multiply-add re-rounds a*b + c once and, amplified through those
+# cancellations, breaks the references -- and only on FMA hardware, costing
+# reproducibility. GCC's GNU dialect contracts by default and Clang contracts
+# even under -std=c99, so set it off explicitly for C sources (nvcc/hip control
+# fmad separately). A builder who sets -ffp-contract in CMAKE_C_FLAGS -- e.g.
+# the =fast CI canary -- is left alone.
+if(NOT CMAKE_C_FLAGS MATCHES "-ffp-contract=")
+  include(CheckCCompilerFlag)
+  check_c_compiler_flag("-ffp-contract=off" XC_HAVE_FFP_CONTRACT_OFF)
+  if(XC_HAVE_FFP_CONTRACT_OFF)
+    add_compile_options($<$<COMPILE_LANGUAGE:C>:-ffp-contract=off>)
+  endif()
+endif()
 option_with_print(DISABLE_FHC "Disable enforcement of Fermi hole curvature?" OFF)
 option_with_print(XC_CHECK_NUMERICS "Check functional outputs for NaN/Inf and (where supported) trap FPEs during evaluation" OFF)
 option_with_print(XC_PROFILING "Enable additional profiling code" OFF)
