 #include <time.h>
 #include <locale.h>
 #include <math.h>
-#include <glib.h>       // will use glist and regex
+
+#ifdef HAVE_G_REGEX_NEW
+#include <glib.h>
+#else
+/* 无 glib 时的最小 GList 替代实现（仅用于 sources 链表） */
+#include <stdlib.h>
+#include <string.h>
+typedef void (*GDestroyNotify)(void *);
+typedef struct _GList {
+    void *data;
+    struct _GList *next;
+} GList;
+static GList *g_list_append(GList *list, void *data) {
+    GList *node = (GList *)malloc(sizeof(GList));
+    if (node == NULL) return NULL;
+    node->data = data;
+    node->next = NULL;
+    if (list == NULL) return node;
+    GList *last = list;
+    while (last->next) last = last->next;
+    last->next = node;
+    return list;
+}
+static unsigned int g_list_length(GList *list) {
+    unsigned int n = 0;
+    while (list) { n++; list = list->next; }
+    return n;
+}
+static GList *g_list_next(GList *list) { return list ? list->next : NULL; }
+static void g_list_free_full(GList *list, void (*free_func)(void *)) {
+    while (list) {
+        GList *next = list->next;
+        if (free_func) free_func(list->data);
+        free(list);
+        list = next;
+    }
+}
+#endif
 
 
 
