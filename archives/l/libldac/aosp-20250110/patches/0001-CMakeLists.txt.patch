diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..3c688df
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,49 @@
+cmake_minimum_required(VERSION 3.16)
+project(libldac LANGUAGES C)
+
+include(GNUInstallDirs)
+
+add_library(ldacBT_enc
+    src/ldaclib.c
+    src/ldacBT.c
+)
+target_compile_features(ldacBT_enc PRIVATE c_std_99)
+target_compile_options(ldacBT_enc PRIVATE -Wall -Wextra)
+target_include_directories(ldacBT_enc
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/inc>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/src
+)
+set_target_properties(ldacBT_enc PROPERTIES
+    VERSION 2.0.2
+    SOVERSION 2
+)
+
+add_library(ldacBT_abr
+    abr/src/ldacBT_abr.c
+)
+target_compile_features(ldacBT_abr PRIVATE c_std_99)
+target_compile_options(ldacBT_abr PRIVATE -Wall -Wextra)
+target_include_directories(ldacBT_abr
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/abr/inc>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+target_link_libraries(ldacBT_abr PRIVATE ldacBT_enc)
+set_target_properties(ldacBT_abr PROPERTIES
+    VERSION 2.0.2
+    SOVERSION 2
+)
+
+install(TARGETS ldacBT_enc ldacBT_abr
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+install(FILES
+    inc/ldacBT.h
+    abr/inc/ldacBT_abr.h
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
