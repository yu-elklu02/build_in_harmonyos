--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -67,20 +67,35 @@
 if (WITH_GSSAPI)
     find_package(GSSAPI)
 endif (WITH_GSSAPI)
 
 if (WITH_NACL)
     find_package(NaCl)
     if (NOT NACL_FOUND)
         set(WITH_NACL OFF)
     endif (NOT NACL_FOUND)
 endif (WITH_NACL)
+
+# Create standard CMake target aliases for Conan-provided dependencies
+# Conan CMakeDeps generates lowercase targets (zlib::zlib, openssl::openssl)
+# but libssh uses standard CMake target names (ZLIB::ZLIB, OpenSSL::Crypto)
+if(TARGET zlib::zlib AND NOT TARGET ZLIB::ZLIB)
+    add_library(ZLIB::ZLIB ALIAS zlib::zlib)
+endif()
+if(TARGET openssl::openssl AND NOT TARGET OpenSSL::Crypto)
+    add_library(OpenSSL::Crypto ALIAS openssl::openssl)
+    # Conan config doesn't set OPENSSL_FOUND/OPENSSL_INCLUDE_DIR which
+    # ConfigureChecks.cmake needs for check_include_file(openssl/*.h)
+    set(OPENSSL_FOUND TRUE)
+    set(OPENSSL_INCLUDE_DIR "${openssl_INCLUDE_DIR}")
+    set(OPENSSL_VERSION "${openssl_VERSION_STRING}")
+endif()
 
 # Disable symbol versioning in non UNIX platforms
 if (UNIX)
     find_package(ABIMap 0.4.0)
 else (UNIX)
     set(WITH_SYMBOL_VERSIONING OFF)
 endif (UNIX)
 
 # config.h checks
 include(ConfigureChecks.cmake)
