+static int
+ffi_tramp_validate_mapped_fd (int fd)
+{
+  struct stat status;
+  unsigned char buffer[4096];
+  const unsigned char *mapped = tramp_globals.text;
+  size_t remaining = tramp_globals.map_size;
+  off_t position = (off_t) tramp_globals.offset;
+
+  if (fd == -1)
+    return -1;
+  if (fstat (fd, &status) != 0 || !S_ISREG (status.st_mode))
+    goto fail;
+
+  while (remaining > 0)
+    {
+      size_t chunk = remaining < sizeof (buffer) ? remaining : sizeof (buffer);
+      size_t consumed = 0;
+
+      while (consumed < chunk)
+        {
+          ssize_t count = pread (fd, buffer + consumed, chunk - consumed,
+                                 position + (off_t) consumed);
+          if (count <= 0)
+            goto fail;
+          consumed += (size_t) count;
+        }
+      if (memcmp (buffer, mapped, chunk) != 0)
+        goto fail;
+      mapped += chunk;
+      position += (off_t) chunk;
+      remaining -= chunk;
+    }
+
+  return fd;
+
+fail:
+  close (fd);
+  return -1;
+}
+
+static int
+ffi_tramp_open_mapped_path (const char *file, int open_flags)
+{
+  FILE *fp;
+  char line[PATH_MAX * 3];
+  char resolved[PATH_MAX];
+  static const char docs_prefix[] = "/files/Docs/";
+  static const size_t docs_layer_len = sizeof ("/files/Docs") - 1;
+  static const char files_prefix[] = "/files/";
+  int fd = -1;
+
+  fp = fopen ("/proc/self/mounts", "r");
+  if (fp == NULL)
+    return -1;
+
+  while (fgets (line, sizeof (line), fp) != NULL)
+    {
+      char *mount_source;
+      char *mount_target;
+      char *mount_type;
+      char *saveptr = NULL;
+      const char *suffix;
+      size_t file_len;
+      size_t source_len;
+      int length;
+
+      mount_source = strtok_r (line, " \t\n", &saveptr);
+      mount_target = strtok_r (NULL, " \t\n", &saveptr);
+      mount_type = strtok_r (NULL, " \t\n", &saveptr);
+      if (mount_source == NULL || mount_target == NULL || mount_type == NULL)
+        continue;
+      if (strcmp (mount_type, "hmdfs") != 0)
+        continue;
+
+      file_len = strlen (file);
+      source_len = strlen (mount_source);
+      if (source_len > file_len
+          || strncmp (file, mount_source, source_len) != 0
+          || (source_len != file_len && file[source_len] != '/'))
+        continue;
+
+      suffix = file + source_len;
+      length = snprintf (resolved, sizeof (resolved), "%s%s",
+                         mount_target, suffix);
+      if (length >= 0 && (size_t) length < sizeof (resolved))
+        fd = ffi_tramp_validate_mapped_fd (open (resolved, open_flags));
+      if (fd != -1)
+        break;
+
+      if (strncmp (suffix, docs_prefix, sizeof (docs_prefix) - 1) == 0)
+        {
+          length = snprintf (resolved, sizeof (resolved), "%s%s",
+                             mount_target, suffix + docs_layer_len);
+          if (length >= 0 && (size_t) length < sizeof (resolved))
+            fd = ffi_tramp_validate_mapped_fd (open (resolved, open_flags));
+          if (fd != -1)
+            break;
+        }
+
+      if (strncmp (suffix, files_prefix, sizeof (files_prefix) - 1) == 0)
+        {
+          length = snprintf (resolved, sizeof (resolved), "%s%s",
+                             mount_target, suffix + sizeof (files_prefix) - 2);
+          if (length >= 0 && (size_t) length < sizeof (resolved))
+            fd = ffi_tramp_validate_mapped_fd (open (resolved, open_flags));
+          if (fd != -1)
+            break;
+        }
+    }
+
+  fclose (fp);
+  return fd;
+}
+
