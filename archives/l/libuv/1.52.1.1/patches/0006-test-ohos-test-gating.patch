diff -ruN a/test/test-pipe-set-fchmod.c b/test/test-pipe-set-fchmod.c
--- a/test/test-pipe-set-fchmod.c	2026-09-05 04:33:56.982770312 +0800
+++ b/test/test-pipe-set-fchmod.c	2026-09-05 04:33:57.022773124 +0800
@@ -43,10 +43,18 @@
   /* No easy way to test if this works, we will only make sure that the call is
    * successful. */
   r = uv_pipe_chmod(&pipe_handle, UV_READABLE);
+#if defined(__OHOS__)
+  /* fchmod on a bound AF_UNIX socket is unsupported (ENOENT) on OpenHarmony. */
+  if (r == UV_EPERM || r == UV_ENOENT) {
+    MAKE_VALGRIND_HAPPY(loop);
+    RETURN_SKIP("fchmod on bound pipes is unsupported on OpenHarmony");
+  }
+#else
   if (r == UV_EPERM) {
     MAKE_VALGRIND_HAPPY(loop);
     RETURN_SKIP("Insufficient privileges to alter pipe fmode");
   }
+#endif
   ASSERT_OK(r);
 #ifndef _WIN32
   memset(&stat_buf, 0, sizeof(stat_buf));
