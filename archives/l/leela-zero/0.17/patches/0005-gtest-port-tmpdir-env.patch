diff --git a/gtest/googletest/src/gtest-port.cc b/gtest/googletest/src/gtest-port.cc
--- a/gtest/googletest/src/gtest-port.cc
+++ b/gtest/googletest/src/gtest-port.cc
@@ -1059,5 +1059,5 @@
-#if defined(GTEST_OS_LINUX_ANDROID) || defined(GTEST_OS_IOS)
+#if defined(GTEST_OS_LINUX_ANDROID) || defined(GTEST_OS_IOS) || defined(GTEST_OS_LINUX)
 bool EndsWithPathSeparator(const std::string& path) {
   return !path.empty() && path.back() == GTEST_PATH_SEP_[0];
 }
 #endif
@@ -1129,6 +1129,11 @@
     if (!EndsWithPathSeparator(name_template))
       name_template.push_back(GTEST_PATH_SEP_[0]);
