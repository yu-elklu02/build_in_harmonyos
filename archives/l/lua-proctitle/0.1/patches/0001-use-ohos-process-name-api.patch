+#include <lua.h>
+#include <lauxlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/prctl.h>
+
+static int
+set_proctitle(lua_State *L)
+{
+    const char *title = luaL_checkstring(L, 1);
+
+    if (prctl(PR_SET_NAME, title, 0, 0, 0) != 0) {
+        return luaL_error(L, "prctl(PR_SET_NAME): %s", strerror(errno));
+    }
+
+    return 0;
+}
