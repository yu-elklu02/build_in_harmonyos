--- a/Makefile.am
+++ b/Makefile.am
@@ -1,89 +1,52 @@
+# Makefile.am — abiword-plugin-clarisworks 3.0.8 (OHOS 平台适配)
+#
+# minimal 构建方案：仅构建 clarisworks 导入插件（不构建 AbiWord 核心）。
+# 与上游 plugins/clarisworks/Makefile.am 对齐：-module -avoid-version 可加载插件模块，
+# 安装到 AbiWord 插件目录 $(libdir)/abiword-3.0/plugins。
+# AbiWord 运行时 API 与 libgsf GsfInput API 由 compat/ shim 提供。
+AUTOMAKE_OPTIONS = foreign subdir-objects
 
-ACLOCAL_AMFLAGS = -I .
+plugindir = $(libdir)/abiword-3.0/plugins
+plugin_LTLIBRARIES = libabiword-plugin-clarisworks.la
 
-DIST_SUBDIRS = goffice-bits goffice-bits2 src plugins po user icons tools
+libabiword_plugin_clarisworks_la_SOURCES = \
+	plugins/clarisworks/xp/ie_imp_ClarisWorks.cpp \
+	plugins/clarisworks/xp/ie_imp_ClarisWorks.h \
+	compat/abiword_shim.cpp \
+	compat/glib.h \
+	compat/ut_types.h \
+	compat/ut_assert.h \
+	compat/ut_debugmsg.h \
+	compat/ut_string.h \
+	compat/ut_growbuf.h \
+	compat/ie_types.h \
+	compat/ie_imp.h \
+	compat/pd_Document.h \
+	compat/xap_Module.h \
+	compat/gsf/gsf-input.h
 
-if WITH_GOFFICE_BUILTIN
+libabiword_plugin_clarisworks_la_CPPFLAGS = \
+	-I$(top_srcdir)/compat \
+	-I$(top_srcdir)/plugins/clarisworks/xp
 
-if TOOLKIT_GTK2
-SUBDIRS = goffice-bits2
-else
-SUBDIRS = goffice-bits
-endif
+libabiword_plugin_clarisworks_la_LDFLAGS = \
+	-avoid-version \
+	-module \
+	-no-undefined
 
-else 
-SUBDIRS =
-endif
-SUBDIRS += src plugins po user icons
+# ---- 测试 (make check) ----
+# 端到端功能测试：dlopen 插件 → abi_plugin_register → sniffer 识别 CWK 头 →
+# 真实 ClarisWorks 5 样例文件 (tests/sample.cwk) → importFile → 校验提取文本
+check_PROGRAMS = test_clarisworks_plugin
 
-if TOOLKIT_GTK_ALL
+test_clarisworks_plugin_SOURCES = tests/test_clarisworks_plugin.cpp
+test_clarisworks_plugin_CPPFLAGS = -I$(top_srcdir)/compat
+# link against the plugin module itself so the test shares the single
+# compat shim copy embedded in the module (deterministic symbol binding)
+test_clarisworks_plugin_LDADD = libabiword-plugin-clarisworks.la -ldl
 
-if !EMBEDDED_HILDON
-desktopdir = $(datadir)/applications
-desktop_DATA = abiword.desktop
-endif
+TESTS = test_clarisworks_plugin
+TESTS_ENVIRONMENT = \
+	PLUGIN_SO=$(abs_builddir)/.libs/libabiword-plugin-clarisworks.so
 
-mimedir = @ABIWORD_DATADIR@/mime-info
-mime_DATA = abiword.keys
-
-appdatadir = $(datarootdir)/appdata
-appdata_DATA = abiword.appdata.xml
-
-pkgconfigdir = $(libdir)/pkgconfig
-pkgconfig_DATA = abiword-$(ABIWORD_SERIES).pc
-
-dist_man1_MANS = abiword.1
-
-endif
-
-if TOOLKIT_GTK
-# we disable introspection for distcheck as it fails because of
-# installation needing sudo
-DISTCHECK_CONFIGURE_FLAGS = \
-	--enable-introspection=no \
-	--with-gir-dir=\$${datadir}/gir-1.0 \
-	--with-typelib-dir=\$${libdir}/girepository-1.0
-endif
-
-EXTRA_DIST = \
-	AUTHORS \
-	BiDiReadme.txt \
-	BUILD.TXT \
-	COPYING	\
-	COPYRIGHT.TXT \
-	INSTALL \
-	NEWS \
-	README \
-	ChangeLog \
-	abiword.desktop \
-	$(appdata_DATA) \
-	abiword.keys \
-	abiword.png \
-	libabiword.pc.in \
-	compile-resource \
-	lt-compile-resource
-
-DISTCLEANFILES = \
-	abiword-$(ABIWORD_SERIES).pc \
-	plugin-builtin.m4 \
-	plugin-configure.m4 \
-	plugin-list.m4 \
-	plugin-makefiles.m4
-
-abiword-$(ABIWORD_SERIES).pc: libabiword.pc
-	cp $< $@
-
-if TOOLKIT_WIN
-zip:
-	rm -rf $(PACKAGE)-$(VERSION)
-	make DESTDIR=$(abs_builddir)/zip install
-	mv zip$(prefix) $(PACKAGE)-$(VERSION)
-	cd $(PACKAGE)-$(VERSION)
-	zip -r $(PACKAGE)-$(VERSION).zip $(PACKAGE)-$(VERSION) -x \*.a \*.la
-	rm -rf $(PACKAGE)-$(VERSION) ./zip
-endif
-
-# needed to make sure we don't include .svn directories.
-dist-hook:
-	rm -rf `find $(distdir) -name .svn`
-
+CLEANFILES = test_clarisworks_plugin
