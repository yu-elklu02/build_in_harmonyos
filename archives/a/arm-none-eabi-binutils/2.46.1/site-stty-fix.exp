# OHOS DejaGNU site config — arm-none-eabi-binutils 2.46.1 (Path C)
#
# Root cause: expect 5.45.4 spawn() internally runs /bin/stty for terminal
# init. /bin/stty does not exist on OHOS (read-only /system/bin, erofs), so
# every spawn emits "sh: /bin/stty: inaccessible or not found" into captured
# output. DejaGNU local_exec collects it as exec_output, binutils_assemble_flags
# misjudges assembly as failed, objcopy_test deletes tmpdir/bintest.o
# (objcopy.exp:58), and the strip test hits UNRESOLVED.
#
# Fix: wrap expect's spawn to always pass -nottyinit (skip terminal init).
# Eliminates the noise at its source. No test output filtering, no upstream
# test changes, no DejaGNU source change, no impact on production tools.
if {[info procs _orig_spawn] eq ""} {
    rename spawn _orig_spawn
    proc spawn {args} {
        if {[lsearch -exact $args -nottyinit] == -1} {
            set args [linsert $args 0 -nottyinit]
        }
        return [uplevel 1 _orig_spawn $args]
    }
    puts "SITE-FIX: spawn wrapped with -nottyinit"
}
