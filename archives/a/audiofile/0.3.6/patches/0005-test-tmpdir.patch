diff --git a/test/TestUtilities.cpp b/test/TestUtilities.cpp
index ed25244bd..21403d9d3 100644
--- a/test/TestUtilities.cpp
+++ b/test/TestUtilities.cpp
@@ -30,7 +30,11 @@
 
 bool createTemporaryFile(const std::string &prefix, std::string *path)
 {
-	*path = "/tmp/" + prefix + "-XXXXXX";
+	static const std::string tmpDir = [] {
+		const char *t = ::getenv("TMPDIR");
+		return t && *t ? std::string(t) : std::string(".");
+	}();
+	*path = tmpDir + "/" + prefix + "-XXXXXX";
 	int fd = ::mkstemp(const_cast<char *>(path->c_str()));
 	if (fd < 0)
 		return false;
@@ -40,7 +44,9 @@ bool createTemporaryFile(const std::string &prefix, std::string *path)
 
 bool createTemporaryFile(const char *prefix, char *path)
 {
-	snprintf(path, PATH_MAX, "/tmp/%s-XXXXXX", prefix);
+	const char *tmpDir = ::getenv("TMPDIR");
+	if (!tmpDir || !*tmpDir) tmpDir = ".";
+	snprintf(path, PATH_MAX, "%s/%s-XXXXXX", tmpDir, prefix);
 	int fd = ::mkstemp(path);
 	if (fd < 0)
 		return false;
