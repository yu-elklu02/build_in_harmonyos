--- a/build-aux/config.guess	2022-01-09 00:00:00.000000000 +0000
+++ b/build-aux/config.guess	2026-08-04 00:00:00.000000000 +0000
@@ -969,6 +969,26 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64)
+		MACHINE=aarch64
+		;;
+	    armv7*|armv8*)
+		MACHINE=arm
+		;;
+	    x86_64|amd64)
+		MACHINE=x86_64
+		;;
+	    i?86)
+		MACHINE=i686
+		;;
+	    *)
+		MACHINE="$UNAME_MACHINE"
+		;;
+	esac
+	GUESS=${MACHINE}-unknown-linux-ohos
+	;;
     aarch64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
