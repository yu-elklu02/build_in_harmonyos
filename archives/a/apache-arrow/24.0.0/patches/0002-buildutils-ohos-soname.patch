--- a/cpp/cmake_modules/BuildUtils.cmake
+++ b/cpp/cmake_modules/BuildUtils.cmake
@@ -385,3 +385,13 @@ function(ADD_ARROW_LIB LIB_NAME)
+    if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+      # CMake 4.1.x doesn't ship a Platform/HarmonyOS module yet, so VERSION and
+      # SOVERSION don't emit an ELF DT_SONAME. Without a SONAME, ld.lld records
+      # the build-tree path (for example ../../release/libarrow.so) in dependent
+      # libraries' DT_NEEDED entries, and installed packages fail at runtime.
+      set(_arrow_ohos_soname
+          "${CMAKE_SHARED_LIBRARY_PREFIX}${LIB_NAME}${CMAKE_SHARED_LIBRARY_SUFFIX}")
+      set(ARG_SHARED_LINK_FLAGS "${ARG_SHARED_LINK_FLAGS} -Wl,-soname,${_arrow_ohos_soname}")
+    endif()
+
     set_target_properties(${LIB_NAME}_shared
                           PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${OUTPUT_PATH}"
                                      RUNTIME_OUTPUT_DIRECTORY "${OUTPUT_PATH}"
