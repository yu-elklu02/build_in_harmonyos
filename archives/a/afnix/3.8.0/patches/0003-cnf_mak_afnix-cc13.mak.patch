--- a/cnf/mak/afnix-cc13.mak	2023-01-14 06:44:45.000000000 +0800
+++ b/cnf/mak/afnix-cc13.mak	2026-08-06 15:30:09.745134532 +0800
@@ -29,7 +29,7 @@
 AR              = ar
 RANLIB		= ranlib
 STDEVFLAGS      =
-STDCCFLAGS      = -Wall -Werror -Wno-overloaded-virtual -fno-builtin -std=c++17
+STDCCFLAGS      = -Wall -Werror -Wno-overloaded-virtual -Wno-inconsistent-missing-override -fno-builtin -std=c++17
 STACCFLAGS	=
 DYNCCFLAGS	= -fPIC
 PLTCCFLAGS      = 
@@ -57,6 +57,15 @@
 ifeq ($(OPENMP),yes)
 PLTCCFLAGS     += -fopenmp
 endif
+# Feature detection via build flags (R8: no platform macros in source).
+# HarmonyOS lacks pthread_cancel (E127) and ncurses/terminfo; both are
+# detected here and exposed to source as AFNIX_NO_CANCEL / AFNIX_NO_TERM.
+ifneq ($(OHOS_FEATURE_NO_CANCEL),)
+PLTCCFLAGS     += -DAFNIX_NO_CANCEL
+endif
+ifneq ($(OHOS_FEATURE_NO_TERM),)
+PLTCCFLAGS     += -DAFNIX_NO_TERM
+endif
 endif
 
 # adjust for freebsd platform
