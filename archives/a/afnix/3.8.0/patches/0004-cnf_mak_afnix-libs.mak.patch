+STDLIBS  = $(EXTSTDLIBS) -ldl -lm
+else
 STDLIBS  = $(EXTSTDLIBS) -ltinfo -ldl -lm
+endif
 STDLIBS += $(AFXCPPLIBS)
 EXESLIB  =
 endif
