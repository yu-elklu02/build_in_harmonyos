From: gyccc <gyccc@gitcode.com>
Date: Sat, 08 Aug 2026 00:00:00 +0800
Subject: [PATCH] libairspy/src/CMakeLists: guard install targets with NOT WIN32

CMake does not set the UNIX variable for HarmonyOS (OHOS is not
recognised), so the `if(${UNIX})` branch is skipped and libairspy
plus headers are never installed. Replace `if(${UNIX})` with
`if(NOT WIN32)` so the install targets run on HarmonyOS the same way
they do on Linux, and keep the Win32 path intact.

This is a portability change; no upstream API or logic is altered.

--- a/libairspy/src/CMakeLists.txt
+++ b/libairspy/src/CMakeLists.txt
@@ -77,7 +77,7 @@ if( ${CYGWIN} )
   SET(WIN32 ON)
 endif( ${CYGWIN} )
 
-if( ${UNIX} )
+if( NOT WIN32 )
    install(TARGETS airspy
            LIBRARY DESTINATION lib${LIB_SUFFIX}
            COMPONENT sharedlibs
@@ -90,7 +90,7 @@ if( ${UNIX} )
            DESTINATION include/${PROJECT_NAME}
            COMPONENT headers
            )
-endif( ${UNIX} )
+endif( NOT WIN32 )
 
 if( ${WIN32} )
    install(TARGETS airspy
