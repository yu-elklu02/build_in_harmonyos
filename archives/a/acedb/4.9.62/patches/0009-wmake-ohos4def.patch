--- /dev/null	2026-08-08 08:43:12.443486563 +0800
+++ b/wmake/OHOS_4_DEF	2026-08-08 13:16:31.530601250 +0800
@@ -0,0 +1,45 @@
+# $Id: OHOS_4_DEF — HarmonyOS PC (aarch64, clang 15) adaptation of LINUX_4_DEF
+#################################################################
+############### acedb: R.Durbin and J.Thierry-Mieg ##############
+############### OHOS adaptation by AtomCode 2026     ##############
+#################################################################
+########### This file is included by wmake/truemake #############
+######  Edit this file to adapt the ACeDB to a new machine ######
+#####   following the explanations given in wmake/truemake  #####
+#################################################################
+
+# OHOS 适配复用 LINUX 的 POSIX 构建路径，NAME=LINUX 使 truemake 的
+# -D$(NAME) 注入 -DLINUX（而非平台宏 -DOHOS），符合 R8（不引入平台条件编译宏）
+NAME = LINUX
+
+# Compiler used to build 3rd party libraries
+LIBCC = clang
+
+COPT = -g -O2
+
+LOPT = -g
+
+GLIB_VER = glib-2.0
+GLIB_LIBS = `../w3rdparty/libs-config $(PKGPATH) $(GLIB_VER)` -lm -lcurses -lreadline
+
+# OHOS has no GTK2; use glib only for the command-line tools.
+LIBS = `../w3rdparty/libs-config $(PKGPATH) $(GLIB_VER)` -lm -lcurses -lreadline
+
+COMPILER = clang $(COPT) -Wall -DLINUX -DACEDB_NO_GTK -DACEDB4 `../w3rdparty/include-config $(PKGPATH) $(GLIB_VER)`
+
+LINKER = clang $(LOPT)
+
+### flex to emulate the standard 'lex' program
+LEX_LIBS = -lfl
+LEX = flex
+LEX_OPTIONS = -l
+
+### bison with flag -y if yacc doesn't exist
+YACC = yacc
+YACC_OPTIONS =
+
+RPCGEN_FLAGS = -b -I
+
+AR_COMMAND = ar
+AR_OPTIONS = cru
+RANLIB_NEEDED = true
