--- a/wtools/aceSetReleaseDir	2016-10-19 18:16:00.000000000 +0800
+++ b/wtools/aceSetReleaseDir	2026-08-08 00:29:52.309279843 +0800
@@ -1,4 +1,4 @@
-#!/usr/bin/perl
+#!/data/service/hnp/bin/perl
 #
 # Perl script to insert the name of a release directory into the aceversion.c
 # source file.
@@ -38,8 +38,17 @@
 
 
 # Now check out the input file to see if it's OK...
-(-f $input_file && -r $input_file && -w $input_file) || die $msghdr . "file specified is not a file, or is not readable/writeable by this program.\n" ;
+if (!(-f $input_file && -r $input_file)) {
+    die $msghdr . "file specified is not a file, or is not readable by this program.\n" ;
+}
 
+# OHOS hmdfs: chmod u+w 静默成功但权限位不生效，-w 检查会失败。
+# release dir 仅是构建元数据（记录构建目录），不可写时跳过更新而非中断构建。
+if (!(-w $input_file)) {
+    print $msghdr . "WARNING: $input_file not writable, skipping release dir update.\n" ;
+    exit 0 ;
+}
+
 # Open the input file...
 open(INFILE, $input_file) || die $msghdr . "could not open $input_file\n" ;
 
