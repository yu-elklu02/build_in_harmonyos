{
  "build_commands": [],
  "test_commands": [
    "perl -c adduser",
    "perl -c deluser"
  ],
  "install_commands": [
    "cp adduser ${bindir}/",
    "cp deluser ${bindir}/",
    "cp addgroup ${bindir}/",
    "cp delgroup ${bindir}/",
    "cp AdduserCommon.pm ${libdir}/perl5/adduser/",
    "cp AdduserCreateHomedir.pm ${libdir}/perl5/adduser/",
    "cp AdduserLogging.pm ${libdir}/perl5/adduser/",
    "cp AdduserRetvalues.pm ${libdir}/perl5/adduser/",
    "cp AdduserStatefile.pm ${libdir}/perl5/adduser/",
    "cp adduser.conf ${sysconfdir}/",
    "cp deluser.conf ${sysconfdir}/"
  ],
  "env": {
    "PERL5LIB": "${libdir}/perl5/adduser"
  }
}
