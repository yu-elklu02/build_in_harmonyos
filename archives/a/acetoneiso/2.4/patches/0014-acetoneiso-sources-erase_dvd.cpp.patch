+    /* 运行时检测：扫描 /dev 下的光驱设备节点（HAL/dbus 在目标平台不可用） */
+    QDir devDir("/dev");
+    QStringList filters;
+    filters << "sr*" << "cdrom*" << "cd*";
+    QStringList devs = devDir.entryList(filters, QDir::System | QDir::Files);
+    QIcon icon_optical_drive( ":/images/drive-optical.png" );
+    int success = -1;
+    if (devs.isEmpty()) {
+        QMessageBox::warning(this, "AcetoneISO::warning", tr("No CD/DVD device found.\nIf you think this is a bug please report it."));
+        disable_buttons();
+        devices_combo->addItem( tr("No CD/DVD device found") );
+        media_available();
+        return;
+    }
+    for (int cc = 0; cc < devs.count(); ++cc) {
+        QString devPath = "/dev/" + devs.at(cc);
+        /* 写入能力过滤：xorriso 查询设备支持的 profile（替代 HAL storage.cdrom.dvdrw 属性）。
+           擦除仅支持可擦写介质：DVD±RW / DVD+RW DL，排除一次性写入的 DVD±R/DL */
+        QProcess cap_probe;
+        cap_probe.start("xorriso", QStringList() << "-outdev" << devPath << "-list_profiles");
+        bool cap_ok = cap_probe.waitForFinished(5000);
+        QString cap_out = QString::fromUtf8(cap_probe.readAllStandardOutput());
+        QStringList dvd_erasable_profiles;
+        dvd_erasable_profiles << "dvd-rw" << "dvd+rw" << "dvd+rw dl";
+        bool cap_erasable = false;
+        for (const QString &p : dvd_erasable_profiles) {
+            if (cap_out.contains(p, Qt::CaseInsensitive)) {
+                cap_erasable = true;
+                break;
+            }
+        }
+        if (!cap_ok || !cap_erasable) {
+            continue; /* 只读光驱、仅支持一次性写入（DVD±R）或不支持擦除，过滤 */
+        }
+        success = success + 1;
+        id_device.insert(success, devPath);
+        device_path.insert(success, devPath);
+        devices_combo->insertItem(success, icon_optical_drive, " " + devPath);
+    }
+    media_available();
+    if (devices_combo->count() < 1) {
+        disable_buttons();
+        QMessageBox::warning(this, "AcetoneISO::warning", tr("No CD/DVD device found capable of writing to DVD-RW discs.\nIf you think this is a bug please report it."));
+        return;
+    }
+    loaded_success = true;
+    timer = new QTimer(this);
+    connect(timer, SIGNAL(timeout()), this, SLOT(media_available()));
+    timer->start(2000);
+    connect( devices_combo, SIGNAL(currentIndexChanged(int) ), this , SLOT( combo_changed(int) ) );
