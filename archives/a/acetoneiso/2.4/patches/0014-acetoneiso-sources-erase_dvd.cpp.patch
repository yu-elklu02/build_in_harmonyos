+    /* 运行时检测：校验当前光驱设备节点是否存在 */
+    QString plusminus = QString::fromUtf8("\xC2\xB1"); //0xC2 0xB1
+    int current_index = devices_combo->currentIndex();
+    if (current_index < 0 || current_index >= id_device.size()) {
+        label_info->setText(tr("Insert a DVD") + plusminus + "RW " + tr("disc."));
+        start->setEnabled(false);
+        return;
+    }
+    QString id = id_device[current_index];
+    if (!QFile::exists(id)) {
+        label_info->setText(tr("Insert a DVD") + plusminus + "RW " + tr("disc."));
+        start->setEnabled(false);
+        return;
+    }
+    /* 运行时介质检测：通过 xorriso 查询介质类型（替代 HAL/dbus，非静默假设） */
+    QProcess probe;
+    probe.start("xorriso", QStringList() << "-indev" << id << "-list_profiles");
+    bool probe_ok = probe.waitForFinished(5000);
+    QString probe_out = QString::fromUtf8(probe.readAllStandardOutput());
+    if (!probe_ok || (!probe_out.contains("dvd-rw", Qt::CaseInsensitive) && !probe_out.contains("dvd+rw", Qt::CaseInsensitive))) {
+        if (!probe_ok) {
+            label_info->setText(tr("Media detection unavailable (xorriso missing). Erasing disabled."));
+        } else {
+            label_info->setText(tr("The inserted disc isn't a DVD") + plusminus + "RW. " + tr("Erasing disabled."));
+        }
+        start->setEnabled(false);
+        return;
+    }
+    /* 介质检测通过：根据实际介质类型设置擦除状态标签并启用擦除按钮 */
+    if (probe_out.contains("dvd+rw", Qt::CaseInsensitive)) {
+        discotipo = "DVD+RW";
+    } else {
+        discotipo = "DVD-RW";
+    }
+    /* 设备子类型擦除能力校验：xorriso -outdev 查询设备支持的 profile，
+       确保设备支持该介质子类型擦除（仅 DVD±RW 可擦写，避免静默失败） */
+    QProcess cap_probe;
+    cap_probe.start("xorriso", QStringList() << "-outdev" << id << "-list_profiles");
+    bool cap_ok = cap_probe.waitForFinished(5000);
+    QString cap_out = QString::fromUtf8(cap_probe.readAllStandardOutput());
