+/* getpass replacement for HarmonyOS (no termios available) */
+static char *getpass(const char *prompt)
+{
+    static char buf[256];
+    fputs(prompt, stderr);
+    fflush(stderr);
+    if (fgets(buf, sizeof(buf), stdin) == NULL)
+        return NULL;
+    buf[strcspn(buf, "\n")] = '\0';
+    fputc('\n', stderr);
+    return buf;
+}
