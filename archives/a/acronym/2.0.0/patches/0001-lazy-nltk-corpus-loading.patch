Subject: [PATCH] acronym: make NLTK corpus loading lazy instead of import-time download

Upstream acronym.py downloads the NLTK word/brown/gutenberg corpora at
module import time when they are missing. In network-restricted
environments (e.g. the OHOS build/worker container) that download hangs
or fails, blocking every consumer that merely imports the package.
Move corpus loading into an explicit helper invoked from find_acronyms()
and main(), so importing the module never touches the network.

---
 acronym/acronym.py | 25 +++++++++++++------------
 1 file changed, 11 insertions(+), 14 deletions(-)

diff --git a/acronym/acronym.py b/acronym/acronym.py
--- a/acronym/acronym.py
+++ b/acronym/acronym.py
@@ -6,21 +6,6 @@
 # import enchant
 import nltk
 from .scoring import score_acronym
-try:
-    nltk.corpus.words.ensure_loaded()
-    nltk.corpus.brown.ensure_loaded()
-    nltk.corpus.gutenberg.ensure_loaded()
-except LookupError:
-    print('Initial downloading of word corpus')
-    import ssl
-    try:
-        _create_unverified_https_context = ssl._create_unverified_context
-    except AttributeError:
-        pass
-    else:
-        ssl._create_default_https_context = _create_unverified_https_context
-    for d in ['words', 'brown', 'gutenberg']:
-        nltk.download(d)
 import argparse
 import textwrap
 import sys
@@ -97,6 +82,22 @@
             return [start + offset] + sub_result + [end + offset]
 
 
+def ensure_corpus(corpus):
+    """Ensure the requested NLTK corpus is available.
+
+    Loads the corpus on demand; if the corpus data is missing and a
+    download is required, raises a clear error instead of silently
+    downloading at import time (network-restricted platforms).
+    """
+    try:
+        corpus.ensure_loaded()
+    except LookupError:
+        raise RuntimeError(
+            "NLTK corpus not available; run nltk.download() "
+            "before using acronym on this platform"
+        )
+
+
 def find_acronyms(s, corpus, min_length=5, max_length=7):
     """
     Returns a dictionary of English acronyms from input string s
@@ -119,6 +120,8 @@
             and each value is the input string with acronym-letters capitalized
     """
 
+    ensure_corpus(corpus)
+
     # Initialize dictionary and results
     results = dict()
     scores = dict()
@@ -179,6 +182,8 @@
         corpus = nltk.corpus.brown
     else:
         corpus = nltk.corpus.gutenberg
+
+    ensure_corpus(corpus)
     
     results = find_acronyms(args.name, corpus,
                             min_length=args.min_length,
