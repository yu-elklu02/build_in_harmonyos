--- a/build/config.guess
+++ b/build/config.guess
@@ -157,6 +157,8 @@
 	cat <<-EOF > "$dummy.c"
 	#if defined(__ANDROID__)
 	LIBC=android
+	#elif defined(__OHOS__)
+		LIBC=ohos
 	#else
 	#include <features.h>
 	#if defined(__UCLIBC__)
@@ -983,6 +985,31 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    aarch64:HarmonyOS:*:*)
+	# OHOS: uname -s returns HarmonyOS; hardcode LIBC=ohos to avoid
+	# mktemp/dummy.c issues on read-only /tmp.
+	LIBC=ohos
+	CPU=$UNAME_MACHINE
+	LIBCABI=$LIBC
+	if test "$CC_FOR_BUILD" != no_compiler_found; then
+	    ABI=64
+	    sed 's/^	    //' << EOF > "$dummy.c"
+	    #ifdef __ARM_EABI__
+	    #ifdef __ARM_PCS_VFP
+	    ABI=eabihf
+	    #else
+	    ABI=eabi
+	    #endif
+	    #endif
+EOF
+	    cc_set_abi=`$CC_FOR_BUILD -E "$dummy.c" 2>/dev/null | grep '^ABI' | sed 's, ,,g'`
+	    eval "$cc_set_abi"
+	    case $ABI in
+		eabi | eabihf) CPU=armv8l; LIBCABI=$LIBC$ABI ;;
+	    esac
+	fi
+	GUESS=$CPU-unknown-linux-$LIBCABI
+	;;
     aarch64:Linux:*:*)
 	set_cc_for_build
 	CPU=$UNAME_MACHINE
