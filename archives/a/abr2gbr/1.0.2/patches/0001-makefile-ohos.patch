+CC ?= gcc
+CDEBUG = $(DEBUG) -g
+CCFLAGS = -Wall -Wstrict-prototypes -Wmissing-declarations -I. $(CDEBUG)
+CLIBS =
+SOURCES = $(wildcard *.c)
+
+OBJDIR = .obj
+BINDIR = /usr/bin
+
+# Honor environment overrides for cross-compilation (Conan).
+# GLIB_CFLAGS / GLIB_LIBS may be passed in; otherwise fall back to pkg-config.
+# Let pkg-config diagnostics surface: if glib-2.0 is missing, its error
+# (e.g. "Package glib-2.0 was not found") is shown instead of a silent empty value.
+GLIB_CFLAGS ?= $(shell pkg-config --cflags glib-2.0)
+GLIB_LIBS ?= $(shell pkg-config --libs glib-2.0)
+
+BIN = abr2gbr
+DESTS = $(addprefix $(OBJDIR)/, $(SOURCES:.c=.o))
+DEPEND = $(OBJDIR)/.depend
+
+CFLAGS ?= $(CCFLAGS) $(GLIB_CFLAGS)
+LDFLAGS ?=
+LIBS = $(CLIBS) $(GLIB_LIBS)
 
 
 default: all
@@ -38,23 +50,24 @@
