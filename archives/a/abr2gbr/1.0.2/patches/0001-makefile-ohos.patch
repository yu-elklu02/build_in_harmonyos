-		ln -s $(OBJDIR)/$(BIN) .; \
-		ln -s $(OBJDIR)/$(BIN) jbr2gbr; \
-	fi
+	$(CC) -o $@ $(LDFLAGS) $(CFLAGS) $(LIBS) $(DESTS)
 
 dep depend:
 	$(CC) $(CFLAGS) -M $(SOURCES) > $(DEPEND)
 
 install: $(BIN)
-	strip $(BIN)
+	@echo "Install handled by Conan package step"
 
 
