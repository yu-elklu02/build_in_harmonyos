-all: $(OBJDIR) $(OBJDIR)/$(BIN)
+all: $(OBJDIR) $(OBJDIR)/$(BIN) $(BIN)
 
-$(OBJDIR)/%.o: %.c
+$(OBJDIR)/%.o: %.c | $(OBJDIR)
 	$(CC) -o $@ $(CFLAGS) -c $<
 
+abr2gbr: $(OBJDIR)/$(BIN)
+	cp -f $(OBJDIR)/$(BIN) abr2gbr
+	ln -sf $(OBJDIR)/$(BIN) jbr2gbr
+
+
 $(OBJDIR)/$(BIN): $(DESTS)
