--- a/config/LibraryDefine.cmake	2024-09-05 06:40:21
+++ b/config/LibraryDefine.cmake	2026-07-15 17:58:34
@@ -29,9 +29,15 @@
   # For example, it's fine for an Imath built with C++14 to be called from
   # an app that is compiled with C++11; Imath needn't force the app to
   # also use C++14.
-  target_compile_features(${objlib}
-                          PRIVATE cxx_std_${IMATH_CXX_STANDARD}
-                          INTERFACE cxx_std_11 )
+  # NOTE: target_compile_features is unusable on OHOS because CMake 4.x
+  # fails to identify the OHOS clang (compiler id "unknown"), leaving
+  # CMAKE_CXX_COMPILE_FEATURES empty. Set the C++ standard via the target
+  # property instead. INTERFACE_STANDARD is used so the consumer C++ standard
+  # requirement (formerly INTERFACE cxx_std_11) is still propagated.
+  set_target_properties(${objlib} PROPERTIES
+                        CXX_STANDARD ${IMATH_CXX_STANDARD}
+                        CXX_STANDARD_REQUIRED ON
+                        INTERFACE_CXX_STANDARD 11)
 
   if(IMATH_CURLIB_PRIV_EXPORT AND BUILD_SHARED_LIBS)
     target_compile_definitions(${objlib} PRIVATE ${IMATH_CURLIB_PRIV_EXPORT})
