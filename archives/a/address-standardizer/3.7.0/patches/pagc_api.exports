# pagc_api.exports — linker export list for the standalone PAGC shared library
# (address_standardizer_pagc.so), vendored into the recipe's patches/ dir.
#
# ── Why this file exists (cycle 31→32) ──────────────────────────────────────
# test_package dlopen's address_standardizer_pagc.so with RTLD_NOW|RTLD_LOCAL
# then dlsym's the PAGC core API symbols (std_init / lex_init /
# std_standardize_one / lex_add_entry / std_use_lex / std_ready_standardizer
# / stdaddr_free / std_free / lex_free — see test_address_standardizer.c).
# dlsym requires the symbol to be STV_DEFAULT (in the .so's dynamic symbol
# table).  STV_HIDDEN symbols are absent from the dynamic table and dlsym
# returns NULL with ``Symbol not found'' — exactly the cycle 29-30 real-
# machine fingerprint:
#   ``dlsym failed for core API: do_dlsym failed: Symbol not found:
#    std_standardize_one, version: null so=.../address_standardizer_pagc.so''
#
# The upstream PAGC API declarations in pagc_std_api.h are PLAIN extern (no
# visibility/dllexport/__attribute__ annotation — verified by grep).  Their
# ELF visibility therefore depends ENTIRELY on the compile/link flags the
# standalone clang invocation passes:
#   * cycle 28-29 passed ``-fvisibility=hidden'' → all extern symbols default
#     to STV_HIDDEN with no attribute to override → dlsym NULL (cycle 29-30).
#   * cycle 30 dropped ``-fvisibility=hidden'' so clang's ELF default
#     visibility ``default'' (= exported) applies → symbols exported.
#     But the cycle 30 fingerprint was IDENTICAL byte-for-byte to cycle 29,
#     meaning the deletion either did not reach the re-link or some other
#     flag/source still hid the symbols — fragile, flag-dependent.
#
# cycle 31 (fundamentally different from cycle 30): force-export the PAGC API
# symbols via a LINKER EXPORT LIST, independent of ANY compile/link visibility
# flag.  The design is robust because it operates at LINK time on the final
# symbol table, AFTER the compile step's visibility attributes have been
# applied — so it does not matter whether ``-fvisibility=hidden'' is passed,
# leaked from PGXS CFLAGS, or absent: the export list forces these specific
# symbols visible regardless.
#
# ── cycle 32: linker flag correction ───────────────────────────────────────
# cycle 31 passed the export list via ``-Wl,--exported_symbols_list=<file>''.
# The real-machine OHOS ld.lld (clang-15 / lld 15) REJECTED this flag with
# ``ld.lld: error: unknown argument '--exported_symbols_list=...''', causing
# the standalone PAGC link to fail before any symbol-export logic ran.
# ``--exported_symbols_list'' is in fact the macOS ld64 spelling; lld's
# per-symbol equivalent is ``--export-dynamic-symbol=<sym>'' (one flag per
# symbol), which lld has supported since 9.x.
#
# cycle 32 keeps cycle 31's vendored export-list file (this file) but, in
# build(), READS it and emits one ``-Wl,--export-dynamic-symbol=<sym>'' flag
# per listed symbol — instead of passing the file path to a list flag the
# real-machine lld does not understand.  The export-list file is thus now a
# *build-time symbol manifest* (parsed by conanfile.py), not a raw ld input.
# Symbol-export semantics are identical to cycle 31's intent: each listed
# symbol is forced to STV_DEFAULT at LINK time, overriding any STV_HIDDEN the
# compile step baked into the object files, independent of compile-time
# visibility flags.
#
# The list enumerates the FULL upstream PAGC API surface declared in
# pagc_std_api.h (verified by grep: every extern decl in that header, no
# static/visibility attribute).  We force-export ALL of them — not just the
# ones test_package dlsym's — so the .so's dynamic symbol surface matches the
# documented PAGC API (a consumer dlsym'ing any documented symbol succeeds),
# and so the test is robust against future test widening (adding a dlsym of
# std_standardize / std_use_gaz / rules_init should not re-trigger this
# cycle).  Force-exporting extra symbols is harmless: lld only exports
# symbols that are actually DEFINED in the .so; a listed symbol that is not
# defined is silently ignored by lld (no link error).
#
# The file format is one bare C symbol name per line; blank lines and
# ``#''-prefixed lines are comments.  We list the bare C symbol names
# (no leading underscore — lld matches the source symbol name, not the
# platform-mangled form; on aarch64-linux ELF there is no leading-underscore
# convention for C symbols anyway).
#
# Symbol names mirror pagc_std_api.h's extern decls exactly:
#   LEXICON *lex_init(ERR_PARAM *err_p);
#   int lex_add_entry(LEXICON *, int, char *, char *, SYMB);
#   void lex_free(LEXICON *);
#   RULES *rules_init(ERR_PARAM *err_p);
#   int rules_add_rule(RULES *, int, int *);
#   int rules_add_rule_from_str(RULES *, char *);
#   int rules_ready(RULES *);
#   void rules_free(RULES *);
#   STANDARDIZER *std_init(void);
#   int std_use_lex(STANDARDIZER *, LEXICON *);
#   int std_use_gaz(STANDARDIZER *, LEXICON *);
#   int std_use_rules(STANDARDIZER *, RULES *);
#   int std_ready_standardizer(STANDARDIZER *);
#   void std_free(STANDARDIZER *);
#   STDADDR *std_standardize_one(STANDARDIZER *, char *, int);
#   STDADDR *std_standardize_mm(STANDARDIZER *, char *, char *, int);
#   STDADDR *std_standardize(STANDARDIZER *, char *, const char *,
#                            const char *, const char *, const char *, int);
#   void stdaddr_free(STDADDR *);
#   void print_stdaddr(STDADDR *);

lex_init
lex_add_entry
lex_free
rules_init
rules_add_rule
rules_add_rule_from_str
rules_ready
rules_free
std_init
std_use_lex
std_use_gaz
std_use_rules
std_ready_standardizer
std_free
std_standardize_one
std_standardize_mm
std_standardize
stdaddr_free
print_stdaddr
