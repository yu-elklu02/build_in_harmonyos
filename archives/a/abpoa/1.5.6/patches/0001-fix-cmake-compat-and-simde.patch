--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.2)
+cmake_minimum_required(VERSION 3.5)
 project(abpoa LANGUAGES C VERSION 3.0.0)
 
 include(GNUInstallDirs)
@@ -10,9 +10,21 @@
 
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall")
 
-set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=native") # SIMD
+# SIMD: aarch64/OHOS build — -march=armv8-a+simd, -D__AVX2__ and the SIMDE
+# macros let SIMDE emulate the AVX2 path (required to avoid "Error in
+# cg_backtrack" at runtime). Guard the ARM-specific flags: on other
+# architectures fall back to the upstream -march=native instead of pretending
+# AVX2 is available, and do NOT define the SIMDE macros there (they would
+# shadow native SSE/AVX with software emulation on x86_64).
+# ABPOA_ARM64 is passed from the conan recipe (settings.arch) because the OHOS
+# cross toolchain leaves CMAKE_SYSTEM_PROCESSOR empty.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64" OR ABPOA_ARM64)
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=armv8-a+simd -D__AVX2__ -DUSE_SIMDE -DSIMDE_ENABLE_NATIVE_ALIASES")
+else()
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=native")
+endif()
 
-# build abPOA as a static library by default
+# Build abPOA as a static library by default
 set(BUILD_SHARED_LIBS OFF CACHE BOOL "Build all libraries as shared")
 SET(CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}")
 
@@ -39,6 +51,8 @@
 
 target_include_directories(abpoa PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+    $<INSTALL_INTERFACE:include>
     $<INSTALL_INTERFACE:src>)
 
 
