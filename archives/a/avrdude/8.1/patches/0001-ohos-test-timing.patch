--- a/tools/test-avrdude
+++ b/tools/test-avrdude
@@ -186,11 +186,17 @@ emulated=0                      # Is programmer dryrun or dryboot, ie, programming is emulated?
 # Execute args as command, set $elapsed and return exit value of command; don't call in a subshell
 execute () {
+  local start ret
+
   if [[ $list_only -eq 1 ]]; then
     echo "\$ ${command[@]}" | sed "s/ -l [^ ]* / /" | tr -s " "
     return 0;
   fi
   [[ $emulated -eq 0 && $elapsed != -1 ]] && sleep "$delay"
-  # These shenanigans keep stdout, stderr and the exit code of the command
-  { read elapsed < <({ time { eval "$@"; echo $? >"$status"; } 2>&4 4>&-; } 4>&2 2>&1 >&3 3>&-); } 3>&1
-  return $(cat "$status")
+  # OHOS Bash cannot preserve fd 3 through the nested process substitution
+  # used upstream for timing. SECONDS retains command output and exit status.
+  start=$SECONDS
+  eval "$@"
+  ret=$?
+  elapsed=$((SECONDS - start))
+  return "$ret"
 }
