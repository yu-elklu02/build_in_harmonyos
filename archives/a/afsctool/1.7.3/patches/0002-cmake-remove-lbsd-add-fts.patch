@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.1 FATAL_ERROR)
+cmake_minimum_required(VERSION 3.5 FATAL_ERROR)
 
 project(afsctool VERSION 1.7.2)
 set(afsctool_FULL_VERSION "${afsctool_VERSION_MAJOR}.${afsctool_VERSION_MINOR}.${afsctool_VERSION_PATCH}.${afsctool_VERSION_TWEAK}")
@@ -47,6 +47,22 @@ include(CheckIncludeFile)
 
 include(GetGitRevisionDescription)
 
+# musl (OHOS) has no <fts.h>; musl-fts provides fts.h + libfts
+find_path(FTS_INCLUDE_DIR fts.h)
+find_library(FTS_LIBRARY NAMES fts)
+if(FTS_INCLUDE_DIR)
+    include_directories(${FTS_INCLUDE_DIR})
+endif()
+
+# POSIX feature detection: pthread_cancel absent on musl (OHOS) —
+# msemul uses pthread_kill(SIGTERM) fallback when not available (R8:
+# no platform conditional macros in source; detect at configure time)
+include(CheckFunctionExists)
+check_function_exists(pthread_cancel HAVE_PTHREAD_CANCEL)
+if(HAVE_PTHREAD_CANCEL)
+    add_definitions(-DHAVE_PTHREAD_CANCEL)
+endif()
+
 set(CMAKE_CXX_STANDARD 11)
 
 find_package(ZLIBP 1.2.8 REQUIRED)
