diff --git a/configure b/configure
new file mode 100644
--- /dev/null
+++ b/configure
@@ -0,0 +1,26 @@
+#!/bin/sh
+# Minimal configure script for Makefile-only projects
+# This script just accepts --prefix and exits successfully
+# The actual build is handled by Makefile
+
+prefix=/usr/local
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            prefix="${1#--prefix=}"
+            ;;
+        *)
+            # Ignore other options
+            ;;
+    esac
+    shift
+done
+
+echo "Configuring alterMIME 0.3.10"
+echo "  Prefix: $prefix"
+echo "  Build system: Makefile (no configure needed)"
+echo ""
+echo "Configuration complete. Run 'make' to build."
+
+exit 0
