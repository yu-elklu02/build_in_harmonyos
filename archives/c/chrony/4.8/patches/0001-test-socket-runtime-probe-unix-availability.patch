+   * when the kernel refuses to create the socket. */
+  int probe_fd = SCK_OpenUnixDatagramSocket(NULL, "probe", 0);
+  int unix_dgram_available = (probe_fd >= 0);
+  if (unix_dgram_available)
+    SCK_CloseSocket(probe_fd);
+  if (!unix_dgram_available)
+    return;
