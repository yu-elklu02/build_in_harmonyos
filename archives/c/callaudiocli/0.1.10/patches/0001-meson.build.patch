--- a/meson.build
+++ b/meson.build
@@ -101,13 +101,25 @@
 config_data.set_quoted('DATADIR', full_datadir)
 config_data.set_quoted('SYSCONFDIR', full_sysconfdir)
 
 config_h = configure_file (
     output: 'config.h',
     configuration: config_data
 )
 
 subdir('data')
 subdir('libcallaudio')
-subdir('src')
+
+# callaudiod daemon requires PulseAudio and ALSA.
+# On platforms where these are unavailable (e.g. HarmonyOS),
+# skip the daemon but still build the CLI tool and library.
+pulseaudio_dep = dependency('libpulse', required: false)
+pulseaudio_mainloop_dep = dependency('libpulse-mainloop-glib', required: false)
+alsa_dep = dependency('alsa', required: false)
+if pulseaudio_dep.found() and pulseaudio_mainloop_dep.found() and alsa_dep.found()
+  subdir('src')
+else
+  warning('PulseAudio or ALSA not found, skipping callaudiod daemon. callaudiocli and libcallaudio will still be built.')
+endif
+
 subdir('tools')
 subdir('doc')
