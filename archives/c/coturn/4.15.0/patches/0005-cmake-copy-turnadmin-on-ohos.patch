--- a/src/apps/relay/CMakeLists.txt
+++ b/src/apps/relay/CMakeLists.txt
@@ -220,5 +220,16 @@ if(WIN32)
     DESTINATION "${CMAKE_INSTALL_BINDIR}"
             COMPONENT Runtime)
+elseif(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    # The OpenHarmony user storage used by native builds does not permit
+    # symbolic-link creation. Preserve the turnadmin compatibility command as
+    # a regular copy with the same name.
+    add_custom_target(turnadmin ALL
+        COMMAND
+            ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:${PROJECT_NAME}> $<TARGET_FILE_DIR:${PROJECT_NAME}>/turnadmin
+        DEPENDS ${PROJECT_NAME})
+    INSTALL(FILES $<TARGET_FILE_DIR:${PROJECT_NAME}>/turnadmin
+    DESTINATION "${CMAKE_INSTALL_BINDIR}"
+            COMPONENT Runtime)
 else()
     add_custom_target(turnadmin ALL
         COMMAND
