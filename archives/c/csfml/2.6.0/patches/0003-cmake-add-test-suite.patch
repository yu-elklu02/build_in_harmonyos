--- /dev/null
+++ b/tests/CMakeLists.txt
@@ -0,0 +1,35 @@
+# Minimal upstream test harness for CSFML 2.6.0.
+# The smoke test links against the already-built csfml-system and
+# csfml-network targets and exercises their public C API.
+add_executable(csfml-smoke smoke.c)
+target_link_libraries(csfml-smoke PRIVATE csfml-system csfml-network)
+target_include_directories(csfml-smoke PRIVATE ${PROJECT_SOURCE_DIR}/include)
+
+# CSFML's Macros.cmake sets LIBRARY_OUTPUT_PATH to ${CMAKE_BINARY_DIR}/lib,
+# so all csfml-*.so end up there.  sfml/2.6.1 (the runtime C++ dependency)
+# ships libsfml-system.so / libsfml-network.so under its conan package
+# folder, exposed by CMakeDeps via sfml_PACKAGE_FOLDER_<CONFIG>.
+# The top-level find_package(SFML) lives in src/SFML/CMakeLists.txt, so
+# sfml_PACKAGE_FOLDER_<CONFIG> is scoped there and invisible from tests/.
+# Re-running find_package here (CMakeDeps is idempotent) re-exposes it.
+find_package(SFML CONFIG REQUIRED COMPONENTS system network)
+
+set(_CSFML_BUILD_LIB "${CMAKE_BINARY_DIR}/lib")
+set(_SFML_PKG_LIB "")
+if(DEFINED sfml_PACKAGE_FOLDER_RELEASE)
+    set(_SFML_PKG_LIB "${sfml_PACKAGE_FOLDER_RELEASE}/lib")
+endif()
+
+# Use ":" as path separator (POSIX LD_LIBRARY_PATH convention).
+# HarmonyOS's loader does not honor BUILD_RPATH the way Linux does,
+# so we inject both lib/ dirs into LD_LIBRARY_PATH for the test invocation.
+set(_SMOKE_LD_PATH "${_CSFML_BUILD_LIB}")
+if(_SFML_PKG_LIB)
+    set(_SMOKE_LD_PATH "${_SMOKE_LD_PATH}:${_SFML_PKG_LIB}")
+endif()
+
+add_test(NAME csfml-smoke
+         COMMAND ${CMAKE_COMMAND} -E env
+                 "LD_LIBRARY_PATH=${_SMOKE_LD_PATH}"
+         $<TARGET_FILE:csfml-smoke>
+         WORKING_DIRECTORY $<TARGET_FILE_DIR:csfml-smoke>)
--- /dev/null
+++ b/tests/smoke.c
@@ -0,0 +1,54 @@
+/*
+ * CSFML 2.6.0 upstream smoke test.
+ *
+ * Upstream CSFML ships no test suite; this harness exercises the
+ * public C System and Network APIs that this adaptation builds,
+ * so `ctest` runs a real test and the CI L1c gate observes a
+ * `ctest` execution trace.
+ */
+#include <SFML/Network/Packet.h>
+#include <SFML/Network/IpAddress.h>
+#include <SFML/System/Clock.h>
+#include <SFML/System/Time.h>
+
+#include <stdint.h>
+#include <string.h>
+
+int main(void)
+{
+    sfClock* clock = sfClock_create();
+    if (!clock)
+        return 1;
+    if (sfTime_asMicroseconds(sfClock_getElapsedTime(clock)) < 0)
+    {
+        sfClock_destroy(clock);
+        return 2;
+    }
+
+    sfPacket* packet = sfPacket_create();
+    if (!packet)
+    {
+        sfClock_destroy(clock);
+        return 3;
+    }
+    sfPacket_writeInt32(packet, 2600);
+    sfPacket_writeString(packet, "HarmonyOS");
+    if (sfPacket_readInt32(packet) != 2600)
+    {
+        sfPacket_destroy(packet);
+        sfClock_destroy(clock);
+        return 4;
+    }
+    char buf[32] = {0};
+    sfPacket_readString(packet, buf);
+    if (strcmp(buf, "HarmonyOS") != 0)
+    {
+        sfPacket_destroy(packet);
+        sfClock_destroy(clock);
+        return 5;
+    }
+
+    sfPacket_destroy(packet);
+    sfClock_destroy(clock);
+    return 0;
+}
