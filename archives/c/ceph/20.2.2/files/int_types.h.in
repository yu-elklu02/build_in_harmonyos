#ifndef CEPH_INTTYPES_H
#define CEPH_INTTYPES_H

#include <stdint.h>

/*
 * Ceph's full build obtains these aliases from generated configuration or
 * Linux UAPI headers. The standalone CRUSH core only requires their fixed
 * widths, so keep the public ABI while avoiding a platform-header dependency.
 */
typedef uint8_t __u8;
typedef int8_t __s8;
typedef uint16_t __u16;
typedef int16_t __s16;
typedef uint32_t __u32;
typedef int32_t __s32;
typedef uint64_t __u64;
typedef int64_t __s64;

#endif
