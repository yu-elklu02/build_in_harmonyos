--- a/connect.c
+++ b/connect.c
@@ -667,10 +667,26 @@
     GetUserName( buf, &size);
     return buf;
 #else  /* not _WIN32 */
+    static char buf[32];
     struct passwd *pw = getpwuid(getuid());
-    if ( pw == NULL )
-        fatal("getpwuid() failed for uid: %d\n", getuid());
-    return pw->pw_name;
+    char *name;
+
+    if ( pw != NULL )
+        return pw->pw_name;
+
+    /* No passwd entry for this uid. This is normal on HarmonyOS/OHOS, where
+       accounts are not listed in /etc/passwd, so aborting here would make
+       connect unusable. The name is only used as the SOCKS/proxy user name,
+       so fall back to the environment and finally to the uid itself. */
+    name = getenv("USER");
+    if ( name == NULL )
+        name = getenv("LOGNAME");
+    if ( (name != NULL) && (*name != '\0') )
+        return name;
+
+    snprintf(buf, sizeof(buf), "%d", (int)getuid());
+    debug("getpwuid() failed for uid %d, using it as the user name\n", getuid());
+    return buf;
 #endif /* not _WIN32 */
 }
 
@@ -791,16 +807,24 @@
 {
 #if !defined(_WIN32) || defined(cygwin)
     char *name;
+    char *home;
     struct passwd *pw;
 #endif
 
     read_parameter_file_1(PARAMETER_FILE);
 #if !defined(_WIN32) || defined(cygwin)
+    /* The per-user rc file is optional. On HarmonyOS/OHOS the uid usually has
+       no /etc/passwd entry, so take the home directory from $HOME instead of
+       aborting, and simply skip the file when there is no home directory. */
     pw = getpwuid(getuid());
-    if ( pw == NULL )
-        fatal("getpwuid() failed for uid: %d\n", getuid());
-    name = xmalloc(strlen(pw->pw_dir) + strlen(PARAMETER_DOTFILE) + 2);
-    strcpy(name, pw->pw_dir);
+    home = (pw != NULL) ? pw->pw_dir : getenv("HOME");
+    if ( (home == NULL) || (*home == '\0') ) {
+        debug("no home directory for uid %d, skipping ~/%s\n",
+              getuid(), PARAMETER_DOTFILE);
+        return;
+    }
+    name = xmalloc(strlen(home) + strlen(PARAMETER_DOTFILE) + 2);
+    strcpy(name, home);
     strcat(name, "/" PARAMETER_DOTFILE);
     read_parameter_file_1(name);
     free(name);
