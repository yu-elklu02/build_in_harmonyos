--- /dev/null
+++ meson.build
@@ -0,0 +1,102 @@
+# Meson build configuration for Carburetor
+# GTK frontend for Tractor (Tor proxy manager)
+# Adapted for OpenHarmony/aarch64 platform
+
+project(
+  'carburetor',
+  version: '4.5.1',
+  meson_version: '>= 0.59.0',
+)
+
+# Find Python interpreter
+python = import('python').find_installation('python3')
+
+# Python module installation - using files() for cross-directory references
+pydir = python.get_path('purelib')
+
+carburetor_py_sources = files(
+  'src/carburetor/__init__.py',
+  'src/carburetor/actions.py',
+  'src/carburetor/carburetor.py',
+  'src/carburetor/config.py',
+  'src/carburetor/handler.py',
+  'src/carburetor/ui.py',
+)
+
+install_data(
+  carburetor_py_sources,
+  install_dir: pydir / 'carburetor',
+)
+
+# Install gresource file
+install_data(
+  files('src/carburetor/res.gresource'),
+  install_dir: pydir / 'carburetor',
+)
+
+# Install locale .mo files
+locale_langs = [
+  'de', 'el', 'es', 'fa', 'fi', 'fr', 'hi', 'hr',
+  'it', 'ja', 'nb_NO', 'nl', 'pl', 'pt', 'pt_BR',
+  'ru', 'sv', 'tr', 'zh_Hans',
+]
+
+foreach lang : locale_langs
+  install_data(
+    files('src/carburetor/locales' / lang / 'LC_MESSAGES' / 'carburetor.mo'),
+    install_dir: pydir / 'carburetor' / 'locales' / lang / 'LC_MESSAGES',
+  )
+endforeach
+
+# Install desktop entry file
+install_data(
+  files('data/io.frama.tractor.carburetor.desktop'),
+  install_dir: get_option('datadir') / 'applications',
+)
+
+# Install man page
+install_data(
+  files('data/carburetor.1'),
+  install_dir: get_option('mandir') / 'man1',
+)
+
+# Install metainfo file
+install_data(
+  files('data/metainfo/io.frama.tractor.carburetor.metainfo.xml'),
+  install_dir: get_option('datadir') / 'metainfo',
+)
+
+# Install icons - scalable
+install_data(
+  files('data/icons/scalable/apps/io.frama.tractor.carburetor.svg'),
+  install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps',
+)
+
+# Install icons - symbolic
+install_data(
+  files('data/icons/symbolic/apps/io.frama.tractor.carburetor-symbolic.svg'),
+  install_dir: get_option('datadir') / 'icons/hicolor/symbolic/apps',
+)
+
+# Install emote icons
+install_data(
+  files(
+    'data/icons/256x256/emotes/orbidead.png',
+    'data/icons/256x256/emotes/orbioff.png',
+    'data/icons/256x256/emotes/orbion.png',
+    'data/icons/256x256/emotes/orbistarting.png',
+  ),
+  install_dir: get_option('datadir') / 'icons/hicolor/256x256/emotes',
+)
+
+# Install carburetor.doap
+install_data(
+  files('carburetor.doap'),
+  install_dir: get_option('datadir') / 'carburetor',
+)
+
+# Install entry point script
+install_data(
+  files('bin/carburetor'),
+  install_dir: get_option('bindir'),
+)
