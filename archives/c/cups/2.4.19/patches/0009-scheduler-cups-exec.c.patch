--- a/scheduler/cups-exec.c
+++ b/scheduler/cups-exec.c
@@ -180,6 +180,69 @@

   execv(argv[i + 1], argv + i + 2);

+#ifdef CUPS_SHELL_SCRIPT_FALLBACK
+  if (errno == EACCES)
+  {
+    int		exec_errno = errno,	/* Original exec error */
+		script_fd;		/* Script file descriptor */
+    char	script_header[256];	/* Script header */
+    ssize_t	header_bytes;		/* Bytes read from script */
+
+    if ((script_fd = open(argv[i + 1], O_RDONLY)) >= 0)
+    {
+      header_bytes = read(script_fd, script_header,
+			  sizeof(script_header) - 1);
+      close(script_fd);
+
+      if (header_bytes > 0)
+      {
+	script_header[header_bytes] = '\0';
+
+	if ((header_bytes >= 10 &&
+	     !strncmp(script_header, "#!/bin/sh", 9) &&
+	     (script_header[9] == '\r' || script_header[9] == '\n')) ||
+	    (header_bytes > (ssize_t)(strlen(CUPS_SHELL_SCRIPT_FALLBACK) + 2) &&
+	     !strncmp(script_header, "#!" CUPS_SHELL_SCRIPT_FALLBACK,
+	              strlen(CUPS_SHELL_SCRIPT_FALLBACK) + 2) &&
+	     (script_header[strlen(CUPS_SHELL_SCRIPT_FALLBACK) + 2] == '\r' ||
+	      script_header[strlen(CUPS_SHELL_SCRIPT_FALLBACK) + 2] == '\n')))
+	{
+	  char		**fallback_argv,	/* Shell argument vector */
+			*program = argv[i + 1];	/* Script path */
+	  size_t	argument,		/* Current argument */
+			num_arguments = 0;	/* Original argument count */
+
+	 /*
+	  * cups-exec receives the program path followed by argv[0], argv[1],
+	  * and later arguments. A shebang execution replaces the caller's
+	  * argv[0] with the script path, so preserve argv[1] and later here.
+	  */
+
+	  while (argv[i + 2 + num_arguments])
+	    num_arguments ++;
+
+	  if ((fallback_argv = calloc(num_arguments + 2,
+				      sizeof(char *))) != NULL)
+	  {
+	    fallback_argv[0] = CUPS_SHELL_SCRIPT_FALLBACK;
+	    fallback_argv[1] = program;
+	    for (argument = 1; argument < num_arguments; argument ++)
+	      fallback_argv[argument + 1] = argv[i + 2 + argument];
+
+	    execv(fallback_argv[0], fallback_argv);
+	    exec_errno = errno;
+	    free(fallback_argv);
+	  }
+	  else
+	    exec_errno = ENOMEM;
+	}
+      }
+    }
+
+    errno = exec_errno;
+  }
+#endif /* CUPS_SHELL_SCRIPT_FALLBACK */
+
  /*
   * If we get here, execv() failed...
   */
