--- a/config-scripts/cups-common.m4
+++ b/config-scripts/cups-common.m4
@@ -135,6 +135,16 @@
 AC_CHECK_HEADER([sys/param.h], AC_DEFINE([HAVE_SYS_PARAM_H], [1], [Have <sys/param.h> header?]))
 AC_CHECK_HEADER([sys/ucred.h], AC_DEFINE([HAVE_SYS_UCRED_H], [1], [Have <sys/ucred.h> header?]))

+dnl Check optional POSIX interfaces used by libcups and cupsd.
+AC_CHECK_FUNCS([symlink getspnam endspent])
+
+dnl Some filesystems reject direct execution of otherwise valid shell scripts.
+AC_ARG_WITH([shell-script-fallback], AS_HELP_STRING([--with-shell-script-fallback=PATH], [retry POSIX shell scripts through PATH after EACCES]))
+AS_CASE([$with_shell_script_fallback],
+    [""|no], [],
+    [/*], [AC_DEFINE_UNQUOTED([CUPS_SHELL_SCRIPT_FALLBACK], ["$with_shell_script_fallback"], [POSIX shell used to retry scripts after EACCES.])],
+    [AC_MSG_ERROR([--with-shell-script-fallback requires an absolute path])])
+
 dnl Checks for iconv.h and iconv_open
 AC_CHECK_HEADER([iconv.h], [
     SAVELIBS="$LIBS"
