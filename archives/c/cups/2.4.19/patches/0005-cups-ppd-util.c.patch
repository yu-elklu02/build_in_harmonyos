+static int	cups_make_local_ppd(const char *source, const char *target);


 /*
+ * 'cups_make_local_ppd()' - Create a caller-owned local PPD file.
+ */
+
+static int				/* O - 0 on success, -1 on failure */
+cups_make_local_ppd(
+    const char *source,			/* I - Source PPD file */
+    const char *target)			/* I - Target PPD file */
+{
+#ifdef HAVE_SYMLINK
+  return (symlink(source, target));
+#else
+  char		buffer[8192],		/* Copy buffer */
+		*bufptr;		/* Pointer into buffer */
+  int		source_fd,		/* Source file descriptor */
+		target_fd,		/* Target file descriptor */
+		saved_errno;		/* Saved error value */
+  ssize_t	bytes,			/* Bytes read */
+		written;		/* Bytes written */
+
+
+  if ((source_fd = open(source, O_RDONLY)) < 0)
+    return (-1);
+
+  if ((target_fd = open(target, O_WRONLY | O_CREAT | O_EXCL, 0600)) < 0)
+  {
+    saved_errno = errno;
+    close(source_fd);
+    errno = saved_errno;
+    return (-1);
+  }
+
+  while ((bytes = read(source_fd, buffer, sizeof(buffer))) != 0)
+  {
+    if (bytes < 0)
+    {
+      if (errno == EINTR)
+        continue;
+
+      goto copy_error;
+    }
+
+    bufptr = buffer;
+    while (bytes > 0)
+    {
+      if ((written = write(target_fd, bufptr, (size_t)bytes)) < 0)
+      {
+        if (errno == EINTR)
+          continue;
+
+        goto copy_error;
+      }
+
+      if (!written)
+      {
+        errno = EIO;
+        goto copy_error;
+      }
+
+      bufptr += written;
+      bytes -= written;
+    }
+  }
+
+  if (close(target_fd))
+  {
+    target_fd = -1;
+    goto copy_error;
+  }
+
+  close(source_fd);
+  return (0);
+
+copy_error:
+  saved_errno = errno;
+  if (target_fd >= 0)
+    close(target_fd);
+  close(source_fd);
+  unlink(target);
+  errno = saved_errno;
+  return (-1);
+#endif /* HAVE_SYMLINK */
+}
+#endif /* !_WIN32 */
+
