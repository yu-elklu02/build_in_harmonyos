+	fi
+
+	dest=
+	for argument in "$@"; do
+		dest="$argument"
+	done
+
+	while test "$#" -gt 1; do
+		source_path="$1"
+		shift
+
+		if test -d "$dest"; then
+			final_path="$dest/`basename "$source_path"`"
+		else
+			final_path="$dest"
+		fi
+
+		case "$source_path" in
+			/*)
+				resolved_path="$source_path"
+				;;
+			*)
+				resolved_path="`dirname "$final_path"`/$source_path"
+				;;
+		esac
+
+		if test -d "$resolved_path"; then
+			cp -Rp "$resolved_path" "$final_path" || return 1
+		else
+			cp -p "$resolved_path" "$final_path" || return 1
+		fi
+	done
+}
 
