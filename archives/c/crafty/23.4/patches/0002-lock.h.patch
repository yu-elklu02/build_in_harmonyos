+#    elif defined(__aarch64__)
+/* HarmonyOS PC / aarch64: no x86 asm constraints (&q), use GCC/clang
+ * atomic exchange builtins instead. Same semantics as the x86 path:
+ * atomic swap 1 into *lock, spin until we get back 0 (unlocked). */
+static void __inline__ LockAtomic(volatile int *lock) {
+  while (__sync_lock_test_and_set(lock, 1) != 0) {
+    while (*lock) {
+      __sync_synchronize();
+    }
+  }
+}
+static void __inline__ UnlockAtomic(volatile int *lock) {
+  __sync_lock_release(lock);
+}
