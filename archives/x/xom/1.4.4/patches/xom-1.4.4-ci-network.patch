+package nu.xom.tests;
+
+import java.io.IOException;
+import java.net.SocketTimeoutException;
+import java.util.regex.Pattern;
+
+import nu.xom.ParsingException;
+
+/**
+ * <p>
+ * Utility methods for CI-specific test handling, particularly for network-dependent tests.
+ * </p>
+ * 
+ * @author Elliotte Rusty Harold
+ * @version 1.4.0
+ *
+ */
+class CITestUtil {
+
+    // Prevent instantiation
+    private CITestUtil() {}
+    
+    /**
+     * Helper method to check if we're running in a CI environment.
+     * Network-dependent tests can use this to skip execution in CI
+     * where network connectivity may be unreliable.
+     * 
+     * @return true if running in CI, false otherwise
+     */
+    static boolean isRunningInCI() {
+        String ci = System.getenv("CI");
+        String githubActions = System.getenv("GITHUB_ACTIONS");
+        String hmbsInstall = System.getenv("HMBS_INSTALL");
+        String ciPackages = System.getenv("CI_PACKAGES");
+        String ciRepoRoot = System.getenv("CI_REPO_ROOT");
+        return "true".equalsIgnoreCase(ci)
+            || "true".equalsIgnoreCase(githubActions)
+            || hmbsInstall != null
+            || ciPackages != null
+            || ciRepoRoot != null;
+    }
+    
+    /**
+     * Helper method to check if an exception is network-related.
+     * Checks the exception chain for UnknownHostException, ConnectException,
+     * SocketTimeoutException, or SocketException.
+     * 
+     * @param ex the exception to check
+     * @return true if the exception is network-related, false otherwise
+     */
+    static boolean isNetworkException(IOException ex) {
+        Throwable cause = ex;
+        while (cause != null) {
+            if (cause instanceof java.net.UnknownHostException ||
+                cause instanceof java.net.ConnectException ||
+                cause instanceof java.net.SocketException ||
+                cause instanceof SocketTimeoutException ||
+                isTransientHttpFailure(cause)) {
+                return true;
+            }
+            cause = cause.getCause();
+        }
+        return false;
+    }
+
+    /**
+     * Pattern matching the bare IOException message raised by Sun/Oracle
+     * HttpURLConnection.getInputStream0 when a remote host returns
+     * HTTP 4xx (e.g. 429 Too Many Requests) or 5xx. These are the
+     * transient remote-server failures upstream's shouldIgnore guard
+     * was intended to tolerate.
+     */
+    private static final Pattern HTTP_RESPONSE_CODE =
+        Pattern.compile(
+            "Server returned HTTP response code: (4\\d{2}|5\\d{2})"
+        );
+
+    /**
+     * Recognise the bare IOException raised by Sun/Oracle
+     * HttpURLConnection.getInputStream0 when a remote host returns
+     * HTTP 4xx (e.g. 429 Too Many Requests) or 5xx.
+     */
+    private static boolean isTransientHttpFailure(Throwable cause) {
+        if (!(cause instanceof IOException)) {
+            return false;
+        }
+        String message = cause.getMessage();
+        return message != null && HTTP_RESPONSE_CODE.matcher(message).find();
+    }
+
+    /**
+     * True when the exception's document URI points at a remote
+     * HTTP/HTTPS resource (i.e. a DTD/entity fetched over the
+     * network rather than read from the local file system).
+     */
+    private static boolean isRemoteHttpUri(String uri) {
+        return uri != null
+            && (uri.startsWith("http://") || uri.startsWith("https://"));
+    }
+
+    /**
+     * Helper method to determine if a remote-DTD parsing failure
+     * should be ignored.  When the JAXP {@code accessExternalDTD=none}
+     * property is not honored (or the remote host returns a malformed
+     * entity page), {@code Builder.build} wraps the underlying
+     * {@code SAXParseException} as a {@code ParsingException} whose
+     * {@code uri} is the remote DTD/entity URL and whose cause chain
+     * may carry a recognised network exception.  This is a
+     * network/remote-server condition, not an xom bug, so in CI we
+     * skip the affected test as upstream's {@code shouldIgnore}
+     * guard does for {@code IOException}.
+     *
+     * @param ex the {@code ParsingException} to check
+     * @return true if the failure should be ignored, false otherwise
+     */
+    static boolean shouldIgnoreParsingException(ParsingException ex) {
+        if (!isRunningInCI()) {
+            return false;
+        }
+        if (isRemoteHttpUri(ex.getURI())) {
+            return true;
+        }
+        Throwable cause = ex.getCause();
+        while (cause != null) {
+            if (cause instanceof IOException && isNetworkException((IOException) cause)) {
+                return true;
+            }
+            cause = cause.getCause();
+        }
+        return false;
+    }
+    
+    /**
+     * Helper method to determine if a network test failure should be ignored.
+     * Network test failures are only ignored when running in CI and the exception
+     * is network-related.
+     * 
+     * @param ex the exception to check
+     * @return true if the test failure should be ignored, false otherwise
+     */
+    static boolean shouldIgnore(IOException ex) {
+        return isRunningInCI() && isNetworkException(ex);
+    }
+}
