--- /dev/null
+++ b/src/pthread_compat.c
@@ -0,0 +1,23 @@
+/* POSIX thread cancellation stubs for musl/OpenHarmony */
+#include <pthread.h>
+
+int pthread_cancel(pthread_t t) {
+    (void)t;
+    return 0;
+}
+
+int pthread_testcancel(void) {
+    return 0;
+}
+
+int pthread_setcancelstate(int s, int *os) {
+    (void)s;
+    if(os) *os = PTHREAD_CANCEL_ENABLE;
+    return 0;
+}
+
+int pthread_setcanceltype(int t, int *ot) {
+    (void)t;
+    if(ot) *ot = PTHREAD_CANCEL_DEFERRED;
+    return 0;
+}
