--- a/src/library/base/R/datetime.R
+++ b/src/library/base/R/datetime.R
@@ -70,6 +70,33 @@
         Sys.setenv(TZDIR = "/var/db/timezone/zoneinfo")
 
 
+    ## OpenHarmony exposes the authoritative local IANA timezone through
+    ## its parameter service rather than the traditional /etc/localtime chain.
+    ## Probe the authoritative name first, then select a database that really
+    ## contains that IANA file.  Prefer the versioned internal R database.
+    if(nzchar(param <- Sys.which("param"))) {
+        tz0 <- try(system2(param, c("get", "persist.time.timezone"),
+                          stdout = TRUE, stderr = FALSE), silent = TRUE)
+        if(!inherits(tz0, "try-error") && length(tz0) == 1L) {
+            tz <- trimws(tz0)
+            if(nzchar(tz)) {
+                tzdirs <- c(file.path(R.home("share"), "zoneinfo"),
+                            Sys.getenv("TZDIR"),
+                            "/usr/share/zoneinfo", "/share/zoneinfo",
+                            "/usr/share/lib/zoneinfo", "/usr/lib/zoneinfo",
+                            "/usr/local/etc/zoneinfo", "/etc/zoneinfo",
+                            "/usr/etc/zoneinfo")
+                tzdirs <- unique(tzdirs[nzchar(tzdirs)])
+                matches <- tzdirs[file.exists(file.path(tzdirs, tz))]
+                if(length(matches)) {
+                    Sys.setenv(TZDIR = matches[1L])
+                    cacheIt(tz)
+                    return(tz)
+                }
+            }
+        }
+    }
+
     ## At least tzcode and glibc respect TZDIR.
     ## glibc uses $(datadir)/zoneinfo
     ## musl does not mention it, just reads /etc/localtime (as from 1.1.13)
