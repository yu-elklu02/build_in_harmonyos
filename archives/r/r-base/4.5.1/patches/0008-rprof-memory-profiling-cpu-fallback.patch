--- a/src/main/eval.c
+++ b/src/main/eval.c
@@ -781,6 +781,36 @@
 
     signal(SIGPROF, doprof);
 
+    /* HarmonyOS workaround: setitimer(ITIMER_PROF) may exhibit an
+       abnormally large initial it_value (observed ~1.4s when 0.02s
+       was requested), which delays the first SIGPROF well beyond
+       typical profiling workloads and yields zero recorded events.
+       Probe the timer and fall back to RPE_ELAPSED (ProfileThread
+       with pthread_kill(SIGPROF)) if the anomaly is detected. */
+    if (R_Profiling_Event == RPE_CPU) {
+        struct itimerval probe_itv, probe_got;
+        probe_itv.it_interval.tv_sec = 0;
+        probe_itv.it_interval.tv_usec = 0;
+        probe_itv.it_value.tv_sec = interval / 1000000;
+        probe_itv.it_value.tv_usec =
+            (suseconds_t)(interval - probe_itv.it_value.tv_sec * 1000000);
+        if (setitimer(ITIMER_PROF, &probe_itv, NULL) == 0 &&
+            getitimer(ITIMER_PROF, &probe_got) == 0) {
+            double p_set = (double)probe_itv.it_value.tv_sec +
+                           (double)probe_itv.it_value.tv_usec / 1e6;
+            double p_got = (double)probe_got.it_value.tv_sec +
+                            (double)probe_got.it_value.tv_usec / 1e6;
+            if (p_set > 0 && p_got > p_set * 10) {
+                R_Profiling_Event = RPE_ELAPSED;
+            }
+        }
+        /* Clear the probe timer */
+        struct itimerval zero_itv;
+        memset(&zero_itv, 0, sizeof(zero_itv));
+        setitimer(ITIMER_PROF, &zero_itv, NULL);
+    }
+
+
     if (R_Profiling_Event == RPE_ELAPSED) {
 # ifdef HAVE_PTHREAD
 	R_profile_thread_info_t *nfo = &R_Profile_Thread_Info;
