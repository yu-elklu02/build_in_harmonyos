--- a/src/scripts/R.sh.in
+++ b/src/scripts/R.sh.in
@@ -2,6 +2,23 @@
 # Shell wrapper for R executable.
 
 R_HOME_DIR=
+
+## A DESTDIR installation may be moved after installation.  Prefer a complete
+## R home adjacent to this launcher over the configured absolute prefix.  The
+## first layout is the public <prefix>/bin/R launcher; the second is the copy
+## installed as <prefix>/lib/R/bin/R and also covers the build-tree launcher.
+R_SCRIPT_DIR=`dirname "$0"`
+R_SCRIPT_DIR=`cd "$R_SCRIPT_DIR" 2>/dev/null && pwd -P`
+if test -n "$R_SCRIPT_DIR"; then
+    if test -x "$R_SCRIPT_DIR/../lib/R/bin/exec/R" &&
+       test -r "$R_SCRIPT_DIR/../lib/R/etc/ldpaths"; then
+        R_HOME_DIR=`cd "$R_SCRIPT_DIR/../lib/R" 2>/dev/null && pwd -P`
+    elif test -x "$R_SCRIPT_DIR/exec/R" &&
+         test -r "$R_SCRIPT_DIR/../etc/ldpaths"; then
+        R_HOME_DIR=`cd "$R_SCRIPT_DIR/.." 2>/dev/null && pwd -P`
+    fi
+fi
+
 if test "${R_HOME_DIR}" = "@prefix@/@LIBnn@/R"; then
    case "@R_OS@" in
    linux*)
