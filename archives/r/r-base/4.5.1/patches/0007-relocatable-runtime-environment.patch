--- a/src/scripts/R.sh.in
+++ b/src/scripts/R.sh.in
@@ -54,8 +54,22 @@
 R_INCLUDE_DIR="${R_HOME_DIR}/include"
 export R_INCLUDE_DIR
 R_DOC_DIR="${R_HOME_DIR}/doc"
 export R_DOC_DIR
+
+## Configure substitutes resource paths after this template is generated.
+## Re-derive them from the validated runtime home in the installed launcher.
+R_SHARE_DIR="${R_HOME_DIR}/share"
+R_INCLUDE_DIR="${R_HOME_DIR}/include"
+R_DOC_DIR="${R_HOME_DIR}/doc"
+export R_SHARE_DIR R_INCLUDE_DIR R_DOC_DIR
+
+## Use the package-owned CA bundle unless the caller selected another one.
+## TLS peer and host verification remain enabled by libcurl.
+if test -z "${CURL_CA_BUNDLE}" && test -r "${R_HOME_DIR}/etc/cacert.pem"; then
+    CURL_CA_BUNDLE="${R_HOME_DIR}/etc/cacert.pem"
+    export CURL_CA_BUNDLE
+fi
 
