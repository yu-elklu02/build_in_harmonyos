diff --git a/src/renattach.c b/src/renattach.c
--- a/src/renattach.c
+++ b/src/renattach.c
@@ -30,0 +31 @@
+#include <errno.h>
@@ -102,0 +104,48 @@
+/*
+ * Prefer the runner-provided TMPDIR when it is set, then fall back to
+ * tmpfile() for the default platform behavior.
+ */
+static FILE* create_tempfile(void)
+{
+    const char* tmpdir = getenv("TMPDIR");
+    size_t dirlen;
+    char* template_path;
+    int fd;
+    int saved_errno;
+    FILE* stream;
+
+    if (!tmpdir || !*tmpdir)
+        return tmpfile();
+    dirlen = strlen(tmpdir);
+    template_path = malloc(dirlen + sizeof("/renattach-XXXXXX") + 1);
+    if (!template_path)
+        return NULL;
+
+    sprintf(template_path, "%s%srenattach-XXXXXX", tmpdir,
+        (tmpdir[dirlen - 1] == '/') ? "" : "/");
+    fd = mkstemp(template_path);
+    if (fd == -1)
+    {
+        free(template_path);
+        return NULL;
+    }
+    if (unlink(template_path) != 0)
+    {
+        saved_errno = errno;
+        close(fd);
+        free(template_path);
+        errno = saved_errno;
+        return NULL;
+    }
+    free(template_path);
+    stream = fdopen(fd, "w+");
+    if (!stream)
+    {
+        saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+    }
+    return stream;
+}
+
+
@@ -260 +316 @@
-	tempfile = tmpfile();
+	tempfile = create_tempfile();
