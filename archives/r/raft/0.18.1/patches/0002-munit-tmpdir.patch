--- a/test/lib/munit.c
+++ b/test/lib/munit.c
@@ -1348,7 +1348,34 @@
 
   stderr_buf = NULL;
 #if !defined(_WIN32) || defined(__MINGW32__)
-  stderr_buf = tmpfile();
+  {
+    /* OHOS: /tmp is read-only; use $TMPDIR for the stderr capture file */
+    const char *tmpdir = getenv("TMPDIR");
+    char tmpl[512];
+    int fd;
+    if (tmpdir == NULL || tmpdir[0] == '\0') {
+      tmpdir = "/data/local/tmp";
+    }
+    if (snprintf(tmpl, sizeof tmpl, "%s/munit-stderr-XXXXXX", tmpdir) >= (int) sizeof tmpl) {
+      munit_log_errno(MUNIT_LOG_ERROR, stderr, "TMPDIR path too long");
+      result = MUNIT_ERROR;
+      goto print_result;
+    }
+    fd = mkstemp(tmpl);
+    if (fd == -1) {
+      munit_log_errno(MUNIT_LOG_ERROR, stderr, "unable to create buffer for stderr");
+      result = MUNIT_ERROR;
+      goto print_result;
+    }
+    unlink(tmpl);
+    stderr_buf = fdopen(fd, "w+");
+    if (stderr_buf == NULL) {
+      close(fd);
+      munit_log_errno(MUNIT_LOG_ERROR, stderr, "unable to create buffer for stderr");
+      result = MUNIT_ERROR;
+      goto print_result;
+    }
+  }
 #else
   tmpfile_s(&stderr_buf);
 #endif
