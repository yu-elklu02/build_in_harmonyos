diff -ruN a/librz/util/path.c b/librz/util/path.c
--- a/librz/util/path.c	2026-08-11 20:24:12.972874300 +0800
+++ b/librz/util/path.c	2026-08-11 20:24:13.028968800 +0800
@@ -136,6 +136,28 @@
  */
 RZ_API RZ_OWN char *rz_path_system(RZ_BORROW RZ_NULLABLE RzPath *sys_path, RZ_NULLABLE const char *path) {
 	const char *prefix = rz_path_prefix(sys_path);
+	// HarmonyOS portability: allow overriding the compiled-in install prefix
+	// at runtime via the RZ_PREFIX env var.  This mirrors the RZ_PREFIX env
+	// handling already present for dir.prefix in rz_core_config_init(), and
+	// lets staged installs (e.g. the upstream test suite run from a meson
+	// install --destdir tree) resolve system data dirs like RZ_SDB_TYPES
+	// (share/rizin/types) which would otherwise point to a nonexistent
+	// /share/rizin on devices without a system-wide rizin install.
+	// rz_path_prefix() itself must keep returning the build-time RZ_PREFIX,
+	// as test/unit/test_util.c test_path_prefix asserts strcmp(output, RZ_PREFIX)==0.
+	{
+		static char *env_prefix = NULL;
+		if (!env_prefix) {
+			char *env = rz_sys_getenv("RZ_PREFIX");
+			if (env && *env) {
+				env_prefix = rz_str_dup(env);
+			}
+			free(env);
+		}
+		if (env_prefix) {
+			prefix = env_prefix;
+		}
+	}
 	return rz_file_path_join(prefix, path);
 }
 
