--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -208,21 +208,28 @@
   find_library(CCD_LIBRARY ccd
     HINTS "${PC_CCD_LIBRARY_DIRS}")
 
   # libccd links to LibM on UNIX.
   if(CYGWIN OR NOT WIN32)
     find_library(M_LIBRARY m)
   endif()
 
   if(CCD_INCLUDE_DIR AND CCD_LIBRARY)
     set(CCD_INCLUDE_DIRS "${CCD_INCLUDE_DIR}")
-    set(CCD_LIBRARIES "${CCD_LIBRARY}" "${M_LIBRARY}")
+    # musl（鸿蒙）把数学函数并入 libc，find_library(m) 必然落空。
+    # 直接把 NOTFOUND 塞进 CCD_LIBRARIES 会让 generate 阶段报
+    # "variables are used in this project, but they are set to NOTFOUND"。
+    if(M_LIBRARY)
+      set(CCD_LIBRARIES "${CCD_LIBRARY}" "${M_LIBRARY}")
+    else()
+      set(CCD_LIBRARIES "${CCD_LIBRARY}")
+    endif()
     set(ccd_FOUND ON)
 
     mark_as_advanced(CCD_INCLUDE_DIR CCD_LIBRARY)
   endif()
 endif()
 
 if(NOT ccd_FOUND)
   message(FATAL_ERROR "CCD is required by FCL")
 endif()
 
