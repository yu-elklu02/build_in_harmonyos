@@ -66,12 +66,30 @@
 AC_CHECK_LIB(z, deflate, ZLIBS=-lz, use_zlib=no)
 
 if test "$use_zlib" = no; then
    # Brain dead way to find tree's zlib.
    AC_MSG_ERROR([Need zlib])
 fi
 AC_SUBST(ZLIBS)
 
 gl_INIT
 
+dnl Override AS_TMPDIR to avoid umask 077, which causes permission
+dnl issues on HMDFS (config.status cannot write to the temp dir).
+dnl This must appear before AC_OUTPUT so it takes effect when
+dnl autoconf expands the config.status tmpdir creation block.
+m4_define([AS_TMPDIR],
+[# Create a (secure) tmp directory for tmp files.
+m4_if([$2], [], [: "${TMPDIR:=/tmp}"])
+{
+  tmp=`(mktemp -d "m4_default([$2],
+    [$TMPDIR])/$1XXXXXX") 2>/dev/null` &&
+  test -d "$tmp"
+}  ||
+{
+  tmp=m4_default([$2], [$TMPDIR])/$1$$-$RANDOM
+  (mkdir "$tmp")
+} || AS_ERROR([cannot create a temporary directory in m4_default([$2],
+	      [$TMPDIR])])])
+
 AC_CONFIG_FILES([lib/Makefile Makefile])
 AC_OUTPUT
