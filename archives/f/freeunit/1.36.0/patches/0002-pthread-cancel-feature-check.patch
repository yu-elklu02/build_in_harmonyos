--- a/auto/threads
+++ b/auto/threads
@@ -73,6 +73,30 @@
 fi
 
 
+# pthread_cancel() is not available on OHOS musl-like libc.
+
+nxt_feature="pthread_cancel()"
+nxt_feature_name=NXT_HAVE_PTHREAD_CANCEL
+nxt_feature_run=
+nxt_feature_incs=
+nxt_feature_libs=$NXT_PTHREAD
+nxt_feature_test="#define _GNU_SOURCE
+              #include <pthread.h>
+
+              int main(void) {
+                  pthread_t  tid;
+
+                  if (pthread_create(&tid, NULL, NULL, NULL) != 0)
+                      return 1;
+
+                  if (pthread_cancel(tid) != 0)
+                      return 1;
+
+                  return 0;
+              }"
+. auto/feature
+
+
 nxt_feature="sem_timedwait()"
 nxt_feature_name=NXT_HAVE_SEM_TIMEDWAIT
 nxt_feature_run=yes
--- a/src/nxt_thread.c
+++ b/src/nxt_thread.c
@@ -212,6 +212,7 @@
 void
 nxt_thread_cancel(nxt_thread_handle_t handle)
 {
+#if (NXT_HAVE_PTHREAD_CANCEL)
     nxt_err_t  err;
 
     nxt_thread_log_debug("thread cancel: %PH", handle);
@@ -221,6 +222,16 @@
     if (err != 0) {
         nxt_main_log_alert("pthread_cancel(%PH) failed %E", handle, err);
     }
+
+#else
+    /*
+     * OHOS musl-like libc does not provide pthread_cancel().  The signal
+     * thread is not started there because epoll/signalfd support signal
+     * event notifications, so thread cancellation is never actually used.
+     */
+    nxt_thread_log_debug("thread cancel is not supported: %PH", handle);
+
+#endif
 }
 
 
