--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -146,8 +146,21 @@
     endif(CUDA_FOUND)
 endif(BUILD_CUDA_LIB)
 
-find_package(PkgConfig REQUIRED)
-pkg_check_modules(LZ4 REQUIRED liblz4)
+# OHOS adaptation: no system liblz4 / pkg-config available on the platform.
+# Vendor lz4 1.9.4 (only lz4.c + lz4hc.c are needed by flann's serialization)
+# as a static, position-independent target, linked PRIVATE into the flann
+# libraries so the shared libflann_cpp.so is self-contained (no runtime lz4
+# dependency). lz4_vendored is registered into the flann-targets export set so
+# install(EXPORT) is satisfied for the static libs too; the export itself is
+# dropped at package time (conan provides flann::flann instead). Include path
+# is added at directory scope below, so no source path leaks into the export.
+add_library(lz4_vendored STATIC
+    ${CMAKE_SOURCE_DIR}/lz4/lib/lz4.c
+    ${CMAKE_SOURCE_DIR}/lz4/lib/lz4hc.c)
+set_target_properties(lz4_vendored PROPERTIES POSITION_INDEPENDENT_CODE ON)
+set(LZ4_INCLUDE_DIRS ${CMAKE_SOURCE_DIR}/lz4/lib)
+set(LZ4_LINK_LIBRARIES PRIVATE lz4_vendored)
+install(TARGETS lz4_vendored EXPORT flann-targets ARCHIVE DESTINATION ${FLANN_LIB_INSTALL_DIR})
 include_directories(${LZ4_INCLUDE_DIRS})
 
 #set the C/C++ include path to the "include" directory
