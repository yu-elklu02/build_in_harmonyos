--- /dev/null
+++ b/configure
@@ -0,0 +1,16 @@
+#!/bin/sh
+# Minimal configure shim for packaging environments that expect ./configure.
+# fatsort is a Makefile-only project; accept --prefix for compatibility.
+for arg in "$@"; do
+  case "$arg" in
+    --prefix=*) ;;
+    --help|-h)
+      echo "Usage: ./configure [--prefix=PREFIX]"
+      exit 0
+      ;;
+    *)
+      echo "configure: warning: ignoring unsupported option: $arg" >&2
+      ;;
+  esac
+done
+exit 0
