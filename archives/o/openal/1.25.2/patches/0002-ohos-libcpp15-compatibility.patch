--- /dev/null
+++ b/common/ohos_libcpp_compat.h
@@ -0,0 +1,40 @@
+#pragma once
+
+/*
+ * OHOS libc++15 exposes std::views::elements poorly. Provide the small
+ * projection adapter OpenAL needs without relying on that view directly.
+ */
+#include <cstddef>
+#include <ranges>
+#include <string_view>
+#include <tuple>
+#include <utility>
+
+namespace openal_compat::views
+{
+template<std::size_t Index>
+inline constexpr auto elements = std::views::transform([](auto&& value) -> decltype(auto)
+{
+    return std::get<Index>(std::forward<decltype(value)>(value));
+});
+}
+
+namespace openal_compat
+{
+template<typename Char, typename Traits, typename Function>
+constexpr void for_each_delimited(std::basic_string_view<Char, Traits> value,
+    const Char delimiter, Function&& function)
+{
+    if(value.empty())
+        return;
+
+    while(true)
+    {
+        const auto position = value.find(delimiter);
+        function(value.substr(0, position));
+        if(position == value.npos)
+            break;
+        value.remove_prefix(position + 1);
+    }
+}
+}
