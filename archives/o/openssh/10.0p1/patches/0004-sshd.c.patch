+#ifdef ENABLE_OPENSSH_HOME
+/*
+ * Resolve a compiled-in path using OPENSSH_HOME env var.
+ * If OPENSSH_HOME is set, returns "$OPENSSH_HOME/lib/sshd-session" etc.
+ * Otherwise returns the original compiled-in path.
+ * Uses a static buffer — caller must copy if persistence needed.
+ */
+static char ohos_path_buf[PATH_MAX];
+
+static const char *
+ohos_resolve_path(const char *compiled_path)
+{
+	const char *home = getenv("OPENSSH_HOME");
+	if (home == NULL || home[0] == '\0')
+		return compiled_path;
+	/* strip leading slashes from compiled path */
+	while (*compiled_path == '/')
+		compiled_path++;
+	snprintf(ohos_path_buf, sizeof(ohos_path_buf), "%s/%s",
+	    home, compiled_path);
+	return ohos_path_buf;
+}
+#endif /* ENABLE_OPENSSH_HOME */
