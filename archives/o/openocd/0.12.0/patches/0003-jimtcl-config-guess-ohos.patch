diff -ruN a/jimtcl/autosetup/autosetup-config.guess b/jimtcl/autosetup/autosetup-config.guess
--- a/jimtcl/autosetup/autosetup-config.guess
+++ b/jimtcl/autosetup/autosetup-config.guess
@@ -966,6 +966,25 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64)
+		GUESS=aarch64-unknown-linux-ohos
+		;;
+	    armv7*|armv8*)
+		GUESS=arm-unknown-linux-ohos
+		;;
+	    x86_64|amd64)
+		GUESS=x86_64-unknown-linux-ohos
+		;;
+	    i?86)
+		GUESS=i686-unknown-linux-ohos
+		;;
+	    *)
+		GUESS=$UNAME_MACHINE-unknown-linux-ohos
+		;;
+	esac
+	;;
     aarch64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
