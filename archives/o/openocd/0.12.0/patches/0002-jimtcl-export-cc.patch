diff -ruN a/jimtcl/configure b/jimtcl/configure
--- a/jimtcl/configure
+++ b/jimtcl/configure
@@ -1,3 +1,18 @@
 #!/bin/sh
+# autosetup does not interpret "VAR=value" configure arguments the way
+# autoconf does; export them as environment variables so that the C
+# compiler set by the parent (openocd) configure is honored.
+# autosetup-find-tclsh uses CC_FOR_BUILD to build the bootstrap jimsh0,
+# so mirror CC into CC_FOR_BUILD as well.
+for _arg in "$@"; do
+    case "$_arg" in
+        [A-Za-z_]*=*)
+            export "$_arg"
+            case "$_arg" in
+                CC=*) export CC_FOR_BUILD="${_arg#CC=}" ;;
+            esac
+            ;;
+    esac
+done
 dir="`dirname "$0"`/autosetup"
 WRAPPER="$0"; export WRAPPER; exec "`"$dir/autosetup-find-tclsh"`" "$dir/autosetup" "$@"
