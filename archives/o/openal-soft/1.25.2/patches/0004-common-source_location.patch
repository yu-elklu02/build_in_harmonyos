--- /dev/null	2026-08-01 09:25:57.431511094 +0800
+++ b/common/source_location
@@ -0,0 +1,48 @@
+/* Local compat header for OHOS SDK libc++ 15.0.4 (libcxx-ohos):
+ * <source_location> is missing entirely from the shipped headers, yet
+ * openal-soft 1.25.2 (C++20) includes it. Clang 15 provides
+ * __builtin_FILE/LINE/COLUMN/FUNCTION, which is exactly how libc++ itself
+ * implements std::source_location::current().
+ *
+ * This is formal archive content (added via patch 0004) — self-contained,
+ * no absolute paths, no host-private shims. Once the SDK ships the real
+ * header, the system include path wins and this file is unused.
+ */
+#ifndef ATOMCODE_COMPAT_SOURCE_LOCATION
+#define ATOMCODE_COMPAT_SOURCE_LOCATION
+
+#include <cstdint>
+
+namespace std {
+
+class source_location {
+    const char* __file_;
+    uint32_t __line_;
+    uint32_t __column_;
+    const char* __function_;
+
+    constexpr source_location(const char* file, uint32_t line, uint32_t column,
+        const char* func) noexcept
+        : __file_(file), __line_(line), __column_(column), __function_(func)
+    {
+    }
+
+public:
+    constexpr source_location() noexcept
+        : __file_(""), __line_(0), __column_(0), __function_("") {}
+
+    static constexpr source_location current() noexcept
+    {
+        return source_location(__builtin_FILE(), __builtin_LINE(),
+            __builtin_COLUMN(), __builtin_FUNCTION());
+    }
+
+    constexpr const char* file_name() const noexcept { return __file_; }
+    constexpr uint32_t line() const noexcept { return __line_; }
+    constexpr uint32_t column() const noexcept { return __column_; }
+    constexpr const char* function_name() const noexcept { return __function_; }
+};
+
+} // namespace std
+
+#endif // ATOMCODE_COMPAT_SOURCE_LOCATION
