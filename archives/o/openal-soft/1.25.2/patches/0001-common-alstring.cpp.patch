+/* OHOS libc++ 15.0.4 lacks std::lexicographical_compare_three_way (C++20
+ * [alg.three.way]). Local equivalent with identical semantics; no external
+ * shim dependency, no ABI impact (internal helper).
+ */
+template<class InputIt1, class InputIt2, class Cmp>
+std::weak_ordering lexicographical_compare_three_way(InputIt1 first1, InputIt1 last1,
+    InputIt2 first2, InputIt2 last2, Cmp comp)
+{
+    for(; first1 != last1 && first2 != last2; ++first1, ++first2)
+        if(auto const c = comp(*first1, *first2); c != 0)
+            return c;
+    return first1 == last1
+        ? (first2 == last2 ? std::weak_ordering::equivalent : std::weak_ordering::less)
+        : std::weak_ordering::greater;
+}
+
+} /* namespace */
