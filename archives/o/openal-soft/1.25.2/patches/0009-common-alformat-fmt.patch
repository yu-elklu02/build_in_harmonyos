--- a/common/alformat.hpp
+++ b/common/alformat.hpp
@@ -7,9 +7,13 @@
 
 /* On macOS, std::format requires std::to_chars, which isn't available prior
  * to macOS 13.3. Older versions of libstdc++ also lack the <format> header.
+ * OHOS SDK libc++ 15.0.4 ships <format> headers but libc++_shared.so does not
+ * export std::format_error (vtable/typeinfo/dtor), so linking fails; use the
+ * bundled fmt implementation instead.
  */
 #if (defined(MAC_OS_X_VERSION_MIN_REQUIRED) && MAC_OS_X_VERSION_MIN_REQUIRED < 130300) \
-    || !__has_include(<format>)
+    || !__has_include(<format>) \
+    || (defined(_LIBCPP_VERSION) && _LIBCPP_VERSION <= 15004)
 #include "fmt/format.h"
 
 namespace al {
