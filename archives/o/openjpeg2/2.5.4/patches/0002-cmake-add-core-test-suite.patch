--- /dev/null
+++ b/tests/core/CMakeLists.txt
@@ -0,0 +1,62 @@
+# Self-contained upstream tests that only require the core openjp2 library.
+include_directories(
+  ${OPENJPEG_BINARY_DIR}/src/lib/openjp2
+  ${OPENJPEG_SOURCE_DIR}/src/lib/openjp2
+  ${OPENJPEG_SOURCE_DIR}/src/bin/common
+)
+
+set(OPENJPEG_CORE_TEST_SOURCE_DIR ${OPENJPEG_SOURCE_DIR}/tests)
+
+add_executable(test_tile_encoder
+  ${OPENJPEG_CORE_TEST_SOURCE_DIR}/test_tile_encoder.c)
+target_link_libraries(test_tile_encoder ${OPENJPEG_LIBRARY_NAME})
+
+add_executable(test_tile_decoder
+  ${OPENJPEG_CORE_TEST_SOURCE_DIR}/test_tile_decoder.c)
+target_link_libraries(test_tile_decoder ${OPENJPEG_LIBRARY_NAME})
+
+add_executable(j2k_random_tile_access
+  ${OPENJPEG_CORE_TEST_SOURCE_DIR}/j2k_random_tile_access.c)
+target_link_libraries(j2k_random_tile_access ${OPENJPEG_LIBRARY_NAME})
+
+add_executable(test_decode_area
+  ${OPENJPEG_CORE_TEST_SOURCE_DIR}/test_decode_area.c)
+target_link_libraries(test_decode_area ${OPENJPEG_LIBRARY_NAME})
+
+add_test(NAME tte0 COMMAND test_tile_encoder)
+add_test(NAME tte1 COMMAND test_tile_encoder 3 2048 2048 1024 1024 8 1 tte1.j2k)
+add_test(NAME tte2 COMMAND test_tile_encoder 3 2048 2048 1024 1024 8 1 tte2.jp2)
+add_test(NAME tte3 COMMAND test_tile_encoder 1 2048 2048 1024 1024 8 1 tte3.j2k)
+add_test(NAME tte4 COMMAND test_tile_encoder 1 256 256 128 128 8 0 tte4.j2k)
+add_test(NAME tte5 COMMAND test_tile_encoder 1 512 512 256 256 8 0 tte5.j2k)
+
+add_test(NAME ttd0 COMMAND test_tile_decoder)
+set_property(TEST ttd0 APPEND PROPERTY DEPENDS tte0)
+add_test(NAME ttd1 COMMAND test_tile_decoder 0 0 1024 1024 tte1.j2k)
+set_property(TEST ttd1 APPEND PROPERTY DEPENDS tte1)
+add_test(NAME ttd2 COMMAND test_tile_decoder 0 0 1024 1024 tte2.jp2)
+set_property(TEST ttd2 APPEND PROPERTY DEPENDS tte2)
+
+add_test(NAME rta1 COMMAND j2k_random_tile_access tte1.j2k)
+set_property(TEST rta1 APPEND PROPERTY DEPENDS tte1)
+add_test(NAME rta2 COMMAND j2k_random_tile_access tte2.jp2)
+set_property(TEST rta2 APPEND PROPERTY DEPENDS tte2)
+add_test(NAME rta3 COMMAND j2k_random_tile_access tte3.j2k)
+set_property(TEST rta3 APPEND PROPERTY DEPENDS tte3)
+add_test(NAME rta4 COMMAND j2k_random_tile_access tte4.j2k)
+set_property(TEST rta4 APPEND PROPERTY DEPENDS tte4)
+add_test(NAME rta5 COMMAND j2k_random_tile_access tte5.j2k)
+set_property(TEST rta5 APPEND PROPERTY DEPENDS tte5)
+
+function(add_decode_area_pair name encoder_args decoder_args)
+  add_test(NAME ${name}_prep COMMAND test_tile_encoder ${encoder_args})
+  add_test(NAME ${name} COMMAND test_decode_area ${decoder_args})
+  set_property(TEST ${name} APPEND PROPERTY DEPENDS ${name}_prep)
+endfunction()
+
+add_decode_area_pair(tda_reversible_no_precinct "1;256;256;32;32;8;0;reversible_no_precinct.j2k;4;4;3;0;0;1" "-q;reversible_no_precinct.j2k")
+add_decode_area_pair(tda_reversible_203_201_17_19_no_precinct "1;203;201;17;19;8;0;reversible_203_201_17_19_no_precinct.j2k;4;4;3;0;0;1" "-q;reversible_203_201_17_19_no_precinct.j2k")
+add_decode_area_pair(tda_reversible_with_precinct "1;256;256;32;32;8;0;reversible_with_precinct.j2k;4;4;3;0;0;1;16;16" "-q;reversible_with_precinct.j2k")
+add_decode_area_pair(tda_irreversible_no_precinct "1;256;256;32;32;8;1;irreversible_no_precinct.j2k;4;4;3;0;0;1" "-q;irreversible_no_precinct.j2k")
+add_decode_area_pair(tda_irreversible_203_201_17_19_no_precinct "1;203;201;17;19;8;1;irreversible_203_201_17_19_no_precinct.j2k;4;4;3;0;0;1" "-q;irreversible_203_201_17_19_no_precinct.j2k")
+add_decode_area_pair(tda_strip "1;256;256;256;256;8;0;tda_single_tile.j2k" "-q;-strip_height;3;-strip_check;tda_single_tile.j2k")
