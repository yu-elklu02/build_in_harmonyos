diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -3142,7 +3142,7 @@
 
 
 
-eval `$ac_aux_dir/version.sh`
+eval `"$CONFIG_SHELL" "$ac_aux_dir/version.sh"`
 if test -z "$OL_STRING"; then
 	as_fn_error $? "could not determine version" "$LINENO" 5
 fi
@@ -28139,9 +28139,9 @@
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`mktemp -d "./confXXXXXX" 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  mkdir "$tmp"
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
diff --git a/build/config.sub b/build/config.sub
--- a/build/config.sub
+++ b/build/config.sub
@@ -1695,7 +1695,7 @@
 	# Now accept the basic system types.
 	# The portable systems comes first.
 	# Each alternative MUST end in a * to match a version number.
-	gnu* | android* | bsd* | mach* | minix* | genix* | ultrix* | irix* \
+	gnu* | android* | ohos* | bsd* | mach* | minix* | genix* | ultrix* | irix* \
 	     | *vms* | esix* | aix* | cnk* | sunos | sunos[34]* \
 	     | hpux* | unos* | osf* | luna* | dgux* | auroraux* | solaris* \
 	     | sym* |  plan9* | psp* | sim* | xray* | os68k* | v88r* \
@@ -1742,7 +1742,7 @@
 # As a final step for OS-related things, validate the OS-kernel combination
 # (given a valid OS), if there is a kernel.
 case $kernel-$os in
-	linux-gnu* | linux-dietlibc* | linux-android* | linux-newlib* | linux-musl* | linux-uclibc* )
+	linux-gnu* | linux-dietlibc* | linux-android* | linux-newlib* | linux-musl* | linux-ohos* | linux-uclibc* )
 		;;
 	uclinux-uclibc* )
 		;;
diff --git a/build/top.mk b/build/top.mk
--- a/build/top.mk
+++ b/build/top.mk
@@ -53,7 +53,7 @@
 
 BUILD_LIBS_DYNAMIC = @BUILD_LIBS_DYNAMIC@
 
-SHTOOL = $(top_srcdir)/build/shtool
+SHTOOL = $(SHELL) $(top_srcdir)/build/shtool
 
-INSTALL = $(SHTOOL) install -c
+INSTALL = /bin/install
 INSTALL_PROGRAM = $(INSTALL)
@@ -65,12 +65,12 @@
 LINT = lint
 5LINT = 5lint
 
-MKDEP = $(top_srcdir)/build/mkdep $(MKDEPFLAG) \
+MKDEP = $(SHELL) $(top_srcdir)/build/mkdep $(MKDEPFLAG) \
 	-d "$(srcdir)" -c "$(MKDEP_CC)" -m "$(MKDEP_CFLAGS)"
 MKDEP_CC	= @OL_MKDEP@
 MKDEP_CFLAGS = @OL_MKDEP_FLAGS@
 
-MKVERSION = $(top_srcdir)/build/mkversion -v "$(VERSION)"
+MKVERSION = $(SHELL) $(top_srcdir)/build/mkversion -v "$(VERSION)"
 
 LIBTOOL = @LIBTOOL@
 LIBVERSION = @OPENLDAP_LIBVERSION@
