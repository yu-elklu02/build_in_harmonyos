 class TestFailure(Exception):
     pass
 
+def ohosLocalMode():
+    return os.environ.get('SAFEKEEP_TEST_OHOS_LOCAL') in ('1', 'true', 'yes')
+
+def findExe(exe):
+    override = os.environ.get('SAFEKEEP_TEST_' + exe.upper().replace('-', '_'))
+    if override:
+        return override
+    found = shutil.which(exe)
+    if found:
+        return found
+    return exe
+
+def prepareOhosLocalTest(tmproot):
+    bindir = os.path.join(tmproot, 'ohos-bin')
+    os.mkdir(bindir)
+
+    client = os.path.join(bindir, 'safekeep-client-emulator.py')
+    writefile(client, """#!/usr/bin/env python3
+import os
+import sys
+
+bdir = os.environ.get("SAFEKEEP_TEST_CLIENT_ROOT")
+if not bdir:
+    print("TRACEBACK missing SAFEKEEP_TEST_CLIENT_ROOT>>>", flush=True)
+    sys.exit(1)
+
+def send(line):
+    print(line, flush=True)
+
+while True:
+    line = sys.stdin.readline()
+    if not line:
+        break
+    if line.startswith("ALOHA"):
+        send("OK 1.4, 1.5.1")
+    elif line.startswith("DEFAULT"):
+        send("OK 0")
+    elif line.startswith("CONFIG"):
+        try:
+            count = int(line.split(":", 2)[1].strip())
+        except Exception:
+            send("ERROR bad CONFIG")
+            continue
+        for _ in range(count):
+            sys.stdin.readline()
+        send("OK 0")
+    elif line.startswith("SETUP"):
+        send("OK 0 " + bdir)
+    elif line.startswith("CLEANUP") or line.startswith("SCRUB"):
+        send("OK 0")
+    else:
+        send("ERROR unsupported " + line.strip())
+""")
+    os.chmod(client, 0o755)
+
+    wrapper = os.path.join(bindir, 'safekeep')
+    writefile(wrapper, """#!/bin/sh
+if [ "$1" = "--client" ]; then
+  exec %s %s
+fi
+exec %s "$@"
+""" % (shlex.quote(sys.executable), shlex.quote(client), shlex.quote(findExe('safekeep'))))
+    os.chmod(wrapper, 0o755)
+
+    return {
+        'bin': bindir,
+        'client_root': os.path.join(tmproot, 'client'),
+        'rdiff_backup': findExe('rdiff-backup'),
+    }
+
 def mkssh(cmd='ssh'):
