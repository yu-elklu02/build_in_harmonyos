diff --git a/src/SFML/System/Unix/ThreadImpl.cpp b/src/SFML/System/Unix/ThreadImpl.cpp
index e3daf7f..f4c2b01 100644
--- a/src/SFML/System/Unix/ThreadImpl.cpp
+++ b/src/SFML/System/Unix/ThreadImpl.cpp
@@ -62,11 +62,20 @@ void ThreadImpl::terminate()
 {
     if (m_isActive)
     {
-        #ifndef SFML_SYSTEM_ANDROID
+        // Prefer pthread_cancel when the platform provides it (detected via
+        // CMake's check_function_exists, see src/SFML/System/CMakeLists.txt).
+        // Android never has pthread_cancel and uses SIGUSR1 instead.
+        // Platforms without pthread_cancel (e.g. HarmonyOS) leave the thread
+        // joinable until it naturally exits.
+        #if defined(SFML_HAVE_PTHREAD_CANCEL)
             pthread_cancel(m_thread);
-        #else
+        #elif defined(SFML_SYSTEM_ANDROID)
             // See https://stackoverflow.com/questions/4610086/pthread-cancel-al
             pthread_kill(m_thread, SIGUSR1);
+        #else
+            // No pthread_cancel and no SIGUSR1 fallback: no-op, keep the
+            // thread joinable. Do not detach: pthread_join would then fail
+            // (EINVAL) and the thread could outlive its sf::Thread owner.
         #endif
     }
 }
@@ -78,7 +87,9 @@ void* ThreadImpl::entryPoint(void* userData)
     // The Thread instance is stored in the user data
     Thread* owner = static_cast<Thread*>(userData);
 
-    #ifndef SFML_SYSTEM_ANDROID
+    // Only request asynchronous cancellation when the platform both supports
+    // pthread_cancel and exposes pthread_setcanceltype.
+    #if defined(SFML_HAVE_PTHREAD_CANCEL) && defined(SFML_HAVE_PTHREAD_SETCANCELTYPE)
         // Tell the thread to handle cancel requests immediately
         pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
     #endif
