diff --git a/src/SFML/System/CMakeLists.txt b/src/SFML/System/CMakeLists.txt
index 1206968..cf63d8e 100644
--- a/src/SFML/System/CMakeLists.txt
+++ b/src/SFML/System/CMakeLists.txt
@@ -89,6 +89,36 @@ endif()
 sfml_add_library(sfml-system
                  SOURCES ${SRC} ${PLATFORM_SRC})
 
+# Detect pthread cancellation features at configure time instead of relying
+# on platform macros (e.g. __OHOS__). This keeps the C++ source portable:
+# platforms that lack pthread_cancel/pthread_setcanceltype simply skip the
+# corresponding calls. See src/SFML/System/Unix/ThreadImpl.cpp.
+if(NOT SFML_OS_WINDOWS)
+    include(CheckFunctionExists)
+
+    # check_function_exists needs pthread on the link line for the test build.
+    set(_sfml_system_check_libs "")
+    if(SFML_OS_LINUX OR SFML_OS_FREEBSD OR SFML_OS_MACOSX OR SFML_OS_ANDROID)
+        set(_sfml_system_check_libs pthread)
+    endif()
+
+    set(CMAKE_REQUIRED_LIBRARIES ${_sfml_system_check_libs})
+    check_function_exists(pthread_cancel SFML_HAVE_PTHREAD_CANCEL)
+    check_function_exists(pthread_setcanceltype SFML_HAVE_PTHREAD_SETCANCELTYPE)
+    unset(CMAKE_REQUIRED_LIBRARIES)
+
+    # Make a failed detection visible: without pthread_cancel (e.g. on
+    # HarmonyOS) Thread::terminate() cannot cancel a running thread; it only
+    # lets the thread exit naturally. Warn instead of silently changing behavior.
+    if(NOT SFML_HAVE_PTHREAD_CANCEL AND NOT SFML_OS_ANDROID)
+        message(WARNING "pthread_cancel not detected: Thread::terminate() will not cancel running threads")
+    endif()
+
+    target_compile_definitions(sfml-system PRIVATE
+        $<$<BOOL:${SFML_HAVE_PTHREAD_CANCEL}>:SFML_HAVE_PTHREAD_CANCEL>
+        $<$<BOOL:${SFML_HAVE_PTHREAD_SETCANCELTYPE}>:SFML_HAVE_PTHREAD_SETCANCELTYPE>)
+endif()
+
 if(SFML_OS_ANDROID)
     # glad sources
     target_include_directories(sfml-system PRIVATE "${PROJECT_SOURCE_DIR}/extlibs/headers/glad/include")
