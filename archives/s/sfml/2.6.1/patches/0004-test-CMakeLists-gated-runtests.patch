diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -42,11 +42,24 @@ if(SFML_BUILD_NETWORK)
 endif()
 
 # Automatically run the tests at the end of the build
-add_custom_target(runtests ALL
-                  DEPENDS test-sfml-system test-sfml-window test-sfml-graphics test-sfml-network
-)
+# This recipe only builds System/Network (SFML_BUILD_WINDOW/GRAPHICS=OFF).
+# The upstream unconditional DEPENDS on window/graphics test targets makes
+# the build fail with "No rule to make target", so gate the list by module flag.
+set(_sfml_test_targets test-sfml-system)
+if(SFML_BUILD_WINDOW)
+    list(APPEND _sfml_test_targets test-sfml-window)
+endif()
+if(SFML_BUILD_GRAPHICS)
+    list(APPEND _sfml_test_targets test-sfml-graphics)
+endif()
+if(SFML_BUILD_NETWORK)
+    list(APPEND _sfml_test_targets test-sfml-network)
+endif()
+add_custom_target(runtests ALL DEPENDS ${_sfml_test_targets})
 
 add_custom_command(TARGET runtests
                    COMMENT "Run tests"
-                   POST_BUILD COMMAND ctest ARGS --output-on-failure
+                   # HarmonyOS loader does not honor BUILD_RPATH, so the test
+                   # binary needs LD_LIBRARY_PATH pointing at the build lib/.
+                   POST_BUILD COMMAND ${CMAKE_COMMAND} -E env "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}/lib:$ENV{LD_LIBRARY_PATH}" ctest ARGS --output-on-failure
 )
