--- /dev/null
+++ b/pthread_cancel_stub.h
@@ -0,0 +1,20 @@
+// pthread_cancel stub for musl libc compatibility
+// OpenHarmony uses musl libc which doesn't implement pthread_cancel()
+
+#ifndef _PTHREAD_CANCEL_STUB_H
+#define _PTHREAD_CANCEL_STUB_H
+
+#include <pthread.h>
+
+// Stub implementation - does nothing but returns success
+// Note: This may affect cleanup logic in some cases
+inline int pthread_cancel_stub(pthread_t thread) {
+    // musl doesn't support pthread_cancel
+    // Return 0 to avoid link errors, but actual behavior may differ
+    return 0;
+}
+
+// Redirect pthread_cancel to stub
+#define pthread_cancel pthread_cancel_stub
+
+#endif // _PTHREAD_CANCEL_STUB_H
