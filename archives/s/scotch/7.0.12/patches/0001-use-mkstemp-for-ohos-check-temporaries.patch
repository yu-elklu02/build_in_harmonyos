 /* The consistency checking routine. */
+/*                                   */
+/*************************************/
+
+static
+FILE *
+checkTmpFile (
+void)
+{
+  FILE *              fileptr;
+  int                 filedes;
+  char                filepath[] = "scotch-check-XXXXXX";
+
+  filedes = mkstemp (filepath);
+  if (filedes < 0)
+    return (NULL);
+
+  unlink (filepath);
+  fileptr = fdopen (filedes, "w+");
+  if (fileptr == NULL) {
+    close (filedes);
+    return (NULL);
+  }
+
+  return (fileptr);
+}
+
+/*************************************/
 /*                                   */
 /*************************************/
 
