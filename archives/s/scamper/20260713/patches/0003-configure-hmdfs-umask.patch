--- a/configure
+++ b/configure
@@ -22058,12 +22058,17 @@
 # Create a (secure) tmp directory for tmp files.
 
+case $host_os in
+  *ohos*) ac_tmp_umask=022 ;;
+  *) ac_tmp_umask=077 ;;
+esac
+
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask "$ac_tmp_umask" && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask "$ac_tmp_umask" && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
