diff --git a/synfig-core/src/ltdl.h b/synfig-core/src/ltdl.h
new file mode 100644
--- /dev/null
+++ b/synfig-core/src/ltdl.h
@@ -0,0 +1,113 @@
+/*
+ * ltdl.h — libltdl 兼容层（OHOS PC 无 libltdl，module.cpp 仅用少量 lt_dl* API）。
+ *
+ * OHOS 有 dlfcn.h（dlopen/dlsym/dlerror），本 shim 把 synfig 用到的 libltdl API
+ * 映射到 dlfcn，行为语义与 libltdl 一致：
+ *   - lt_dlinit/lt_dlexit       → no-op（dlopen 无需显式初始化）
+ *   - lt_dlerror                → dlerror()
+ *   - lt_dladdsearchdir         → 记录搜索目录（lt_dlopenext 用）
+ *   - lt_dlopenext              → 依次尝试 <dir>/<name>、<dir>/lib<name>.so
+ *   - lt_dlsym                  → dlsym
+ *
+ * 仅静态链接到 synfig-core；本 shim 不提供完整 libltdl ABI。
+ */
+#ifndef SYNFG_LTDL_SHIM_H
+#define SYNFG_LTDL_SHIM_H
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void *lt_dlhandle;
+
+static inline int
+lt_dlinit(void)
+{
+	return 0;
+}
+
+static inline int
+lt_dlexit(void)
+{
+	return 0;
+}
+
+static inline const char *
+lt_dlerror(void)
+{
+	return dlerror();
+}
+
+#define LT_SEARCH_DIRS_MAX 32
+static const char *lt_search_dirs[LT_SEARCH_DIRS_MAX];
+static int lt_search_dirs_n = 0;
+
+static inline int
+lt_dladdsearchdir(const char *dir)
+{
+	if (lt_search_dirs_n < LT_SEARCH_DIRS_MAX) {
+		lt_search_dirs[lt_search_dirs_n++] = dir;
+		return 0;
+	}
+	return 1;
+}
+
+static inline lt_dlhandle
+lt_dlopenext(const char *name)
+{
+	void *h = NULL;
+	char *cand;
+	size_t len;
+	int i;
+
+	if (!name)
+		return NULL;
+	/* 先按原样试 */
+	h = dlopen(name, RTLD_LAZY | RTLD_LOCAL);
+	if (h)
+		return h;
+	/* 再试 lib<name>.so */
+	len = strlen(name);
+	cand = (char *)malloc(len + 8);
+	if (cand) {
+		sprintf(cand, "lib%s.so", name);
+		h = dlopen(cand, RTLD_LAZY | RTLD_LOCAL);
+		free(cand);
+		if (h)
+			return h;
+	}
+	/* 逐搜索目录试 dir/name 与 dir/lib<name>.so */
+	for (i = 0; i < lt_search_dirs_n; ++i) {
+		size_t dlen = strlen(lt_search_dirs[i]);
+		cand = (char *)malloc(dlen + len + 16);
+		if (!cand)
+			continue;
+		sprintf(cand, "%s/%s", lt_search_dirs[i], name);
+		h = dlopen(cand, RTLD_LAZY | RTLD_LOCAL);
+		if (!h) {
+			sprintf(cand, "%s/lib%s.so", lt_search_dirs[i], name);
+			h = dlopen(cand, RTLD_LAZY | RTLD_LOCAL);
+		}
+		free(cand);
+		if (h)
+			return h;
+	}
+	return NULL;
+}
+
+static inline void *
+lt_dlsym(lt_dlhandle handle, const char *symbol)
+{
+	return dlsym(handle, symbol);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SYNFG_LTDL_SHIM_H */
