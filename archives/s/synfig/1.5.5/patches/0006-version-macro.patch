diff --git a/synfig-core/src/tool/CMakeLists.txt b/synfig-core/src/tool/CMakeLists.txt
--- a/synfig-core/src/tool/CMakeLists.txt	2026-08-02 20:31:02.005121094 +0800
+++ b/synfig-core/src/tool/CMakeLists.txt	2026-08-02 20:31:08.757117969 +0800
@@ -9,6 +9,15 @@
     cxx_override
 )
 
+# HarmonyOS: the autotools build defines VERSION/PACKAGE via config.h, but the
+# CMake build does not - definitions.h then falls back to VERSION "unknown",
+# so `synfig --version` prints "synfig-tool unknown". Define them here so the
+# CLI reports the real version (and PACKAGE so the #ifndef fallback is skipped).
+target_compile_definitions(synfig_bin PRIVATE
+    VERSION="1.5.5"
+    PACKAGE="synfig-tool"
+)
+
 target_sources(synfig_bin
     PRIVATE
         "${CMAKE_CURRENT_LIST_DIR}/definitions.cpp"
