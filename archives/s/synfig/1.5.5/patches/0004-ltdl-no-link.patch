diff --git a/synfig-core/src/synfig/CMakeLists.txt b/synfig-core/src/synfig/CMakeLists.txt
--- a/synfig-core/src/synfig/CMakeLists.txt
+++ b/synfig-core/src/synfig/CMakeLists.txt
@@ -24,5 +24,14 @@
 else()
     set(LTDL_LIBRARIES ltdl)
 endif()
 
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS" OR CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+    # OHOS has no libltdl.  The lt_dl* symbols used by module.cpp are provided
+    # by the ltdl.h shim (mapped onto dlfcn, which lives in libc), so no extra
+    # library needs to be linked.  Note: ohos.toolchain.cmake sets
+    # CMAKE_SYSTEM_NAME=OHOS (conan's CMakeToolchain uses "HarmonyOS"); match
+    # both spellings so the guard fires regardless of which toolchain is used.
+    set(LTDL_LIBRARIES "")
+endif()
+
 target_include_directories(libsynfig PUBLIC ${LTDL_INCLUDE_DIRS})
