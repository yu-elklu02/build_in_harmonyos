--- a/test/test_prelude.sh
+++ b/test/test_prelude.sh
@@ -28,8 +28,18 @@
 #
 # Remember where we came from, so that we can refer back to it as necessary.
 #
-here=$(pwd)
-test $? -eq 0 || exit 2
+# OHOS/HMDFS: getcwd(3) may fail ("cannot access parent directories").
+# Prefer an absolute path injected by CTest, then PWD, then pwd(1).
+#
+if [ -n "${SRECORD_TEST_HERE:-}" ]
+then
+    here=$SRECORD_TEST_HERE
+elif [ -n "${PWD:-}" ] && [ -d "$PWD" ]
+then
+    here=$PWD
+else
+    here=$(pwd 2>/dev/null) || here=${TMPDIR:-${HOME:-/tmp}}
+fi
 arch=${1-.}
 bindir=$here/$arch/bin
 
@@ -39,7 +49,11 @@
 # tests can be run even if the development directory is read only (e.g.
 # for reviewers).
 #
-testdir=/tmp/srecord-$$
+# Prefer TMPDIR: HarmonyOS /tmp is often read-only (erofs).
+# Fall back to $HOME/tmp, then /tmp for conventional Unix hosts.
+tmpdir=${TMPDIR:-${HOME:+$HOME/tmp}}
+tmpdir=${tmpdir:-/tmp}
+testdir=$tmpdir/srecord-$$
 
 #
 # The tear_down function is used by all the ways of leaving a test
