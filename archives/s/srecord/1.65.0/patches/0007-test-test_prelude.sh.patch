--- a/test/test_prelude.sh
+++ b/test/test_prelude.sh
@@ -120,9 +120,27 @@
 # On cygwin, we need to have diff ignore the CR in CRLF sequences
 # otherwise we see diff output which looks to be identical but which
 # diff things differs.  And it does, by a carriage return.
-if diff --strip-trailing-cr /dev/null /dev/null > /dev/null 2>&1
+#
+# HarmonyOS: PATH may surface toybox /usr/bin/diff first, which lacks
+# -c (context) and --strip-trailing-cr support, breaking tests that
+# use `diff -c` (e.g. t0015a.sh / t0016a.sh). Probe diff candidates
+# and prefer one that supports both --strip-trailing-cr and -c
+# (GNU diffutils); fall back to whichever diff is in PATH if GNU
+# diff is unavailable.
+diffpath=
+for candidate in /data/service/hnp/bin/diff `command -v diff`
+do
+    [ -n "$candidate" ] || continue
+    [ -x "$candidate" ] || continue
+    if "$candidate" --strip-trailing-cr /dev/null /dev/null >/dev/null 2>&1 \
+        && "$candidate" -c /dev/null /dev/null >/dev/null 2>&1
+    then
+        diffpath=$candidate
+        break
+    fi
+done
+if [ -n "$diffpath" ]
 then
-    diffpath=`which diff`
     diff() {
         $diffpath --strip-trailing-cr "$@"
     }
