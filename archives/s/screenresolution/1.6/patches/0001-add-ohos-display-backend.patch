diff --git a/main_ohos.c b/main_ohos.c
new file mode 100644
index 0000000..4a17073
--- /dev/null
+++ b/main_ohos.c
@@ -0,0 +1,105 @@
+/*
+ * OHOS backend for screenresolution.
+ *
+ * The upstream program is a macOS CoreGraphics tool. HarmonyOS exposes
+ * read-only default-display metrics through NativeDisplayManager, so this
+ * backend supports `get` and `-version` and reports unsupported operations
+ * explicitly instead of pretending to change display modes.
+ */
+#include "version.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <window_manager/oh_display_manager.h>
+
+#define DEFAULT_DEPTH 32
+
+static int readDefaultDisplay(int32_t *width, int32_t *height, uint32_t *refreshRate) {
+    NativeDisplayManager_ErrorCode rc;
+
+    rc = OH_NativeDisplayManager_GetDefaultDisplayWidth(width);
+    if (rc != DISPLAY_MANAGER_OK) {
+        fprintf(stderr, "Error: failed to get default display width: %d\n", (int)rc);
+        return 0;
+    }
+
+    rc = OH_NativeDisplayManager_GetDefaultDisplayHeight(height);
+    if (rc != DISPLAY_MANAGER_OK) {
+        fprintf(stderr, "Error: failed to get default display height: %d\n", (int)rc);
+        return 0;
+    }
+
+    rc = OH_NativeDisplayManager_GetDefaultDisplayRefreshRate(refreshRate);
+    if (rc != DISPLAY_MANAGER_OK) {
+        fprintf(stderr, "Error: failed to get default display refresh rate: %d\n", (int)rc);
+        return 0;
+    }
+
+    if (*width <= 0 || *height <= 0 || *refreshRate == 0) {
+        fprintf(stderr,
+                "Error: invalid default display metrics: %dx%dx%d@%u\n",
+                *width,
+                *height,
+                DEFAULT_DEPTH,
+                *refreshRate);
+        return 0;
+    }
+
+    return 1;
+}
+
+static int printCurrentMode(void) {
+    int32_t width = 0;
+    int32_t height = 0;
+    uint32_t refreshRate = 0;
+
+    if (!readDefaultDisplay(&width, &height, &refreshRate)) {
+        return 0;
+    }
+
+    printf("Display 0: %dx%dx%d@%u\n", width, height, DEFAULT_DEPTH, refreshRate);
+    return 1;
+}
+
+static void printUnsupported(const char *command, const char *reason) {
+    fprintf(stderr,
+            "Error: %s is not supported on OHOS NativeDisplayManager backend: %s\n",
+            command,
+            reason);
+}
+
+int main(int argc, const char *argv[]) {
+    if (argc <= 1) {
+        fprintf(stderr, "Incorrect command line\n");
+        return 1;
+    }
+
+    if (strcmp(argv[1], "-version") == 0) {
+        printf("screenresolution version %s\nLicensed under GPLv2\n", VERSION);
+        return 0;
+    }
+
+    if (strcmp(argv[1], "get") == 0) {
+        return printCurrentMode() ? 0 : 1;
+    }
+
+    if (strcmp(argv[1], "list") == 0) {
+        printUnsupported(
+            "list",
+            "the public C API used here exposes current default-display metrics, not the full switchable mode list");
+        return 1;
+    }
+
+    if (strcmp(argv[1], "set") == 0) {
+        printUnsupported(
+            "set",
+            "the public C API used here does not expose a physical display mode setter");
+        return 1;
+    }
+
+    fprintf(stderr, "Unknown command: %s\n", argv[1]);
+    return 1;
+}
