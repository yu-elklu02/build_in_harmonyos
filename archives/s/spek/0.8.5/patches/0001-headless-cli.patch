+++ b/src/spek-cli.cc	2026-07-18 11:11:29.352935000 +0800
@@ -0,0 +1,233 @@
+/* spek-cli.cc — Headless CLI spectrum analyser
+ * Built when --disable-gui is passed to configure.
+ * Uses libspek.a (FFmpeg + wxBase) to decode audio and compute FFT.
+ * Outputs spectrum data as CSV: time(ms), band0, band1, ..., bandN
+ */
+#include <cmath>
+#include <cstdio>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "spek-audio.h"
+#include "spek-fft.h"
+#include "spek-pipeline.h"
+
+// Pipeline callback: collect spectrum data per sample
+static void spectrum_cb(int bands, int sample, float *values, void *cb_data)
+{
+    auto *out = static_cast<FILE *>(cb_data);
+    // Write CSV header on the first callback, once we know the band count.
+    // Replaces the old fprintf(output, "sample") at pipeline creation time
+    // which lacked a newline and concatenated with the first data row
+    // ("sample0,val0,..."). Header is sample + band0..bandN.
+    static bool header_written = false;
+    if (!header_written) {
+        fprintf(out, "sample");
+        for (int i = 0; i < bands; i++) {
+            fprintf(out, ",band%d", i);
+        }
+        fprintf(out, "\n");
+        header_written = true;
+    }
+    // Print time in milliseconds
+    fprintf(out, "%d", sample);
+    // Print magnitudes for each frequency band
+    for (int i = 0; i < bands; i++) {
+        fprintf(out, ",%.2f", values[i]);
+    }
+    fprintf(out, "\n");
+}
+
+static void print_usage(const char *prog)
+{
+    fprintf(stderr, "Usage: %s [options] <audio-file>\n", prog);
+    fprintf(stderr, "Options:\n");
+    fprintf(stderr, "  --stream N     Audio stream index (default: 0)\n");
+    fprintf(stderr, "  --channel N    Channel index (default: 0)\n");
+    fprintf(stderr, "  --samples N    FFT samples (default: 1024, must be power of 2)\n");
+    fprintf(stderr, "  --window TYPE  Window function: hann, hamming, blackman_harris (default: hann)\n");
+    fprintf(stderr, "  --output FILE  Output file (default: stdout)\n");
+    fprintf(stderr, "  --info         Print file info and exit\n");
+    fprintf(stderr, "  --help         Show this help\n");
+}
+
+static int parse_window(const char *name)
+{
+    if (strcmp(name, "hann") == 0) return WINDOW_HANN;
+    if (strcmp(name, "hamming") == 0) return WINDOW_HAMMING;
+    if (strcmp(name, "blackman_harris") == 0) return WINDOW_BLACKMAN_HARRIS;
+    return -1;
+}
+
+// Parse a base-10 integer CLI argument. Returns 0 on success and stores the
+// value into *out; returns -1 on failure (non-numeric input, empty string,
+// trailing garbage, or out-of-range). Uses strtol with endptr + errno so
+// "abc" (returns 0 via atoi but is not a valid number) and overflow are
+// distinguished from a legitimate 0. Matches the project C-rule requiring
+// strtol/strtoul endptr + errno checks.
+static int parse_int_arg(const char *s, int *out)
+{
+    if (!s || !*s) return -1;
+    errno = 0;
+    char *endptr = nullptr;
+    long v = strtol(s, &endptr, 10);
+    if (errno != 0 || *endptr != '\0' || endptr == s) return -1;
+    if (v < INT_MIN || v > INT_MAX) return -1;
+    *out = (int)v;
+    return 0;
+}
+
+int main(int argc, char *argv[])
+{
+    const char *file_name = nullptr;
+    int stream = 0, channel = 0, samples = 1024;
+    int window = WINDOW_DEFAULT;
+    FILE *output = stdout;
+    const char *output_path = nullptr;  // deferred fopen — parse first, open later
+    bool info_only = false;
+
+    // Parse arguments. --output only records the path here; the actual
+    // fopen is deferred until after parsing completes (see "Open output
+    // file" below). This eliminates the file-handle leak on every early
+    // return in this loop (--help / unknown --window / unknown option /
+    // missing input file) — none of them can leak because output is still
+    // stdout at this point.
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--help") == 0) {
+            print_usage(argv[0]);
+            return 0;
+        } else if (strcmp(argv[i], "--info") == 0) {
+            info_only = true;
+        } else if (strcmp(argv[i], "--stream") == 0 && i + 1 < argc) {
+            if (parse_int_arg(argv[++i], &stream) != 0) {
+                fprintf(stderr, "Invalid --stream value: %s\n", argv[i]);
+                return 1;
+            }
+        } else if (strcmp(argv[i], "--channel") == 0 && i + 1 < argc) {
+            if (parse_int_arg(argv[++i], &channel) != 0) {
+                fprintf(stderr, "Invalid --channel value: %s\n", argv[i]);
+                return 1;
+            }
+        } else if (strcmp(argv[i], "--samples") == 0 && i + 1 < argc) {
+            if (parse_int_arg(argv[++i], &samples) != 0) {
+                fprintf(stderr, "Invalid --samples value: %s\n", argv[i]);
+                return 1;
+            }
+        } else if (strcmp(argv[i], "--window") == 0 && i + 1 < argc) {
+            window = parse_window(argv[++i]);
+            if (window < 0) {
+                fprintf(stderr, "Unknown window function: %s\n", argv[i]);
+                return 1;
+            }
+        } else if (strcmp(argv[i], "--output") == 0 && i + 1 < argc) {
+            output_path = argv[++i];
+        } else if (argv[i][0] == '-') {
+            fprintf(stderr, "Unknown option: %s\n", argv[i]);
+            print_usage(argv[0]);
+            return 1;
+        } else {
+            file_name = argv[i];
+        }
+    }
+
+    if (!file_name) {
+        fprintf(stderr, "No input file specified.\n");
+        print_usage(argv[0]);
+        return 1;
+    }
+
+    // Open output file — deferred to here so every parse-phase early return
+    // above is guaranteed not to leak a handle (output was still stdout).
+    if (output_path) {
+        output = fopen(output_path, "w");
+        if (!output) {
+            fprintf(stderr, "Cannot open output file: %s\n", output_path);
+            return 1;
+        }
+    }
+
+    // Open audio file
+    Audio audio;
+    auto file = audio.open(file_name, stream);
+    if (!file) {
+        fprintf(stderr, "Failed to open audio file: %s\n", file_name);
+        if (output != stdout) fclose(output);
+        return 1;
+    }
+
+    if (file->get_error() != AudioError::OK) {
+        fprintf(stderr, "Audio error: %s (code %d)\n", file_name,
+                static_cast<int>(file->get_error()));
+        if (output != stdout) fclose(output);
+        return 1;
+    }
+
+    // Print file info
+    fprintf(stderr, "File:     %s\n", file_name);
+    fprintf(stderr, "Codec:    %s\n", file->get_codec_name().c_str());
+    fprintf(stderr, "Sample:   %d Hz, %d bps\n", file->get_sample_rate(), file->get_bits_per_sample());
+    fprintf(stderr, "Streams:  %d, Channels: %d\n", file->get_streams(), file->get_channels());
+    fprintf(stderr, "Duration: %.2f s\n", file->get_duration());
+    fprintf(stderr, "Bitrate:  %d kbps\n", file->get_bit_rate() / 1000);
+
+    if (info_only) {
+        if (output != stdout) fclose(output);
+        return 0;
+    }
+
+    // Validate samples is power of 2
+    int nbits = 0;
+    int tmp = samples;
+    while (tmp > 1) { tmp >>= 1; nbits++; }
+    if ((1 << nbits) != samples) {
+        fprintf(stderr, "Samples must be a power of 2, got %d\n", samples);
+        if (output != stdout) fclose(output);
+        return 1;
+    }
+
+    // Create FFT
+    FFT fft;
+    auto fft_plan = fft.create(nbits);
+    if (!fft_plan) {
+        fprintf(stderr, "Failed to create FFT plan\n");
+        if (output != stdout) fclose(output);
+        return 1;
+    }
+
+    // Create pipeline
+    auto *pipeline = spek_pipeline_open(
+        std::move(file), std::move(fft_plan),
+        stream, channel,
+        static_cast<enum window_function>(window),
+        samples, spectrum_cb, output
+    );
+
+    if (!pipeline) {
+        fprintf(stderr, "Failed to create pipeline\n");
+        if (output != stdout) fclose(output);
+        return 1;
+    }
+
+    // CSV header is written by spectrum_cb on its first callback, once
+    // the band count is known (sample,band0,band1,...,bandN\n). This
+    // replaces the prior fprintf(output, "sample") here which lacked a
+    // newline and concatenated with the first data row.
+
+    // Run pipeline
+    fprintf(stderr, "Processing...\n");
+    spek_pipeline_start(pipeline);
+    spek_pipeline_close(pipeline);
+
+    fprintf(stderr, "Done.\n");
+
+    if (output != stdout) {
+        fclose(output);
+    }
+
+    return 0;
+}
