-AM_OPTIONS_WXCONFIG
-reqwx=3.0.0
-AM_PATH_WXCONFIG($reqwx, wx=1)
-if test "$wx" != 1; then
-	AC_MSG_ERROR([
-		wxWidgets must be installed on your system.
+# --disable-gui: build headless CLI tool instead of the GUI binary
+AC_ARG_ENABLE([gui],
+    AS_HELP_STRING([--disable-gui], [Build headless CLI tool instead of GUI binary]),
+    [build_gui=$enableval],
+    [build_gui=yes]
+)
 
-		Please check that wx-config is in path, the directory
-		where wxWidgets libraries are installed (returned by
-		'wx-config --libs' or 'wx-config --static --libs' command)
-		is in LD_LIBRARY_PATH or equivalent variable and
-		wxWidgets version is $reqwx or above.
-		])
-fi
+AM_CONDITIONAL([BUILD_GUI], [test "x$build_gui" = xyes])
+AC_DEFINE_UNQUOTED([HAVE_GUI], [`test "x$build_gui" = xyes && echo 1 || echo 0`], [GUI support])
 
+AS_IF([test "x$build_gui" = xyes], [
+    AM_OPTIONS_WXCONFIG
+    reqwx=3.0.0
+    AM_PATH_WXCONFIG($reqwx, wx=1)
+    if test "$wx" != 1; then
+        AC_MSG_ERROR([
+            wxWidgets must be installed on your system.
+
+            Please check that wx-config is in path, the directory
+            where wxWidgets libraries are installed (returned by
+            'wx-config --libs' or 'wx-config --static --libs' command)
+            is in LD_LIBRARY_PATH or equivalent variable and
+            wxWidgets version is $reqwx or above.
+            ])
+    fi
+])
+
 GETTEXT_PACKAGE=spek
 AC_DEFINE_UNQUOTED([GETTEXT_PACKAGE], ["$GETTEXT_PACKAGE"], [Gettext Package])
 AC_SUBST(GETTEXT_PACKAGE)
