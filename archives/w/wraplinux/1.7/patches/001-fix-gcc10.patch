Description: Fix FTBFS with GCC-10 (extern opt global)

 Forwarded from Debian fix-gcc10.patch (Bug-Debian: 957960).
 wraplinux-1.7 defines `struct opt opt` in wraplinux.h (a header) which yields
 duplicate storage across translation units under GCC-10+ / newer linkers.
 Move the storage to main.c and declare it extern in the header.

Author: Sudip Mukherjee <sudipm.mukherjee@gmail.com>

--- a/main.c
+++ b/main.c
@@ -30,6 +30,7 @@
 #include "version.h"
 
 const char *program;
+struct opt opt;
 
 enum longopts {
 	OPT_NOLOADHIGH  = 256,
--- a/wraplinux.h
+++ b/wraplinux.h
@@ -31,7 +31,8 @@ struct opt {
 	const char *params;
 	int (*output) (struct segment *, addr_t, FILE *);
 	bool loadhigh;
-} opt;
+};
+extern struct opt opt;
 
 struct string_list {
 	struct string_list *next;
