--- a/build-aux/config.guess	2026-08-06 21:08:09.302761718 +0800
+++ b/build-aux/config.guess	2026-08-06 21:09:17.414760781 +0800
@@ -101,7 +101,9 @@
 set_cc_for_build() {
     # prevent multiple calls if $tmp is already set
     test "$tmp" && return 0
-    : "${TMPDIR=/tmp}"
+    # Use portable tmp directory (HarmonyOS /tmp is read-only)
+    : "${TMPDIR:=$HOME/tmp}"
+    mkdir -p "$TMPDIR" 2>/dev/null || true
     # shellcheck disable=SC2039
     { tmp=$( (umask 077 && mktemp -d "$TMPDIR/cgXXXXXX") 2>/dev/null) && test -n "$tmp" && test -d "$tmp" ; } ||
 	{ test -n "$RANDOM" && tmp=$TMPDIR/cg$$-$RANDOM && (umask 077 && mkdir "$tmp" 2>/dev/null) ; } ||
@@ -143,7 +145,9 @@
 	set_cc_for_build
 	cat <<-EOF > "$dummy.c"
 	#include <features.h>
-	#if defined(__UCLIBC__)
+	#if defined(__OHOS__)
+	LIBC=ohos
+	#elif defined(__UCLIBC__)
 	LIBC=uclibc
 	#elif defined(__dietlibc__)
 	LIBC=dietlibc
@@ -177,6 +181,18 @@
 # Note: order is significant - the case branches are not exclusive.
 
 case "$UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION" in
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) MACHINE=aarch64 ;;
+	    armv7*|armv8*) MACHINE=arm ;;
+	    x86_64|amd64)  MACHINE=x86_64 ;;
+	    i?86)         MACHINE=i686 ;;
+	    *)            MACHINE="$UNAME_MACHINE" ;;
+	esac
+	GUESS=${MACHINE}-unknown-linux-ohos
+	echo "$GUESS"
+	exit ;;
+
     *:NetBSD:*:*)
 	# NetBSD (nbsd) targets should (where applicable) match one or
 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
