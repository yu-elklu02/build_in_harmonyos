--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -506,5 +506,16 @@ add_executable(nekotools ${CMAKE_BINARY_DIR}/nekotools.c)
 target_link_libraries(nekotools libneko)
 
+# Keep runtime lookup relocatable. During the build all targets are emitted to
+# bin/, while installation puts executables in bin/ and libneko in lib/.
+if(NEKO_TARGET_OHOS)
+    foreach(neko_executable nekovm nekoc nekotools)
+        set_target_properties(${neko_executable} PROPERTIES
+            BUILD_RPATH "$ORIGIN"
+            INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}"
+        )
+    endforeach()
+endif()
+
 if (WITH_NEKOML)
 	file(GLOB CORE_NMLS RELATIVE ${CMAKE_SOURCE_DIR}/src src/core/*.nml)
 	set(nekoml_std ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/nekoml.std)
