+        IF(NOT HAVE_PTHREAD_CANCEL)
+                ADD_DEFINITIONS("-DGC_NO_PTHREAD_CANCEL")
+                MESSAGE("pthread_cancel unavailable: disabling cancellation interception")
+        ENDIF()
         MESSAGE("Thread Model: ${CMAKE_THREAD_LIBS_INIT}" )
         INCLUDE_DIRECTORIES(${Threads_INCLUDE_DIR})
         SET(LIBS ${LIBS} ${Threads_LIBRARIES})
