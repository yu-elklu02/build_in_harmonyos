 OPTION(enable_threads "TODO" NO)
 IF(enable_threads)
         FIND_PACKAGE(Threads REQUIRED)
+        SET(CMAKE_REQUIRED_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+        CHECK_SYMBOL_EXISTS(
+                pthread_setcancelstate
