--- a/cmake/dependencies.cmake
+++ b/cmake/dependencies.cmake
@@ -135,6 +135,22 @@
   # First, find the C and HL libraries.
   #####
   find_package(HDF5 COMPONENTS C HL REQUIRED)
+
+  # conan 的 CMakeDeps 只声明一个扁平目标 hdf5::hdf5（其 cpp_info.libs 由
+  # collect_libs() 收全，已包含 libhdf5_hl），而本项目按 FindHDF5 的惯例
+  # 分别写 HDF5::HDF5（11 处）与 hdf5::hdf5_hl（4 处）。CMake 目标名大小写敏感，
+  # 链接期会报 `links to: HDF5::HDF5 but the target was not found`。
+  # 这里一次补齐两个别名，覆盖后续所有引用点。
+  # IMPORTED 目标默认只在创建它的目录可见，ALIAS 之前须先提升为 GLOBAL。
+  if(TARGET hdf5::hdf5)
+    set_target_properties(hdf5::hdf5 PROPERTIES IMPORTED_GLOBAL TRUE)
+    if(NOT TARGET HDF5::HDF5)
+      add_library(HDF5::HDF5 ALIAS hdf5::hdf5)
+    endif()
+    if(NOT TARGET hdf5::hdf5_hl)
+      add_library(hdf5::hdf5_hl ALIAS hdf5::hdf5)
+    endif()
+  endif()
 
   message(STATUS "Found HDF5 version: ${HDF5_VERSION}")
   if(${HDF5_VERSION} VERSION_LESS ${HDF5_VERSION_REQUIRED})
