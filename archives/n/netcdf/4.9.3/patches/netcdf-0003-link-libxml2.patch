--- a/cmake/dependencies.cmake
+++ b/cmake/dependencies.cmake
@@ -495,6 +495,18 @@
       PRIVATE
         ${LIBXML2_INCLUDE_DIRS}
     )
+    # 上游只加了头目录、**从未链接** libxml2，而 libnetcdf.so 确实引用了
+    # xmlReadMemory / xmlCleanupParser 等符号。glibc 平台默认允许共享库留
+    # 未定义符号（运行期再解析），所以上游 CI 一直发现不了；OHOS 默认带
+    # --no-allow-shlib-undefined，链接期直接报一串 undefined reference。
+    # 目标名按实际存在的挑：conan 的 CMakeDeps 与上游 FindLibXml2 命名不同。
+    if(TARGET LibXml2::LibXml2)
+      target_link_libraries(netcdf PRIVATE LibXml2::LibXml2)
+    elseif(TARGET libxml2::libxml2)
+      target_link_libraries(netcdf PRIVATE libxml2::libxml2)
+    else()
+      target_link_libraries(netcdf PRIVATE ${LIBXML2_LIBRARIES})
+    endif()
     set(XMLPARSER "libxml2")
   else()
     set(HAVE_LIBXML2 FALSE)
