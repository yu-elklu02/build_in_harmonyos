 package Object::Event;
-use common::sense;
+use strict;
+no strict 'refs';
+use warnings;
+use feature qw(say state switch);
+no warnings 'uninitialized';
 use Carp qw/croak/;
-use AnyEvent::Util qw/guard/;
 
 use sort 'stable';
 
+# Minimal guard implementation replacing AnyEvent::Util::guard.
+# Creates a scope-guard object whose DESTROY runs the callback,
+# so reg_cb's return value can auto-unregister on scope exit.
+sub guard(&) {
+    my $cb = shift;
+    return bless \$cb, 'Object::Event::Guard';
+}
+
+package Object::Event::Guard;
+sub DESTROY { ${$_[0]}->() if ${$_[0]} }
+
+package Object::Event;
+
 our $DEBUG = $ENV{PERL_OBJECT_EVENT_DEBUG};
 
