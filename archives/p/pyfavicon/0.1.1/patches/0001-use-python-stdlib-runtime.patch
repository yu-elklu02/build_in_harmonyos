+class _FaviconHTMLParser(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.sources = []
+
+    def handle_starttag(self, tag, attrs):
+        attrs = {name.lower(): value for name, value in attrs}
+        if tag == 'link' and 'href' in attrs and _rel_matches(attrs.get('rel')):
+            self.sources.append(attrs['href'])
+        if tag == 'meta' and 'content' in attrs:
+            name = attrs.get('name', '')
+            if name.lower() in {item.lower() for item in META_NAMES}:
+                self.sources.append(attrs['content'])
+
+
+def _rel_matches(value):
+    if not value:
+        return False
+    rel = ' '.join(value.lower().split())
+    return rel in LINK_RELS or any(item in rel.split() for item in LINK_RELS)
+
+
+async def _run_blocking(func, *args):
+    loop = asyncio.get_event_loop()
+    return await loop.run_in_executor(None, functools.partial(func, *args))
+
+
+def _read_url(url, headers):
+    request = urllib.request.Request(str(url), headers=headers or {})
+    with urllib.request.urlopen(request, timeout=10) as response:
+        final_url = response.geturl()
+        return response.read(), final_url
+
+
+def _image_info(data):
+    if data.startswith(b'\x89PNG\r\n\x1a\n') and len(data) >= 24:
+        width, height = struct.unpack('>II', data[16:24])
+        return (width, height), 'png'
+    if data[:6] in (b'GIF87a', b'GIF89a') and len(data) >= 10:
+        width, height = struct.unpack('<HH', data[6:10])
+        return (width, height), 'gif'
+    if data.startswith(b'\x00\x00\x01\x00') and len(data) >= 8:
+        width = data[6] or 256
+        height = data[7] or 256
+        return (width, height), 'ico'
+    if data.startswith(b'\xff\xd8'):
+        offset = 2
+        while offset + 9 < len(data):
+            if data[offset] != 0xFF:
+                offset += 1
+                continue
+            marker = data[offset + 1]
+            offset += 2
+            if marker in (0xD8, 0xD9):
+                continue
+            if offset + 2 > len(data):
+                break
+            length = struct.unpack('>H', data[offset:offset + 2])[0]
+            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
+                if offset + 7 <= len(data):
+                    height, width = struct.unpack('>HH', data[offset + 3:offset + 7])
+                    return (width, height), 'jpeg'
+                break
+            offset += length
+    return (-1, -1), None
+
