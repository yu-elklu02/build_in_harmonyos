diff --git a/config/arch-osname b/config/arch-osname
index 00afcbe..739f4b8 100755
--- a/config/arch-osname
+++ b/config/arch-osname
@@ -7,6 +7,13 @@ if test -n "$myuname"; then
 	  env LC_ALL=C tr '[A-Z]' '[a-z]' | tr '\012' ' '`
   set X $myuname; shift; osname=$1
   case "$osname" in
+  # HarmonyOS：`uname -a` 报 harmonyos，原本无分支命中 → arch 保持初值 none，
+  # 构建目录退化成 O<osname>-none，且**不产共享库**、汇编内核选成通用 C 实现。
+  # 它是 ELF + aarch64 的类 Linux 目标，按 linux 处理即可。
+  harmonyos*|ohos*)
+            arch=`uname -m`
+            if test -z "$arch"; then arch=aarch64; fi
+            osname=linux;;
   irix*)    osname=irix;;
   fx2800)   arch=fx2800; osname=concentrix;;
   hp*)      osname=hpux; arch=`uname -m`
