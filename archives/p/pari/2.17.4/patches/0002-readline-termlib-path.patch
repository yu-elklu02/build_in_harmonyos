diff --git a/config/get_readline b/config/get_readline
index 2972140..4c0522f 100644
--- a/config/get_readline
+++ b/config/get_readline
@@ -40,6 +40,13 @@ for tlib in "" tinfow tinfo ncursesw ncurses termcap; do
   t=$rl
   if test -n "$tlib"; then # need a termcap compatible library?
     eval with="\$with_${tlib}_lib"
+    # Configure 只解析 --with-ncurses-lib（见 config/get_config_options），
+    # 没有 --with-ncursesw-lib / --with-tinfo-lib 之类；于是 ncursesw / tinfow
+    # 这些候选**永远拿不到 -L**，在「终端库只以宽字符变体存在」的发行版上
+    # （例如只提供 libncursesw.a）readline 探测必然全军覆没，
+    # 然后静默退回「不启用 readline」——库照样建成，下游编译才炸。
+    # 这里让没有专属路径变量的候选回退用 --with-ncurses-lib 给的目录。
+    if test -z "$with"; then with="$with_ncurses_lib"; fi
     if test -n "$with"; then
       t="$t -L$with -l$tlib"
     else
