index 0000000..5651319
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,13 @@
+cmake_minimum_required(VERSION 3.10)
+project(pikapython VERSION 1.14.0 LANGUAGES C)
+set(CMAKE_C_STANDARD 11)
+add_compile_options(-Wno-error)
+
+# Build the PikaPython core as a static library
+file(GLOB PIKA_SRC "src/*.c")
+add_library(pika-core STATIC ${PIKA_SRC})
+target_include_directories(pika-core PUBLIC src)
+
+install(TARGETS pika-core ARCHIVE DESTINATION lib)
+install(DIRECTORY src/ DESTINATION include/pika
+  FILES_MATCHING PATTERN "*.h")
