+# HarmonyOS exposes /tmp as read-only, while HMDFS does not preserve private
+# directory modes.  Put config.status data in the app-private cache instead.
+m4_define([AS_TMPDIR],
+[# Create a (secure) tmp directory for tmp files.
+case "`uname -s 2>/dev/null`" in
+  HarmonyOS)
+    ohos_tmp_base=/data/storage/el2/base/cache
+    test -d "$ohos_tmp_base" && test -w "$ohos_tmp_base" ||
+      AS_ERROR([private HarmonyOS cache directory is unavailable])
+    tmp=$ohos_tmp_base/$1$$-$RANDOM
+    (umask 077 && mkdir "$tmp") && test -d "$tmp" ||
+      AS_ERROR([cannot create a private HarmonyOS temporary directory])
+    ;;
+  *)
+    {
+      tmp=`(umask 077 && mktemp -d "./$1XXXXXX") 2>/dev/null` &&
+      test -d "$tmp"
+    }  ||
+    {
+      tmp=./$1$$-$RANDOM
+      (umask 077 && mkdir "$tmp")
+    }
+    ;;
+esac || AS_ERROR([cannot create a secure temporary directory])])
+
 AC_OUTPUT
