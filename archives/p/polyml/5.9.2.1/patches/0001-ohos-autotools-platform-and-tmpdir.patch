+// Disable an alternate signal stack in its owning thread before that thread
+// exits and the backing allocation can be released after pthread_join.
+void releaseThreadSignals(TaskData *taskData)
+{
+#if defined(SA_ONSTACK) && defined(HAVE_SIGALTSTACK)
+    if (taskData->signalStack != 0)
+    {
+#ifdef HAVE_STACK_T
+        stack_t ex_stack;
+#else
+        struct sigaltstack ex_stack;
+#endif
+        memset(&ex_stack, 0, sizeof(ex_stack));
+        ex_stack.ss_flags = SS_DISABLE;
+        if (sigaltstack(&ex_stack, NULL) != 0)
+            taskData->signalStack = 0; // Avoid an unsafe free; leak only on disable failure.
+    }
+#else
+    (void)taskData;
+#endif
+}
+
 
 /* General purpose function to set up a signal handler. */
