+sub _probe_write_access {
+    my $dir = shift;
+    return 0 unless defined $dir && -d $dir;
+
+    my $base = File::Spec->catfile($dir, ".eu-install-write-probe-$$");
+    for my $try (0..9) {
+        my $probe = $try ? "$base-$try" : $base;
+        next if -e $probe;
+        if (open my $fh, ">", $probe) {
+            close $fh;
+            unlink $probe;
+            return 1;
+        }
+    }
+
+    return 0;
+}
