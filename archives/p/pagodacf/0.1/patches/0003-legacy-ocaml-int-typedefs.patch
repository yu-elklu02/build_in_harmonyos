--- a/cf_common_p.h
+++ b/cf_common_p.h
@@ -42,6 +42,41 @@
 #include <caml/misc.h>
 #include <caml/mlvalues.h>
 
+/*
+ * OCaml 3.x's caml/config.h provided uint64/int64/uint32/int32 as short
+ * typedef aliases for the C99 fixed-width integer types.  OCaml 4.14.1
+ * removed these short forms (only uint64_t/int64_t/uint32_t/int32_t
+ * remain).  The 2004-era cf_*_p.[ch] sources still use the short forms,
+ * so re-define them here after the caml headers are pulled in.  The
+ * guard prevents double-definition if the host toolchain ever restores
+ * the legacy aliases.
+ */
+#ifndef CF_LEGACY_INT_TYPES
+#define CF_LEGACY_INT_TYPES
+typedef uint64_t uint64;
+typedef int64_t  int64;
+typedef uint32_t uint32;
+typedef int32_t  int32;
+/*
+ * The 2004-era cf_*_p.c sources also use the historical BSD fixed-width
+ * integer typedefs (u_int8_t, u_int16_t, u_int32_t, u_int64_t) and the
+ * legacy byte/short/long typedefs (u_char, u_short, u_long) that glibc's
+ * <sys/types.h> traditionally exposed when _BSD_SOURCE/_DEFAULT_SOURCE
+ * was in effect.  OHOS's bionic libc and musl no longer define these BSD
+ * aliases, so the C compile of cf_tai64n_p.c fails with
+ * `error: unknown type name 'u_int8_t'`.  Re-define them in terms of the
+ * C99 standard fixed-width types.  The same guard above prevents
+ * double-definition if a future host libc re-exposes the BSD names.
+ */
+typedef uint8_t  u_int8_t;
+typedef uint16_t u_int16_t;
+typedef uint32_t u_int32_t;
+typedef uint64_t u_int64_t;
+typedef unsigned char  u_char;
+typedef unsigned short u_short;
+typedef unsigned long  u_long;
+#endif
+
 CAMLextern void enter_blocking_section(void);
 CAMLextern void leave_blocking_section(void);
 
