--- a/configure	2023-12-02 00:52:50.000000000 +0800
+++ b/configure	2026-08-08 00:49:17.319473281 +0800
@@ -16836,12 +16836,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(mktemp -d "$TMPDIR/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  tmp=$TMPDIR/conf$$-$RANDOM
+  (mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
