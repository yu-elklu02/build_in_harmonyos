--- a/config.guess
+++ b/config.guess
@@ -1,4 +1,14 @@
 #! /bin/sh
+# Conan OHOS config.guess hook
+machine=`(uname -m) 2>/dev/null || echo aarch64`
+system=`(uname -s) 2>/dev/null || echo unknown`
+case "$system" in
+    HarmonyOS|OHOS)
+        echo "${machine}-unknown-linux-ohos"
+        exit 0
+        ;;
+esac
+
 # Attempt to guess a canonical system name.
 #   Copyright 1992-2017 Free Software Foundation, Inc.
 
@@ -100,9 +110,9 @@ set_cc_for_build='
 trap "exitcode=\$?; (rm -f \$tmpfiles 2>/dev/null; rmdir \$tmp 2>/dev/null) && exit \$exitcode" 0 ;
 trap "rm -f \$tmpfiles 2>/dev/null; rmdir \$tmp 2>/dev/null; exit 1" 1 2 13 15 ;
 : ${TMPDIR=/tmp} ;
- { tmp=`(umask 077 && mktemp -d "$TMPDIR/cgXXXXXX") 2>/dev/null` && test -n "$tmp" && test -d "$tmp" ; } ||
- { test -n "$RANDOM" && tmp=$TMPDIR/cg$$-$RANDOM && (umask 077 && mkdir $tmp) ; } ||
- { tmp=$TMPDIR/cg-$$ && (umask 077 && mkdir $tmp) && echo "Warning: creating insecure temp directory" >&2 ; } ||
+ { tmp=`(umask 022 && mktemp -d "$TMPDIR/cgXXXXXX") 2>/dev/null` && test -n "$tmp" && test -d "$tmp" ; } ||
+ { test -n "$RANDOM" && tmp=$TMPDIR/cg$$-$RANDOM && (umask 022 && mkdir $tmp) ; } ||
+ { tmp=$TMPDIR/cg-$$ && (umask 022 && mkdir $tmp) && echo "Warning: creating insecure temp directory" >&2 ; } ||
  { echo "$me: cannot create a temporary directory in $TMPDIR" >&2 ; exit 1 ; } ;
 dummy=$tmp/dummy ;
 tmpfiles="$dummy.c $dummy.o $dummy.rel $dummy" ;
--- a/config.sub
+++ b/config.sub
@@ -1,4 +1,12 @@
 #! /bin/sh
+# Conan OHOS config.sub hook
+case "$1" in
+    *-linux-ohos|*-unknown-linux-ohos)
+        echo "$1"
+        exit 0
+        ;;
+esac
+
 # Configuration validation subroutine script.
 #   Copyright 1992-2017 Free Software Foundation, Inc.
 
--- a/configure
+++ b/configure
@@ -4945,12 +4945,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
