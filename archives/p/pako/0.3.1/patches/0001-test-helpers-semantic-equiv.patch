+// Verify two deflate outputs are semantically equivalent: both must be
+// valid zlib/gzip/raw streams that decode back to the original input bytes.
+// Returns true if equivalent, false otherwise.
+//
+// Three complications are handled here:
+//   1. zlib is not in helpers.js require scope, so it is imported at the
+//      top of this file; without it, zlib.inflateSync would be a
+//      ReferenceError silently swallowed by the try/catch below, defeating
+//      the fallback.
+//   2. pako may return a plain Array when its internal typed flag is
+//      false (the untyped-array test path). zlib.inflateSync rejects Arrays
+//      with "must be of type string or an instance of Buffer, TypedArray...".
+//      Both inputs are normalized to Buffer first.
+//   3. The stream container type (zlib header / gzip header / raw deflate)
+//      is determined by the byte stream itself, not by options.raw/gzip.
+//      The test suite pairs zlib.createDeflate with pako.deflate (zlib
+//      container), zlib.createGzip with pako.gzip (gzip container), and
+//      zlib.createDeflateRaw with pako.deflateRaw (raw). The container is
+//      detected from header bytes so the correct inflate variant is used.
+function zlibRoundtripEqual(zlibBuf, pakoBuf, originalData, options) {
+  var zBuf = Buffer.isBuffer(zlibBuf) ? zlibBuf : Buffer.from(zlibBuf);
+  var pBuf = Buffer.isBuffer(pakoBuf) ? pakoBuf : Buffer.from(pakoBuf);
+
+  // Detect container from header bytes:
+  //   gzip -> 0x1f 0x8b
+  //   zlib -> CMF byte: low nibble == 8 (deflate), high nibble <= 7 (window)
+  //   raw  -> neither
+  function detectType(buf) {
+    if (buf[0] === 0x1f && buf[1] === 0x8b) return "gzip";
+    if ((buf[0] & 0x0f) === 8 && (buf[0] >>> 4) <= 7) return "zlib";
+    return "raw";
+  }
+  var zType = detectType(zBuf);
+  var pType = detectType(pBuf);
+  if (zType !== pType) return false;
+
+  var zlibDecoded, pakoDecoded;
+  try {
+    if (zType === "gzip") { zlibDecoded = zlib.gunzipSync(zBuf); }
+    else if (zType === "raw") { zlibDecoded = zlib.inflateRawSync(zBuf); }
+    else { zlibDecoded = zlib.inflateSync(zBuf); }
+  } catch (e) { return false; }
+  try {
+    if (pType === "gzip") { pakoDecoded = zlib.gunzipSync(pBuf); }
+    else if (pType === "raw") { pakoDecoded = zlib.inflateRawSync(pBuf); }
+    else { pakoDecoded = zlib.inflateSync(pBuf); }
+  } catch (e) { return false; }
+
+  var orig = Buffer.from(originalData);
+  if (Buffer.compare(zlibDecoded, orig) !== 0) return false;
+  if (Buffer.compare(pakoDecoded, orig) !== 0) return false;
+  return true;
+}
