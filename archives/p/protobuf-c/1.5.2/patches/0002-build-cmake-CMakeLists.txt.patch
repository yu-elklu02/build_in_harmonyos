 cmake_policy(SET CMP0091 NEW)
 cmake_policy(SET CMP0112 NEW)
 
 project(protobuf-c C CXX)
 
 if(MSVC AND NOT BUILD_SHARED_LIBS)
   set(Protobuf_USE_STATIC_LIBS ON)
 endif()
 
-find_package(Protobuf CONFIG)
-if(Protobuf_FOUND)
