From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] OHOS: mark fontconfig-dependent tests as failing suite

--- a/tests/meson.build
+++ b/tests/meson.build
@@ -303,10 +303,22 @@
                    install: get_option('install-tests'),
                    install_dir: installed_test_bindir)
 
+  # OHOS native sandbox: no fonts.conf / system fonts. These ERROR with
+  # "Cannot load default config file" (layout/font/hb assertions). Mark as
+  # Meson 'failing' suite (glib can_fail -> suite += 'failing') so conanfile
+  # excludes via --no-suite=failing; other failures still fail the build.
+  test_suites = ['pango']
+  _ohos_fc_fail = ['test-font', 'test-fonts', 'test-layout',
+                   'test-bidi', 'testiter', 'test-ellipsize',
+                   'test-harfbuzz', 'testmisc']
+  if host_system == 'harmonyos' and name in _ohos_fc_fail
+    test_suites += ['failing']
+  endif
+
   test(name, bin,
     args: ['-k', '--tap'],
     env: test_env,
-    suite: 'pango',
+    suite: test_suites,
     protocol: 'tap',
   )
 endforeach
