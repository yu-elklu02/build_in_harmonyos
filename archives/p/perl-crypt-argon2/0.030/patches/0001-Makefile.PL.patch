--- /dev/null
+++ b/Makefile.PL
@@ -0,0 +1,72 @@
+use strict;
+use warnings;
+use ExtUtils::MakeMaker;
+
+# C sources (aarch64: no SSE3/AVX optimizations, only ref implementation)
+my @c_sources = qw(
+    src/argon2.c
+    src/core.c
+    src/encoding.c
+    src/thread.c
+    src/blake2/blake2b.c
+    src/switch.c
+    src/ref.c
+);
+
+my @o_files = map { my $o = $_; $o =~ s/\.c$/\$(OBJ_EXT)/; $o } @c_sources;
+
+WriteMakefile(
+    NAME             => 'Crypt::Argon2',
+    VERSION_FROM     => 'lib/Crypt/Argon2.pm',
+    LICENSE          => 'apache_2_0',
+    AUTHOR           => 'Leon Timmermans <leont@cpan.org>',
+    ABSTRACT_FROM    => 'lib/Crypt/Argon2.pm',
+    TYPEMAPS         => ['typemap'],
+    XS               => { 'lib/Crypt/Argon2.xs' => 'lib/Crypt/Argon2.c' },
+    INC              => '-Iinclude',
+    LIBS             => ['-lpthread'],
+    PREREQ_PM        => {
+        'Exporter'   => '5.57',
+        'Time::HiRes' => 0,
+        'XSLoader'   => 0,
+    },
+    TEST_REQUIRES    => {
+        'Test::More' => '0.90',
+    },
+    META_MERGE       => {
+        'meta-spec' => { version => 2 },
+        resources   => {
+            repository => {
+                type => 'git',
+                url  => 'git://github.com/Leont/crypt-argon2.git',
+                web  => 'https://github.com/Leont/crypt-argon2',
+            },
+            bugtracker => {
+                web => 'https://github.com/Leont/crypt-argon2/issues',
+            },
+        },
+    },
+    OBJECT           => join(' ', @o_files, '$(BASEEXT)$(OBJ_EXT)'),
+    clean            => { FILES => 'lib/Crypt/Argon2.c *.o src/*.o src/blake2/*.o' },
+);
+
+# Postamble: compile C sources manually with correct output paths
+sub MY::postamble {
+    my $self = shift;
+    my @rules;
+    for my $src (@c_sources) {
+        my $obj = $src;
+        $obj =~ s/\.c$/\$(OBJ_EXT)/;
+        push @rules, <<EOF;
+$obj: $src
+	\$(CC) \$(CCFLAGS) \$(OPTIMIZE) \$(CCCDLFLAGS) \$(INC) -c $src -o $obj
+EOF
+    }
+    # Rule for XS-generated Argon2.c
+    push @rules, <<EOF;
+Argon2\$(OBJ_EXT): lib/Crypt/Argon2.c
+	\$(CC) \$(CCFLAGS) \$(OPTIMIZE) \$(INC) -DVERSION=\\"0.030\\" -DXS_VERSION=\\"0.030\\" -fPIC "-I\$(PERL_INC)" -c lib/Crypt/Argon2.c -o Argon2\$(OBJ_EXT)
+EOF
+    return join("\n", @rules);
+}
+
