diff --git a/myldr/Makefile.PL b/myldr/Makefile.PL
index 1f762e5..3ac058b 100644
--- a/myldr/Makefile.PL
+++ b/myldr/Makefile.PL
@@ -63,13 +63,33 @@ my $gccversion = $Config{gccversion};
 # NOTE: on some platforms, ccopts or ldopts may contain newlines
 chomp( my $pccflags = ccopts() );
 chomp( my $pldflags = ldopts() );
+
+# OHOS: strip -fstack-protector-strong from linker flags (ld.lld doesn't support it)
+$pccflags =~ s/-fstack-protector-strong\s*//g;
+$pldflags =~ s/-fstack-protector-strong\s*//g;
 my $dynperl = $Config{useshrplib} && ($Config{useshrplib} ne 'false');
 
 $dynperl = 1 if $pldflags =~ /\B-lperl\b/; # Gentoo lies to us!
 
-my $cc = $Config{cc};
+# OHOS: ldd is not available, create a wrapper using readelf
+if ($^O eq 'OHOS' && !-x "/usr/bin/ldd" && !-x "/bin/ldd") {
+    my $tmpdir = $ENV{TMPDIR} || "/tmp";
+    my $ldd_script = "$tmpdir/ldd";
+    open my $fh, '>', $ldd_script or die "Cannot create ldd wrapper: $!";
+    print $fh "#!/system/bin/sh\n";
+    print $fh 'readelf -d "$1" 2>/dev/null | grep NEEDED | while read line; do lib=$(echo "$line" | sed "s/.*\[\(.*\)\].*/\1/"); found=""; for dir in /system/lib64 /system/lib /lib64 /lib; do [ -f "$dir/$lib" ] && found="$dir/$lib" && break; done; [ -n "$found" ] && printf "\t%s => %s\n" "$lib" "$found" || printf "\t%s => not found\n" "$lib"; done', "\n";
+    close $fh;
+    chmod 0755, $ldd_script;
+    $ENV{PATH} = "$tmpdir:" . $ENV{PATH};
+}
+
+# OHOS: use sysroot for system headers and CRT files
+my $ohos_sysroot = $ENV{OHOS_SYSROOT} or die "OHOS_SYSROOT environment variable must be set";
+my $ohos_crt_dir = "$ohos_sysroot/usr/lib/aarch64-linux-ohos";
+my $cc = $Config{cc} . " --sysroot=$ohos_sysroot";
 my $ld = $Config{ld} || (($^O eq 'MSWin32') ? 'link.exe' : $Config{cc});
-$ld = $Config{cc} if ($^O =~ /^(?:dec_osf|aix|hpux)$/);
+$ld .= " --sysroot=$ohos_sysroot";
+$ld = $Config{cc} . " --sysroot=$ohos_sysroot" if ($^O =~ /^(?:dec_osf|aix|hpux)$/);
 
 my $par_pl = catfile('..', 'script', "par.pl");
 my $par_exe = catfile('.', "par$exe");
@@ -137,9 +157,15 @@ if($ENV{ACTIVEPERL_MINGW} and $Config{cf_email}=~/ActiveState.com/i){
     $perl58lib = "-l$Config{libperl}";
     $perl58lib =~ s/\.lib$//;
 }
-my $cflags = "$ccdebug$warn$pccflags";
+my $cflags = "$ccdebug$warn$pccflags -Doff64_t=off_t";
 my $optimize = $Config{optimize};
-my $ldflags = "$lddebug$pldflags $perl58lib";
+# OHOS: add CRT files and -nostartfiles -nodefaultlibs -lc to avoid libunwind and CRT issues
+# Also add compiler-rt builtins for soft-float functions (__extenddftf2, __addtf3, etc.)
+my $ohos_crt = "$ohos_crt_dir/crti.o $ohos_crt_dir/crt1.o $ohos_crt_dir/crtn.o";
+my $ohos_compiler_rt = `$Config{cc} -print-file-name=libclang_rt.builtins.a 2>/dev/null`;
+chomp($ohos_compiler_rt);
+$ohos_compiler_rt ||= "$ohos_crt_dir/libclang_rt.builtins.a";
+my $ldflags = "$lddebug -nostartfiles -nodefaultlibs $ohos_crt $pldflags -L$ohos_crt_dir $ohos_compiler_rt -lc $perl58lib";
 my $static_ldflags = $ldflags;
 
 my $libperl;
