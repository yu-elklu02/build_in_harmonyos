diff --git a/Makefile.PL b/Makefile.PL
index f9df052..ba14cb2 100644
--- a/Makefile.PL
+++ b/Makefile.PL
@@ -17,7 +17,11 @@ if ($] == 5.010000) {
 
 sub for_win32 { return ($^O eq 'MSWin32') ? @_ : (); }
 
-my $have_cc = ExtUtils::CBuilder->new->have_compiler;
+# OHOS: force have_compiler = 1 since clang is available but CBuilder test fails
+# due to CRT file issues (crti.o, crtn.o, etc.) on this platform
+my $have_cc = 1;
+# OHOS: ensure sysroot is set for compiler/linker flags
+$ENV{OHOS_SYSROOT} or die "OHOS_SYSROOT environment variable must be set";
 warn "No compiler found, won't generate 'script/parl$Config{_exe}!\n"
     unless $have_cc;
 
@@ -74,9 +78,9 @@ WriteMakefile1(
         'script/pp',
         'script/tkpp',
     ],
-    DIR => [ 
-        't/data/XSFoo', 
-        $have_cc ? 'myldr' : () 
+    DIR => [
+        't/data/XSFoo',
+        $have_cc ? 'myldr' : ()
     ],
     clean => { FILES => 't/data/blib' },
 
@@ -111,6 +115,10 @@ WriteMakefile1(
         directory => [ 'contrib' ],
       },
     },
+    # OHOS: override flags to strip -fstack-protector-strong (ld.lld doesn't support it)
+    CCFLAGS    => "--sysroot=$ENV{OHOS_SYSROOT} -fPIC -O2 -D_GNU_SOURCE -fno-strict-aliasing -pipe -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -Doff64_t=off_t",
+    LDFLAGS    => "--sysroot=$ENV{OHOS_SYSROOT}",
+    LDDLFLAGS  => "--sysroot=$ENV{OHOS_SYSROOT} -shared -nostartfiles -nodefaultlibs -lc",
 );
 
 # inhibit parallel make as modules must be installed into blib *before*
@@ -151,6 +159,8 @@ sub WriteMakefile1 {  #Compatibility code for old versions of EU::MM. Written by
     delete $params{META_ADD} if $eumm_version < 6.46;
     delete $params{LICENSE} if $eumm_version < 6.31;
 
+    # OHOS: add linker flags to avoid missing CRT files (crti.o, crtn.o, crtbeginS.o, crtendS.o)
+    $params{dynamic_lib} = { OTHERLDFLAGS => '-nostartfiles -nodefaultlibs -lc' };
     WriteMakefile(%params);
 }
 
