--- a/senddata.c
+++ b/senddata.c
@@ -5,0 +6 @@
+#include <stdatomic.h>
@@ -74,0 +76 @@ struct returnChannel {
+    _Atomic int stop;
@@ -85,0 +88,35 @@ struct returnChannel {
+static ssize_t receiveReturnMessage(struct returnChannel *returnChannel,
+                                    int socket, void *message, size_t length,
+                                    struct sockaddr_in *from, in_port_t portBase) {
+    while(1) {
+        if(atomic_load_explicit(&returnChannel->stop, memory_order_acquire))
+            pthread_exit(NULL);
+
+        fd_set readSet;
+        struct timeval timeout;
+        int ready;
+        ssize_t received;
+
+        FD_ZERO(&readSet);
+        FD_SET(socket, &readSet);
+        timeout.tv_sec = 0;
+        timeout.tv_usec = 100000;
+        ready = select(socket + 1, &readSet, NULL, NULL, &timeout);
+        if(ready > 0) {
+            errno = 0;
+            received = doReceive(socket, message, length, from, portBase);
+            if(received >= 0)
+                return received;
+            if(errno == 0 || errno == EINTR)
+                continue;
+            pthread_exit(NULL);
+        }
+        if(ready < 0 && errno != EINTR)
+            pthread_exit(NULL);
+    }
+}
+
+#undef RECV
+#define RECV(s, msg, from, portBase) \
+    receiveReturnMessage(returnChannel, (s), &(msg), sizeof(msg), \
+                         &(from), (portBase))
@@ -721,0 +760 @@ static void initReturnChannel(struct returnChannel *returnChannel,
+    atomic_init(&returnChannel->stop, 0);
@@ -736,3 +775,4 @@ static void cancelReturnChannel(struct returnChannel *returnChannel) {
      */
-    pthread_cancel(returnChannel->thread);
+    atomic_store_explicit(&returnChannel->stop, 1, memory_order_release);
