From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hmbs <noreply@atomgit.com>
Date: Mon, 3 Aug 2026 08:30:00 +0000
Subject: [PATCH] Isolate each CTest group's working directory

The vendored upstream test suite registers 29 CTest cases across 5 groups
(4 v0 CAB-extraction groups + v5/CVE-2015-1386 + v5/stack_memory_file).
All five extraction groups share the *same* working directory:

    set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir)

and the same `extractO`/`extractN` sub-directories, and each group's
`cleanup` test runs `rm -rf ${TESTS_WORKING_DIRECTORY}`.

When CTest runs these groups in parallel (the default), one group's
`cleanup` deletes another group's still-in-use `test_tmp_dir`, and
concurrent `old_compression` runs overwrite each other's `extractO`.
The observed failure pattern on HarmonyOS aarch64 is exactly this
interference:

    avigomanager_old_compression .....***Failed    (extractO wiped mid-run)
    avigomanager_hashes_match ........***Not Run   (extractO missing)
    the-feeble-files_old_compression .***Failed
    the-feeble-files_hashes_match ....***Not Run
    wireplay_old_compression ..........***Failed
    wireplay_hashes_match .............***Not Run
    baldurs_gate_new_compression ......***Failed
    baldurs_gate_hashes_match .........***Not Run

Fix: give each extraction group its *own* working directory by overriding
`TESTS_WORKING_DIRECTORY` at the top of each group's CMakeLists.txt:

    set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_avigomanager)
    ...

Each group now creates, populates, reads and removes a directory that no
other group touches, so parallel CTest execution is safe and the
`old_compression`/`hashes_match` cascades disappear.

This is a pure CTest wiring change; it does not alter any unshield library
assertion, weaken any test, or skip any of the 29 upstream cases.

diff --git a/test/v0/avigomanager/CMakeLists.txt b/test/v0/avigomanager/CMakeLists.txt
--- a/test/v0/avigomanager/CMakeLists.txt
+++ b/test/v0/avigomanager/CMakeLists.txt
@@ -1,3 +1,4 @@
+set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_avigomanager)
 add_test(
     NAME avigomanager_new_compression
     COMMAND $<TARGET_FILE:unshield> -d extractN x data1.cab
diff --git a/test/v0/baldurs_gate_patch_v1_1_4315_international/CMakeLists.txt b/test/v0/baldurs_gate_patch_v1_1_4315_international/CMakeLists.txt
--- a/test/v0/baldurs_gate_patch_v1_1_4315_international/CMakeLists.txt
+++ b/test/v0/baldurs_gate_patch_v1_1_4315_international/CMakeLists.txt
@@ -1,3 +1,4 @@
+set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_baldurs_gate)
 add_test(
     NAME baldurs_gate_new_compression
     COMMAND $<TARGET_FILE:unshield> -d extractN x data1.cab
diff --git a/test/v0/the-feeble-files-spanish/CMakeLists.txt b/test/v0/the-feeble-files-spanish/CMakeLists.txt
--- a/test/v0/the-feeble-files-spanish/CMakeLists.txt
+++ b/test/v0/the-feeble-files-spanish/CMakeLists.txt
@@ -1,3 +1,4 @@
+set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_the_feeble_files)
 add_test(
     NAME the-feeble-files_new_compression
     COMMAND $<TARGET_FILE:unshield> -d extractN x data1.cab
diff --git a/test/v0/wireplay/CMakeLists.txt b/test/v0/wireplay/CMakeLists.txt
--- a/test/v0/wireplay/CMakeLists.txt
+++ b/test/v0/wireplay/CMakeLists.txt
@@ -1,3 +1,4 @@
+set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_wireplay)
 add_test(
     NAME wireplay_new_compression
     COMMAND $<TARGET_FILE:unshield> -d extractN x dpcb1197-Wireplay/DOS/data1.cab
diff --git a/test/v5/CVE-2015-1386/CMakeLists.txt b/test/v5/CVE-2015-1386/CMakeLists.txt
--- a/test/v5/CVE-2015-1386/CMakeLists.txt
+++ b/test/v5/CVE-2015-1386/CMakeLists.txt
@@ -1,3 +1,4 @@
+set(TESTS_WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/test_tmp_dir_cve_2015_1386)
 add_test(
     NAME CVE-2015-1386_new_compression
     COMMAND $<TARGET_FILE:unshield> -d extractN x ${CMAKE_CURRENT_SOURCE_DIR}/data1.cab
