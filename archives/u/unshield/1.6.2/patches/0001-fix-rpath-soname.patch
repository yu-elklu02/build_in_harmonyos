--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1,9 +1,5 @@
-list(FIND CMAKE_PLATFORM_IMPLICIT_LINK_DIRECTORIES "${CMAKE_INSTALL_PREFIX}/lib" isSystemDir)
-if("${isSystemDir}" STREQUAL "-1")
-    set(CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}")
-endif()
-
 add_executable(unshield unshield.c)
+set_target_properties(unshield PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
 target_link_libraries(unshield libunshield)
 if(WIN32)
     if(HAVE_ICONV)
@@ -14,5 +10,6 @@ endif()
 
 add_executable(unshield-deobfuscate unshield-deobfuscate.c)
+set_target_properties(unshield-deobfuscate PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
 target_link_libraries(unshield-deobfuscate libunshield)
 if(WIN32)
     target_link_libraries(unshield-deobfuscate ${ZLIB_LIBRARIES})
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -37,5 +37,12 @@ set_target_properties(libunshield PROPERTIES OUTPUT_NAME unshield)
 set_target_properties(libunshield PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
 
+# HarmonyOS is "unknown" to CMake, which means CMAKE_SHARED_LIBRARY_SONAME_C_FLAG
+# may not be set. Without a SONAME, the linker records the library file path as
+# the DT_NEEDED entry instead of the SONAME, causing runtime loading failures.
+if(NOT CMAKE_SHARED_LIBRARY_SONAME_C_FLAG)
+    set_target_properties(libunshield PROPERTIES LINK_FLAGS "-Wl,-soname,libunshield.so")
+endif()
+
 if(USE_OUR_OWN_MD5)
     target_link_libraries(libunshield PRIVATE $<TARGET_OBJECTS:md5>)
 else()
