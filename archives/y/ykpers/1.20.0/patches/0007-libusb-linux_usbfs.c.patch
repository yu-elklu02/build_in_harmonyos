diff -ruN a/libusb/os/linux_usbfs.c b/libusb/os/linux_usbfs.c
--- a/libusb/os/linux_usbfs.c
+++ b/libusb/os/linux_usbfs.c
@@ -311,20 +311,34 @@
 	struct utsname uts;
 	int atoms;
 
 	if (uname(&uts) < 0) {
 		usbi_err(ctx, "uname failed, errno=%d", errno);
 		return -1;
 	}
 
 	atoms = sscanf(uts.release, "%d.%d.%d", &ver->major, &ver->minor, &ver->sublevel);
 	if (atoms < 2) {
+		/* HongMeng/OHOS kernel: release format is "HongMeng Kernel X.Y.Z"
+		 * which doesn't match standard Linux version parsing.
+		 * The underlying Linux kernel is modern (5.x+), so report a
+		 * compatible version to pass minimum checks. */
+		if (strstr(uts.release, "HongMeng") != NULL ||
+		    strstr(uts.release, "OHOS") != NULL ||
+		    strstr(uts.release, "OpenHarmony") != NULL ||
+		    strstr(uts.release, "HarmonyOS") != NULL) {
+			ver->major = 5;
+			ver->minor = 10;
+			ver->sublevel = 0;
+			usbi_dbg(ctx, "HongMeng/OHOS kernel detected (%s), assuming modern Linux kernel", uts.release);
+			return 0;
+		}
 		usbi_err(ctx, "failed to parse uname release '%s'", uts.release);
 		return -1;
 	}
 
 	if (atoms < 3)
 		ver->sublevel = -1;
 
 	usbi_dbg(ctx, "reported kernel version is %s", uts.release);
 
 	return 0;
