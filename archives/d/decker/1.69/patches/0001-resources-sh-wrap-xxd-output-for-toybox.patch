diff --git a/scripts/resources.sh b/scripts/resources.sh
index 57cb15f..19141fb 100644
--- a/scripts/resources.sh
+++ b/scripts/resources.sh
@@ -12,9 +12,58 @@ fi
 
 DST=c/resources.h
 
+# HarmonyOS ships the toybox 0.8.x `xxd`, whose `-i` mode emits only the
+# raw byte list and omits the surrounding `unsigned char NAME[] = { ... };`
+# declaration and the companion `_len` variable that Vim/GNU `xxd -i`
+# produces. dom.h and decker.c reference the bundled assets by the fixed
+# GNU-style symbol names (e.g. `js_lil_js`, `js_lil_js_len`,
+# `examples_decks_tour_deck`, `examples_decks_tour_deck_len`), so wrap
+# the byte list ourselves to make `resources.h` valid C on either `xxd`.
+emit_array() {
+	# $1 = input file path (relative to repo root, as upstream passes it)
+	# $2 = destination file (the generated c/resources.h), opened in append mode
+	in_path="$1"
+	dst="$2"
+	# Derive the GNU xxd -i variable name: replace every non-alnum byte
+	# with '_', then strip a single leading '_'. ('js/lil.js' -> 'js_lil_js',
+	# 'examples/decks/tour.deck' -> 'examples_decks_tour_deck'.)
+	name=$(printf '%s' "$in_path" | tr -c 'A-Za-z0-9' '_' | sed 's/^_//')
+	# Write xxd -i output to a temp file so we can check its first line
+	# without capturing the full (potentially large) output in a shell
+	# variable (avoids "Argument list too long" on OHOS / system/bin/printf).
+	tmpf=$(mktemp) || { printf 'emit_array: mktemp failed\n' >&2; exit 1; }
+	if ! xxd -i "$in_path" > "$tmpf" 2>/dev/null; then
+		rm -f "$tmpf"
+		printf 'emit_array: xxd -i "%s" failed\n' "$in_path" >&2
+		exit 1
+	fi
+	# Guard against empty output (e.g. xxd silently produced nothing),
+	# which would otherwise emit an empty `unsigned char NAME[] = {};`
+	# array and a zero-length `_len` variable, masking the failure.
+	if [ ! -s "$tmpf" ]; then
+		rm -f "$tmpf"
+		printf 'emit_array: xxd -i "%s" produced empty output\n' "$in_path" >&2
+		exit 1
+	fi
+	if head -1 "$tmpf" | grep -q '^unsigned char'; then
+		# GNU xxd: output already contains the full declaration -- pass through.
+		cat "$tmpf" >> "$dst"
+	else
+		# Toybox xxd: wrap the raw byte list ourselves.
+		{
+			printf 'unsigned char %s[] = {\n' "$name"
+			cat "$tmpf"
+			printf '};\n'
+			printf '\n'
+			printf 'unsigned int %s_len = %u;\n' "$name" "$(wc -c < "$in_path")"
+		} >> "$dst"
+	fi
+	rm -f "$tmpf"
+}
+
 printf "%s\n" "// auto-generated from web-decker source!" > $DST
-xxd -i js/lil.js      >> $DST
-xxd -i js/danger.js   >> $DST
-xxd -i js/decker.html >> $DST
-xxd -i js/decker.js   >> $DST
-xxd -i $DECK          >> $DST
+emit_array js/lil.js      "$DST"
+emit_array js/danger.js   "$DST"
+emit_array js/decker.html "$DST"
+emit_array js/decker.js   "$DST"
+emit_array "$DECK"        "$DST"
