+QString DISOMasterPrivate::findXorriso() const
+{
+    // 优先从环境变量获取 xorriso 路径
+    QByteArray env = qgetenv("DISOMASTER_XORRISO");
+    if (!env.isEmpty()) {
+        QString path = QString::fromLocal8Bit(env);
+        if (QFileInfo::exists(path))
+            return path;
+    }
+    // 从 PATH 查找 xorriso
+    return QStandardPaths::findExecutable("xorriso");
+}
+
+bool DISOMasterPrivate::runXorriso(const QStringList &args, QString &output)
+{
+    Q_Q(DISOMaster);
+
+    if (xorrisoPath.isEmpty()) {
+        emit q->jobStatusChanged(DISOMaster::Failed, 0);
+        return false;
+    }
+
+    emit q->jobStatusChanged(DISOMaster::Running, 0);
+
+    QProcess proc;
+    // 合并 stderr 到 stdout，避免 stderr 管道缓冲区写满导致子进程阻塞（死锁）
+    proc.setProcessChannelMode(QProcess::MergedChannels);
+    // 启动前连接 finished 信号，保证状态回调与发射时机一致
+    // 使用 QOverload 消除 QProcess::finished 在 Qt 5.15 中的重载歧义
+    QObject::connect(&proc, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+                     q, [q](int exitCode, QProcess::ExitStatus) {
+                         emit q->jobStatusChanged(
+                             exitCode == 0 ? DISOMaster::Finished : DISOMaster::Failed,
+                             exitCode == 0 ? 100 : 0);
+                     });
+
+    // 检查进程是否成功启动，避免 TOCTOU 场景下误报成功
+    proc.start(xorrisoPath, args);
+    if (!proc.waitForStarted(30000)) {
+        emit q->jobStatusChanged(DISOMaster::Failed, 0);
+        return false;
+    }
+
+    // 循环等待并读取输出，实时解析进度（只解析新增片段，避免 O(n²) 冗余扫描）
+    QByteArray accumulated;
+    while (proc.waitForReadyRead(30000)) {
+        QByteArray chunk = proc.readAllStandardOutput();
+        accumulated += chunk;
+        parseProgress(QString::fromLocal8Bit(chunk));
+    }
+    proc.waitForFinished(-1);
+    accumulated += proc.readAllStandardOutput();
+
+    output = QString::fromLocal8Bit(accumulated);
+
+    // 最终仅解析速度，不再发射进度信号（finished 信号已发射 Finished/Failed）
+    parseSpeed(output);
+
+    // 将输出行添加到消息列表
+    messages.append(output.split('\n', Qt::SkipEmptyParts));
+
+    return proc.exitCode() == 0;
+}
