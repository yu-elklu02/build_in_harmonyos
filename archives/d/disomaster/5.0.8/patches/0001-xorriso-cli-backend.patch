+MediaType DISOMasterPrivate::parseMediaType(const QString &text) const
+{
+    QString t = text.trimmed().toUpper();
+    if (t == "CD-ROM" || t == "CDROM") return CD_ROM;
+    if (t == "CD-R") return CD_R;
+    if (t == "CD-RW") return CD_RW;
+    if (t == "DVD-ROM" || t == "DVDROM") return DVD_ROM;
+    if (t == "DVD-R") return DVD_R;
+    if (t == "DVD-RW") return DVD_RW;
+    if (t == "DVD+R") return DVD_PLUS_R;
+    if (t == "DVD+R/DL" || t == "DVD+R DL") return DVD_PLUS_R_DL;
+    if (t == "DVD-RAM") return DVD_RAM;
+    if (t == "DVD+RW") return DVD_PLUS_RW;
+    if (t == "BD-ROM" || t == "BDROM") return BD_ROM;
+    if (t == "BD-R") return BD_R;
+    if (t == "BD-RE") return BD_RE;
+    return NoMedia;
+}
