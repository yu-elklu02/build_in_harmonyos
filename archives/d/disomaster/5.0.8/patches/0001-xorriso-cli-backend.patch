+// 单位转换：将带后缀的大小字符串转换为字节数
+static quint64 parseSize(const QString &num, const QString &unit)
+{
+    quint64 val = num.toULongLong();
+    if (unit == "k") return val * 1024ULL;
+    if (unit == "m") return val * 1024ULL * 1024ULL;
+    if (unit == "g") return val * 1024ULL * 1024ULL * 1024ULL;
+    return val;
+}
+
+class DISOMasterPrivate
+{
+    Q_DECLARE_PUBLIC(DISOMaster)
+public:
+    DISOMasterPrivate(DISOMaster *q);
+    ~DISOMasterPrivate();
+
+    DISOMaster *q_ptr;
+
+    QString xorrisoPath;                              // xorriso 可执行文件路径
+    QString currentDev;                               // 当前设备路径
+    QHash<QUrl, QUrl> files;                          // 暂存文件映射
+    mutable QHash<QString, DeviceProperty> devCache;  // 设备属性缓存
+    QStringList messages;                             // 信息消息列表
+    QString currentSpeed;                             // 当前写入速度
+
+    // 查找 xorriso 可执行文件路径
+    QString findXorriso() const;
+    // 执行 xorriso 命令并解析输出
+    bool runXorriso(const QStringList &args, QString &output);
+    // 解析设备属性
+    DeviceProperty parseDeviceProperty(const QString &output, const QString &dev);
+    // 解析介质类型字符串
+    MediaType parseMediaType(const QString &text) const;
+    // 解析输出中的进度并发射 Running 状态（仅在进程运行期间调用）
+    void parseProgress(const QString &output);
+    // 仅解析输出中的速度信息，不发射任何状态信号
+    void parseSpeed(const QString &output);
+};
+
+DISOMasterPrivate::DISOMasterPrivate(DISOMaster *q)
+    : q_ptr(q)
+{
+    xorrisoPath = findXorriso();
+}
+
+DISOMasterPrivate::~DISOMasterPrivate()
+{
+}
