+DeviceProperty DISOMasterPrivate::parseDeviceProperty(const QString &output, const QString &dev)
+{
+    DeviceProperty dp;
+    dp.formatted = false;
+    dp.media = NoMedia;
+    dp.data = 0;
+    dp.avail = 0;
+    dp.datablocks = 0;
+    dp.devid = dev;
+
+    const QStringList lines = output.split('\n');
+    for (const QString &line : lines) {
+        QString trimmed = line.trimmed();
+
+        // 解析介质类型: "Media current: CD-RW"
+        if (trimmed.startsWith("Media current:", Qt::CaseInsensitive)) {
+            QString typeStr = trimmed.mid(trimmed.indexOf(':') + 1).trimmed();
+            dp.media = parseMediaType(typeStr);
+        }
+        // 解析介质状态: "Media status : is blank"
+        else if (trimmed.startsWith("Media status", Qt::CaseInsensitive)) {
+            if (trimmed.contains("blank", Qt::CaseInsensitive))
+                dp.formatted = true;
+        }
+        // 解析介质摘要: "Media summary: 0 sessions, 0 data blocks, 0k data, 653m free"
+        else if (trimmed.startsWith("Media summary:", Qt::CaseInsensitive)) {
+            static QRegularExpression re(
+                "(\\d+)\\s*sessions?,\\s*(\\d+)\\s*data\\s*blocks?,\\s*"
+                "(\\d+)\\s*(\\w)\\s*data,\\s*(\\d+)\\s*(\\w)\\s*free",
+                QRegularExpression::CaseInsensitiveOption);
+            auto m = re.match(trimmed);
+            if (m.hasMatch()) {
+                dp.datablocks = m.captured(2).toULongLong();
+                dp.data = parseSize(m.captured(3), m.captured(4).toLower());
+                dp.avail = parseSize(m.captured(5), m.captured(6).toLower());
+            }
+        }
+        // 解析卷标: "Volume id : 'ISOIMAGE'"
+        else if (trimmed.startsWith("Volume id", Qt::CaseInsensitive)) {
+            int start = trimmed.indexOf('\'');
+            int end = trimmed.lastIndexOf('\'');
+            if (start >= 0 && end > start)
+                dp.volid = trimmed.mid(start + 1, end - start - 1);
+        }
+        // 解析写入速度: "Write speed : 1411k 70x"
+        else if (trimmed.startsWith("Write speed", Qt::CaseInsensitive)) {
+            static QRegularExpression re("(\\d+(?:\\.\\d+)?)x\\b");
+            auto m = re.match(trimmed);
+            if (m.hasMatch())
+                dp.writespeed.append(m.captured(1) + "x");
+        }
+    }
+
+    return dp;
+}
+
+void DISOMasterPrivate::parseProgress(const QString &output)
+{
+    Q_Q(DISOMaster);
+
+    int maxProgress = -1;
+
+    const QStringList lines = output.split('\n');
+    for (const QString &line : lines) {
+        QString trimmed = line.trimmed();
+
+        // 解析进度: "N% fifo" 或 "N% done"
+        static QRegularExpression progressRe("(\\d+)%\\s*(?:fifo|done)");
+        auto pm = progressRe.match(trimmed);
+        if (pm.hasMatch()) {
+            int percent = pm.captured(1).toInt();
+            if (percent > maxProgress)
+                maxProgress = percent;
+        }
+
+        // 解析 "N of M MB written" 格式的进度
+        static QRegularExpression mbRe("(\\d+)\\s*of\\s*(\\d+)\\s*MB\\s*written");
+        auto mm = mbRe.match(trimmed);
+        if (mm.hasMatch()) {
+            int written = mm.captured(1).toInt();
+            int total = mm.captured(2).toInt();
+            if (total > 0) {
+                int percent = written * 100 / total;
+                if (percent > maxProgress)
+                    maxProgress = percent;
+            }
+        }
+
+        // 解析当前速度: "Nx."
+        static QRegularExpression speedRe("(\\d+(?:\\.\\d+)?)x\\.");
+        auto sm = speedRe.match(trimmed);
+        if (sm.hasMatch()) {
+            currentSpeed = sm.captured(1) + "x";
+        }
+    }
+
+    if (maxProgress >= 0)
+        emit q->jobStatusChanged(DISOMaster::Running, maxProgress);
+}
+
+void DISOMasterPrivate::parseSpeed(const QString &output)
+{
+    const QStringList lines = output.split('\n');
+    for (const QString &line : lines) {
+        QString trimmed = line.trimmed();
+
+        // 解析当前速度: "Nx."
+        static QRegularExpression speedRe("(\\d+(?:\\.\\d+)?)x\\.");
+        auto sm = speedRe.match(trimmed);
+        if (sm.hasMatch()) {
+            currentSpeed = sm.captured(1) + "x";
+        }
+    }
+}
