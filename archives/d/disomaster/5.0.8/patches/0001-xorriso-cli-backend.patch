+DISOMaster::DISOMaster(QObject *parent)
+    : QObject(parent)
+    , d_ptr(new DISOMasterPrivate(this))
+{
+}
+
+DISOMaster::~DISOMaster() = default;
+
+bool DISOMaster::acquireDevice(QString dev)
+{
+    Q_D(DISOMaster);
+
+    d->messages.clear();
+    d->currentSpeed.clear();
+
+    QStringList args;
+    args << "-dev" << dev << "-end";
+
+    QString output;
+    if (!d->runXorriso(args, output))
+        return false;
+
+    d->currentDev = dev;
+    return true;
+}
+
+void DISOMaster::releaseDevice()
+{
+    Q_D(DISOMaster);
+    d->currentDev.clear();
+}
+
+QString DISOMaster::currentDevice() const
+{
+    Q_D(const DISOMaster);
+    return d->currentDev;
+}
+
+DeviceProperty DISOMaster::getDeviceProperty()
+{
+    Q_D(DISOMaster);
+
+    DeviceProperty dp;
+    dp.formatted = false;
+    dp.media = NoMedia;
+    dp.data = 0;
+    dp.avail = 0;
+    dp.datablocks = 0;
+
+    if (d->currentDev.isEmpty())
+        return dp;
+
+    QStringList args;
+    args << "-dev" << d->currentDev << "-toc" << "-list_speeds" << "-end";
+
+    QString output;
+    if (!d->runXorriso(args, output))
+        return dp;
+
+    dp = d->parseDeviceProperty(output, d->currentDev);
+    d->devCache[d->currentDev] = dp;
+    return dp;
+}
+
+DeviceProperty DISOMaster::getDevicePropertyCached(QString dev) const
+{
+    Q_D(const DISOMaster);
+
+    auto it = d->devCache.find(dev);
+    if (it != d->devCache.end())
+        return it.value();
+
+    DeviceProperty dp;
+    dp.formatted = false;
+    dp.media = NoMedia;
+    dp.data = 0;
+    dp.avail = 0;
+    dp.datablocks = 0;
+    return dp;
+}
+
+void DISOMaster::nullifyDevicePropertyCache(QString dev)
+{
+    Q_D(DISOMaster);
+    d->devCache.remove(dev);
+}
+
+QStringList DISOMaster::getInfoMessages()
+{
+    Q_D(DISOMaster);
+    return d->messages;
+}
+
+QString DISOMaster::getCurrentSpeed() const
+{
+    Q_D(const DISOMaster);
+    return d->currentSpeed;
+}
+
+void DISOMaster::stageFiles(const QHash<QUrl, QUrl> filelist)
+{
+    Q_D(DISOMaster);
+    for (auto it = filelist.begin(); it != filelist.end(); ++it)
+        d->files[it.key()] = it.value();
+}
+
+const QHash<QUrl, QUrl> &DISOMaster::stagingFiles() const
+{
+    Q_D(const DISOMaster);
+    return d->files;
+}
+
+void DISOMaster::removeStagingFiles(const QList<QUrl> filelist)
+{
+    Q_D(DISOMaster);
+    for (const QUrl &url : filelist)
+        d->files.remove(url);
+}
+
+bool DISOMaster::commit(const BurnOptions &opts, int speed, QString volId)
+{
+    Q_D(DISOMaster);
+
+    if (d->currentDev.isEmpty())
+        return false;
+
+    d->messages.clear();
+
+    QStringList args;
+    args << "-dev" << d->currentDev;
+
+    if (speed > 0)
+        args << "-speed" << QString::number(speed) + "k";
+
+    args << "-volid" << volId;
+    args << "-overwrite" << "off";
+
+    // 设置 Joliet 扩展
+    if (opts & JolietSupport || opts & JolietAndRockRidge)
+        args << "-joliet" << "on";
+    else
+        args << "-joliet" << "off";
+
+    // 设置 Rock Ridge 扩展
+    if (opts & RockRidgeSupport || opts & JolietAndRockRidge)
+        args << "-rockridge" << "on";
+    else
+        args << "-rockridge" << "off";
+
+    // 添加暂存文件映射
+    for (auto it = d->files.begin(); it != d->files.end(); ++it) {
+        args << "-map" << it.value().toLocalFile() << it.key().toLocalFile();
+    }
+
+    // 设置是否关闭会话
+    if (opts & KeepAppendable)
+        args << "-close" << "off";
+    else
+        args << "-close" << "on";
+
+    args << "-commit" << "-end";
+
+    QString output;
+    return d->runXorriso(args, output);
+}
+
+bool DISOMaster::commit(int speed, bool closeSession, QString volId)
+{
+    BurnOptions opts;
+    if (!closeSession)
+        opts |= KeepAppendable;
+    opts |= ISO9660Only;
+    return commit(opts, speed, volId);
+}
+
+bool DISOMaster::erase()
+{
+    Q_D(DISOMaster);
+
+    if (d->currentDev.isEmpty())
+        return false;
+
+    d->messages.clear();
+
+    QStringList args;
+    args << "-outdev" << d->currentDev << "-blank" << "as_needed" << "-end";
+
+    QString output;
+    return d->runXorriso(args, output);
+}
+
+bool DISOMaster::checkmedia(double *qgood, double *qslow, double *qbad)
+{
+    Q_D(DISOMaster);
+
+    if (d->currentDev.isEmpty())
+        return false;
+
+    d->messages.clear();
+
+    QStringList args;
+    args << "-dev" << d->currentDev << "-check_media" << "-end";
+
+    QString output;
+    bool ok = d->runXorriso(args, output);
+
+    // 解析 Media region 行计算质量比例
+    int goodBlocks = 0, slowBlocks = 0, badBlocks = 0, totalBlocks = 0;
+
+    static QRegularExpression re(
+        "Media\\s*region\\s*:\\s*(\\d+)\\s+(\\d+)\\s+(\\S+)",
+        QRegularExpression::CaseInsensitiveOption);
+    auto it = re.globalMatch(output);
+    while (it.hasNext()) {
+        auto m = it.next();
+        int start = m.captured(1).toInt();
+        int end = m.captured(2).toInt();
+        QString status = m.captured(3).trimmed();
+        int blocks = end - start;
+        if (blocks <= 0) blocks = 1;
+        totalBlocks += blocks;
+        if (status == "<-")
+            goodBlocks += blocks;
+        else if (status == "slow")
+            slowBlocks += blocks;
+        else
+            badBlocks += blocks;
+    }
+
+    if (totalBlocks > 0) {
+        if (qgood) *qgood = (double)goodBlocks / totalBlocks;
+        if (qslow) *qslow = (double)slowBlocks / totalBlocks;
+        if (qbad) *qbad = (double)badBlocks / totalBlocks;
+    }
+
+    return ok;
+}
+
+bool DISOMaster::dumpISO(const QUrl isopath)
+{
+    Q_D(DISOMaster);
+
+    if (d->currentDev.isEmpty())
+        return false;
+
+    d->messages.clear();
+
+    QStringList args;
+    args << "-outdev" << d->currentDev
+         << "-check_media" << "use=outdev"
+         << "data_to=" + isopath.toLocalFile()
+         << "-end";
+
+    QString output;
+    return d->runXorriso(args, output);
+}
+
+bool DISOMaster::writeISO(const QUrl isopath, int speed)
+{
+    Q_D(DISOMaster);
+
+    if (d->currentDev.isEmpty())
+        return false;
+
+    d->messages.clear();
+
+    QStringList args;
+    args << "-as" << "cdrecord" << "-v"
+         << "dev=" + d->currentDev
+         << "blank=as_needed";
+
+    if (speed > 0)
+        args << "speed=" + QString::number(speed) + "k";
+
+    args << isopath.toLocalFile();
+
+    QString output;
+    return d->runXorriso(args, output);
+}
