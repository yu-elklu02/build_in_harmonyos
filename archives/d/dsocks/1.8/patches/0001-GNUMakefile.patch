 	$(INSTALL) -m 755 $(LIBSHARED) $(DESTDIR)$(LIBDIR)
+	rm -f $(DESTDIR)$(LIBDIR)/libdsocks.so.1
+	ln -s $(LIBSHARED) $(DESTDIR)$(LIBDIR)/libdsocks.so.1
+	rm -f $(DESTDIR)$(LIBDIR)/libdsocks.so
+	ln -s libdsocks.so.1 $(DESTDIR)$(LIBDIR)/libdsocks.so
+	$(INSTALL) -m 755 dsocks.sh $(DESTDIR)$(BINDIR)/dsocks
+	$(INSTALL) -m 755 dsocks-torify.sh $(DESTDIR)$(BINDIR)/dsocks-torify
 clean:
 	$(RM) $(LIBSHARED) *.o
