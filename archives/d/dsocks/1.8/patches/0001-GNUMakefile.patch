diff -ruN a/GNUMakefile b/GNUMakefile
--- a/GNUMakefile
+++ b/GNUMakefile
@@ -1,33 +1,41 @@
 # $Id$

-CC = gcc
+CC ?= clang
 LD = $(CC)
-CFLAGS = -g -Wall -O2 -fPIC
-LDFLAGS = --shared -Wl,--version-script,$(MAP)
+CFLAGS = -fPIC -O2 -Wall -g
+LDFLAGS = -shared -Wl,--version-script,$(MAP)
 LDLIBS = -ldl -lresolv

 MKDIR = mkdir -p
 INSTALL = install -c
 RM = rm -f

 DESTDIR =
-LIBDIR = ${HOME}/lib
+LIBDIR = /usr/local/lib
+BINDIR = /usr/local/bin

 LIBSHARED = libdsocks.so.1.0

-OBJS = atomicio.o dsocks.o strlcpy.o
+OBJS = atomicio.o dsocks.o
 MAP = libdsocks.map

 all: $(LIBSHARED)

 $(LIBSHARED): $(OBJS) $(MAP)
 	$(LD) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@

 .c.o:
 	$(CC) $(CFLAGS) -c $*.c

 install:
-	$(MKDIR) $(LIBDIR)
+	$(MKDIR) $(DESTDIR)$(LIBDIR)
