 #if OPENSSL_1_1_API
     const RSA_METHOD *default_method = RSA_PKCS1_OpenSSL();
     EC_KEY_METHOD *ecdsa_method;
@@ -1440,11 +1440,20 @@ int neverbleed_init(neverbleed_t *nb, char *errbuf)
         goto Fail;
     }
