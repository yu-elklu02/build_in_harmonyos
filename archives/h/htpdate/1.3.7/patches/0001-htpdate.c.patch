diff -ruN a/htpdate.c b/htpdate.c
--- a/htpdate.c
+++ b/htpdate.c
@@ -45,20 +45,31 @@
 #include <netdb.h>
 #include <time.h>
 #include <sys/time.h>
 #include <sys/timex.h>
 #include <syslog.h>
 #include <stdarg.h>
 #include <limits.h>
 #include <pwd.h>
 #include <grp.h>
 #include <float.h>
+
+/* On Linux, use adjtimex instead of adjtime (adjtime may be unavailable on some libc) */
+#ifdef __linux__
+#define adjtime(tv, oldtv) adjtimex_compat(tv)
+static inline int adjtimex_compat(const struct timeval *tv) {
+    struct timex txc = {0};
+    txc.modes = ADJ_OFFSET_SINGLESHOT;
+    txc.offset = (long long)tv->tv_sec * 1000000LL + tv->tv_usec;
+    return adjtimex(&txc);
+}
+#endif
 
 #if defined __NetBSD__ || defined __FreeBSD__ || defined __APPLE__
 #define adjtimex ntp_adjtime
 #endif
 
 #ifdef ENABLE_HTTPS
 #include <openssl/ssl.h>
 #endif
 
 #define VERSION                  "1.3.7"
