@@ -161,0 +165,34 @@
+#ifdef HP2XX_USE_MKSTEMP
+static FILE *hp2xx_tmpfile(void)
+{
+	const char *tmpdir;
+	char *name;
+	size_t len;
+	int fd;
+	FILE *fp;
+
+	tmpdir = getenv("TMPDIR");
+	if (tmpdir == NULL || *tmpdir == '\0')
+		tmpdir = ".";
+
+	len = strlen(tmpdir) + sizeof("/hp2xx-XXXXXX");
+	name = malloc(len);
+	if (name == NULL)
+		return NULL;
+
+	snprintf(name, len, "%s/hp2xx-XXXXXX", tmpdir);
+	fd = mkstemp(name);
+	if (fd < 0) {
+		free(name);
+		return NULL;
+	}
+	unlink(name);
+
+	fp = fdopen(fd, "w+b");
+	if (fp == NULL)
+		close(fd);
+	free(name);
+	return fp;
+}
+#endif
+
