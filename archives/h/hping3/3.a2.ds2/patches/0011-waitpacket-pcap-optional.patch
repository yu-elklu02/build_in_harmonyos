--- a/waitpacket.c
+++ b/waitpacket.c
@@ -549,7 +549,14 @@
 /* This function is exported to listen.c also */
 int read_packet(void *packet, int size)
 {
+#ifdef USE_PCAP
 	size = pcap_recv(packet, size);
+#else
+	/* 无 libpcap：收包能力不可用，返回 -1 而非假成功 */
+	(void)packet;
+	(void)size;
+	size = -1;
+#endif
 	if (size == -1)
 		perror("[wait_packet] pcap_recv()");
 	return size;
