+    curl_path = curl_bin if os.path.dirname(curl_bin) else shutil.which(curl_bin)
+    if curl_path and os.path.isfile(curl_path) and os.access(curl_path, os.X_OK):
+        cmd[0] = curl_path
+        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=cmd_env)
+        out, err = p.communicate()
+        if PY3:
+            out, err = out.decode(), err.decode()
+    else:
+        if curl_args:
+            quit(yellow('Error: extra curl args require an installed curl command'), 1)
+
+        started = time.monotonic()
