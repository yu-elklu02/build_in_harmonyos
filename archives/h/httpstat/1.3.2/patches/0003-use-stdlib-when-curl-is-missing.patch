+            version = '1.1' if response.version == 11 else '1.0'
+            reason = response.reason or ''
+            with open(headerf.name, 'w') as f:
+                f.write('HTTP/{} {} {}\n'.format(version, response.status, reason))
+                for key, value in response.headers.items():
+                    f.write('{}: {}\n'.format(key, value))
+
+            elapsed = max(finished - started, 0.000001)
+            first = max(first_byte - started, 0.0)
+            host = response.url.split('://', 1)[-1].split('/', 1)[0]
+            remote_port = '443' if response.url.startswith('https://') else '80'
+            d = {
+                'time_namelookup': 0.0,
+                'time_connect': 0.0,
+                'time_appconnect': 0.0,
+                'time_pretransfer': 0.0,
+                'time_redirect': 0.0,
+                'time_starttransfer': first,
+                'time_total': elapsed,
+                'speed_download': int(len(body) / elapsed),
+                'speed_upload': 0,
+                'remote_ip': host,
+                'remote_port': remote_port,
+                'local_ip': '',
+                'local_port': '',
+            }
+            out = json.dumps(d)
+            err = ''
+            p = type('StdlibResult', (object,), {'returncode': 0})()
+        except Exception as e:
+            out = ''
+            err = str(e)
+            p = type('StdlibResult', (object,), {'returncode': 1})()
