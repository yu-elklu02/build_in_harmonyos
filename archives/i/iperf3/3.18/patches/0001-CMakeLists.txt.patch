--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -0,0 +1,81 @@
+cmake_minimum_required(VERSION 3.10)
+project(iperf3 VERSION 3.18 LANGUAGES C)
+
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_BUILD_TYPE Release)
+
+# Compiler flags
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall")
+set(CMAKE_C_FLAGS_RELEASE "-O2")
+
+# Find pthread
+find_package(Threads REQUIRED)
+
+# Source files
+set(IPERF3_SOURCES
+    src/cjson.c
+    src/dscp.c
+    src/iperf_api.c
+    src/iperf_auth.c
+    src/iperf_client_api.c
+    src/iperf_error.c
+    src/iperf_locale.c
+    src/iperf_pthread.c
+    src/iperf_sctp.c
+    src/iperf_server_api.c
+    src/iperf_tcp.c
+    src/iperf_time.c
+    src/iperf_udp.c
+    src/iperf_util.c
+    src/main.c
+    src/net.c
+    src/pthread_stubs.c
+    src/tcp_info.c
+    src/timer.c
+    src/units.c
+)
+
+# Create executable
+add_executable(iperf3 ${IPERF3_SOURCES})
+
+# Include directories
+target_include_directories(iperf3 PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/src
+    ${CMAKE_CURRENT_BINARY_DIR}
+)
+
+# Define necessary macros based on HarmonyOS
+target_compile_definitions(iperf3 PRIVATE
+    HAVE_CLOCK_GETTIME=1
+    HAVE_CLOCK_NANOSLEEP=1
+    HAVE_DAEMON=1
+    HAVE_ENDIAN_H=1
+    HAVE_GETLINE=1
+    HAVE_POLL_H=1
+    HAVE_PTHREAD=1
+    HAVE_PTHREAD_PRIO_INHERIT=1
+    HAVE_SCHED_SETAFFINITY=1
+    HAVE_SENDFILE=1
+    HAVE_STDATOMIC_H=1
+    HAVE_TCP_CONGESTION=1
+    HAVE_TCP_USER_TIMEOUT=1
+    HAVE_FLOWLABEL=1
+    HAVE_SO_MAX_PACING_RATE=1
+    HAVE_SO_BINDTODEVICE=1
+    HAVE_IP_MTU_DISCOVER=1
+    HAVE_DONT_FRAGMENT=1
+    HAVE_TCP_INFO_SND_WND=1
+    HAVE_CPU_AFFINITY=1
+    PACKAGE="iperf3"
+    VERSION="3.18"
+    PACKAGE_VERSION="3.18"
+)
+
+# Link libraries
+target_link_libraries(iperf3 PRIVATE
+    Threads::Threads
+    m
+)
+
+# Install
+install(TARGETS iperf3 DESTINATION bin)
