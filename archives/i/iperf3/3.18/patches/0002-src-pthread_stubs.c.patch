--- a/src/pthread_stubs.c
+++ b/src/pthread_stubs.c
@@ -0,0 +1,30 @@
+/*
+ * pthread_stubs.c - Stub implementations for HarmonyOS
+ * 
+ * HarmonyOS pthread library does not implement cancellation functions.
+ * We provide stubs that do nothing but return success.
+ */
+
+#include <pthread.h>
+
+/* Stub for pthread_cancel - not implemented in HarmonyOS */
+int pthread_cancel(pthread_t thread) {
+    /* Cannot cancel threads in HarmonyOS */
+    return 0;  /* Return success to avoid errors */
+}
+
+/* Stub for pthread_setcancelstate - not implemented in HarmonyOS */
+int pthread_setcancelstate(int state, int *oldstate) {
+    if (oldstate) {
+        *oldstate = PTHREAD_CANCEL_ENABLE;
+    }
+    return 0;  /* Return success */
+}
+
+/* Stub for pthread_setcanceltype - not implemented in HarmonyOS */
+int pthread_setcanceltype(int type, int *oldtype) {
+    if (oldtype) {
+        *oldtype = PTHREAD_CANCEL_ASYNCHRONOUS;
+    }
+    return 0;  /* Return success */
+}
