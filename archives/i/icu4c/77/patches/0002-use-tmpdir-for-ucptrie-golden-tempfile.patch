diff --git a/source/test/cintltst/ucptrietest.c b/source/test/cintltst/ucptrietest.c
index 0b3c8d1..c95048f 100644
--- a/source/test/cintltst/ucptrietest.c
+++ b/source/test/cintltst/ucptrietest.c
@@ -7,5 +7,6 @@
 #include <stdbool.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include "unicode/utypes.h"
 #include "unicode/ucptrie.h"
 #include "unicode/umutablecptrie.h"
@@ -724,5 +725,23 @@ trieTestGolden(const char *testName,
     // Write the data into a tmpfile (memstream is not portable)
+    char fallbackTmpPath[512] = "";
     FILE* stream = tmpfile();
+    if (stream == NULL) {
+        const char *tmpdir = getenv("TMPDIR");
+        if (tmpdir == NULL || *tmpdir == 0) {
+            tmpdir = ".";
+        }
+        // Some OHOS test environments do not provide a libc tmpfile()
+        // backing path. The recipe sets TMPDIR to a writable build-local
+        // directory, so keep the golden comparison but create the stream
+        // there when tmpfile() is unavailable.
+        snprintf(fallbackTmpPath, sizeof(fallbackTmpPath),
+                 "%s%sucptrietest-%s.tmp", tmpdir, U_FILE_SEP_STRING, testName);
+        stream = fopen(fallbackTmpPath, "w+b");
+    }
+    if (stream == NULL) {
+        log_err("Could not create temporary file for golden trie '%s'\n", testName);
+        return;
+    }
     usrc_writeCopyrightHeader(stream, "#", 2021);
     usrc_writeFileNameGeneratedBy(stream, "#", testName, "ucptrietest.c");
     fputs("[code_point_trie.struct]\n", stream);
@@ -767,4 +786,7 @@ trieTestGolden(const char *testName,
 cleanup:
     fclose(stream);
+    if (fallbackTmpPath[0] != 0) {
+        remove(fallbackTmpPath);
+    }
     free(memoryBuffer);
 }
