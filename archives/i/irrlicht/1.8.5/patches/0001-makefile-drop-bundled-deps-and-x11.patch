From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 5 Aug 2026 00:00:00 +0000
Subject: [PATCH] Makefile: drop bundled zlib/png/jpeg/bz2 objects, link conan deps + rpath; drop X11/OpenGL desktop flags

irrlicht's Makefile bundles its own copies of zlib/jpeglib/libpng/bzip2
as .o files directly into libIrrlicht.so/.a (LINKOBJ includes $(ZLIBOBJ)
$(JPEGLIBOBJ) $(LIBPNGOBJ) $(BZIP2OBJ)). These bundled objects reference
internal hidden symbols (e.g. zlib's inflate_fast) and NEON optimization
symbols that the conan-built zlib/libpng deps export differently, so
linking test_package against libIrrlicht.so fails:

  ld.lld: error: undefined hidden symbol: inflate_fast
  ld.lld: error: undefined reference: png_riffle_palette_neon
  ...

Drop the four bundled dependency object sets from LINKOBJ (keep
$(LIBAESGM) = irrlicht's own aesGladman code) and link the conan-provided
deps (-lz -lpng -ljpeg -lbz2) instead, both for sharedlib and staticlib
targets. Also drop the Linux desktop X11/OpenGL link + include flags
that the OHOS headless/null-device build does not use.

Add -Wl,-rpath,$ORIGIN to the shared lib link so test_irrlicht can find
libIrrlicht.so.<soname> next to itself at runtime without relying on
LD_LIBRARY_PATH (conan's VirtualRunEnv does not inject the just-built
package's own lib dir into the run env).

---
 source/Irrlicht/Makefile | 6 ++----
 1 file changed, 3 insertions(+), 4 deletions(-)

--- a/source/Irrlicht/Makefile	2026-08-05 22:14:40.616085625 +0800
+++ b/source/Irrlicht/Makefile	2026-08-05 22:14:40.880085312 +0800
@@ -58,8 +58,8 @@
 EXTRAOBJ =
 LINKOBJ = $(IRRMESHOBJ) $(IRROBJ) $(IRRPARTICLEOBJ) $(IRRANIMOBJ) \
 	$(IRRVIDEOOBJ) $(IRRSWRENDEROBJ) $(IRRIOOBJ) $(IRROTHEROBJ) \
-	$(IRRGUIOBJ) $(ZLIBOBJ) $(JPEGLIBOBJ) $(LIBPNGOBJ) $(LIBAESGM) \
-	$(BZIP2OBJ) $(EXTRAOBJ)
+	$(IRRGUIOBJ) $(LIBAESGM) \
+	$(EXTRAOBJ)
 
 ###############
 #Compiler flags
@@ -90,8 +90,8 @@
 LIB_PATH = ../../lib/$(SYSTEM)
 INSTALL_DIR = /usr/local/lib
 sharedlib install: SHARED_LIB = libIrrlicht.so
-sharedlib: LDFLAGS += -L/usr/X11R6/lib$(LIBSELECT) -lGL -lXxf86vm
-staticlib sharedlib: CXXINCS += -I/usr/X11R6/include
+sharedlib staticlib: LDFLAGS += -lz -lpng -ljpeg -lbz2
+sharedlib: LDFLAGS += -Wl,-rpath,$$ORIGIN
 
 #OSX specific options
 staticlib_osx sharedlib_osx install_osx: SYSTEM = MacOSX
