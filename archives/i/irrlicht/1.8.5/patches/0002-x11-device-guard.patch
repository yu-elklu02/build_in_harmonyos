 #endif
 #endif
 
-#if defined(_IRR_COMPILE_WITH_X11_DEVICE_)
+#if defined(_IRR_COMPILE_WITH_X11_)
 #include "CIrrDeviceLinux.h"
 #endif
 #ifdef _IRR_COMPILE_WITH_OSX_DEVICE_
@@ -29,7 +29,7 @@
