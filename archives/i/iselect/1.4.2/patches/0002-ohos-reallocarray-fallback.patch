+#ifndef ISELECT_REALLOCARRAY_COMPAT_H
+#define ISELECT_REALLOCARRAY_COMPAT_H
+
+#if defined(ISELECT_NEED_REALLOCARRAY)
+#include <errno.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+static inline void *iselect_reallocarray(void *ptr, size_t nmemb, size_t size)
+{
+	if (nmemb != 0 && size > (size_t)-1 / nmemb) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	return realloc(ptr, nmemb * size);
+}
+#define reallocarray(ptr, nmemb, size) iselect_reallocarray(ptr, nmemb, size)
+#endif
+
+#endif
