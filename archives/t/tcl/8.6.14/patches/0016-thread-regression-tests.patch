--- tests/thread.test	2024-01-25 03:26:26.000000000 +0800
+++ tests/thread.test	2026-08-01 17:33:38.001062500 +0800
@@ -1444,6 +1444,40 @@
     unset -nocomplain ::threadCount ::execCount ::threads ::thread
 } -result {}
 
+# Regression test for patches 0013-0015: child interp static Thread load.
+# A worker thread creates a child interp which must resolve
+# "package require -exact Thread 2.8.9" through the static bridge
+# (Tcl_StaticPackage + package ifneeded load {} Thread). The worker
+# reports completion back; the primary thread waits with a bounded
+# loop (no bare vwait) so a regression fails naturally instead of
+# hanging the whole test suite.
+test thread-7.38 {static child interp Thread load: worker + interp create + require -exact} \
+	-constraints {thread} -setup {
+    unset -nocomplain ::childThreadResult
+} -body {
+    set mainid [thread::id]
+    set worker [thread::create -joinable [string map [list %MAIN% $mainid] {
+	set i [interp create]
+	set code [catch {$i eval {package require -exact Thread 2.8.9}} msg]
+	set present [$i eval {package present Thread}]
+	thread::send -async %MAIN% [list set ::childThreadResult [list $code $present $msg]]
+	thread::release
+    }]]
+    # bounded wait: never a bare vwait
+    set deadline [expr {[clock milliseconds] + 10000}]
+    while {![info exists ::childThreadResult] && [expr {[clock milliseconds] < $deadline}]} {
+	update
+	after 20
+    }
+    thread::join $worker
+    if {![info exists ::childThreadResult]} {
+	return -code error "worker did not report completion (child interp static Thread load regression)"
+    }
+    set ::childThreadResult
+} -cleanup {
+    unset -nocomplain ::childThreadResult
+} -result {0 2.8.9 2.8.9}
+
 # cleanup
 ::tcltest::cleanupTests
-return
+return
\ No newline at end of file

