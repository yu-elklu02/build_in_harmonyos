+
+# Regression test for patch 0012: ThreadJoin protection for invalid
+# handles and double join. Must return safe errors, never SIGSEGV.
+test thread-4.6 {thread::join - invalid handle and double join (0012 regression)} {
+    ThreadReap
+    # invalid thread handle: safe error
+    set r1 [catch {thread::join 123456789} m1]
+    # -joinable normal join
+    set tid [thread::create -joinable {set x 5}]
+    set c1 [thread::join $tid]
+    # double join: second join fails safely
+    set r2 [catch {thread::join $tid} m2]
+    ThreadReap
+    list $r1 [lrange $m1 0 2] $c1 $r2 [lrange $m2 0 2]
+} {1 {invalid thread handle} 0 1 {cannot join thread}}
 removeFile dummyForTransfer
-::tcltest::cleanupTests
+::tcltest::cleanupTests
