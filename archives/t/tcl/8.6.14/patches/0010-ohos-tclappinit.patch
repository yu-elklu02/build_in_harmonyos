--- unix/tclAppInit.c.orig	2026-07-30 18:17:33.729384374 +0800
+++ unix/tclAppInit.c	2026-07-30 18:20:56.857382655 +0800
@@ -23,8 +23,37 @@
 #ifdef TCL_TEST
 extern Tcl_LibraryInitProc Tcltest_Init;
 extern Tcl_LibraryInitProc Tcltest_SafeInit;
+
+/* Itcl, tdbc, tdbcmysql: have Tcl library files -- linked via PKG_OBJS (tcltest only) */
+extern Tcl_LibraryInitProc Itcl_Init;
+extern Tcl_LibraryInitProc Itcl_SafeInit;
+extern Tcl_LibraryInitProc Tdbc_Init;
+extern Tcl_LibraryInitProc Tdbcmysql_Init;
 #endif /* TCL_TEST */

+/*
+ * Sqlite3 and Thread are pure C (no Tcl library overhead).
+ * Linked into both tclsh and tcltest via TCLSH_PKG_OBJS / PKG_OBJS.
+ */
+extern Tcl_LibraryInitProc Sqlite3_Init;
+extern Tcl_LibraryInitProc Sqlite3_SafeInit;
+extern Tcl_LibraryInitProc Thread_Init;
+
+/* tdbcsqlite3 is pure Tcl -- no C InitProc needed */
+
+/*
+ * OHOS: Statically link select sub-packages into the interpreter.
+ *
+ * Sqlite3, Thread -- InitProc called directly (pure C, no Tcl library files).
+ * These are linked into both tclsh and tcltest.
+ */
+static int OhosStaticPkgs_Init(Tcl_Interp *interp) {
+    if (Sqlite3_Init(interp) != TCL_OK) return TCL_ERROR;
+    Tcl_StaticPackage(interp, "sqlite3", Sqlite3_Init, Sqlite3_SafeInit);
+    if (Thread_Init(interp) != TCL_OK) return TCL_ERROR;
+    return TCL_OK;
+}
+
 #ifdef TCL_XT_TEST
 extern void                XtToolkitInitialize(void);
 extern Tcl_LibraryInitProc Tclxttest_Init;
@@ -54,7 +83,7 @@
