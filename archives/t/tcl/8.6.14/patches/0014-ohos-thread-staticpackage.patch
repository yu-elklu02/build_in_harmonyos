--- unix/tclAppInit.c.orig	2026-08-01 11:07:57.336775469 +0800
+++ unix/tclAppInit.c	2026-08-01 11:07:43.852776563 +0800
@@ -51,6 +51,13 @@
     if (Sqlite3_Init(interp) != TCL_OK) return TCL_ERROR;
     Tcl_StaticPackage(interp, "sqlite3", Sqlite3_Init, Sqlite3_SafeInit);
     if (Thread_Init(interp) != TCL_OK) return TCL_ERROR;
+    /* Register Thread as a statically linked package so that any interp
+     * (including child interps created by "interp create") can resolve
+     * "package require Thread" via "load {} Thread". Without this, the
+     * core test unix/tests/thread.test hangs: the worker thread creates a
+     * child interp that must require Thread, fails, and the main thread's
+     * vwait never returns. */
+    Tcl_StaticPackage(interp, "Thread", Thread_Init, NULL);
     return TCL_OK;
 }
 
