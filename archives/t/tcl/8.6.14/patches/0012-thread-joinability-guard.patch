     Tcl_ThreadId thrId         /* Thread ID of other interpreter. */
 ) {
     int ret, state;
+    JoinableThread *jtPtr, **jtPrevPtr;
+    char thrHandle[THREAD_HNDLMAXLEN];
+
+    /*
+     * Guard against joining invalid, already-released, or non-joinable
+     * threads.  Calling Tcl_JoinThread() on such threads is undefined
+     * behaviour and crashes on some platforms (e.g. OHOS pthread).
+     */
+
+    /*
+     * A live thread that is in the list but was not created with
+     * -joinable must not be joined (Tcl_JoinThread on a detached/
+     * non-joinable thread is undefined behaviour and crashes on
+     * some platforms).  Threads that already exited are removed
+     * from the list; for them we defer to Tcl_JoinThread, which
+     * is safe for joinable threads.
+     */
+    Tcl_MutexLock(&threadMutex);
+    jtPtr = joinableThreads;
+    jtPrevPtr = &joinableThreads;
+    while (jtPtr != NULL && jtPtr->id != thrId) {
+        jtPrevPtr = &jtPtr->nextPtr;
+        jtPtr = jtPtr->nextPtr;
+    }
