--- a/Makefile
+++ b/Makefile
@@ -22,1 +22,8 @@
+PTHREAD_CANCEL_SUPPORTED := $(shell printf '%s\n' '\#include <pthread.h>' \
+	'int main(void) { return pthread_cancel((pthread_t)0); }' | \
+	$(CC) -x c - -pthread -o /dev/null >/dev/null 2>&1 && echo 1)
+ifeq ($(PTHREAD_CANCEL_SUPPORTED),)
+CFLAGS += -DTPL_NO_PTHREAD_CANCEL=1
+endif
+
