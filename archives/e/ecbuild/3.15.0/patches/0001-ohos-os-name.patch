diff --git a/a/cmake/ecbuild_check_os.cmake b/b/cmake/ecbuild_check_os.cmake
index 259222f..7fcbb96 100644
--- a/cmake/ecbuild_check_os.cmake
+++ b/cmake/ecbuild_check_os.cmake
@@ -230,7 +230,15 @@ if( UNIX )
 
   ### Linux ###
 
-  if( ${CMAKE_SYSTEM_NAME} MATCHES "Linux" )
+  # OHOS/HarmonyOS 按 linux 处理：它是 Linux 内核 + musl，/proc 齐备，
+  # 下游（如 eckit）用 EC_OS_NAME 挑 SystemInfo 实现时需要这个值。
+  # 不认的话 EC_OS_NAME 停在 "UNKNOWN"，eckit 只 ecbuild_warn 就不编
+  # SystemInfoLinux.cc，而 SystemInfo.cc 又用 `#if defined(__linux__)` 引用它
+  # （OHOS 的 clang 定义了 __linux__）→ 产物缺 vtable、**加载期才炸**。
+  #
+  # 注意不能靠命令行 -DEC_OS_NAME=linux 绕过：本文件开头的
+  # `set( EC_OS_NAME "UNKNOWN" )` 是**普通变量**，会遮蔽掉命令行传的 cache 变量。
+  if( ${CMAKE_SYSTEM_NAME} MATCHES "Linux|OHOS|HarmonyOS" )
 
     set( EC_OS_NAME "linux" )
 
