--- a/src/c/ffi/libraries.d
+++ b/src/c/ffi/libraries.d
@@ -65,6 +65,16 @@
 #  include <unistd.h>
 # endif
 #endif /* ENABLE_DLOPEN */
+/* 上面 include <dlfcn.h> 之后做了 `#undef bool`（为清掉某些平台上 dlfcn.h
+ * 带进来的 bool 宏）。但 <stdbool.h> 有 include guard——此处 bool 被 undef 掉后，
+ * 后面 ecl/internal.h 里再 include <stdbool.h> 是空操作，不会重新定义，
+ * 于是 internal.h 与 ecl/threads.h 中所有 `bool` 都成了未知类型：
+ *   error: unknown type name 'bool'
+ * 在把 bool 当关键字的工具链（C23）上恰好无碍；clang 15 默认 -std=gnu17 下是硬错误。
+ * 这里按 C99 语义显式恢复，与 <stdbool.h> 的定义一致。 */
+#if !defined(__cplusplus) && !defined(bool)
+# define bool _Bool
+#endif
 #include <ecl/ecl-inl.h>
 #include <ecl/internal.h>
 
