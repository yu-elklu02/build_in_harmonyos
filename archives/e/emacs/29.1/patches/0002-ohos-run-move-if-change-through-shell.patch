--- a/Makefile.in
+++ b/Makefile.in
@@ -447,7 +447,7 @@ etc-emacsver:
 	majorversion=`echo ${version} | sed 's/\..*//'`; \
 	sed "s/[@]majorversion@/$${majorversion}/" \
 	  ${srcdir}/etc/refcards/emacsver.tex.in > emacsver.tex.$$$$ && \
-	  ${srcdir}/build-aux/move-if-change emacsver.tex.$$$$ \
+	  $(SHELL) ${srcdir}/build-aux/move-if-change emacsver.tex.$$$$ \
 	  ${srcdir}/etc/refcards/emacsver.tex
 
 # The shared gamedir name as a C string literal, or a null ptr if not in use.
@@ -480,7 +480,7 @@ epaths-force:
 	  -e 's;\(#.*PATH_BITMAPS\).*$$;\1 "${bitmapdir}";'		\
 	  -e 's;\(#.*PATH_X_DEFAULTS\).*$$;\1 "${x_default_search_path}";' \
 	  -e 's;\(#.*PATH_GAME\).*$$;\1 $(PATH_GAME);'			\
 	  -e 's;\(#.*PATH_DOC\).*$$;\1 "${etcdocdir}";') &&		\
-	${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
+	$(SHELL) ${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
 
 # The w32 build needs a slightly different editing, and it uses
 # nt/epaths.nt as the template.
@@ -503,7 +503,7 @@ epaths-force-w32:
 	  -e 's;\(#.*PATH_REL_LOADSEARCH\).*$$;\1 "${lispdirrel}";' \
 	  -e '/^.*#/s/@VER@/${version}/g' 			\
 	  -e '/^.*#/s/@CFG@/${configuration}/g' 		\
 	  -e "/^.*#/s|@SRC@|$${w32srcdir}|g") &&		\
-	${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
+	$(SHELL) ${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
 
 # A NextStep style app bundle is relocatable, so instead of
 # hard-coding paths try to generate them at run-time.
@@ -516,7 +516,7 @@ epaths-force-ns-self-contained: epaths-force
 	@(sed < src/epaths.h > epaths.h.$$$$		\
 	  -e 's;${ns_appdir}/;;') &&			\
-	${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
+	$(SHELL) ${srcdir}/build-aux/move-if-change epaths.h.$$$$ src/epaths.h
 
 ifneq ($(NTDIR),)
 $(NTDIR): lib
 endif
--- a/doc/emacs/Makefile.in
+++ b/doc/emacs/Makefile.in
@@ -197,4 +197,4 @@ doc-emacsver:
 	sed 's/[@]version@/${version}/' \
 	  ${srcdir}/emacsver.texi.in > emacsver.texi.$$$$ && \
-	  ${top_srcdir}/build-aux/move-if-change emacsver.texi.$$$$ \
+	  $(SHELL) ${top_srcdir}/build-aux/move-if-change emacsver.texi.$$$$ \
 	  ${srcdir}/emacsver.texi
--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -672,7 +672,7 @@ GLOBAL_SOURCES = $(base_obj:.o=.c) $(NS_OBJC_OBJ:.o=.m)
 
 gl-stamp: $(libsrc)/make-docfile$(EXEEXT) $(GLOBAL_SOURCES)
 	$(AM_V_GLOBALS)$(libsrc)/make-docfile -d $(srcdir) -g $(doc_obj) > globals.tmp
-	$(AM_V_at)$(top_srcdir)/build-aux/move-if-change globals.tmp globals.h
+	$(AM_V_at)$(SHELL) $(top_srcdir)/build-aux/move-if-change globals.tmp globals.h
 	$(AM_V_at)echo timestamp > $@
 
 globals.h: gl-stamp; @true
