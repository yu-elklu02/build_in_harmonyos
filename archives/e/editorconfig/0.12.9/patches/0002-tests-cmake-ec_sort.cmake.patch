--- a/tests/cmake/ec_sort.cmake
+++ b/tests/cmake/ec_sort.cmake
@@ -55,16 +55,37 @@
 
 run_and_sort(RETVAL lines RETVAL_FAILURE did_fail
     CMDLINE ${EDITORCONFIG_CMD} ${ECARGS}
 )
 
 if(${did_fail})
     message(FATAL_ERROR "${EDITORCONFIG_CMD} ${ECARGS} returned a nonzero exit code")
     return()
 endif()
 
-# message() will give us an extra \n, so trim one if we can.
-string(REGEX REPLACE "(\r\n|\r|\n)$" "" lines "${lines}")
-
+# message() will give us an extra \n, so trim one if we can.
+string(REGEX REPLACE "(\r\n|\r|\n)$" "" lines "${lines}")
+
+# CTest's PASS_REGULAR_EXPRESSION does not match across output lines on all
+# supported CMake versions.  Match the exact logical output emitted by
+# message(), including its final newline, after normalizing line endings.
+if(DEFINED EXPECTED_REGEX)
+    string(ASCII 30 line_separator)
+    set(normalized_lines "${lines}\n")
+    set(normalized_regex "${EXPECTED_REGEX}")
+    foreach(line_ending "\r\n" "\r" "\n")
+        string(REPLACE "${line_ending}" "${line_separator}"
+            normalized_lines "${normalized_lines}")
+        string(REPLACE "${line_ending}" "${line_separator}"
+            normalized_regex "${normalized_regex}")
+    endforeach()
+
+    if(NOT "${normalized_lines}" MATCHES "${normalized_regex}")
+        message(FATAL_ERROR
+            "Output did not match expected regular expression.\n"
+            "Expected: ${EXPECTED_REGEX}\nActual:\n${lines}")
+    endif()
+endif()
+
 # Output **to stderr**.  If we used message(STATUS...), it would print to
 # stdout but also emit a leading "--".
 message("${lines}")
