--- a/src/main.c
+++ b/src/main.c
@@ -976,9 +976,28 @@
   /* Get user's passwd entry. */
   passwd = getpwuid (getuid ());
   if (passwd == NULL)
-    FATAL ((stderr, _("couldn't get passwd entry for uid=%d: %s"), getuid (),
-	    strerror (errno)));
+    {
+      /* HarmonyOS/OHOS (musl) may not support passwd database lookups
+	 (getpwuid returns "Not supported").  Instead of aborting, synthesize
+	 a fallback entry from the environment so enscript stays usable. */
+      static struct passwd fallback_pw;
+      char *env_name = getenv ("LOGNAME");
+      char *env_home = getenv ("HOME");
 
+      if (env_name == NULL)
+	env_name = getenv ("USER");
+      if (env_name == NULL)
+	env_name = "user";
+      if (env_home == NULL)
+	env_home = "/";
+
+      fallback_pw.pw_name = env_name;
+      fallback_pw.pw_gecos = env_name;
+      fallback_pw.pw_dir = env_home;
+      fallback_pw.pw_uid = getuid ();
+      passwd = &fallback_pw;
+    }
+
   /* Defaults for some options. */
   media_name 		= xstrdup ("A4");
   encoding_name		= xstrdup ("88591");
