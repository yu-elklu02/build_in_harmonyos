--- a/src/util.c
+++ b/src/util.c
@@ -2158,4 +2158,40 @@
   *outp = 0;
 
   return retval;
+}
+
+
+/*
+ * xtmpfile - portable replacement for tmpfile().
+ *
+ * On HarmonyOS/OHOS (musl libc) tmpfile() always creates its file under a
+ * read-only "/tmp", so it fails with ENOENT/EROFS.  Honour $TMPDIR (and then
+ * $HOME) and create an unlinked temporary file there, falling back to the
+ * libc tmpfile() when no writable directory is known.
+ */
+FILE *
+xtmpfile ()
+{
+  const char *dir;
+  char template[512];
+  int fd;
+  FILE *fp;
+
+  dir = getenv ("TMPDIR");
+  if (dir == NULL || *dir == '\0')
+    dir = getenv ("HOME");
+  if (dir == NULL || *dir == '\0')
+    return tmpfile ();
+
+  snprintf (template, sizeof (template), "%s/enscriptXXXXXX", dir);
+  fd = mkstemp (template);
+  if (fd < 0)
+    return tmpfile ();
+
+  /* Unlink immediately so the file disappears on close, like tmpfile(). */
+  (void) unlink (template);
+  fp = fdopen (fd, "w+b");
+  if (fp == NULL)
+    close (fd);
+  return fp;
 }
