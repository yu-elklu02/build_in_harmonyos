 void ThreadControler::kill() {
+#if defined(__OHOS__)
+    /* OHOS 的 libc 不提供任何线程取消机制 —— 实测 pthread_cancel /
+     * pthread_kill / pthread_setcanceltype 三者在 sysroot 的 pthread.h 里
+     * 一次都没出现，试编也全部失败。
+     *
+     * 这里**故意不做等价替换**：异步取消本就是有害的原语（在任意点打断线程，
+     * 锁与不变量都可能处于半途），上游自己在下一行注释里也只是把 pthread_kill
+     * 当备选。OHOS 上正确的停线程方式是走已有的协作式路径 ——
+     * ThreadControler::stop() → proc_->stop()，那条路径不依赖取消。
+     *
+     * 故本函数在 OHOS 上降级为 no-op，并明确记入 notes：
+     * 依赖 kill() 强杀线程的用法在鸿蒙上不生效，应改用 stop()。 */
+    (void)thread_;
+#else
     pthread_cancel(thread_);
     // pthread_kill(thread_,sig);
+#endif
 }
 
