         c_args: [],
 )
+
+# Test-only build: same sources with QBOOTCTL_TESTING defined, which
+# switches the backend to an in-memory mock (no device access). It is
+# NOT installed into bin/ — the recipe copies it to a test-only
+# location so the production package ships only the real qbootctl.
+executable('qbootctl-test', src,
+        include_directories: inc,
+        install: false,
+        c_args: ['-DQBOOTCTL_TESTING'],
+)
