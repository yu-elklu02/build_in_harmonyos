diff -ruN a/src/corelib/thread/qthread_unix.cpp b/src/corelib/thread/qthread_unix.cpp
--- a/src/corelib/thread/qthread_unix.cpp
+++ b/src/corelib/thread/qthread_unix.cpp
@@ -6,4 +6,12 @@
 #include "qthread.h"
 #include "qthread_p.h"
-
+
+// Some platforms define PTHREAD_CANCEL_DISABLE in <pthread.h> but do not
+// provide the pthread cancellation functions. QT_NO_PTHREAD_CANCEL is set by
+// a link-capability check in conanfile.py; undefine the macro so Qt follows
+// its no-op fallback branches.
+#ifdef QT_NO_PTHREAD_CANCEL
+#  undef PTHREAD_CANCEL_DISABLE
+#endif
+
 #include <private/qcoreapplication_p.h>
@@ -896,5 +904,5 @@
 void QThread::terminate()
 {
-#if !defined(Q_OS_ANDROID)
+#if !defined(Q_OS_ANDROID) && !defined(QT_NO_PTHREAD_CANCEL)
     Q_D(QThread);
     QMutexLocker locker(&d->mutex);
