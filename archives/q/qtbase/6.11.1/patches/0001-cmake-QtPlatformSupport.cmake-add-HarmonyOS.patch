diff -ruN a/cmake/QtPlatformSupport.cmake b/cmake/QtPlatformSupport.cmake
--- a/cmake/QtPlatformSupport.cmake
+++ b/cmake/QtPlatformSupport.cmake
@@ -4,4 +4,4 @@
-if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
     set(LINUX 1)
 else()
     set(LINUX 0)
@@ -8,3 +8,11 @@
 endif()
-
+# HarmonyOS is a Linux-based POSIX system, but its CMake does not set UNIX=ON.
+# Force UNIX=ON so that Qt's UNIX code paths are enabled.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    set(UNIX ON)
+    set(HARMONYOS 1)
+else()
+    set(HARMONYOS 0)
+endif()
+
 if(CMAKE_SYSTEM_NAME STREQUAL "HPUX")
