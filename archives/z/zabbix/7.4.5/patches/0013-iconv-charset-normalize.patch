--- a/src/libs/zbxstr/str.c
+++ b/src/libs/zbxstr/str.c
@@ -1313,7 +1313,7 @@
 	iconv_t		cd;
 	size_t		in_size_left, out_size_left, sz, out_alloc = 0;
 	const char	to_code[] = "UTF-8";
-	char		*p, *out_utf8_string = NULL;
+	char		*p, *out_utf8_string = NULL, *encoding_norm = NULL;

 	out_alloc = in_size + 1;
 	p = out_utf8_string = (char *)zbx_malloc(out_utf8_string, out_alloc);
@@ -1329,8 +1329,39 @@
 		goto out;
 	}

+	/* glibc's iconv_open tolerates HTML charset artifacts - a surrounding pair
+	 * of double quotes (from charset="\"name\"") and a trailing backslash
+	 * (unterminated escape). musl rejects them with EINVAL, which would make this
+	 * function return NULL and crash callers that assume a non-NULL result. Strip
+	 * them so both libc implementations behave the same. */
+	if ('"' == *encoding || '\\' == encoding[strlen(encoding) - 1])
+	{
+		encoding_norm = zbx_strdup(NULL, encoding);
+		zbx_lrtrim(encoding_norm, "\"");
+		zbx_rtrim(encoding_norm, "\\");
+		encoding = encoding_norm;
+	}
+
+	if ('\0' == *encoding)
+	{
+		memcpy(out_utf8_string, in, in_size);
+		out_utf8_string[in_size] = '\0';
+		goto out;
+	}
+
 	if ((iconv_t)-1 == (cd = iconv_open(to_code, encoding)))
+	{
+		/* glibc treats an un-detectable (non-ASCII) charset name as "cannot
+		 * detect" and returns an empty result without an error; musl returns
+		 * EINVAL. Match glibc so callers get an empty (non-NULL) buffer. */
+		if (FAIL == zbx_is_ascii_string(encoding))
+		{
+			*p = '\0';
+			goto out;
+		}
+
 		goto utf8_convert_fail;
+	}

 	in_size_left = in_size;
 	out_size_left = out_alloc - 1;
@@ -1363,6 +1394,8 @@
 	*error = zbx_dsprintf(NULL, "Failed to convert from encoding %s to utf8. Error: %s.", encoding,
 			zbx_strerror(errno));
 out:
+	zbx_free(encoding_norm);
+
 	return out_utf8_string;
 }
 #endif	/* HAVE_ICONV */
