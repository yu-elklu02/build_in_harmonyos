--- a/m4/resolv.m4
+++ b/m4/resolv.m4
@@ -53,6 +53,51 @@
 	fi
 
 	if test "x$found_resolv" = "xyes"; then
+		dnl dns.c has two resolver code paths: thread-safe (res_ninit +
+		dnl res_nsend) and thread-unsafe (_res + res_init + res_send).
+		dnl On platforms that expose res_query but neither complete path
+		dnl (e.g. musl-based / OpenHarmony, which lack res_ninit/res_nsend
+		dnl and the _res global), defining HAVE_RES_QUERY would make dns.c
+		dnl fail to compile. Only define it when a complete path exists.
+		AC_MSG_CHECKING(for complete resolver API)
+
+		dnl Thread-safe path: res_ninit + res_nsend
+		AC_LINK_IFELSE([AC_LANG_PROGRAM([[
+#ifdef HAVE_RESOLV_H
+#	include <resolv.h>
+#endif
+		]], [[
+			struct __res_state	res_state_local;
+
+			res_ninit(&res_state_local);
+			res_nsend(&res_state_local, NULL, 0, NULL, 0);
+		]])],[resolver_thread_safe="yes"],[resolver_thread_safe="no"])
+
+		dnl Thread-unsafe path: _res + res_init + res_send
+		AC_LINK_IFELSE([AC_LANG_PROGRAM([[
+#ifdef HAVE_RESOLV_H
+#	include <resolv.h>
+#endif
+		]], [[
+			res_init();
+			res_send(NULL, 0, NULL, 0);
+#ifndef _res
+			(void) _res;
+#endif
+		]])],[resolver_thread_unsafe="yes"],[resolver_thread_unsafe="no"])
+
+		if test "x$resolver_thread_safe" = "xno" && test "x$resolver_thread_unsafe" = "xno"; then
+			have_res_query="no"
+			AC_MSG_RESULT(no - resolver API incomplete, disabling DNS lookups)
+		else
+			have_res_query="yes"
+			AC_MSG_RESULT(yes)
+		fi
+	else
+		have_res_query="no"
+	fi
+
+	if test "x$have_res_query" = "xyes"; then
 		AC_DEFINE([HAVE_RES_QUERY], 1, [Define to 1 if you have the DNS functions])
 	else
 		AC_MSG_RESULT(no)
