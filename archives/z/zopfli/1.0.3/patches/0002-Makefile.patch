--- a/Makefile
+++ b/Makefile
@@ -56,10 +56,28 @@
 libzopflipng: $(ZOPFLILIB_OBJ) $(LODEPNG_OBJ) $(ZOPFLIPNGLIB_OBJ)
 	$(CXX) $^ $(CFLAGS) --shared -Wl,-soname,libzopflipng.so.1 -o libzopflipng.so.1.0.3 $(LDFLAGS)
 
 # ZopfliPNG static library
 libzopflipng.a: $(LODEPNG_OBJ) $(ZOPFLIPNGLIB_OBJ)
 	ar rcs $@ $^
 
 # Remove all libraries and binaries
 clean:
 	rm -f zopflipng zopfli $(ZOPFLILIB_OBJ) $(ZOPFLIBIN_OBJ) $(LODEPNG_OBJ) $(ZOPFLIPNGLIB_OBJ) $(ZOPFLIPNGBIN_OBJ) libzopfli*
+
+# Install targets
+PREFIX ?= /usr/local
+
+.PHONY: install
+
+install: all
+	@mkdir -p $(DESTDIR)$(PREFIX)/bin
+	@mkdir -p $(DESTDIR)$(PREFIX)/lib
+	@mkdir -p $(DESTDIR)$(PREFIX)/include/zopfli
+	@mkdir -p $(DESTDIR)$(PREFIX)/include/zopflipng/lodepng
+	install -m 755 zopfli zopflipng $(DESTDIR)$(PREFIX)/bin/
+	install -m 755 libzopfli.so.1.0.3 libzopflipng.so.1.0.3 $(DESTDIR)$(PREFIX)/lib/
+	install -m 644 libzopfli.a libzopflipng.a $(DESTDIR)$(PREFIX)/lib/
+	install -m 644 src/zopfli/*.h $(DESTDIR)$(PREFIX)/include/zopfli/
+	install -m 644 src/zopflipng/zopflipng_lib.h $(DESTDIR)$(PREFIX)/include/zopflipng/
+	install -m 644 src/zopflipng/lodepng/*.h $(DESTDIR)$(PREFIX)/include/zopflipng/lodepng/
+	cd $(DESTDIR)$(PREFIX)/lib && ln -sf libzopfli.so.1.0.3 libzopfli.so.1 && ln -sf libzopfli.so.1 libzopfli.so
