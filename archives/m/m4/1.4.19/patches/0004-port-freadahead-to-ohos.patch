--- a/lib/freadahead.c
+++ b/lib/freadahead.c
@@ -94,6 +94,10 @@
   if (fp->state == 4 /* WR */ || fp->rp >= fp->wp)
     return 0;
   return fp->wp - fp->rp;
+#elif defined GNULIB_FREADAHEAD_OPAQUE_FILE
+  /* Some libc implementations expose FILE as opaque and do not provide
+     __freadahead.  Use a conservative fallback selected by the build system.  */
+  return 0;
 #elif defined SLOW_BUT_NO_HACKS     /* users can define this */
   abort ();
   return 0;
