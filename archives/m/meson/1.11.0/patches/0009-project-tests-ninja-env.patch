diff --git a/run_project_tests.py b/run_project_tests.py
index 4b1c5e2..8f9a3d1 100644
--- a/run_project_tests.py
+++ b/run_project_tests.py
@@ -1492,11 +1492,19 @@
     ]
 
     def get_version(t: ToolInfo) -> str:
-        exe = shutil.which(t.tool)
+        # On OHOS the toolchain dir is not in the worker PATH; run_tests.py
+        # already exports the resolved tool via $NINJA, so honour it here.
+        if t.tool == 'ninja' and os.environ.get('NINJA'):
+            exe = os.environ['NINJA']
+        else:
+            exe = shutil.which(t.tool)
         if not exe:
             return 'not found'
 
-        args = [t.tool] + t.args
+        # Use the resolved absolute path (e.g. $NINJA) instead of the bare
+        # tool name: Popen via PATH fails when the toolchain dir is not in
+        # the worker PATH (FileNotFoundError: 'ninja').
+        args = [exe] + t.args
         pc, o, e = Popen_safe(args)
         if pc.returncode != 0:
             return f'{exe} (invalid {t.tool} executable)'
