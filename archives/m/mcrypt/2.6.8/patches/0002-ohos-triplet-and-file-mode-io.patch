--- a/config.guess
+++ b/config.guess
@@ -1,2 +1,12 @@
 #! /bin/sh
+# Conan OHOS config.guess hook
+machine=`(uname -m) 2>/dev/null || echo aarch64`
+system=`(uname -s) 2>/dev/null || echo unknown`
+case "$system" in
+    HarmonyOS|OHOS)
+        echo "${machine}-unknown-linux-ohos"
+        exit 0
+        ;;
+esac
+
 # Attempt to guess a canonical system name.
--- a/config.sub
+++ b/config.sub
@@ -1,2 +1,10 @@
 #! /bin/sh
+# Conan OHOS config.sub hook
+case "$1" in
+    *-linux-ohos|*-unknown-linux-ohos)
+        echo "$1"
+        exit 0
+        ;;
+esac
+
