--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -145,6 +145,14 @@
 # Set ``CURSES_NEED_NCURSES`` to ``TRUE`` before the
 # ``find_package(Curses)`` call if NCurses functionality is required.
 set(CURSES_NEED_NCURSES TRUE)
+# 从环境变量读 ncurses include 路径（conan generate() 设置 CURSES_INCLUDE_DIR），
+# FindCurses 的 find_path 用 CURSES_NCURSES_INCLUDE_PATH 找 curses.h；
+# 直接设置 CURSES_INCLUDE_PATH（find_path 保留已设置值——FindCurses 的
+# WIDE 模式 NAMES 不含纯 curses.h，curses.h 在 include/ 顶层时找不到）
+if(DEFINED ENV{CURSES_INCLUDE_DIR})
+    set(CURSES_NCURSES_INCLUDE_PATH "$ENV{CURSES_INCLUDE_DIR}")
+    set(CURSES_INCLUDE_PATH "$ENV{CURSES_INCLUDE_DIR}")
+endif()
 find_file(CURSES_INCLUDE_FILE ncurses.h)
 find_package(Curses REQUIRED)
 if(CURSES_FOUND)
