diff --git a/acc_mmap.c b/acc_mmap.c
index 2becdac..133bb0f 100644
--- a/acc_mmap.c
+++ b/acc_mmap.c
@@ -121,10 +121,19 @@ static ssize_t mmap_write(struct memtool_fd *handle, off_t offset,
 
 	if (S_ISREG(s->st_mode) && s->st_size < offset + nbytes) {
 		ret = posix_fallocate(mmap_fd->fd, offset, nbytes);
-		if (ret) {
+		if (ret == EACCES || ret == EOPNOTSUPP || ret == ENOSYS) {
+			/*
+			 * Sandboxed filesystems may permit sparse extension while
+			 * rejecting explicit block allocation.
+			 */
+			if (ftruncate(mmap_fd->fd, offset + nbytes) < 0) {
+				perror("ftruncate");
+				return -1;
+			}
+		} else if (ret) {
 			errno = ret;
 			perror("fallocate");
 			return -1;
 		}
 		s->st_size = offset + nbytes;
 	}
