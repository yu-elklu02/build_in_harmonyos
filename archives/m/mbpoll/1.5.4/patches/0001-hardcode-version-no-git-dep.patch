     WORLD_READ WORLD_EXECUTE)
 endif()
 
-# Get version from git tags
-include(GitVersion)
-GetGitVersion(MBPOLL_VERSION)
-WriteGitVersionFile(${CMAKE_CURRENT_BINARY_DIR}/version-git.h)
-set(MBPOLL_VERSION_STRING
-  ${MBPOLL_VERSION_MAJOR}.${MBPOLL_VERSION_MINOR}.${MBPOLL_VERSION_PATCH})
+# Version - hardcoded for reproducible builds. Upstream derives the version
+# from git tags via cmake/GitVersion.cmake, which is unreliable for source
+# tarballs and build trees that are not a git repo carrying a matching tag
+# (it even hard-aborts the configure step in that case, e.g. when a parent
+# directory happens to be an unrelated git repository).
+set(MBPOLL_VERSION_MAJOR 1)
+set(MBPOLL_VERSION_MINOR 5)
+set(MBPOLL_VERSION_PATCH 4)
+set(MBPOLL_VERSION_STRING "${MBPOLL_VERSION_MAJOR}.${MBPOLL_VERSION_MINOR}.${MBPOLL_VERSION_PATCH}")
+file(WRITE  ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION \"${MBPOLL_VERSION_STRING}\"\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_SHORT \"${MBPOLL_VERSION_STRING}\"\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_TINY \"${MBPOLL_VERSION_MAJOR}.${MBPOLL_VERSION_MINOR}\"\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_MAJOR ${MBPOLL_VERSION_MAJOR}\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_MINOR ${MBPOLL_VERSION_MINOR}\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_PATCH ${MBPOLL_VERSION_PATCH}\n")
+file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/version-git.h "#define VERSION_SHA1 0x0\n")
 
 # Define source files
 set(MBPOLL_SOURCES
