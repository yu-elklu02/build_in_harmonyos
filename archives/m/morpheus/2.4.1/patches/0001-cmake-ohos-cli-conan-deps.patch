diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -62,1 +62,1 @@
-IF(HAVE_IPO AND CMAKE_BUILD_TYPE STREQUAL "Release" AND NOT WIN32)
+IF(HAVE_IPO AND CMAKE_BUILD_TYPE STREQUAL "Release" AND NOT WIN32 AND NOT CMAKE_SYSTEM_NAME MATCHES "OHOS|HarmonyOS")
@@ -93,1 +93,1 @@
-IF( UNIX AND NOT APPLE )
+IF( (UNIX AND NOT APPLE) OR CMAKE_SYSTEM_NAME MATCHES "OHOS|HarmonyOS" )
diff -ruN a/morpheus/CMakeLists.txt b/morpheus/CMakeLists.txt
--- a/morpheus/CMakeLists.txt
+++ b/morpheus/CMakeLists.txt
@@ -127,1 +127,14 @@
-TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC ${ZLIB_LIBRARY} ${TIFF_LIBRARY} ${TIFF_LIBRARY})
+IF(TARGET ZLIB::ZLIB)
+	TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC ZLIB::ZLIB)
+ELSE()
+	TARGET_INCLUDE_DIRECTORIES(MorpheusCore PUBLIC ${ZLIB_INCLUDE_DIRS} ${ZLIB_INCLUDE_DIR})
+	TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC ${ZLIB_LIBRARY} ${ZLIB_LIBRARIES})
+ENDIF()
+IF(TARGET TIFF::tiff)
+	TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC TIFF::tiff)
+ELSEIF(TARGET TIFF::TIFF)
+	TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC TIFF::TIFF)
+ELSE()
+	TARGET_INCLUDE_DIRECTORIES(MorpheusCore PUBLIC ${TIFF_INCLUDE_DIRS} ${TIFF_INCLUDE_DIR})
+	TARGET_LINK_LIBRARIES_PATCHED(MorpheusCore PUBLIC ${TIFF_LIBRARY} ${TIFF_LIBRARIES})
+ENDIF()
diff -ruN a/morpheus/core/threading.h b/morpheus/core/threading.h
