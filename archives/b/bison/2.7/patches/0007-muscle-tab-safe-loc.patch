diff -ruN a/src/muscle-tab.c b/src/muscle-tab.c
--- a/src/muscle-tab.c
+++ b/src/muscle-tab.c
@@ -483,6 +483,11 @@ muscle_percent_define_get_loc (char const *variable)
   char const *loc_name;
   char const *value;
   loc_name = UNIQSTR_CONCAT ("percent_define_loc(", variable, ")");
   value = muscle_find_const (loc_name);
   if (!value)
     fatal (_("%s: undefined %%define variable %s"),
            "muscle_percent_define_get_loc", quote (variable));
-  return location_decode (value);
+  {
+    location loc = location_decode (value);
+    /* Guard against a NULL file pointer that can appear on platforms
+       whose heap layout differs from glibc x86-64 (e.g. OHOS aarch64).
+       An uninitialised or corrupted loc.start.file causes a SIGSEGV
+       inside complain_at / complain_at_indent when they dereference it
+       to build the diagnostic prefix.  Fall back to empty_location so
+       the error message is still emitted without crashing.           */
+    if (!loc.start.file)
+      loc = empty_location;
+    return loc;
+  }
 }
