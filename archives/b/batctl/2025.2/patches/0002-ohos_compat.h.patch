+/* SPDX-License-Identifier: GPL-2.0 */
+/* E119 fix: Prevent linux/socket.h redefinition of sockaddr_storage
+ * by pre-defining _UAPI_LINUX_SOCKET_H guard and manually
+ * providing __kernel_sa_family_t needed by linux/netlink.h
+ */
+
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+/* Manually define what we need from linux/socket.h */
+typedef unsigned short __kernel_sa_family_t;
+#endif /* _UAPI_LINUX_SOCKET_H */
