diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,17 +1,21 @@
 SRCS = bannergrab.c
-BINPATH = /usr/bin/
-MANPATH = /usr/share/man/
+BINPATH = $(prefix)/bin/
+MANPATH = $(prefix)/share/man/
+
+.PHONY: all install uninstall clean

 all:
-	gcc -lssl -o bannergrab $(SRCS) $(LDFLAGS) $(CFLAGS)
