--- a/Makefile	2019-07-14 01:50:05.000000000 +0800
+++ b/Makefile	2026-04-09 18:57:22.166061094 +0800
@@ -21,7 +21,10 @@
 LDFLAGS=
 
 BIGFILES=-D_FILE_OFFSET_BITS=64
-CFLAGS=-Wall -Winline -O2 -g $(BIGFILES)
+
+# Auto-detect HarmonyOS (OHOS): add -fPIC required for static library consumers
+EXTRA_CFLAGS := $(shell $(CC) -dumpmachine 2>/dev/null | grep -q "ohos" && echo "-fPIC")
+CFLAGS = -Wall -Winline -O2 -g $(BIGFILES) $(EXTRA_CFLAGS)
 
 # Where you want it installed when you do 'make install'
 PREFIX=/usr/local
