--- a/boot-strap
+++ b/boot-strap
@@ -411,3 +411,13 @@
 # make sure test below uses the same diff that configure did
 TOOL_DIFF=`which diff`
+if [ -z "$TOOL_DIFF" ]; then
+	tool_ifs=$IFS
+	IFS=:
+	for tool_dir in $PATH; do
+		[ -x "$tool_dir/diff" ] || continue
+		TOOL_DIFF=$tool_dir/diff
+		break
+	done
+	IFS=$tool_ifs
+fi
 export TOOL_DIFF
