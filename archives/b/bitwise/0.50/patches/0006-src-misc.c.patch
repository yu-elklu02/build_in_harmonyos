 #include <ctype.h>
 #include <inttypes.h>
+#include <stdlib.h>
 #include "bitwise.h"
+
+/* OpenHarmony does not provide l64a() in libc, so we implement it here. */
+char *l64a(long value)
+{
+	static char buf[8];
+	const char digits[] = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+	int i = 0;
+	unsigned long v = (unsigned long)value;
+
+	if (v == 0) {
+		buf[0] = '\0';
+		return buf;
+	}
+	while (v > 0 && i < 7) {
+		buf[i++] = digits[v & 0x3f];
+		v >>= 6;
+	}
+	buf[i] = '\0';
+	return buf;
+}
 
 /* IEC Standard */
 #define KiB (1ULL << 10)
 #define MiB (1ULL << 20)
 #define GiB (1ULL << 30)
 #define TiB (1ULL << 40)
 #define PiB (1ULL << 50)
 
 /* SI Standard */
 #define kB (1000ULL)
