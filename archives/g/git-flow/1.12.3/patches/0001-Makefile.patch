--- a/Makefile
+++ b/Makefile
@@ -47,22 +47,23 @@
 SCRIPT_FILES+=gitflow-shFlags
 
 # Hook files
 HOOK_FILES=$(wildcard hooks/*)
 
 all:
 	@echo "usage: make install"
 	@echo "       make uninstall"
 
 install:
-	install -d -m 0755 $(prefix)/bin
-	install -d -m 0755 $(docdir)/hooks
-	install -m 0755 $(EXEC_FILES) $(prefix)/bin
-	install -m 0644 $(SCRIPT_FILES) $(prefix)/bin
-	install -m 0644 $(HOOK_FILES) $(docdir)/hooks
+	mkdir -p $(prefix)/bin
+	mkdir -p $(docdir)/hooks
+	cp $(EXEC_FILES) $(prefix)/bin/
+	chmod 755 $(prefix)/bin/git-flow
+	for file in $(SCRIPT_FILES); do cp "$$file" $(prefix)/bin/ && chmod 644 $(prefix)/bin/"$$file"; done
+	for hook in $(HOOK_FILES); do cp "$$hook" $(docdir)/hooks/ && chmod 644 $(docdir)/hooks/"$$(basename $$hook)"; done
 
 uninstall:
 	test -d $(prefix)/bin && \
 	cd $(prefix)/bin && \
 	rm -f $(EXEC_FILES) $(SCRIPT_FILES)
 	test -d $(docdir) && \
 	rm -rf $(docdir)
