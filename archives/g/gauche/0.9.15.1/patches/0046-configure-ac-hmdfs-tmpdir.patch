diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1,4 +1,21 @@
 dnl Process this file with autoconf to produce a configure script.
 AC_PREREQ([2.71])
+
+dnl HMDFS does not permit writes within the 0700 temporary directories that
+dnl Autoconf's default AS_TMPDIR creates for config.status.  Override the m4
+dnl source macro before AC_OUTPUT expands it, then regenerate configure.
+m4_define([AS_TMPDIR],
+[# Create a temporary directory suitable for HMDFS config.status output.
+m4_if([$2], [], [: "${TMPDIR:=/tmp}"])
+{
+  tmp=`(umask 002 && mktemp -d "m4_default([$2],
+    [$TMPDIR])/$1XXXXXX") 2>/dev/null` &&
+  test -d "$tmp"
+} || {
+  tmp=m4_default([$2], [$TMPDIR])/$1$$-$RANDOM
+  (umask 002 && mkdir "$tmp")
+} || AS_ERROR([cannot create a temporary directory in m4_default([$2],
+      [$TMPDIR])])])
+
 AC_INIT([Gauche],[0.9.15],[shiro@acm.org],[],[https://practical-scheme.net/gauche/])
 BUILD_GOSH_VERSION=0.9.14  # Host Gauche version required to build from scratch
