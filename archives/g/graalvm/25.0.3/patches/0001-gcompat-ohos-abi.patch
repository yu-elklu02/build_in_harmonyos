+static unsigned short ctype_bits(int c)
+{
+	unsigned short bits = 0;
+	int upper = c >= 'A' && c <= 'Z';
+	int lower = c >= 'a' && c <= 'z';
+	int alpha = upper || lower;
+	int digit = c >= '0' && c <= '9';
+	int xdigit = digit || (c >= 'A' && c <= 'F') ||
+	             (c >= 'a' && c <= 'f');
+	int space = c == ' ' || (c >= '\t' && c <= '\r');
+	int print = c >= 0x20 && c <= 0x7e;
+	int graph = c >= 0x21 && c <= 0x7e;
+	int blank = c == ' ' || c == '\t';
+	int cntrl = c < 0x20 || c == 0x7f;
+	int alnum = alpha || digit;
+	int punct = graph && !alnum;
+
+	if (upper) bits |= 0x0100;
+	if (lower) bits |= 0x0200;
+	if (alpha) bits |= 0x0400;
+	if (digit) bits |= 0x0800;
+	if (xdigit) bits |= 0x1000;
+	if (space) bits |= 0x2000;
+	if (print) bits |= 0x4000;
+	if (graph) bits |= 0x8000;
+	if (blank) bits |= 0x0001;
+	if (cntrl) bits |= 0x0002;
+	if (punct) bits |= 0x0004;
+	if (alnum) bits |= 0x0008;
+	return bits;
+}
+
+__attribute__((constructor))
+static void init_gcompat_ohos(void)
+{
+	int c;
+	int mapped;
+
+	__progname_full = __progname != NULL ? __progname : (char *)"";
+	program_invocation_name = __progname_full;
+
+	for (c = -128; c < 256; ++c) {
+		mapped = c < -1 ? c + 256 : c;
+		ctype_b_table[c + 128] = c >= 0 && c < 128 ? ctype_bits(c) : 0;
+		ctype_tolower_table[c + 128] =
+		    mapped >= 'A' && mapped <= 'Z' ? mapped + ('a' - 'A') : mapped;
+		ctype_toupper_table[c + 128] =
+		    mapped >= 'a' && mapped <= 'z' ? mapped - ('a' - 'A') : mapped;
+	}
+}
