+
+static int read_database_line(FILE *stream, char **line, size_t *capacity)
+{
+	ssize_t length;
+
+	for (;;) {
+		errno = 0;
+		length = getline(line, capacity, stream);
+		if (length < 0) return -1;
+		while (length > 0 &&
+		       ((*line)[length - 1] == '\n' || (*line)[length - 1] == '\r')) {
+			(*line)[--length] = '\0';
+		}
+		if (length > 0 && (*line)[0] != '#') return 0;
+	}
+}
+
+static int split_database_fields(char *line, char **fields, size_t count)
+{
+	char *cursor = line;
+
+	for (size_t i = 0; i + 1 < count; ++i) {
+		char *separator = strchr(cursor, ':');
+		if (separator == NULL) return -1;
+		fields[i] = cursor;
+		*separator = '\0';
+		cursor = separator + 1;
+	}
+	fields[count - 1] = cursor;
+	return strchr(cursor, ':') == NULL ? 0 : -1;
+}
+
+static int parse_database_id(const char *text, unsigned long *result)
+{
+	char *end;
+	unsigned long value;
+
+	if (text[0] == '\0' || text[0] == '+' || text[0] == '-') return -1;
+	errno = 0;
+	value = strtoul(text, &end, 10);
+	if (errno != 0 || end[0] != '\0') return -1;
+	*result = value;
+	return 0;
+}
+
+static __thread char *passwd_line;
+static __thread size_t passwd_capacity;
+static __thread struct passwd passwd_entry;
+
+struct passwd *fgetpwent(FILE *stream)
+{
+	char *fields[7];
+	unsigned long uid_value, gid_value;
+	uid_t uid;
+	gid_t gid;
+
+	if (stream == NULL) {
+		errno = EINVAL;
+		return NULL;
+	}
+	while (read_database_line(stream, &passwd_line, &passwd_capacity) == 0) {
+		if (split_database_fields(passwd_line, fields, 7) != 0 ||
+		    parse_database_id(fields[2], &uid_value) != 0 ||
+		    parse_database_id(fields[3], &gid_value) != 0) {
+			continue;
+		}
+		uid = (uid_t)uid_value;
+		gid = (gid_t)gid_value;
+		if ((unsigned long)uid != uid_value ||
+		    (unsigned long)gid != gid_value) {
+			continue;
+		}
+		passwd_entry.pw_name = fields[0];
+		passwd_entry.pw_passwd = fields[1];
+		passwd_entry.pw_uid = uid;
+		passwd_entry.pw_gid = gid;
+		passwd_entry.pw_gecos = fields[4];
+		passwd_entry.pw_dir = fields[5];
+		passwd_entry.pw_shell = fields[6];
+		return &passwd_entry;
+	}
+	return NULL;
+}
+
+static __thread char *group_line;
+static __thread size_t group_capacity;
+static __thread struct group group_entry;
+static __thread char **group_members;
+static __thread size_t group_members_capacity;
+
+struct group *fgetgrent(FILE *stream)
+{
+	char *fields[4];
+	unsigned long gid_value;
+	gid_t gid;
+	size_t member_count, member_index;
+	char *member, *separator;
+	char **resized;
+
+	if (stream == NULL) {
+		errno = EINVAL;
+		return NULL;
+	}
+	while (read_database_line(stream, &group_line, &group_capacity) == 0) {
+		if (split_database_fields(group_line, fields, 4) != 0 ||
+		    parse_database_id(fields[2], &gid_value) != 0) {
+			continue;
+		}
+		gid = (gid_t)gid_value;
+		if ((unsigned long)gid != gid_value) continue;
+
+		member_count = fields[3][0] == '\0' ? 0 : 1;
+		for (member = fields[3]; *member != '\0'; ++member) {
+			if (*member == ',') ++member_count;
+		}
+		if (member_count + 1 > group_members_capacity) {
+			resized = realloc(group_members,
+			                  (member_count + 1) * sizeof(*group_members));
+			if (resized == NULL) return NULL;
+			group_members = resized;
+			group_members_capacity = member_count + 1;
+		}
+
+		member_index = 0;
+		member = fields[3];
+		while (member[0] != '\0') {
+			separator = strchr(member, ',');
+			if (separator != NULL) *separator = '\0';
+			if (member[0] == '\0') break;
+			group_members[member_index++] = member;
+			if (separator == NULL) break;
+			member = separator + 1;
+		}
+		if (member_index != member_count) continue;
+		group_members[member_index] = NULL;
+
+		group_entry.gr_name = fields[0];
+		group_entry.gr_passwd = fields[1];
+		group_entry.gr_gid = gid;
+		group_entry.gr_mem = group_members;
+		return &group_entry;
+	}
+	return NULL;
+}
