+#ifndef RTLD_DI_LMID
+#define RTLD_DI_LMID 1
+#endif
+
+int dlinfo(void *handle, int request, void *result)
+{
+	if (handle == NULL || result == NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (request == RTLD_DI_LMID) {
+		*(long *)result = 0;
+		return 0;
+	}
+	if (request == RTLD_DI_LINKMAP) {
+		errno = ENOTSUP;
+		return -1;
+	}
+	errno = EINVAL;
+	return -1;
+}
