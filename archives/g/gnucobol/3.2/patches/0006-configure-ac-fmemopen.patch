--- a/configure.ac
+++ b/configure.ac
@@ -1250,8 +1250,29 @@ dnl   [AC_DEFINE([HAVE_RAISE], [1]) AC_MSG_RESULT([yes])],
 dnl   [AC_MSG_RESULT([no])],
 dnl   [])
 
-AC_CHECK_FUNCS([fdatasync sigaction fmemopen])
+AC_CHECK_FUNCS([fdatasync sigaction])
 AC_CHECK_DECLS([fdatasync])	# also check for declaration, missing on MacOS...
 AC_CHECK_DECLS([fmemopen])	# also check for declaration, missing on AIX...
+# fmemopen may exist at link time but not work at runtime (e.g. OHOS).
+# Verify it actually works with a runtime test.
+AC_CACHE_CHECK([whether fmemopen works], [ac_cv_fmemopen_works],
+  [AC_RUN_IFELSE(
+    [AC_LANG_PROGRAM(
+      [[#include <stdio.h>
+        #include <string.h>]],
+      [[char buf[32];
+        FILE *f = fmemopen(buf, sizeof(buf), "w");
+        if (!f) return 1;
+        if (fprintf(f, "test") != 4) { fclose(f); return 1; }
+        fclose(f);
+        return strcmp(buf, "test") != 0;]])],
+    [ac_cv_fmemopen_works=yes],
+    [ac_cv_fmemopen_works=no],
+    [ac_cv_fmemopen_works=no])]
+)
+if test "$ac_cv_fmemopen_works" = yes; then
+  AC_DEFINE([HAVE_FMEMOPEN], [1], [Define if fmemopen works properly])
+fi
+
 
 # Checks for gettext.
