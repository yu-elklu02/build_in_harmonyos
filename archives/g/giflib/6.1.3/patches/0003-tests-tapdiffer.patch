 	if [ ! "${QUIET}" = 1 ]
 	then
 		echo "  --- |"
-		sed </tmp/tapdiff$$ -e 's/^/  /'
+		sed <"$tmpfile" -e 's/^/  /'
 		echo "  ..."
 	fi
 fi
 
