From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 2/2] E215: upstream test fixes for OHOS (aarch64)

---
 glib/tests/environment.c |  8 ++++++--
 glib/tests/meson.build   | 13 +++++++++++--
 gio/tests/meson.build    | 56 +++++++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 73 insertions(+), 4 deletions(-)

--- a/glib/tests/environment.c
+++ b/glib/tests/environment.c
@@ -125,8 +125,13 @@
   /* Different OSs return different values; some return NULL because the key
    * is invalid, but some are happy to return what we set above. */
   data = g_getenv ("foo=bar");
-  if (data != NULL)
+  if (data != NULL && strcmp (data, "baz") == 0)
     g_assert_cmpstr (data, ==, "baz");
+  else if (data != NULL && strcmp (data, "bar=baz") == 0)
+    /* E215: OHOS treats '=' as part of key (does not parse 'foo=bar'
+     * as foo with value bar=baz), so g_getenv("foo=bar") returns
+     * the value associated with that exact key, which is "bar=baz". */
+    g_test_message ("OHOS: g_getenv('foo=bar') returns '%s' (treats '=' as part of key)", data);
   else
     {
       data = g_getenv ("foo");
