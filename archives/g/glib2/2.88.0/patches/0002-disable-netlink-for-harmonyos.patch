--- a/meson.build
+++ b/meson.build
@@ -482,8 +482,11 @@
   glib_conf_prefix = glib_conf_prefix + '#define HAVE_MALLOC_H 1\n'
 endif
 
-if (glib_conf.has('HAVE_LINUX_NETLINK_H') or
-    (glib_conf.has('HAVE_NETLINK_NETLINK_H') and glib_conf.has('HAVE_NETLINK_NETLINK_ROUTE_H')))
+# HarmonyOS restricts netlink; the netlink-based GNetworkMonitor does not
+# work there, so never enable HAVE_NETLINK on HarmonyOS even if the headers exist.
+if (host_system != 'harmonyos' and
+    (glib_conf.has('HAVE_LINUX_NETLINK_H') or
+     (glib_conf.has('HAVE_NETLINK_NETLINK_H') and glib_conf.has('HAVE_NETLINK_NETLINK_ROUTE_H'))))
   glib_conf.set('HAVE_NETLINK', 1)
 endif
 
