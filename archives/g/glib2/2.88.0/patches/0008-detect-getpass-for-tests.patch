From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Detect getpass before building tests

---
 meson.build                       | 1 +
 gio/tests/gtlsconsoleinteraction.c | 6 +++---
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -737,6 +737,7 @@ functions = [
   'getgrgid_r',
   'getifaddrs',
   'getmntent_r',
   'getpwnam_r',
+  'getpass',
   'getpwuid_r',
   'getresuid',
   'getvfsstat',
diff --git a/gio/tests/gtlsconsoleinteraction.c b/gio/tests/gtlsconsoleinteraction.c
--- a/gio/tests/gtlsconsoleinteraction.c
+++ b/gio/tests/gtlsconsoleinteraction.c
@@ -40,8 +40,8 @@
 
 G_DEFINE_TYPE (GTlsConsoleInteraction, g_tls_console_interaction, G_TYPE_TLS_INTERACTION)
 
-#if defined(G_OS_WIN32) || defined(__BIONIC__)
-/* win32 doesn't have getpass() */
+#ifndef HAVE_GETPASS
+/* No getpass() (win32 / bionic / musl); meson sets HAVE_GETPASS via cc.has_function. */
 #include <stdio.h>
 #ifndef BUFSIZ
 #define BUFSIZ 8192
@@ -57,9 +57,9 @@
 
   for (i = 0; i < BUFSIZ - 1; ++i)
     {
-#ifdef __BIONIC__
+#ifndef G_OS_WIN32
       buf[i] = getc (stdin);
 #else
       buf[i] = _getch ();
 #endif
       if (buf[i] == '\r')
