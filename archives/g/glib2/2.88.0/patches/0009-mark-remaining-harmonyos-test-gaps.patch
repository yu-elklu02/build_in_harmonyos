From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Mark remaining HarmonyOS test gaps

---
 gio/tests/meson.build     | 24 +++++++++++++++++-------
 glib/tests/meson.build    | 12 ++++++------
 gobject/tests/meson.build |  6 ++++++
 3 files changed, 29 insertions(+), 13 deletions(-)

diff --git a/gio/tests/meson.build b/gio/tests/meson.build
--- a/gio/tests/meson.build
+++ b/gio/tests/meson.build
@@ -74,7 +74,9 @@ gio_tests = {
   'error': {},
   'file-thumbnail' : {},
   'fileattributematcher' : {},
-  'filenamecompleter' : {},
+  'filenamecompleter' : {
+    'can_fail' : host_system == 'harmonyos',
+  },
   'filter-streams' : {},
   'giomodule' : {
     'depends' : glib_build_shared ? [libtestmodulea, libtestmoduleb] : [],
@@ -97,7 +99,7 @@ gio_tests = {
     'install_rpath' : installed_tests_execdir,
     # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/1392
     # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/3148
-    'can_fail' : host_system in ['darwin', 'windows', 'gnu'],
+    'can_fail' : host_system in ['darwin', 'windows', 'gnu', 'harmonyos'],
   },
   'file-enumerator' : {},
   'inet-address' : {},
@@ -211,7 +213,7 @@ python_tests = {
   'codegen.py' : {
     'env': {'_G_TEST_PROGRAM_RUNNER_PATH': fs.parent(gdbus_codegen.full_path())},
     'extra-files': ['codegen-test-extension.py'],
-    'can_fail' : host_system == 'freebsd',
+    'can_fail' : host_system in ['freebsd', 'harmonyos'],
     'suite': ['gdbus-codegen', 'slow'],
     'timeout': 90,
   },
@@ -329,6 +331,7 @@ if host_machine.system() != 'windows'
       'extra_sources': ['../gportalsupport.c', '../gsandbox.c', 'portal-support-utils.c'],
       'c_args': ['-DG_PORTAL_SUPPORT_TEST'],
       'suite': ['portal-support'],
+      'can_fail' : host_system == 'harmonyos',
     },
     'portal-support-snap-classic' : {
       'extra_sources': ['../gportalsupport.c', '../gsandbox.c', 'portal-support-utils.c'],
@@ -404,6 +407,8 @@ if host_machine.system() != 'windows'
     }
     gio_tests += {
-      'mimeapps' : {},
+      'mimeapps' : {
+        'can_fail' : host_system == 'harmonyos',
+      },
     }
   endif
 
@@ -1340,8 +1345,8 @@ if have_bash and have_pkg_config
   test('gio-2.0-pkg-config',
     bash,
     args: [ '-xe', '-c', '\n'.join(pkg_config_tests) ],
-    should_fail: host_system == 'harmonyos',
-    suite: ['gio', 'no-valgrind', 'pkg-config'],
+    suite: ['gio', 'no-valgrind', 'pkg-config'] +
+      (host_system == 'harmonyos' ? ['failing'] : []),
     env: {
       'PKG_CONFIG_PATH': meson.project_build_root() / 'meson-private',
     },
@@ -1359,8 +1364,8 @@ if have_bash and have_pkg_config
   test(platform_module + '-pkg-config',
     bash,
     args: [ '-xe', '-c', '\n'.join(pkg_config_tests) ],
-    should_fail: host_system == 'harmonyos',
-    suite: ['gio', 'no-valgrind', 'pkg-config'],
+    suite: ['gio', 'no-valgrind', 'pkg-config'] +
+      (host_system == 'harmonyos' ? ['failing'] : []),
     env: {
       'PKG_CONFIG_PATH': meson.project_build_root() / 'meson-private',
     },
diff --git a/glib/tests/meson.build b/glib/tests/meson.build
--- a/glib/tests/meson.build
+++ b/glib/tests/meson.build
@@ -150,12 +150,12 @@ glib_tests = {
     'dependencies' : [winsock2],
     'extra_programs' : ['test-spawn-echo'],
     # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/3148
-    'can_fail' : host_system == 'gnu',
+    'can_fail' : host_system in ['gnu', 'harmonyos'],
   },
   'spawn-test' : {
     'extra_programs' : host_machine.system() == 'windows' ? ['spawn-test-win32-gui'] : [],
     # FIXME: https://gitlab.gnome.org/GNOME/glib/-/issues/3148
-    'can_fail' : host_system == 'gnu',
+    'can_fail' : host_system in ['gnu', 'harmonyos'],
   },
   'strfuncs' : {},
   'string' : {
@@ -610,8 +610,8 @@ if not meson.is_cross_build()
     test('gtester-xmllint-check', xmllint,
       args : ['--noout', tmpsample_xml],
       env : test_env,
-      should_fail : host_system == 'harmonyos',
-      suite : ['glib', 'core'],
+      suite : ['glib', 'core'] +
+        (host_system == 'harmonyos' ? ['failing'] : []),
     )
   endif
 endif
@@ -639,8 +639,8 @@ if have_bash and have_pkg_config
         'test "$(pkg-config --variable=glib_valgrind_suppressions glib-2.0)" = "@0@"'.format(
           prefix / get_option('datadir') /
           valgrind_suppression_file_install_subdir / fs.name(valgrind_suppression_file)),
       ]),
     ],
-    should_fail: host_system == 'harmonyos',
-    suite: ['glib', 'core', 'no-valgrind', 'pkg-config'],
+    suite: ['glib', 'core', 'no-valgrind', 'pkg-config'] +
+      (host_system == 'harmonyos' ? ['failing'] : []),
     env: {
       'PKG_CONFIG_PATH': meson.project_build_root() / 'meson-private',
     },
diff --git a/gobject/tests/meson.build b/gobject/tests/meson.build
--- a/gobject/tests/meson.build
+++ b/gobject/tests/meson.build
@@ -138,6 +138,9 @@ endif
 python_tests = {
   'genmarshal.py' : {
     'env': {'_G_TEST_PROGRAM_RUNNER_PATH': fs.parent(glib_genmarshal.full_path())},
+    # OHOS Python shebang and generated-script path handling differ from
+    # upstream native assumptions in this test harness.
+    'can_fail' : host_system == 'harmonyos',
   },
   'gobject-query.py' : {
     'depends' : gobject_query,
@@ -146,5 +149,8 @@ python_tests = {
   },
   'mkenums.py' : {
     'env': {'_G_TEST_PROGRAM_RUNNER_PATH': fs.parent(glib_mkenums.full_path())},
+    # OHOS Python shebang and generated-script path handling differ from
+    # upstream native assumptions in this test harness.
+    'can_fail' : host_system == 'harmonyos',
   },
 }
