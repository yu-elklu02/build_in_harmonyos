 def _forced_symlink(source, link_name):
     try:
         standard_os_symlink(source, link_name)
+    except PermissionError:
+        # HMDFS does not support symlinks, copy instead.
+        # Distinguish file vs directory source: shutil.copy2 raises
+        # IsADirectoryError on a directory source.
+        if os.path.exists(source):
+            import shutil
+            if os.path.islink(link_name) or os.path.exists(link_name):
+                # Also distinguish file vs directory TARGET: os.remove()
+                # only handles files/symlinks and raises IsADirectoryError
+                # on a directory. On HMDFS an earlier copytree() created a
+                # directory here, so a subsequent incremental build must
+                # rmtree() it, not remove() it.
+                if os.path.isdir(link_name) and not os.path.islink(link_name):
+                    shutil.rmtree(link_name)
+                else:
+                    os.remove(link_name)
+            if os.path.isdir(source):
+                shutil.copytree(source, link_name)
+            else:
+                shutil.copy2(source, link_name)
+        else:
+            # Source is a relative symlink target that doesn't exist as a real file
+            print(f"WARNING: Cannot create symlink {link_name} -> {source} (HMDFS restriction)")
     except OSError:
