--- a/configure
+++ b/configure
@@ -0,0 +1,16 @@
+#!/bin/sh
+# Minimal configure shim for package build systems that expect ./configure.
+# krep uses a plain Makefile; accept standard options and generate no files.
+for arg in "$@"; do
+    case "$arg" in
+        --help)
+            echo "krep uses a plain Makefile; configure options are ignored."
+            exit 0
+            ;;
+        --prefix=*|--host=*|--build=*|--target=*)
+            ;;
+        *)
+            ;;
+    esac
+done
+exit 0
